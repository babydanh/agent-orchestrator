24:export default function RegisterModal({ tournamentId, divisionId, tournamentName, entryFee, matchType, isRanked = false, isOpen, onClose }: Props) {
25:  const { user, isAuthenticated } = useAuthStore();
26:  const router = useRouter();
27:  const translate = useTranslations('Common');
28:  const [isSubmitting, setIsSubmitting] = useState(false);
29:  const [partnerEmailOrPhone, setPartnerEmailOrPhone] = useState('');
30:  const [rankingConsent, setRankingConsent] = useState(false);
31:
32:  const isDoubles = matchType === 'DOUBLES' || matchType === 'MIXED_DOUBLES';
33:
34:  if (!isOpen) return null;
35:
36:  const handleRegisterSubmit = async (e: React.FormEvent) => {
37:    e.preventDefault();
38:    if (!isAuthenticated || !user) {
39:      toast.error(translate('loginToRegister'));
40:      window.location.assign(`/login?redirect=/tournaments/${tournamentId}`);
41:      return;
42:    }
43:
44:
45:    try {
46:      setIsSubmitting(true);
47:      const teamName = user?.fullName || translate('player');
48:      const payload: { teamName: string; partnerEmailOrPhone?: string; tournamentDivisionId?: string; rankingConsent?: true } = {
49:        teamName,
50:        ...(isRanked && rankingConsent ? { rankingConsent: true } : {}),
51:        ...(divisionId ? { tournamentDivisionId: divisionId } : {}),
52:      };
53:      if (isDoubles && partnerEmailOrPhone.trim()) {
54:        payload.partnerEmailOrPhone = partnerEmailOrPhone.trim();
55:      }
56:
57:      const res = await tournamentsApi.register(tournamentId, payload);
58:      const participantId = res?.data?.participant?.id;
59:      const payableEntryFee = Number(res?.data?.entryFee ?? entryFee);
60:      const paymentEligible = res?.data?.paymentEligible === true;
61:
62:      if (isDoubles && partnerEmailOrPhone.trim()) {
63:        toast.success(translate('partnerInviteSent'), { duration: 5000 });
64:      } else {
65:        toast.success(translate('registrationSuccess'));
66:      }
67:      onClose();
68:      
69:            if (paymentEligible && payableEntryFee > 0 && participantId) {
70:
71:        router.push(`/payments/checkout?participantId=${participantId}&tournamentId=${tournamentId}`);
72:      } else {
73:        router.refresh();
74:      }
75:    } catch (error) {
76:      toast.error(getErrorMessage(error));
77:    } finally {
78:      setIsSubmitting(false);
79:    }
80:  };
81:
82:  return (
83:    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
84:      <div className="bg-white rounded-lg shadow-xl w-full max-w-md overflow-hidden">
85:        <div className="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
86:          <h2 className="text-lg font-bold text-slate-900 flex items-center gap-2">
87:            <Users className="w-5 h-5 text-blue-600" /> {translate('registerForTournament')}
88:          </h2>
89:          <button onClick={onClose} className="text-slate-400 hover:text-slate-600 transition-colors">
90:            <X className="w-5 h-5" />
91:          </button>
92:        </div>
93:        
94:        <div className="p-6">
95:          <p className="text-sm text-slate-600 mb-5">
96:            {translate('registerDescription')} <strong className="text-slate-900">{tournamentName}</strong>.
97:          </p>
98:          
99:          <form onSubmit={handleRegisterSubmit} className="flex flex-col gap-4">
100:            <div className="bg-blue-50/70 border border-blue-200/80 rounded-lg p-4 flex items-center justify-between">
101:              <div>
102:                <p className="text-xs text-blue-600 font-semibold mb-0.5">{translate('registeredAthleteCaptain')}</p>
103:                <p className="text-base font-bold text-slate-900">{user?.fullName || translate('notUpdated')}</p>
104:                <p className="text-xs text-slate-500 mt-0.5">{translate('accountNameAuto')}</p>
105:              </div>
106:            </div>
107:
108:            {isDoubles && (
109:              <div className="space-y-1.5">
110:                <label className="text-xs font-bold text-slate-700">{translate('partnerLabel')}</label>
111:                <input
112:                  type="text"
113:                  placeholder="{translate('partnerPlaceholder')}"
114:                  value={partnerEmailOrPhone}
115:                  onChange={(e) => setPartnerEmailOrPhone(e.target.value)}
116:                  className="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
117:                />
118:                <p className="text-xs text-amber-700 bg-amber-50 p-2.5 rounded-md border border-amber-200 leading-snug">
119:                  ⏱️ <strong>{translate('pairingDeadline')}:</strong> {translate('pairingDeadlineNotice', { hours: 1 })}
120:                </p>
121:              </div>
122:            )}
123:            
124:            <div className="bg-slate-50 border border-slate-200/80 p-4 rounded-lg">
125:              <p className="text-xs text-slate-600 font-medium leading-relaxed">
126:                {translate('registrationTermsNotice')}
127:              </p>
128:            </div>
129:
130:            {isRanked && (
131:              <label className="flex items-start gap-3 rounded-xl border border-sky-200 bg-sky-50 p-3 text-sm text-slate-700">
132:                <input
133:                  type="checkbox"
134:                  checked={rankingConsent}
135:                  onChange={(event) => setRankingConsent(event.target.checked)}
136:                  className="mt-1 h-4 w-4 accent-sky-600"
137:                />
138:                <span>{translate('rankingConsentLabel')}</span>
139:              </label>
140:            )}
141:
142:            <div className="flex justify-end gap-3 mt-4">
143:              <Button type="button" variant="outline" onClick={onClose} className="border-slate-200 text-slate-600">
144:                {translate('cancel')}
145:              </Button>
146:              <Button type="submit" disabled={isSubmitting} className="bg-blue-600 hover:bg-blue-700 text-white font-semibold">
147:                {isSubmitting ? translate('processing') : translate('confirmRegistration')}
148:              </Button>
149:            </div>
150:          </form>
151:        </div>
152:      </div>
153:    </div>
154:  );
155:}

