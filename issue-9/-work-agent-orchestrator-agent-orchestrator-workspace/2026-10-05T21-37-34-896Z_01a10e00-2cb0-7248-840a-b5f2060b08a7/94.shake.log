40:  const isTeamSport = mainSize !== undefined || config?.teamSize !== undefined || config?.minTeamSize !== undefined;
41:  if (!isTeamSport) {
42:    return { isTeamSport: false, requiredPlayerCount: 1, maxPlayerCount: 1, maxReserveCount: 0 };
