51:  private buildFrontendLink(path: string, claimToken?: string): string | null {
52:    const configuredUrl =
53:      process.env.FRONTEND_URL ?? 'http://localhost:3001';
54:    try {
55:      const base = new URL(configuredUrl);
56:      if (
57:        (base.protocol !== 'http:' && base.protocol !== 'https:') ||
58:        base.username ||
59:        base.password
60:      ) {
61:        return null;
62:      }
63:
64:      const link = new URL(path, base.origin);
65:      if (link.origin !== base.origin) return null;
66:      if (claimToken) {
67:        link.hash = new URLSearchParams({ token: claimToken }).toString();
68:      }
69:      return link.toString();
70:    } catch {
71:      return null;
72:    }
73:  }
