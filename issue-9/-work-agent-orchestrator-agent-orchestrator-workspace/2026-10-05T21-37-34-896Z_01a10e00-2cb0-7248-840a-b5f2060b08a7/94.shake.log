100:  const minSize = Number(record.minTeamSize);
101:  const option = Array.isArray(record.teamSizeOptions)
102:    ? record.teamSizeOptions.map(Number).find((size) => FOOTBALL_TEAM_SIZES.includes(size as FootballTeamSize))
103:    : undefined;
104:  const mainSize = [explicitSize, minSize, option ?? 0].find(
105:    (size) => Number.isInteger(size) && FOOTBALL_TEAM_SIZES.includes(size as FootballTeamSize),
106:  ) ?? 0;
107:  const isTeamSport = mainSize > 0 || record.teamSize !== undefined || record.minTeamSize !== undefined || option !== undefined;
108:  if (!isTeamSport) {
109:    return { isTeamSport: false, mainSize: 0, maxReserve: 0, maxTotalSize: Number.MAX_SAFE_INTEGER };
110:  }
111:
112:  const configuredReserve = Number(record.maxReserve ?? 0);
113:  const maxReserve = record.allowReserve === false
114:    ? 0
115:    : Number.isFinite(configuredReserve) && configuredReserve > 0
116:      ? Math.floor(configuredReserve)
117:      : 0;
118:  const configuredMax = Number(record.maxTeamSize);
119:  const maxTotalSize = Number.isInteger(configuredMax) && configuredMax >= mainSize
120:    ? configuredMax
121:    : mainSize + maxReserve;
122:
123:  return { isTeamSport: true, mainSize, maxReserve, maxTotalSize };
