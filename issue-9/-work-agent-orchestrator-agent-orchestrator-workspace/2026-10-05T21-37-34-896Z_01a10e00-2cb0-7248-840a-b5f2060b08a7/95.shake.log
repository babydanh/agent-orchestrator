113:  async sendDueReminders(): Promise<number> {
114:    if (!this.mailService) return 0;
115:    const now = new Date();
116:
117:    // Keep rows whose notifiedAt is NULL: failed delivery must not consume an
118:    // attempt or silently end all reminders.
119:    const due = await this.db
120:      .select({
121:        id: schema.tournamentRosters.id,
122:        attempts: schema.tournamentRosters.consentNotifiedCount,
123:        consentNotifiedAt: schema.tournamentRosters.consentNotifiedAt,
124:        joinedAt: schema.tournamentRosters.joinedAt,
125:      })
126:      .from(schema.tournamentRosters)
127:      .innerJoin(
128:        schema.users,
129:        eq(schema.users.id, schema.tournamentRosters.userId),
130:      )
131:      .innerJoin(
132:        schema.tournamentParticipants,
133:        eq(
134:          schema.tournamentParticipants.id,
135:          schema.tournamentRosters.participantId,
136:        ),
137:      )
138:      .innerJoin(
139:        schema.tournaments,
140:        eq(schema.tournaments.id, schema.tournamentParticipants.tournamentId),
141:      )
142:      .where(
143:        and(
144:          isNull(schema.tournamentRosters.rankingConsentAt),
145:          eq(schema.tournamentRosters.status, 'ACTIVE'),
146:          inArray(
147:            schema.tournamentParticipants.teamStatus,
148:            [...CAPACITY_RESERVING_TEAM_STATUSES],
149:          ),
150:          eq(schema.users.isEmailVerified, true),
151:          isNull(schema.users.deletedAt),
152:          eq(schema.tournaments.isRanked, true),
153:          isNull(schema.tournaments.deletedAt),
154:          notInArray(schema.tournaments.status, [
155:            'COMPLETED',
156:            'CANCELLED',
157:          ]),
158:          or(
159:            isNull(schema.tournaments.endDate),
160:            gt(schema.tournaments.endDate, now),
161:          ),
162:          lt(
163:            schema.tournamentRosters.consentNotifiedCount,
164:            CONSENT_MAX_NOTIFICATIONS,
165:          ),
166:        ),
167:      );
168:
169:    let sent = 0;
170:    for (const row of due) {
171:      if (!this.isReminderDue(row, now)) continue;
172:      if (await this.dispatch(row.id, 'REMINDER')) sent += 1;
173:    }
174:    return sent;
175:  }
176:
177:  private isReminderDue(row: ConsentScheduleRow, now: Date): boolean {
178:    if (row.attempts >= CONSENT_MAX_NOTIFICATIONS) return false;
179:    const anchor = row.consentNotifiedAt ?? row.joinedAt;
180:    if (!anchor) return false;
181:    const delayHours =
182:      CONSENT_REMINDER_DELAYS_HOURS[
183:        Math.min(
184:          Math.max(row.attempts - 1, 0),
185:          CONSENT_REMINDER_DELAYS_HOURS.length - 1,
186:        )
187:      ];
188:    return now.getTime() - new Date(anchor).getTime() >= delayHours * 3_600_000;
189:  }
