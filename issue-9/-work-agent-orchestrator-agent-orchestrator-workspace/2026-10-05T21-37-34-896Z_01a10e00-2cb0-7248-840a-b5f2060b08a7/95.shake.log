149:  private async withLeaderboardCacheTimeout<T>(
150:    operation: Promise<T>,
151:  ): Promise<T | undefined> {
152:    return new Promise<T | undefined>((resolve) => {
153:      let settled = false;
154:      const timer = setTimeout(() => {
155:        if (!settled) {
156:          settled = true;
157:          resolve(undefined);
158:        }
159:      }, RankingsService.LEADERBOARD_CACHE_TIMEOUT_MS);
160:
161:      operation.then(
162:        (value) => {
163:          if (settled) return;
164:          settled = true;
165:          clearTimeout(timer);
166:          resolve(value);
167:        },
168:        () => {
169:          if (settled) return;
170:          settled = true;
171:          clearTimeout(timer);
172:          resolve(undefined);
173:        },
174:      );
175:    });
176:  }
