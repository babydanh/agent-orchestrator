130:export async function fulfillApi(route: Route, payload: unknown, status = 200) {
131:  const requestHeaders = route.request().headers();
132:  const headers = createApiFixtureCorsHeaders(requestHeaders, 'http://127.0.0.1:3001');
133:
134:  if (route.request().method() === 'OPTIONS') {
135:    await route.fulfill({ status: 204, headers });
136:    return;
137:  }
138:
139:  await route.fulfill({ status, headers, json: payload });
140:}
