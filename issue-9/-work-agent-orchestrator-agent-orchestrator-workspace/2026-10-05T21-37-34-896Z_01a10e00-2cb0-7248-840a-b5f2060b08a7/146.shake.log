111:async function fulfillApi(route: Route, payload: unknown, status = 200) {
112:  const request = route.request();
113:  const requestHeaders = request.headers();
114:  const headers = {
115:    'access-control-allow-origin': requestHeaders.origin ?? 'http://127.0.0.1:3001',
116:    'access-control-allow-credentials': 'true',
117:    'access-control-allow-methods': 'GET, POST, OPTIONS',
118:    'access-control-allow-headers': requestHeaders['access-control-request-headers'] ?? 'authorization,content-type',
119:  };
120:
121:  if (request.method() === 'OPTIONS') {
122:    await route.fulfill({ status: 204, headers });
123:    return;
124:  }
125:
126:  await route.fulfill({ status, headers, json: payload });
127:}
