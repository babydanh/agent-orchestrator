    if (!this.mailService) return false;
    const link = this.buildFrontendLink(
      `/tournaments/${encodeURIComponent(args.tournamentId)}/guest-claim/${encodeURIComponent(args.guestId)}`,
      args.claimToken,
    );
    if (!link) return false;

    const tournamentName = args.tournamentName.replace(/[\r\n]+/g, ' ').trim();
