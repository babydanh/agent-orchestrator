28:  const [isSubmitting, setIsSubmitting] = useState(false);
29:  const [partnerEmailOrPhone, setPartnerEmailOrPhone] = useState('');
30:  const [rankingConsent, setRankingConsent] = useState(false);
31:
32:  const isDoubles = matchType === 'DOUBLES' || matchType === 'MIXED_DOUBLES';
33:
34:  if (!isOpen) return null;
35:
36:  const handleRegisterSubmit = async (e: React.FormEvent) => {
37:    e.preventDefault();
38:    if (!isAuthenticated || !user) {
39:      toast.error(translate('loginToRegister'));
40:      window.location.assign(`/login?redirect=/tournaments/${tournamentId}`);
41:      return;
42:    }
43:
44:
45:    try {
46:      setIsSubmitting(true);
47:      const teamName = user?.fullName || translate('player');
48:      const payload: { teamName: string; partnerEmailOrPhone?: string; tournamentDivisionId?: string; rankingConsent?: true } = {
49:        teamName,
50:        ...(isRanked && rankingConsent ? { rankingConsent: true } : {}),
51:        ...(divisionId ? { tournamentDivisionId: divisionId } : {}),
52:      };
53:      if (isDoubles && partnerEmailOrPhone.trim()) {
54:        payload.partnerEmailOrPhone = partnerEmailOrPhone.trim();
55:      }
56:
57:      const res = await tournamentsApi.register(tournamentId, payload);
58:      const participantId = res?.data?.participant?.id;
59:      const payableEntryFee = Number(res?.data?.entryFee ?? entryFee);
60:      const paymentEligible = res?.data?.paymentEligible === true;
61:
62:      if (isDoubles && partnerEmailOrPhone.trim()) {
63:        toast.success(translate('partnerInviteSent'), { duration: 5000 });
64:      } else {
65:        toast.success(translate('registrationSuccess'));
66:      }
67:      onClose();
68:      
69:            if (paymentEligible && payableEntryFee > 0 && participantId) {
70:
71:        router.push(`/payments/checkout?participantId=${participantId}&tournamentId=${tournamentId}`);
72:      } else {
73:        router.refresh();
74:      }
