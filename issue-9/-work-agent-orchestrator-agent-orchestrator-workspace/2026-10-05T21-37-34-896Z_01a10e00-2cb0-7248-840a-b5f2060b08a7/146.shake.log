89:function RegistrationProfileAvatar({ name, avatarUrl, size = 'sm' }: RegistrationProfileAvatarProps) {
90:  const initials = (name || '?')
91:    .trim()
92:    .split(/\s+/)
93:    .filter(Boolean)
94:    .slice(-2)
95:    .map((part) => part[0]?.toUpperCase() ?? '')
96:    .join('') || '?';
97:  const sizeClass = size === 'md' ? 'h-11 w-11 text-sm' : 'h-8 w-8 text-xs';
98:
99:  return avatarUrl ? (
100:    // eslint-disable-next-line @next/next/no-img-element
101:    <img
102:      src={avatarUrl}
103:      alt={name || 'Profile'}
104:      className={cn('shrink-0 rounded-full object-cover ring-1 ring-slate-200', sizeClass)}
105:    />
106:  ) : (
107:    <span className={cn('inline-flex shrink-0 items-center justify-center rounded-full bg-blue-100 font-bold text-blue-700 ring-1 ring-blue-200', sizeClass)}>
108:      {initials}
109:    </span>
110:  );
111:}
