136:/**
137: * The persisted auth blob, narrowed at runtime rather than asserted into a
138: * shape: it is the only place a stale session bootstrap can resurface after a
139: * logout, because the store writes through to storage on every update.
140: */
141:async function readPersistedAuthState(page: Page): Promise<Record<string, unknown>> {
142:  const blob: unknown = await page.evaluate(() => {
143:    const raw = window.localStorage.getItem('auth-storage');
144:    if (!raw) return null;
145:    const parsed: unknown = JSON.parse(raw);
146:    if (parsed && typeof parsed === 'object' && 'state' in parsed) return parsed.state;
147:    return null;
148:  });
149:  return blob !== null && typeof blob === 'object' ? (blob as Record<string, unknown>) : {};
150:}
