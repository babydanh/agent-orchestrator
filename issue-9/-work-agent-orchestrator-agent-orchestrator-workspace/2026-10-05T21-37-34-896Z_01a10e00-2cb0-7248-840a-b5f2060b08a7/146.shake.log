1406:    return players.map((player) => {
1407:      const email = player.email ? normalizeEmail(player.email) : null;
1408:      const matches = email ? accountsByEmail.get(email) ?? [] : [];
1409:      const account = matches.length === 1 ? matches[0] : null;
1410:      return {
