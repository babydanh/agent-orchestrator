1364:  private async resolveDirectAthletes(
1365:    tx: AppDbOrTx,
1366:    players: AddAthletePlayerDto[],
1367:  ): Promise<ResolvedAddAthlete[]> {
1368:    const normalizedEmails = [
1369:      ...new Set(
