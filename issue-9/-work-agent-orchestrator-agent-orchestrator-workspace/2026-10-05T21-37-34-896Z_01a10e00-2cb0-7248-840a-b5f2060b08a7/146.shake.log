  private buildFrontendLink(path: string, claimToken?: string): string | null {
    const configuredUrl =
      process.env.FRONTEND_URL ?? 'http://localhost:3001';
    try {
      const base = new URL(configuredUrl);
      if (
        (base.protocol !== 'http:' && base.protocol !== 'https:') ||
        base.username ||
        base.password
      ) {
        return null;
      }

      const link = new URL(path, base.origin);
      if (link.origin !== base.origin) return null;
      if (claimToken) {
        link.hash = new URLSearchParams({ token: claimToken }).toString();
      }
      return link.toString();
    } catch {
      return null;
    }
  }

