    if (!isOrganizerPairing && cleanTeamName.length < 3) {
      toast.error(registrationTranslate('teamNameMinLength'));
      return;
    }

    const submittedCustomResponses = normalizeRegistrationResponses(customResponses ?? {});
    if (registrationFields && registrationFields.length > 0) {
      const customError = validateRegistrationResponses(registrationFields, submittedCustomResponses, registrationTranslate);
      if (customError) {
        toast.error(customError);
        return;
      }
    }

    if (!isOrganizerPairing && !inviteLater && !searchedPartner) {
      toast.error(registrationTranslate('partnerSearchConfirm'));
      return;
    }

    if (tournament?.isRanked && !rankingConsent) {
      toast.error(doublesTranslate('rankingConsentRequired'));
      return;
    }

    if (submitLockRef.current) return;
    submitLockRef.current = true;

    try {
      setIsSubmitting(true);
      const partnerEmailOrPhone = isOrganizerPairing
        ? undefined
        : inviteLater ? undefined : (searchedPartner?.email || searchedPartner?.phoneNumber || partnerQuery);
      const res = await tournamentsApi.register(tournamentId, {
        ...(!isOrganizerPairing && cleanTeamName ? { teamName: cleanTeamName } : {}),
        inviteCode,
        partnerEmailOrPhone,
        doublesPairingMode: pairingMode,
        tournamentDivisionId: divisionId,
        rankingConsent,
        customResponses: submittedCustomResponses,
      });

      if (res.data) {
        const part = normalizeRegistrationParticipant(res.data.participant, res.data.teamInviteLink, res.data.paymentEligible);
        if (!part) {
          toast.error(doublesTranslate('validRegistrationData'));
          return;
        }
        setParticipant(part);
        setPairingModeFromParticipant(part);
        const shouldShowPersistentStatus = isOrganizerPairing && (
          isParticipantPendingApproval(part.teamStatus) ||
          isParticipantPendingPartner(part.teamStatus)
        );
        if (!shouldShowPersistentStatus) {
          toast.success(
            isParticipantPendingApproval(part.teamStatus)
              ? doublesTranslate('approvalSubmitted')
              : isParticipantPendingPartner(part.teamStatus)
                ? isOrganizerPairing
                  ? doublesTranslate('organizerPairingSubmitted')
                  : partnerEmailOrPhone
                    ? doublesTranslate('notificationSentTitle')
                    : registrationTranslate('teamCreatedInviteNextStep')
                : isParticipantReadyForNextStep(part.teamStatus)
                  ? doublesTranslate('doublesRegistered')
                  : isParticipantWaitlisted(part.teamStatus)
                    ? doublesTranslate('waitlistedRegistrationTitle')
                    : registrationTranslate('teamCreatedInviteNextStep'),
          );
        }
        if (isOrganizerPairing) {
          setStep(2);
        } else if (isParticipantReadyForNextStep(part.teamStatus)) {
          setStep(3);
        } else {
          setStep(2);
        }
        onRegistrationChanged?.(part);
      }
    } catch (err) {
      if (isAxiosError(err) && err.response?.status === 401) {
        redirectToLogin();
        return;
      }
      toast.error(getErrorMessage(err));
    } finally {
      submitLockRef.current = false;
      setIsSubmitting(false);
    }
