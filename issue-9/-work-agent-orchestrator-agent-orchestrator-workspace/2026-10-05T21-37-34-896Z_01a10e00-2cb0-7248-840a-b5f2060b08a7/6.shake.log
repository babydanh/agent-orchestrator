8: * commit re-checks capacity inside the transaction.
9: */
10:
11:import { and, eq, gt, inArray, isNull, ne, notExists, or, sql } from 'drizzle-orm';
12:import type { AppDbOrTx } from '../../../database/db.types';
13:import * as schema from '../../../database/schema';
14:import { calculateRequestedTeamSlots } from '../utils/tournament-participant-status';
15:
16:export const ROSTER_EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
17:
18:export interface EligibleRosterAccount {
19:  id: string;
20:  email: string;
21:}
22:
23:function normalizeCandidateEmails(emails: readonly string[]): string[] {
24:  return [
25:    ...new Set(
26:      emails
27:        .filter((email) => ROSTER_EMAIL_PATTERN.test(email.trim()))
28:        .map(normalizeRosterEmail),
29:    ),
30:  ];
31:}
32:
33:/** Account identities stay inside the write path; preview projects email status only. */
34:export async function findEligibleRosterAccountIds(
35:  emails: readonly string[],
36:  db: AppDbOrTx,
37:): Promise<Map<string, string>> {
38:  const normalizedEmails = normalizeCandidateEmails(emails);
39:  if (normalizedEmails.length === 0) return new Map();
40:
41:  const now = new Date();
42:  const activeBan = db
43:    .select({ id: schema.userBans.id })
44:    .from(schema.userBans)
45:    .where(
46:      and(
47:        eq(schema.userBans.userId, schema.users.id),
48:        eq(schema.userBans.isActive, true),
49:        inArray(schema.userBans.banType, ['SOFT_BAN', 'HARD_BAN']),
50:        or(
51:          isNull(schema.userBans.expiresAt),
52:          gt(schema.userBans.expiresAt, now),
53:        ),
54:      ),
55:    );
56:  const accounts = await db
57:    .select({
58:      id: schema.users.id,
59:      email: sql<string>`lower(${schema.users.email})`,
60:    })
61:    .from(schema.users)
62:    .where(
63:      and(
64:        inArray(sql`lower(${schema.users.email})`, normalizedEmails),
65:        isNull(schema.users.deletedAt),
66:        eq(schema.users.isMock, false),
67:        notExists(activeBan),
68:      ),
69:    );
70:
71:  return new Map(accounts.map((account) => [account.email, account.id]));
72:}
73:
74:export async function resolveRosterAccountStatuses(
75:  emails: readonly string[],
76:  db: AppDbOrTx,
77:): Promise<Set<string>> {
78:  return new Set(
79:    (await findEligibleRosterAccountIds(emails, db)).keys(),
80:  );
81:}
82:
83:export async function findExistingRosterImportEmails(
84:  tournamentId: string,
85:  emails: readonly string[],
86:  db: AppDbOrTx,
87:): Promise<Set<string>> {
88:  const normalizedEmails = normalizeCandidateEmails(emails);
89:  if (normalizedEmails.length === 0) return new Set();
90:
91:  const activeParticipant = and(
92:    ne(schema.tournamentParticipants.teamStatus, 'WITHDRAWN'),
93:    ne(schema.tournamentParticipants.teamStatus, 'REJECTED'),
94:    ne(schema.tournamentParticipants.teamStatus, 'KICKED'),
95:    ne(schema.tournamentParticipants.teamStatus, 'EXPIRED'),
96:  );
97:  const player1Email =
98:    sql<string | null>`lower(${schema.tournamentParticipants.customResponses}->>'player1Email')`;
99:  const player2Email =
100:    sql<string | null>`lower(${schema.tournamentParticipants.customResponses}->>'player2Email')`;
101:  const metadataRows = await db
102:    .select({ player1Email, player2Email })
103:    .from(schema.tournamentParticipants)
104:    .where(
105:      and(
106:        eq(schema.tournamentParticipants.tournamentId, tournamentId),
107:        activeParticipant,
108:        or(
109:          inArray(player1Email, normalizedEmails),
110:          inArray(player2Email, normalizedEmails),
111:        ),
112:      ),
113:    );
114:  const rosterRows = await db
115:    .select({ email: sql<string>`lower(${schema.users.email})` })
116:    .from(schema.tournamentRosters)
117:    .innerJoin(
118:      schema.tournamentParticipants,
119:      eq(
120:        schema.tournamentRosters.participantId,
121:        schema.tournamentParticipants.id,
122:      ),
123:    )
124:    .innerJoin(
125:      schema.users,
126:      eq(schema.tournamentRosters.userId, schema.users.id),
127:    )
128:    .where(
129:      and(
130:        eq(schema.tournamentParticipants.tournamentId, tournamentId),
131:        activeParticipant,
132:        inArray(sql`lower(${schema.users.email})`, normalizedEmails),
133:      ),
134:    );
135:
136:  return new Set([
137:    ...metadataRows.flatMap((row) =>
138:      [row.player1Email, row.player2Email].filter(
139:        (email): email is string =>
140:          typeof email === 'string' && normalizedEmails.includes(email),
141:      ),
142:    ),
143:    ...rosterRows.map((row) => row.email),
144:  ]);
145:}
146:
147:export type RosterRowStatus =
148:  | 'FOUND'
149:  | 'NOT_FOUND'
150:  | 'INVALID_EMAIL'
151:  | 'MISSING_EMAIL'
152:  | 'MISSING_NAME'
153:  | 'DUPLICATE_IN_FILE'
154:  | 'DUPLICATE_IN_TOURNAMENT'
155:  | 'PLAYER2_REQUIRED'
156:  | 'PLAYER2_NOT_ALLOWED'
157:  | 'DIVISION_UNKNOWN';
158:
159:export type RosterEntryType = 'REGULAR' | 'WILD_CARD_REQUEST';
160:
161:export interface RosterImportItem {
162:  teamName?: string;
163:  divisionName?: string;
164:  player1Name?: string;
165:  player1Email?: string;
166:  player1Phone?: string;
167:  player2Name?: string;
168:  player2Email?: string;
169:  player2Phone?: string;
170:  elo?: number;
171:  isPaid?: boolean;
172:  autoApprove?: boolean;
173:  entryType?: RosterEntryType;
174:  customResponses?: Record<string, unknown>;
175:}
176:
177:export interface RosterPreviewRow {
178:  rowIndex: number;
179:  player1Email: string;
180:  player2Email: string | null;
181:  status: RosterRowStatus[];
182:  /** No blocking status remains; the row may be committed. */
183:  isEligible: boolean;
184:  capacityDelta: number;
185:}
186:
187:export interface ValidateRosterRowsInput {
188:  items: readonly RosterImportItem[];
189:  isDoubles: boolean;
190:  matchType?: string | null;
191:  tournamentConfig?: unknown;
192:  divisionNames?: readonly string[];
193:  existingEmails?: ReadonlySet<string>;
194:}
195:
196:export interface ValidatedRosterRows {
197:  rows: RosterPreviewRow[];
198:  /** Team slots the whole batch would claim, summed row by row. */
199:  requestedTeamSlots: number;
200:}
201:
202:const BLOCKING_STATUSES: ReadonlySet<RosterRowStatus> = new Set<RosterRowStatus>([
203:  'INVALID_EMAIL',
204:  // MISSING_EMAIL is deliberately absent. A missing address means the athlete
205:  // has no account yet, not that the row is unusable: organizers collect fees on
206:  // paper all the time. The row still imports, is still a real athlete rather
207:  // than mock data, and the preview shows a note.
208:  //
209:  // The cost is identity. Nothing can later match this row to a user, to an
210:  // existing entry, or to a notification, so it cannot complete its own profile.
211:  // That trade belongs to the organizer, not to the system.
212:  'MISSING_NAME',
213:  'DUPLICATE_IN_FILE',
214:  'DUPLICATE_IN_TOURNAMENT',
215:  'PLAYER2_REQUIRED',
216:  'PLAYER2_NOT_ALLOWED',
217:  'DIVISION_UNKNOWN',
218:]);
219:
220:/** Whether a status prevents the row from being committed. */
221:export function isBlockingRosterStatus(status: RosterRowStatus): boolean {
222:  return BLOCKING_STATUSES.has(status);
223:}

