241:export const tournamentRosters = pgTable('tournament_rosters', {
242:  id: uuid('id').primaryKey().defaultRandom(),
243:  participantId: uuid('participant_id')
244:    .references(() => tournamentParticipants.id, { onDelete: 'cascade' })
245:    .notNull(),
246:  userId: uuid('user_id')
247:    .references(() => users.id, { onDelete: 'restrict' })
248:    .notNull(),
249:  role: varchar('role', { length: 50 }).default('MAIN').notNull(),
250:  // Team sport: status mời — INVITED (chưa accept) / ACTIVE / REMOVED
251:  status: varchar('status', { length: 20 }).default('ACTIVE').notNull(),
252:  // When THIS user agreed to have their results ranked in THIS tournament.
253:  //
254:  // Lives here, not on tournament_participants, because ELO is applied per
255:  // tournament_rosters.userId: a team participant can carry several users
256:  // (MAIN + RESERVE), so a single per-participant timestamp cannot tell whose
257:  // consent it is — one user confirming would hand every team-mate their score.
258:  //
259:  // NULL means not confirmed. Distinct from tournament_participants.ranking_consent,
260:  // which is only a copy of the tournament's isRanked flag.
261:  //
262:  // Business rule: a match counts only when matches.completedAt >= this instant.
263:  // Matches played before confirming stay permanently unscored, so nobody can be
264:  // force-enrolled and then have old results land against them.
265:  rankingConsentAt: timestamp('ranking_consent_at', { withTimezone: true }),
266:  joinedAt: timestamp('joined_at', { withTimezone: true })
267:    .defaultNow()
268:    .notNull(),
269:  // When the confirmation mail was last queued, and how many times it has been
270:  // sent. Self-reminders (1-3, then stop) are scheduled from these — without them
271:  // the scheduler cannot tell "never notified" from "notified and ignored", and
272:  // the organizer's "awaiting confirmation" view becomes unverifiable.
273:  consentNotifiedAt: timestamp('consent_notified_at', { withTimezone: true }),
274:  consentNotifiedCount: integer('consent_notified_count').default(0).notNull(),
275:}, (table) => ({
276:  idxRostersParticipantUserUnique: uniqueIndex(
277:    'tournament_rosters_participant_user_unique_idx',
278:  ).on(table.participantId, table.userId),
279:}));
