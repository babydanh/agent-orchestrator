570:  /**
571:   * Single write path for both endpoints: entry fee is resolved once per batch.
572:   *
573:   * `strippedResponseKeys` is the only per-path difference: the strict roster
574:   * route removes import-owned keys from caller form answers before merging,
575:   * while the legacy route keeps its original behaviour and merges the caller's
576:   * answers untouched.
577:   */
578:  private async persistImportRows(
579:    tx: AppTx,
580:    context: {
581:      tournamentId: string;
582:      managerUserId: string;
583:      tournament: typeof schema.tournaments.$inferSelect;
584:      divisionId?: string;
585:      rows: ImportPersistRow[];
586:      strippedResponseKeys: readonly string[];
587:    },
588:  ): Promise<{
589:    participants: (typeof schema.tournamentParticipants.$inferSelect)[];
590:    linkedAccountNotifications: Array<{
591:      rosterId: string;
592:      userId: string;
593:      status: 'COMPLETE' | 'PENDING_APPROVAL';
594:      divisionId: string | null;
595:    }>;
596:  }> {
597:    const {
598:      tournamentId,
599:      managerUserId,
600:      tournament,
601:      divisionId,
602:      rows,
603:      strippedResponseKeys,
604:    } = context;
605:    const entryFeeAtRegistration = (
606:      await this.tournamentPaymentRepository.resolveDivisionEntryFee(
607:        tx,
608:        tournament,
609:        divisionId,
610:      )
611:    ).toFixed(2);
612:    const participants: (typeof schema.tournamentParticipants.$inferSelect)[] =
613:      [];
614:    const linkedAccountNotifications: Array<{
615:      rosterId: string;
616:      userId: string;
617:      status: 'COMPLETE' | 'PENDING_APPROVAL';
618:      divisionId: string | null;
619:    }> = [];
620:
621:    for (const row of rows) {
622:      const teamStatus =
623:        row.autoApprove && (row.isPaid ?? true)
624:          ? 'COMPLETE'
625:          : 'PENDING_APPROVAL';
626:
627:      const customResponses = { ...(row.customResponses ?? {}) };
628:      for (const key of strippedResponseKeys) {
629:        delete customResponses[key];
630:      }
631:
632:      const [participant] = await tx
633:        .insert(schema.tournamentParticipants)
634:        .values({
635:          tournamentId,
636:          tournamentDivisionId: divisionId ?? null,
637:          registeredBy: row.registeredByUserId || managerUserId,
638:          teamName: row.teamName || 'Đội đăng ký',
639:          isPaid: row.isPaid ?? true,
640:          entryFeeAtRegistration,
641:          teamStatus,
642:          partnerUserId: row.partnerUserId || null,
643:          seed: row.elo ? Math.round(row.elo) : null,
644:          customResponses: {
645:            ...customResponses,
646:            ...row.importMetadata,
647:          },
648:        })
649:        .returning();
650:
651:      for (const linkedUserId of new Set(
652:        [row.registeredByUserId, row.partnerUserId].filter(
653:          (value): value is string => Boolean(value),
654:        ),
655:      )) {
656:        const [rosterRow] = await tx
657:          .insert(schema.tournamentRosters)
658:          .values({
659:            participantId: participant.id,
660:            userId: linkedUserId,
661:            role: 'MAIN',
662:          })
663:          .returning({ id: schema.tournamentRosters.id });
664:        linkedAccountNotifications.push({
665:          rosterId: rosterRow.id,
666:          userId: linkedUserId,
667:          status: teamStatus,
668:          divisionId: divisionId ?? null,
669:        });
670:      }
671:
672:      participants.push(participant);
673:    }
674:
675:    return { participants, linkedAccountNotifications };
676:  }
