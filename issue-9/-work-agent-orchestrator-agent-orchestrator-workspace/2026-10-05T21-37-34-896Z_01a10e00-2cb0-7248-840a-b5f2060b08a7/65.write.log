{"resolved_from_name":"@src/modules/tournaments/services/tournament-participant-admin.service.ts:105","handle":"sym#4c7020619fbd44b9@9b90e84f78c6a404","name":"TournamentParticipantAdminService","kind":"cls","file":"src/modules/tournaments/services/tournament-participant-admin.service.ts","line":105,"start_line":1,"end_line":1479,"total_lines":1479,"partial":false,"bytes":47292,"body":"class TournamentParticipantAdminService {\n  private readonly logger = new Logger(TournamentParticipantAdminService.name);\n\n  constructor(\n    private readonly tournamentsRepository: TournamentsRepository,\n    private readonly tournamentAccessService: TournamentAccessService,\n    private readonly notificationsService: NotificationsService,\n    @Inject(PG_CONNECTION) private readonly db: AppDb,\n    private readonly auditService: AuditService,\n    private readonly tournamentPaymentRepository: TournamentPaymentRepository,\n    @Optional()\n    private readonly rankingConsentService?: RankingConsentService,\n  ) {}\n\n  async listAddAthleteCandidates(\n    tournamentId: string,\n    userId: string,\n    systemRoles: string[],\n    dto: AddAthleteCandidatesDto,\n  ) {\n    const tournament = await this.getManagedAddableTournament(\n      tournamentId,\n      userId,\n      systemRoles,\n    );\n    if (dto.divisionId) {\n      await this.getTournamentDivision(this.db, tournamentId, dto.divisionId);\n    }\n    const sourceUserIds = await this.getSourceUserIds(\n      this.db,\n      tournament,\n      userId,\n      dto.source,\n    );\n    if (sourceUserIds.length === 0) return { items: [], nextCursor: null };\n\n    const limit = dto.limit ?? 20;\n    const search = dto.search?.trim() ?? '';\n    const cursor = this.decodeCandidateCursor(dto.cursor, {\n      source: dto.source,\n      divisionId: dto.divisionId ?? null,\n      search,\n    });\n    const activeRosterQuery = this.db\n      .select({ id: schema.tournamentRosters.id })\n      .from(schema.tournamentRosters)\n      .innerJoin(\n        schema.tournamentParticipants,\n        eq(\n          schema.tournamentParticipants.id,\n          schema.tournamentRosters.participantId,\n        ),\n      )\n      .where(\n        and(\n          eq(schema.tournamentRosters.userId, schema.users.id),\n          eq(schema.tournamentRosters.status, 'ACTIVE'),\n          eq(schema.tournamentParticipants.tournamentId, tournamentId),\n          inArray(\n            schema.tournamentParticipants.teamStatus,\n            [...CAPACITY_RESERVING_TEAM_STATUSES],\n          ),\n          dto.divisionId\n            ? eq(\n                schema.tournamentParticipants.tournamentDivisionId,\n                dto.divisionId,\n              )\n            : undefined,\n        ),\n      );\n    const rows = await this.db\n      .select({\n        userId: schema.users.id,\n        displayName: schema.profiles.fullName,\n        avatarUrl: schema.profiles.avatarUrl,\n      })\n      .from(schema.profiles)\n      .innerJoin(schema.users, eq(schema.users.id, schema.profiles.userId))\n      .where(\n        and(\n          inArray(schema.users.id, sourceUserIds),\n          eq(schema.users.isMock, false),\n          isNull(schema.users.deletedAt),\n          notExists(activeRosterQuery),\n          search ? ilike(schema.profiles.fullName, `%${search}%`) : undefined,\n          cursor\n            ? or(\n                gt(schema.profiles.fullName, cursor.displayName),\n                and(\n                  eq(schema.profiles.fullName, cursor.displayName),\n                  gt(schema.users.id, cursor.userId),\n                ),\n              )\n            : undefined,\n        ),\n      )\n      .orderBy(asc(schema.profiles.fullName), asc(schema.users.id))\n      .limit(limit + 1);\n\n    const hasMore = rows.length > limit;\n    const items = rows.slice(0, limit).map((row) => ({\n      ...row,\n      source: dto.source,\n    }));\n    const last = items[items.length - 1];\n    return {\n      items,\n      nextCursor:\n        hasMore && last\n          ? CursorPaginationHelper.encodeCursor({\n              displayName: last.displayName,\n              divisionId: dto.divisionId ?? null,\n              search,\n              source: dto.source,\n              userId: last.userId,\n            })\n          : null,\n    };\n  }\n\n  async addAthletes(\n    tournamentId: string,\n    userId: string,\n    systemRoles: string[],\n    dto: AddAthletesDto,\n    broadcast: RegistrationChanged,\n  ) {\n    const tournament = await this.getManagedAddableTournament(\n      tournamentId,\n      userId,\n      systemRoles,\n    );\n    this.assertAddAthletePayload(dto);\n\n    const created = await this.db.transaction(async (tx) => {\n      await lockCapacityOwner(tx, {\n        tournamentId,\n        divisionId: dto.divisionId,\n      });\n      const tournament = await this.getTransactionalTournament(tx, tournamentId);\n      this.assertAddableTournament(tournament);\n      const division = dto.divisionId\n        ? await this.getTournamentDivision(tx, tournamentId, dto.divisionId)\n        : null;\n      const players = await this.resolveAddAthletes(\n        tx,\n        tournament,\n        userId,\n        dto,\n      );\n      const matchType = division?.matchType ?? tournament.matchType;\n      this.assertRosterComposition(\n        tournament,\n        matchType,\n        players,\n      );\n      await this.assertNoExistingRoster(\n        tx,\n        tournamentId,\n        dto.divisionId ?? null,\n        players,\n      );\n      const capacity = await readEffectiveCapacity(tx, {\n        tournamentId,\n        divisionId: dto.divisionId,\n      });\n      assertDivisionHasRoom(\n        capacity,\n        matchType,\n        players.length,\n        { tournamentConfig: tournament.tournamentConfig },\n      );\n\n      const entryFee = await this.tournamentPaymentRepository\n        .resolveDivisionEntryFee(tx, tournament, dto.divisionId)\n        .then(Number);\n      if (!Number.isFinite(entryFee) || entryFee < 0) {\n        throw new BadRequestException('Lệ phí giải đấu không hợp lệ.');\n      }\n      const [participant] = await tx\n        .insert(schema.tournamentParticipants)\n        .values({\n          tournamentId,\n          tournamentDivisionId: dto.divisionId ?? null,\n          registeredBy: userId,\n          teamName:\n            dto.teamName?.trim() ||\n            players.map((player) => player.displayName).join(' / '),\n          teamStatus: 'COMPLETE',\n          rankingConsent: Boolean(tournament.isRanked),\n          organizerNote: dto.organizerNote?.trim() || null,\n          isPaid: entryFee === 0,\n          isPresent: false,\n          entryFeeAtRegistration: entryFee.toFixed(2),\n          isMock: false,\n          isWildcard: false,\n        })\n        .returning();\n      if (!participant) {\n        throw new BadRequestException('Không thể thêm VĐV vào giải đấu.');\n      }\n\n      const accountPlayers = players.filter(\n        (player): player is ResolvedAddAthlete & { userId: string } =>\n          player.userId !== null,\n      );\n      const rosters =\n        accountPlayers.length > 0\n          ? await tx\n              .insert(schema.tournamentRosters)\n              .values(\n                accountPlayers.map((player) => ({\n                  participantId: participant.id,\n                  userId: player.userId,\n                  role: player.role,\n                  status: 'ACTIVE',\n                })),\n              )\n              .returning({\n                id: schema.tournamentRosters.id,\n                userId: schema.tournamentRosters.userId,\n              })\n          : [];\n\n      const pendingGuests = await this.insertGuestRosters(\n        tx,\n        participant.id,\n        players.filter((player) => player.userId === null),\n      );\n      await this.auditService.logCreate(\n        tx,\n        userId,\n        'tournament_participants',\n        participant.id,\n        participant,\n      );\n      for (const roster of rosters) {\n        await this.auditService.logCreate(\n          tx,\n          userId,\n          'tournament_rosters',\n          roster.id,\n          {\n            participantId: participant.id,\n            userId: roster.userId,\n          },\n        );\n      }\n      for (const guest of pendingGuests) {\n        await this.auditService.logCreate(\n          tx,\n          userId,\n          'tournament_guest_rosters',\n          guest.guestId,\n          {\n            participantId: participant.id,\n            role: guest.role,\n            claimExpiresAt: guest.claimExpiresAt,\n          },\n        );\n      }\n      return { participant, rosters, pendingGuests };\n    });\n\n    const claims = await this.deliverGuestClaims(\n      created.pendingGuests,\n      tournamentId,\n      tournament.name,\n    );\n    await this.notifyAddedAccounts(\n      created.rosters,\n      tournamentId,\n      created.participant.teamName,\n      created.participant.tournamentDivisionId,\n    );\n    broadcast(tournamentId, {\n      participantId: created.participant.id,\n      divisionId: created.participant.tournamentDivisionId,\n      action: 'PARTICIPANT_ADDED',\n    });\n    return { participant: created.participant, claims };\n  }\n\n  async claimGuestRoster(\n    tournamentId: string,\n    guestId: string,\n    userId: string,\n    claimToken: string,\n    broadcast: RegistrationChanged,\n  ) {\n    const claimHash = createHash('sha256').update(claimToken).digest('hex');\n    const claimed = await this.db.transaction(async (tx) => {\n      const [user] = await tx\n        .select({\n          email: schema.users.email,\n          isEmailVerified: schema.users.isEmailVerified,\n          deletedAt: schema.users.deletedAt,\n        })\n        .from(schema.users)\n        .where(eq(schema.users.id, userId))\n        .for('share')\n        .limit(1);\n      if (!user || !user.isEmailVerified || user.deletedAt) {\n        throw new ForbiddenException('Cần email đã xác minh để nhận suất.');\n      }\n\n      const [guest] = await tx\n        .select()\n        .from(schema.tournamentGuestRosters)\n        .where(eq(schema.tournamentGuestRosters.id, guestId))\n        .for('update')\n        .limit(1);\n      if (\n        !guest ||\n        guest.claimExpiresAt <= new Date() ||\n        !isMatchingClaimHash(guest.claimTokenHash, claimHash)\n      ) {\n        throw new ConflictException('Mã nhận suất không hợp lệ hoặc đã hết hạn.');\n      }\n      if (\n        guest.contactEmail &&\n        normalizeEmail(guest.contactEmail) !== normalizeEmail(user.email)\n      ) {\n        throw new ForbiddenException(\n          'Tài khoản phải dùng email đã nhận lời mời.',\n        );\n      }\n\n      const [context] = await tx\n        .select({\n          participantId: schema.tournamentParticipants.id,\n          tournamentId: schema.tournamentParticipants.tournamentId,\n          divisionId: schema.tournamentParticipants.tournamentDivisionId,\n          participantStatus: schema.tournamentParticipants.teamStatus,\n          tournamentName: schema.tournaments.name,\n          tournamentStatus: schema.tournaments.status,\n          tournamentEndDate: schema.tournaments.endDate,\n          tournamentDeletedAt: schema.tournaments.deletedAt,\n          isRanked: schema.tournaments.isRanked,\n        })\n        .from(schema.tournamentParticipants)\n        .innerJoin(\n          schema.tournaments,\n          eq(\n            schema.tournaments.id,\n            schema.tournamentParticipants.tournamentId,\n          ),\n        )\n        .where(eq(schema.tournamentParticipants.id, guest.participantId))\n        .for('share')\n        .limit(1);\n      this.assertClaimContext(context, tournamentId);\n      await this.assertNoExistingRoster(\n        tx,\n        tournamentId,\n        null,\n        [{ userId, displayName: '', email: null, phone: null, role: guest.role }],\n      );\n\n      const [roster] = await tx\n        .insert(schema.tournamentRosters)\n        .values({\n          participantId: guest.participantId,\n          userId,\n          role: guest.role,\n          status: 'ACTIVE',\n        })\n        .returning({\n          id: schema.tournamentRosters.id,\n          participantId: schema.tournamentRosters.participantId,\n          userId: schema.tournamentRosters.userId,\n        });\n      if (!roster) {\n        throw new ConflictException('Không thể nhận suất tham gia.');\n      }\n      await tx\n        .delete(schema.tournamentGuestRosters)\n        .where(eq(schema.tournamentGuestRosters.id, guestId));\n      await this.auditService.logDelete(\n        tx,\n        userId,\n        'tournament_guest_rosters',\n        guestId,\n        { participantId: guest.participantId, role: guest.role },\n      );\n      await this.auditService.logCreate(\n        tx,\n        userId,\n        'tournament_rosters',\n        roster.id,\n        {\n          participantId: roster.participantId,\n          userId: roster.userId,\n          role: guest.role,\n        },\n      );\n      return { roster, context };\n    });\n\n    await this.notifyAddedAccounts(\n      [{ id: claimed.roster.id, userId }],\n      tournamentId,\n      claimed.context.tournamentName,\n      claimed.context.divisionId,\n    );\n    broadcast(tournamentId, {\n      participantId: claimed.roster.participantId,\n      divisionId: claimed.context.divisionId,\n      action: 'GUEST_CLAIMED',\n    });\n    return {\n      participantId: claimed.roster.participantId,\n      claimed: true,\n    };\n  }\n\n  async previewRosterImport(\n    tournamentId: string,\n    userId: string,\n    systemRoles: string[],\n    dto: RosterImportPreviewDto,\n  ) {\n    const tournament = await this.tournamentsRepository.findById(tournamentId);\n    if (!tournament) throw new NotFoundException('Giải đấu không tồn tại');\n\n    const isAuthorized = await this.tournamentAccessService.isManager(\n      tournament,\n      userId,\n      systemRoles,\n    );\n    if (!isAuthorized) {\n      throw new ForbiddenException(\n        'Bạn không có quyền xem trước danh sách VĐV',\n      );\n    }\n\n    if (tournament.status === 'COMPLETED') {\n      throw new BadRequestException('Giải đấu đã kết thúc');\n    }\n    if (\n      tournament.status === 'REGISTRATION_CLOSED' ||\n      tournament.isRegistrationLocked\n    ) {\n      throw new BadRequestException(\n        'Đăng ký đã được khóa. Không thể nhập thêm VĐV.',\n      );\n    }\n\n    return this.tournamentsRepository.previewRosterImport(tournamentId, dto);\n  }\n  async seedMockParticipants(\n    tournamentId: string,\n    userId: string,\n    names: string[],\n    systemRoles: string[] = [],\n    divisionId?: string,\n  ) {\n    const tournament = await this.tournamentsRepository.findById(tournamentId);\n    if (!tournament) throw new NotFoundException('Giải đấu không tồn tại');\n\n    const isLite =\n      (\n        tournament.tournamentConfig as\n          | Record<string, unknown>\n          | null\n          | undefined\n      )?.isLite === true;\n    if (\n      tournament.status !== 'DRAFT' &&\n      !isLite &&\n      tournament.status !== 'REGISTRATION_OPEN' &&\n      tournament.status !== 'UPCOMING'\n    ) {\n      throw new BadRequestException(\n        'Chỉ có thể tạo dữ liệu ảo khi giải đấu ở trạng thái Nháp hoặc Mở đăng ký.',\n      );\n    }\n\n    const isAuthorized = await this.tournamentAccessService.isManager(tournament, userId, systemRoles);\n    if (!isAuthorized) {\n      throw new ForbiddenException('Bạn không có quyền tạo dữ liệu ảo');\n    }\n\n    return this.tournamentsRepository.seedMockParticipants(\n      tournamentId,\n      names,\n      divisionId,\n    );\n  }\n\n  async clearMockParticipants(\n    tournamentId: string,\n    userId: string,\n    systemRoles: string[] = [],\n    divisionId?: string,\n  ) {\n    const tournament = await this.tournamentsRepository.findById(tournamentId);\n    if (!tournament) throw new NotFoundException('Giải đấu không tồn tại');\n\n    const isLite =\n      (\n        tournament.tournamentConfig as\n          | Record<string, unknown>\n          | null\n          | undefined\n      )?.isLite === true;\n    if (\n      tournament.status !== 'DRAFT' &&\n      !isLite &&\n      tournament.status !== 'REGISTRATION_OPEN' &&\n      tournament.status !== 'UPCOMING'\n    ) {\n      throw new BadRequestException(\n        'Chỉ có thể xóa dữ liệu ảo ở trạng thái Nháp hoặc Đang mở đăng ký.',\n      );\n    }\n\n    const isAuthorized = await this.tournamentAccessService.isManager(tournament, userId, systemRoles);\n    if (!isAuthorized) {\n      throw new ForbiddenException('Bạn không có quyền xóa dữ liệu ảo');\n    }\n\n    return this.tournamentsRepository.clearMockParticipants(\n      tournamentId,\n      divisionId,\n    );\n  }\n\n  async deleteMockParticipant(\n    tournamentId: string,\n    participantId: string,\n    userId: string,\n    systemRoles: string[] = [],\n    broadcastRegistrationChanged: RegistrationChanged,\n  ) {\n    const tournament = await this.tournamentsRepository.findById(tournamentId);\n    if (!tournament) throw new NotFoundException('Giải đấu không tồn tại');\n\n    const isLite =\n      (\n        tournament.tournamentConfig as\n          | Record<string, unknown>\n          | null\n          | undefined\n      )?.isLite === true;\n    if (\n      tournament.status !== 'DRAFT' &&\n      !isLite &&\n      tournament.status !== 'REGISTRATION_OPEN' &&\n      tournament.status !== 'UPCOMING'\n    ) {\n      throw new BadRequestException(\n        'Chỉ có thể xoá dữ liệu giả lập ở trạng thái Nháp hoặc Đang mở đăng ký.',\n      );\n    }\n\n    const isAuthorized = await this.tournamentAccessService.isManager(tournament, userId, systemRoles);\n    if (!isAuthorized) {\n      throw new ForbiddenException('Bạn không có quyền xóa người tham gia ảo');\n    }\n\n    const result = await this.tournamentsRepository.deleteMockParticipant(\n      tournamentId,\n      participantId,\n    );\n    broadcastRegistrationChanged(tournamentId, {\n      participantId,\n      action: 'PARTICIPANT_REMOVED',\n    });\n    return result;\n  }\n  async updateParticipantStatus(\n    tournamentId: string,\n    participantId: string,\n    status: string,\n    userId: string,\n    systemRoles: string[] = [],\n    broadcastRegistrationChanged: RegistrationChanged,\n  ) {\n    const tournament = await this.tournamentsRepository.findById(tournamentId);\n    if (!tournament) throw new NotFoundException('Giải đấu không tồn tại');\n\n    if (tournament.status !== 'REGISTRATION_OPEN') {\n      throw new BadRequestException(\n        'Giải đấu đã chốt danh sách, không thể duyệt hoặc từ chối vận động viên.',\n      );\n    }\n\n    const isAuthorized = await this.tournamentAccessService.isManager(tournament, userId, systemRoles);\n    if (!isAuthorized) {\n      throw new ForbiddenException('Bạn không có quyền cập nhật trạng thái');\n    }\n\n    if (status !== 'COMPLETE' && status !== 'REJECTED') {\n      throw new BadRequestException(\n        'Chỉ hỗ trợ duyệt hoặc từ chối hồ sơ đăng ký.',\n      );\n    }\n\n    const participant =\n      await this.tournamentsRepository.findParticipantById(participantId);\n    if (!participant || participant.tournamentId !== tournamentId) {\n      throw new NotFoundException('Người tham gia không tồn tại');\n    }\n\n    if (participant.teamStatus !== 'PENDING_APPROVAL') {\n      throw new BadRequestException(\n        'Chỉ hồ sơ đang chờ duyệt mới được phép duyệt hoặc từ chối.',\n      );\n    }\n\n    let nextStatus = status;\n    let participantRosters: Array<{ userId: string }> | null = null;\n    const tournamentConfig = (tournament.tournamentConfig || {}) as Record<\n      string,\n      unknown\n    >;\n    if (status === 'COMPLETE') {\n      const division = participant.tournamentDivisionId\n        ? await this.tournamentsRepository.findDivisionById(\n            participant.tournamentDivisionId,\n          )\
