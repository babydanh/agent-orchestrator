.tournamentPaymentRepository.setParticipantPaidInTx(\n          tx,\n          participantId,\n          paid,\n        );\n      if (!updatedParticipant) {\n        throw new NotFoundException('Người tham gia không tồn tại');\n      }\n\n      await this.auditService.logUpdate(\n        tx,\n        userId,\n        'tournament_participants',\n        participantId,\n        participant,\n        updatedParticipant,\n      );\n\n      // Report what this call actually did: a payment that already carried a\n      // refund state did not get a new request out of it.\n      const refundRequested = completedPayment !== null && !completedPayment.refundStatus;\n      return {\n        participant: updatedParticipant,\n        refundRequested,\n        refundPaymentId: refundRequested ? completedPayment!.id : null,\n      };\n    });\n\n    broadcastRegistrationChanged(tournamentId, {\n      participantId: result.participant.id,\n      divisionId: result.participant.tournamentDivisionId,\n      action: 'FEE_PAYMENT_UPDATED',\n    });\n\n    return result;\n  }\n\n  /**\n   * Organizer's day-of-event mark.\n   *\n   * Deliberately ungated by tournament status: attendance happens while the\n   * event runs, long after registration closes, so a REGISTRATION_OPEN gate\n   * would make the feature unusable exactly when it is needed. Nothing reads\n   * this flag except the list view.\n   */\n  async setParticipantPresent(\n    tournamentId: string,\n    participantId: string,\n    present: boolean,\n    userId: string,\n    systemRoles: string[],\n    broadcastRegistrationChanged: (\n      tournamentId: string,\n      payload: { participantId: string; divisionId?: string | null; action: string },\n    ) => void,\n  ) {\n    const tournament = await this.tournamentsRepository.findById(tournamentId);\n    if (!tournament) throw new NotFoundException('Giải đấu không tồn tại');\n\n    const isAuthorized = await this.tournamentAccessService.isManager(\n      tournament,\n      userId,\n      systemRoles,\n    );\n    if (!isAuthorized) {\n      throw new ForbiddenException('Bạn không có quyền đánh dấu người tham gia có mặt');\n    }\n\n    const participant =\n      await this.tournamentsRepository.findParticipantById(participantId);\n    if (!participant || participant.tournamentId !== tournamentId) {\n      throw new NotFoundException('Người tham gia không tồn tại');\n    }\n\n    const updatedParticipant = await this.db.transaction(async (tx) => {\n      const updated =\n        await this.tournamentPaymentRepository.setParticipantPresentInTx(\n          tx,\n          participantId,\n          present,\n        );\n      if (!updated) {\n        throw new NotFoundException('Người tham gia không tồn tại');\n      }\n\n      await this.auditService.logUpdate(\n        tx,\n        userId,\n        'tournament_participants',\n        participantId,\n        participant,\n        updated,\n      );\n\n      return updated;\n    });\n\n    broadcastRegistrationChanged(tournamentId, {\n      participantId: updatedParticipant.id,\n      divisionId: updatedParticipant.tournamentDivisionId,\n      action: 'PRESENCE_UPDATED',\n    });\n\n    return { participant: updatedParticipant };\n  }\n  private async getManagedAddableTournament(\n    tournamentId: string,\n    userId: string,\n    systemRoles: string[],\n  ): Promise<AdminTournament> {\n    const tournament = await this.tournamentsRepository.findById(tournamentId);\n    if (!tournament || tournament.deletedAt) {\n      throw new NotFoundException('Giải đấu không tồn tại');\n    }\n    const allowed = await this.tournamentAccessService.isManager(\n      tournament,\n      userId,\n      systemRoles,\n    );\n    if (!allowed) throw new ForbiddenException('Bạn không có quyền quản lý giải đấu');\n    this.assertAddableTournament(tournament);\n    return tournament;\n  }\n\n  private assertAddableTournament(tournament: AdminTournament): void {\n    if (tournament.deletedAt) throw new NotFoundException('Giải đấu không tồn tại');\n    if (\n      tournament.status === 'COMPLETED' ||\n      tournament.status === 'CANCELLED' ||\n      (tournament.endDate && tournament.endDate <= new Date())\n    ) {\n      throw new BadRequestException('Không thể thêm VĐV vào giải đã kết thúc.');\n    }\n    if (\n      tournament.isRegistrationLocked ||\n      ['REGISTRATION_CLOSED', 'IN_PROGRESS', 'ONGOING', 'PENDING_DELETE'].includes(\n        tournament.status,\n      )\n    ) {\n      throw new BadRequestException('Đăng ký giải đấu đã đóng.');\n    }\n  }\n\n  private async getTransactionalTournament(\n    tx: AppDbOrTx,\n    tournamentId: string,\n  ) {\n    const [tournament] = await tx\n      .select()\n      .from(schema.tournaments)\n      .where(eq(schema.tournaments.id, tournamentId))\n      .limit(1);\n    if (!tournament) throw new NotFoundException('Giải đấu không tồn tại');\n    return tournament;\n  }\n\n  private async getTournamentDivision(\n    executor: AppDbOrTx,\n    tournamentId: string,\n    divisionId: string,\n  ) {\n    const [division] = await executor\n      .select({\n        id: schema.tournamentDivisions.id,\n        matchType: schema.tournamentDivisions.matchType,\n      })\n      .from(schema.tournamentDivisions)\n      .where(\n        and(\n          eq(schema.tournamentDivisions.id, divisionId),\n          eq(schema.tournamentDivisions.tournamentId, tournamentId),\n        ),\n      )\n      .limit(1);\n    if (!division) {\n      throw new BadRequestException('Nội dung thi đấu không thuộc giải này.');\n    }\n    return division;\n  }\n\n  private decodeCandidateCursor(\n    encoded: string | undefined,\n    scope: Pick<AddAthleteCursor, 'source' | 'divisionId' | 'search'>,\n  ): AddAthleteCursor | null {\n    if (!encoded) return null;\n    const cursor =\n      CursorPaginationHelper.decodeCursor<Partial<AddAthleteCursor>>(encoded);\n    if (\n      !cursor ||\n      typeof cursor.displayName !== 'string' ||\n      typeof cursor.userId !== 'string' ||\n      !isUuid(cursor.userId) ||\n      cursor.source !== scope.source ||\n      cursor.divisionId !== scope.divisionId ||\n      cursor.search !== scope.search\n    ) {\n      throw new BadRequestException('Cursor ứng viên không hợp lệ.');\n    }\n    return cursor as AddAthleteCursor;\n  }\n\n  private async getSourceUserIds(\n    executor: AppDbOrTx,\n    tournament: AdminTournament,\n    managerId: string,\n    source: 'FRIENDS' | 'CLUB',\n    selectedIds?: string[],\n  ): Promise<string[]> {\n    if (source === 'FRIENDS') {\n      return this.getAcceptedFriendIds(executor, managerId, selectedIds);\n    }\n    return this.getJoinedClubMemberIds(\n      executor,\n      tournament.communityId,\n      selectedIds,\n    );\n  }\n\n  private async getAcceptedFriendIds(\n    executor: AppDbOrTx,\n    managerId: string,\n    selectedIds?: string[],\n  ): Promise<string[]> {\n    if (selectedIds?.length === 0) return [];\n    const selection =\n      selectedIds && selectedIds.length > 0\n        ? or(\n            and(\n              eq(schema.friendships.senderId, managerId),\n              inArray(schema.friendships.receiverId, selectedIds),\n            ),\n            and(\n              eq(schema.friendships.receiverId, managerId),\n              inArray(schema.friendships.senderId, selectedIds),\n            ),\n          )\n        : undefined;\n    const relations = await executor\n      .select({\n        senderId: schema.friendships.senderId,\n        receiverId: schema.friendships.receiverId,\n      })\n      .from(schema.friendships)\n      .where(\n        and(\n          eq(schema.friendships.status, 'ACCEPTED'),\n          isNull(schema.friendships.deletedAt),\n          or(\n            eq(schema.friendships.senderId, managerId),\n            eq(schema.friendships.receiverId, managerId),\n          ),\n          selection,\n        ),\n      )\n      .for('share');\n    return [\n      ...new Set(\n        relations.map((relation) =>\n          relation.senderId === managerId\n            ? relation.receiverId\n            : relation.senderId,\n        ),\n      ),\n    ];\n  }\n\n  private async getJoinedClubMemberIds(\n    executor: AppDbOrTx,\n    communityId: string | null,\n    selectedIds?: string[],\n  ): Promise<string[]> {\n    if (!communityId || selectedIds?.length === 0) return [];\n    const members = await executor\n      .select({ userId: schema.communityMembers.userId })\n      .from(schema.communityMembers)\n      .where(\n        and(\n          eq(schema.communityMembers.communityId, communityId),\n          eq(schema.communityMembers.status, 'JOINED'),\n          selectedIds?.length\n            ? inArray(schema.communityMembers.userId, selectedIds)\n            : undefined,\n        ),\n      )\n      .for('share');\n    return [...new Set(members.map((member) => member.userId))];\n  }\n\n  private assertAddAthletePayload(dto: AddAthletesDto): void {\n    if (!dto.players.length) {\n      throw new BadRequestException('Cần chọn ít nhất một VĐV.');\n    }\n    const userIds = new Set<string>();\n    const emails = new Set<string>();\n    for (const player of dto.players) {\n      if (dto.source === 'DIRECT') {\n        if (player.userId || !player.displayName?.trim()) {\n          throw new BadRequestException('Thông tin VĐV nhập trực tiếp không hợp lệ.');\n        }\n        const email = player.email ? normalizeEmail(player.email) : '';\n        if (email && emails.has(email)) {\n          throw new BadRequestException('Email khách mời bị trùng.');\n        }\n        if (email) emails.add(email);\n      } else if (\n        !player.userId ||\n        player.displayName !== undefined ||\n        player.email !== undefined ||\n        player.phone !== undefined\n      ) {\n        throw new BadRequestException('Danh sách ứng viên không hợp lệ.');\n      }\n      if (player.userId && userIds.has(player.userId)) {\n        throw new BadRequestException('Không thể thêm trùng VĐV.');\n      }\n      if (player.userId) userIds.add(player.userId);\n    }\n  }\n\n  private async resolveAddAthletes(\n    tx: AppDbOrTx,\n    tournament: AdminTournament,\n    managerId: string,\n    dto: AddAthletesDto,\n  ): Promise<ResolvedAddAthlete[]> {\n    if (dto.source === 'DIRECT') {\n      return this.resolveDirectAthletes(tx, dto.players);\n    }\n    return this.resolveSelectedAthletes(\n      tx,\n      tournament,\n      managerId,\n      dto.source,\n      dto.players,\n    );\n  }\n\n  private async resolveSelectedAthletes(\n    tx: AppDbOrTx,\n    tournament: AdminTournament,\n    managerId: string,\n    source: 'FRIENDS' | 'CLUB',\n    players: AddAthletePlayerDto[],\n  ): Promise<ResolvedAddAthlete[]> {\n    const selectedIds = players.map((player) => player.userId!);\n    const allowedIds = await this.getSourceUserIds(\n      tx,\n      tournament,\n      managerId,\n      source,\n      selectedIds,\n    );\n    if (allowedIds.length !== selectedIds.length) {\n      throw new ForbiddenException('Một hoặc nhiều ứng viên không còn đủ điều kiện.');\n    }\n    const rows = await tx\n      .select({\n        userId: schema.users.id,\n        displayName: schema.profiles.fullName,\n      })\n      .from(schema.users)\n      .leftJoin(schema.profiles, eq(schema.profiles.userId, schema.users.id))\n      .where(\n        and(\n          inArray(schema.users.id, selectedIds),\n          eq(schema.users.isMock, false),\n          isNull(schema.users.deletedAt),\n        ),\n      );\n    if (rows.length !== selectedIds.length) {\n      throw new ConflictException('Một hoặc nhiều ứng viên không còn khả dụng.');\n    }\n    const namesById = new Map(\n      rows.map((row) => [\n        row.userId,\n        row.displayName?.trim() || 'Vận động viên',\n      ]),\n    );\n    return players.map((player) => ({\n      userId: player.userId!,\n      displayName: namesById.get(player.userId!) ?? 'Vận động viên',\n      email: null,\n      phone: null,\n      role: player.role === 'RESERVE' ? 'RESERVE' : 'MAIN',\n    }));\n  }\n\n  private async resolveDirectAthletes(\n    tx: AppDbOrTx,\n    players: AddAthletePlayerDto[],\n  ): Promise<ResolvedAddAthlete[]> {\n    const normalizedEmails = [\n      ...new Set(\n        players\n          .map((player) => player.email)\n          .filter((email): email is string => Boolean(email))\n          .map(normalizeEmail),\n      ),\n    ];\n    const accountRows =\n      normalizedEmails.length > 0\n        ? await tx\n            .select({\n              userId: schema.users.id,\n              email: schema.users.email,\n              displayName: schema.profiles.fullName,\n            })\n            .from(schema.users)\n            .leftJoin(\n              schema.profiles,\n              eq(schema.profiles.userId, schema.users.id),\n            )\n            .where(\n              and(\n                inArray(\n                  sql<string>`lower(trim(${schema.users.email}))`,\n                  normalizedEmails,\n                ),\n                eq(schema.users.isEmailVerified, true),\n                eq(schema.users.isMock, false),\n                isNull(schema.users.deletedAt),\n              ),\n            )\n        : [];\n    const accountsByEmail = new Map<string, typeof accountRows>();\n    for (const account of accountRows) {\n      const email = normalizeEmail(account.email);\n      accountsByEmail.set(email, [...(accountsByEmail.get(email) ?? []), account]);\n    }\n    return players.map((player) => {\n      const email = player.email ? normalizeEmail(player.email) : null;\n      const matches = email ? accountsByEmail.get(email) ?? [] : [];\n      const account = matches.length === 1 ? matches[0] : null;\n      return {\n        userId: account?.userId ?? null,\n        displayName:\n          account?.displayName?.trim() || player.displayName!.trim(),\n        email: account ? null : email,\n        phone: account ? null : player.phone?.trim() || null,\n        role: player.role === 'RESERVE' ? 'RESERVE' : 'MAIN',\n      };\n    });\n  }\n\n  private assertRosterComposition(\n    tournament: AdminTournament,\n    matchType: string | null,\n    players: ResolvedAddAthlete[],\n  ): void {\n    const football = resolveFootballTeamConfig(tournament.tournamentConfig);\n    if (matchType === 'DOUBLES' || matchType === 'MIXED_DOUBLES') {\n      if (\n        players.length !== 2 ||\n        players.some((player) => player.role !== 'MAIN')\n      ) {\n        throw new BadRequestException('Giải đôi cần đúng hai VĐV chính.');\n      }\n      return;\n    }\n    if (football.isTeamSport) {\n      const mainCount = players.filter((player) => player.role === 'MAIN').length;\n      const reserveCount = players.length - mainCount;\n      if (\n        mainCount !== football.mainSize ||\n        reserveCount > football.maxReserve ||\n        players.length > football.maxTotalSize\n      ) {\n        throw new BadRequestException('Danh sách đội không khớp cấu hình đội bóng.');\n      }\n      return;\n    }\n    if (players.length !== 1 || players[0]?.role !== 'MAIN') {\n      throw new BadRequestException('Giải đơn cần đúng một VĐV chính.');\n    }\n  }\n\n  private async assertNoExistingRoster(\n    tx: AppDbOrTx,\n    tournamentId: string,\n    divisionId: string | null,\n    players: ResolvedAddAthlete[],\n  ): Promise<void> {\n    const userIds = players\n      .map((player) => player.userId)\n      .filter((userId): userId is string => Boolean(userId));\n    if (userIds.length === 0) return;\n    const existing = await tx\n      .select({ userId: schema.tournamentRosters.userId })\n      .from(schema.tournamentRosters)\n      .innerJoin(\n        schema.tournamentParticipants,\n        eq(\n          schema.tournamentParticipants.id,\n          schema.tournamentRosters.participantId,\n        ),\n      )\n      .where(\n        and(\n          eq(schema.tournamentParticipants.tournamentId, tournamentId),\n          inArray(schema.tournamentRosters.userId, userIds),\n          eq(schema.tournamentRosters.status, 'ACTIVE'),\n          inArray(\n            schema.tournamentParticipants.teamStatus,\n            [...CAPACITY_RESERVING_TEAM_STATUSES],\n          ),\n          divisionId\n            ? eq(\n                schema.tournamentParticipants.tournamentDivisionId,\n                divisionId,\n              )\n            : undefined,\n        ),\n      );\n    if (existing.length > 0) {\n      throw new ConflictException('Một hoặc nhiều VĐV đã có suất trong giải.');\n    }\n  }\n\n  private async insertGuestRosters(\n    tx: AppDbOrTx,\n    participantId: string,\n    players: ResolvedAddAthlete[],\n  ): Promise<PendingGuestClaim[]> {\n    const pending: PendingGuestClaim[] = [];\n    for (const player of players) {\n      const guestId = randomUUID();\n      const claimToken = randomBytes(32).toString('base64url');\n      const claimExpiresAt = new Date(Date.now() + GUEST_CLAIM_TTL_MS);\n      await tx.insert(schema.tournamentGuestRosters).values({\n        id: guestId,\n        participantId,\n        displayName: player.displayName,\n        role: player.role,\n        contactEmail: player.email,\n        contactPhone: player.phone,\n        claimTokenHash: createHash('sha256').update(claimToken).digest('hex'),\n        claimExpiresAt,\n      });\n      pending.push({\n        guestId,\n        claimToken,\n        claimExpiresAt,\n        displayName: player.displayName,\n        email: player.email,\n        phone: player.phone,\n        role: player.role,\n      });\n    }\n    return pending;\n  }\n\n  private async deliverGuestClaims(\n    guests: PendingGuestClaim[],\n    tournamentId: string,\n    tournamentName: string,\n  ) {\n    const claims: Array<{\n      guestId: string;\n      delivery: 'EMAILED' | 'HANDOFF';\n      claimToken?: string;\n    }> = [];\n    for (const guest of guests) {\n      const emailed = Boolean(\n        guest.email &&\n          (await this.rankingConsentService?.sendGuestClaimInvite({\n            email: guest.email,\n            displayName: guest.displayName,\n            tournamentName,\n            tournamentId,\n            guestId: guest.guestId,\n            claimToken: guest.claimToken,\n          })),\n      );\n      claims.push({\n        guestId: guest.guestId,\n        delivery: emailed ? 'EMAILED' : 'HANDOFF',\n        ...(emailed ? {} : { claimToken: guest.claimToken }),\n      });\n    }\n    return claims;\n  }\n\n  private async notifyAddedAccounts(\n    rosters: Array<{ id: string; userId: string }>,\n    tournamentId: string,\n    tournamentName: string,\n    divisionId: string | null,\n  ): Promise<void> {\n    for (const roster of rosters) {\n      try {\n        await this.notificationsService.sendNotification(\n          buildParticipantRegistrationSuccessNotification({\n            receiverId: roster.userId,\n            tournamentId,\n            tournamentName,\n            divisionId,\n          }),\n        );\n      } catch {\n        this.logger.warn(`Không gửi được thông báo roster ${roster.id}.`);\n      }\n      try {\n        await this.rankingConsentService?.sendConfirmationRequest(roster.id);\n      } catch {\n        this.logger.warn(`Không gửi được yêu cầu consent roster ${roster.id}.`);\n      }\n    }\n  }\n\n  private assertClaimContext(\n    context:\n      | {\n          tournamentId: string;\n          participantStatus: string;\n          tournamentStatus: string;\n          tournamentEndDate: Date | null;\n          tournamentDeletedAt: Date | null;\n        }\n      | undefined,\n    tournamentId: string,\n  ): asserts context {\n    if (\n      !context ||\n      context.tournamentId !== tournamentId ||\n      !CAPACITY_RESERVING_TEAM_STATUSES.some(\n        (status) => status === context.participantStatus,\n      ) ||\n      context.tournamentDeletedAt ||\n      context.tournamentStatus === 'COMPLETED' ||\n      context.tournamentStatus === 'CANCELLED' ||\n      (context.tournamentEndDate && context.tournamentEndDate <= new Date())\n    ) {\n      throw new ConflictException('Suất tham gia không còn khả dụng.');\n    }\n  }\n}"}

