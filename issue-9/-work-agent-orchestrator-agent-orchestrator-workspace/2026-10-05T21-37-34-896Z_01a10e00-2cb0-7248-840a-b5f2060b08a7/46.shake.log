1668:  /**
1669:   * Return the already completed leg of a two-legged football tie. Keeping
1670:   * this query in the repository makes aggregate resolution deterministic and
1671:   * avoids letting the service scan arbitrary matches from another tie.
1672:   */
1673:  async findCompletedTieLeg(tieId: string, currentMatchId: string) {
1674:    const [leg] = await this.db
1675:      .select()
1676:      .from(schema.matches)
1677:      .where(
1678:        and(
1679:          eq(schema.matches.tieId, tieId),
1680:          ne(schema.matches.id, currentMatchId),
1681:          eq(schema.matches.status, 'COMPLETED'),
1682:          isNull(schema.matches.deletedAt),
1683:        ),
1684:      )
1685:      .orderBy(schema.matches.leg)
1686:      .limit(1);
