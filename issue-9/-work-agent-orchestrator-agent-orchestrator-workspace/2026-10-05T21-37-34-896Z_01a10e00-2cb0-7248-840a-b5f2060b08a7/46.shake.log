1690:  async completeMatch(
1691:    id: string,
1692:    winnerId: string | null,
1693:    matchDetails: {
1694:      nextMatchId?: string | null;
1695:      loserNextMatchId?: string | null;
1696:      matchOrder: number;
1697:      participant1Id: string | null;
1698:      participant2Id: string | null;
1699:      groupId?: string | null;
1700:      isRoundRobin: boolean;
1701:      p1SetsWon: number;
1702:      p2SetsWon: number;
1703:      scoreDetails: Record<string, unknown> | null | undefined;
1704:      auditUserId?: string | null;
1705:      expectedRevision?: number;
1706:    },
1707:  ) {
1708:    return await this.db.transaction(async (tx) => {
1709:      const updated = await this.completeMatchInTx(tx, id, winnerId, {
1710:        p1SetsWon: matchDetails.p1SetsWon,
1711:        p2SetsWon: matchDetails.p2SetsWon,
1712:        scoreDetails: matchDetails.scoreDetails,
1713:        auditUserId: matchDetails.auditUserId,
1714:        expectedRevision: matchDetails.expectedRevision,
1715:      });
1716:
1717:      // A stale-revision completion surfaces as a conflict — standings must NOT
1718:      // run for it (the transaction did not win the completion).
1719:      if (updated && typeof updated === 'object' && 'conflict' in updated) {
1720:        return updated;
1721:      }
1722:
1723:      // 5. Update standings if Round Robin
1724:      if (matchDetails.isRoundRobin && updated) {
1725:        // Query custom win/draw/loss points from sportRules
1726:        const [group] = await tx
1727:          .select({
1728:            tournamentId: schema.tournamentStages.tournamentId,
1729:          })
1730:          .from(schema.tournamentGroups)
1731:          .innerJoin(
1732:            schema.tournamentStages,
1733:            eq(schema.tournamentGroups.stageId, schema.tournamentStages.id),
1734:          )
1735:          .where(eq(schema.tournamentGroups.id, updated.groupId))
1736:          .limit(1);
1737:
1738:        let winPoints = 3;
1739:        let drawPoints = 1;
1740:        let lossPoints = 0;
1741:
1742:        if (group) {
1743:          const [tournament] = await tx
1744:            .select({
1745:              sportRules: schema.tournaments.sportRules,
1746:            })
1747:            .from(schema.tournaments)
1748:            .where(eq(schema.tournaments.id, group.tournamentId))
1749:            .limit(1);
1750:
1751:          if (tournament && tournament.sportRules) {
1752:            const rules = tournament.sportRules as Record<string, unknown>;
1753:            const scoring =
1754:              (rules.scoring as Record<string, unknown> | undefined) ?? rules;
1755:            if (typeof scoring.winPoints === 'number')
1756:              winPoints = scoring.winPoints;
1757:            if (typeof scoring.drawPoints === 'number')
1758:              drawPoints = scoring.drawPoints;
1759:            if (typeof scoring.lossPoints === 'number')
1760:              lossPoints = scoring.lossPoints;
1761:          }
1762:        }
1763:
1764:        const p1Id = updated.participant1Id;
1765:        const p2Id = updated.participant2Id;
1766:        const participants = [p1Id, p2Id];
1767:        const isDraw = !winnerId && p1Id && p2Id;
1768:
1769:        // points_for/points_against = TỔNG điểm ghi được qua các set (chuẩn
1770:        // hiệu số điểm), không phải số set thắng. totalPoints giữ nguyên 3/1/0.
1771:        const { p1: team1Total, p2: team2Total } = sumSetPoints(
1772:          matchDetails.scoreDetails,
1773:        );
1774:
1775:        for (const pId of participants) {
1776:          if (!pId) continue;
1777:          const isWinner = pId === winnerId;
1778:          const pointsEarned = isDraw
1779:            ? drawPoints
1780:            : isWinner
1781:              ? winPoints
1782:              : lossPoints;
1783:          const pointsFor = pId === p1Id ? team1Total : team2Total;
1784:          const pointsAgainst = pId === p1Id ? team2Total : team1Total;
1785:
1786:          // Atomic upsert (NOTE-2): INSERT ... ON CONFLICT DO UPDATE with
1787:          // SQL-side increments. Replaces read-modify-write, so concurrent
1788:          // completions for the same group/participant never lose an update.
1789:          await tx
1790:            .insert(schema.groupStandings)
1791:            .values({
1792:              groupId: updated.groupId,
1793:              participantId: pId,
1794:              played: 1,
1795:              won: isWinner ? 1 : 0,
1796:              lost: !isWinner && !isDraw ? 1 : 0,
1797:              draws: isDraw ? 1 : 0,
1798:              pointsFor: pointsFor,
1799:              pointsAgainst: pointsAgainst,
1800:              totalPoints: pointsEarned,
1801:              updatedAt: new Date(),
1802:            })
1803:            .onConflictDoUpdate({
1804:              target: [
1805:                schema.groupStandings.groupId,
1806:                schema.groupStandings.participantId,
1807:              ],
1808:              set: {
1809:                played: sql`${schema.groupStandings.played} + 1`,
1810:                won: sql`${schema.groupStandings.won} + ${isWinner ? 1 : 0}`,
1811:                lost: sql`${schema.groupStandings.lost} + ${!isWinner && !isDraw ? 1 : 0}`,
1812:                draws: sql`${schema.groupStandings.draws} + ${isDraw ? 1 : 0}`,
1813:                pointsFor: sql`${schema.groupStandings.pointsFor} + ${pointsFor}`,
1814:                pointsAgainst: sql`${schema.groupStandings.pointsAgainst} + ${pointsAgainst}`,
1815:                totalPoints: sql`${schema.groupStandings.totalPoints} + ${pointsEarned}`,
1816:                updatedAt: new Date(),
1817:              },
1818:            });
1819:        }
1820:      }
1821:
1822:      return updated;
1823:    });
1824:  }
1825:
1826:  private async completeMatchInTx(
1827:    tx: any,
1828:    id: string,
1829:    winnerId: string | null,
1830:    details: {
