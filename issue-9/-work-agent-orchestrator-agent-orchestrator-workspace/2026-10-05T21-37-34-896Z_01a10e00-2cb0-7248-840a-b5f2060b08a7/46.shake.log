58:  });
59:
60:  afterEach(() => {
61:    jest.useRealTimers();
62:  });
63:
64:  it('retries a send that never landed, anchoring on the join time', async () => {
65:    // The reason notifiedAt NULL rows stay in scope: one mail outage must not
66:    // permanently silence the reminders, or the player never learns their
67:    // matches will go unscored.
68:    const { service, mailService } = build([
69:      { id: 'r1', attempts: 0, notifiedAt: null, joinedAt: hoursAgo(25) },
