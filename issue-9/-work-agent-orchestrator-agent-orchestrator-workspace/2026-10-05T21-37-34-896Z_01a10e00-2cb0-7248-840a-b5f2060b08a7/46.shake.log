184:/** Team slots occupied by the given rows. */
185:export function calculateOccupiedTeamSlots(
186:  matchType: string | null | undefined,
187:  entries: readonly CapacityEntry[],
188:  options?: { tournamentConfig?: unknown },
189:): number {
190:  return calculateOccupiedCapacity(matchType, entries, options).teamSlots;
191:}
192:
193:/**
194: * Team slots a single new claim will consume.
195: *
196: * Doubles pairing adds one member slot per requested athlete (so a single
197: * unpaired athlete takes half a team); every other unit adds one whole team
198: * for the new registration row. A non-positive request adds nothing, which is
199: * how paths that only append athletes to an already-counted team row (a
200: * football squad joining through an open invite link) stay out of the check.
201: */
202:export function calculateRequestedTeamSlots(
203:  matchType: string | null | undefined,
204:  requestedMemberCount: number,
205:  options?: { tournamentConfig?: unknown },
206:): number {
207:  const requestedMembers = normalizedMemberCount(requestedMemberCount);
208:  if (requestedMembers <= 0) return 0;
209:
210:  const unit = resolveCapacityUnit(matchType, options?.tournamentConfig);
211:  return unit === 'MEMBER' ? requestedMembers / 2 : 1;
212:}
213:
214:/**
215: * Whether appending another athlete to a participant row changes occupancy.
216: *
217: * A doubles pairing row grows from half a team to a whole one, so the partner
218: * must clear capacity. A team-sport row is already counted as one whole team,
219: * so another squad member adds nothing and must never be rejected by capacity.
220: */
221:export function isRosterWeightedCapacity(
222:  matchType: string | null | undefined,
223:  tournamentConfig?: unknown,
224:): boolean {
225:  return resolveCapacityUnit(matchType, tournamentConfig) === 'MEMBER';
226:}

