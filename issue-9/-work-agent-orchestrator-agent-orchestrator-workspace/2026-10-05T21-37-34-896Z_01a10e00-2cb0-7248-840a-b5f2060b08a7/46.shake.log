1646:  async updateStatus(id: string, data: UpdateMatchStatusDto) {
1647:    const setClause: Record<string, unknown> = {
1648:      status: data.status,
1649:      updatedAt: new Date(),
1650:      revision: sql`${schema.matches.revision} + 1`,
1651:    };
1652:
1653:    if (data.status === 'ONGOING') {
1654:      setClause.startedAt = new Date();
1655:    } else if (data.status === 'COMPLETED') {
1656:      setClause.completedAt = new Date();
1657:    }
1658:
1659:    const [updated] = await this.db
1660:      .update(schema.matches)
1661:      .set(setClause)
1662:      .where(eq(schema.matches.id, id))
1663:      .returning();
1664:
1665:    return await this.findById(updated.id);
1666:  }
