1:import { resolveFootballTeamConfig } from './football-team-config';
2:import { isDoublesMatchType } from './tournament-input-policy';
3:
4:export type DoublesPairingMode = 'ORGANIZER' | 'SELF';
5:export type DoublesParticipantTransition =
6:  | {
7:      event: 'REGISTER';
8:      registrationMode: unknown;
9:      waitlisted: boolean;
10:      isLite?: boolean;
11:      pairingMode?: DoublesPairingMode;
12:      rosterCount?: number;
13:      hasPartnerInvite?: boolean;
14:    }
15:  | {
16:      event: 'APPROVE';
17:      registrationMode: unknown;
18:      isDoubles: boolean;
19:      rosterCount: number;
20:      isLite?: boolean;
21:      pairingMode?: DoublesPairingMode;
22:      hasPartnerInvite?: boolean;
23:    }
24:  | { event: 'PAIR' };
25:
26:export type DoublesParticipantStatus =
27:  | 'WAITLISTED'
28:  | 'PENDING_APPROVAL'
29:  | 'PENDING_PARTNER'
30:  | 'COMPLETE';
31:
32:export function resolveDoublesParticipantStatus(
33:  transition: DoublesParticipantTransition,
34:): DoublesParticipantStatus {
35:  switch (transition.event) {
36:    case 'REGISTER': {
37:      if (transition.waitlisted) return 'WAITLISTED';
38:      const pairingMode = transition.pairingMode ?? 'ORGANIZER';
39:      const rosterCount = transition.rosterCount ?? 1;
40:      const hasPartnerInvite = transition.hasPartnerInvite ?? false;
41:
42:      if (transition.registrationMode === 'APPROVAL') {
43:        if (rosterCount >= 2) return 'PENDING_APPROVAL';
44:        if (pairingMode === 'ORGANIZER' || !hasPartnerInvite) {
45:          return 'PENDING_APPROVAL';
46:        }
47:      }
48:      return rosterCount >= 2 ? 'COMPLETE' : 'PENDING_PARTNER';
49:    }
50:    case 'APPROVE':
51:      return transition.registrationMode === 'APPROVAL' &&
52:        transition.isDoubles &&
53:        transition.rosterCount === 1
54:        ? 'PENDING_PARTNER'
55:        : 'COMPLETE';
56:    case 'PAIR':
57:      return 'COMPLETE';
58:  }
59:}
60:
61:export type NonDoublesParticipantStatus =
62:  | 'WAITLISTED'
63:  | 'PENDING'
64:  | 'PENDING_APPROVAL'
65:  | 'COMPLETE';
66:
67:export function resolveNonDoublesParticipantStatus(input: {
68:  registrationMode: unknown;
69:  waitlisted: boolean;
70:  incompleteRoster: boolean;
71:}): NonDoublesParticipantStatus {
72:  if (input.waitlisted) return 'WAITLISTED';
73:  if (input.incompleteRoster) return 'PENDING';
74:  return input.registrationMode === 'APPROVAL'
75:    ? 'PENDING_APPROVAL'
76:    : 'COMPLETE';
77:}
78:export function isDoublesParticipantPairable(
79:  teamStatus: string | null | undefined,
80:  teamInviteToken?: string | null,
81:): boolean {
82:  return teamStatus === 'PENDING_PARTNER' && !teamInviteToken;
83:}

