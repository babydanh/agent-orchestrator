19:describe('RankingConsentService.sendDueReminders', () => {
20:  const hoursAgo = (h: number) => new Date(NOW.getTime() - h * HOUR);
21:
22:  /**
23:   * Resolves by call order: the first select is the candidate scan, every later
24:   * select is a dispatch looking up its own roster detail row.
25:   */
26:  const createDb = (candidates: unknown[]) => {
27:    let call = 0;
28:    const chain: Record<string, unknown> = {};
29:    const self = () => chain;
30:    chain.select = jest.fn(self);
31:    chain.from = jest.fn(self);
32:    chain.innerJoin = jest.fn(self);
33:    chain.where = jest.fn(self);
34:    chain.limit = jest.fn(self);
35:    chain.update = jest.fn(self);
36:    chain.set = jest.fn(self);
37:    chain.then = (resolve: (value: unknown) => unknown) =>
38:      Promise.resolve().then(() => {
39:        const value = call === 0 ? candidates : [detailRow()];
40:        call += 1;
41:        resolve(value);
42:      });
43:    return chain;
44:  };
45:
46:  const build = (candidates: unknown[], sendOk = true) => {
47:    const db = createDb(candidates);
