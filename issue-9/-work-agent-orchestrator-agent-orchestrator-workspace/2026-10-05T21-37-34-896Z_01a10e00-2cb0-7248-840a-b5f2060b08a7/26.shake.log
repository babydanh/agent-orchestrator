6:test('organizer can add a directly entered guest with optional contact and note', async ({ page }) => {
7:  let addRequest: Record<string, unknown> | undefined;
8:  await page.route(`**/api/v1/tournaments/${tournamentId}/add-athletes/candidates**`, async (route) => {
9:    await fulfillApi(route, { data: { rows: [], nextCursor: null } });
