1:export class CursorPaginationHelper {
2:  /**
3:   * Mã hoá (encode) đối tượng thành chuỗi cursor base64
4:   * @param payload Bất kỳ object nào (VD: { id: string, createdAt: Date })
5:   * @returns Chuỗi base64
6:   */
7:  static encodeCursor(payload: Record<string, unknown>): string {
8:    const stringified = JSON.stringify(payload);
9:    return Buffer.from(stringified).toString('base64');
10:  }
11:
12:  /**
13:   * Giải mã (decode) chuỗi cursor base64 về object
14:   * @param cursor Chuỗi base64
15:   * @returns Object hoặc null nếu lỗi
16:   */
17:  static decodeCursor<T = Record<string, unknown>>(cursor: string): T | null {
18:    if (!cursor) return null;
19:    try {
20:      const stringified = Buffer.from(cursor, 'base64').toString('utf-8');
21:      return JSON.parse(stringified) as T;
22:    } catch (e) {
23:      return null;
24:    }
25:  }
26:}

