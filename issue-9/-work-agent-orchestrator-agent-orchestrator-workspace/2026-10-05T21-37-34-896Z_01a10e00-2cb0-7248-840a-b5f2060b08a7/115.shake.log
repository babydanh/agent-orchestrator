1907:      details.auditUserId ?? null,
1908:      'matches',
1909:      id,
1910:      oldValues,
1911:      newValues,
1912:    );
1913:
1914:    // 1b. ELO transactional outbox (NOTE-3, T12): enqueue ONLY from the winning
1915:    // transaction, and ONLY for ranked tournaments. Ranked determination is done
1916:    // INSIDE the tx (no TOCTOU against a service-level read). UNIQUE(match_id) +
