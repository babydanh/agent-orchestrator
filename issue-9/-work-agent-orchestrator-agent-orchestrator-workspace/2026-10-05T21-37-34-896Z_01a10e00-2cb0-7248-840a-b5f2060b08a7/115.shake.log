1192:  private async getAcceptedFriendIds(
1193:    executor: AppDbOrTx,
1194:    managerId: string,
1195:    selectedIds?: string[],
1196:  ): Promise<string[]> {
1197:    if (selectedIds?.length === 0) return [];
1198:    const selection =
1199:      selectedIds && selectedIds.length > 0
1200:        ? or(
1201:            and(
1202:              eq(schema.friendships.senderId, managerId),
1203:              inArray(schema.friendships.receiverId, selectedIds),
1204:            ),
1205:            and(
1206:              eq(schema.friendships.receiverId, managerId),
1207:              inArray(schema.friendships.senderId, selectedIds),
1208:            ),
1209:          )
1210:        : undefined;
1211:    const relations = await executor
1212:      .select({
1213:        senderId: schema.friendships.senderId,
1214:        receiverId: schema.friendships.receiverId,
1215:      })
1216:      .from(schema.friendships)
1217:      .where(
1218:        and(
1219:          eq(schema.friendships.status, 'ACCEPTED'),
1220:          isNull(schema.friendships.deletedAt),
1221:          or(
1222:            eq(schema.friendships.senderId, managerId),
1223:            eq(schema.friendships.receiverId, managerId),
1224:          ),
1225:          selection,
1226:        ),
1227:      )
1228:      .for('share');
1229:    return [
1230:      ...new Set(
1231:        relations.map((relation) =>
1232:          relation.senderId === managerId
1233:            ? relation.receiverId
1234:            : relation.senderId,
1235:        ),
1236:      ),
1237:    ];
1238:  }
