1826:  private async completeMatchInTx(
1827:    tx: any,
1828:    id: string,
1829:    winnerId: string | null,
1830:    details: {
1831:      p1SetsWon: number;
1832:      p2SetsWon: number;
1833:      scoreDetails: Record<string, unknown> | null | undefined;
1834:      auditUserId?: string | null;
1835:      isBye?: boolean;
1836:      expectedRevision?: number;
1837:    },
1838:  ) {
1839:    const [existing] = await tx
1840:      .select()
1841:      .from(schema.matches)
1842:      .where(eq(schema.matches.id, id))
1843:      .limit(1);
1844:
1845:    if (!existing) return null;
1846:
1847:    // 1. Conditional update: only the FIRST transaction that flips
1848:    // status away from COMPLETED may run side effects (NOTE-1).
1849:    // Optional optimistic lock: when the caller supplies expectedRevision
1850:    // (from a client-visible match), the update only wins if revision matches.
1851:    const [updated] = await tx
1852:      .update(schema.matches)
1853:      .set({
1854:        status: 'COMPLETED',
1855:        winnerId,
1856:        p1SetsWon: details.p1SetsWon,
1857:        p2SetsWon: details.p2SetsWon,
1858:        scoreDetails: details.scoreDetails,
1859:        isBye: details.isBye ?? existing.isBye,
1860:        completedAt: new Date(),
1861:        updatedAt: new Date(),
1862:        revision: sql`${schema.matches.revision} + 1`,
1863:      })
1864:      .where(
1865:        and(
1866:          eq(schema.matches.id, id),
1867:          ne(schema.matches.status, 'COMPLETED'),
1868:          ...(details.expectedRevision !== undefined
1869:            ? [eq(schema.matches.revision, details.expectedRevision)]
1870:            : []),
1871:        ),
1872:      )
1873:      .returning();
1874:
1875:    // Affected-row gate: no row updated means either already COMPLETED
1876:    // (idempotent — return null, zero side effects) or a stale revision
1877:    // conflict (client saw an older match) — surface as 409 in the service.
1878:    if (!updated) {
1879:      const [current] = await tx
1880:        .select({
1881:          status: schema.matches.status,
1882:          revision: schema.matches.revision,
1883:        })
1884:        .from(schema.matches)
1885:        .where(eq(schema.matches.id, id))
1886:        .limit(1);
1887:      if (!current || current.status === 'COMPLETED') return null;
1888:      return { conflict: true, currentMatch: current } as never;
1889:    }
1890:
1891:    const oldValues = {
1892:      p1SetsWon: existing.p1SetsWon,
1893:      p2SetsWon: existing.p2SetsWon,
1894:      scoreDetails: existing.scoreDetails,
1895:      winnerId: existing.winnerId,
1896:      status: existing.status,
1897:    };
1898:    const newValues = {
1899:      p1SetsWon: updated.p1SetsWon,
1900:      p2SetsWon: updated.p2SetsWon,
1901:      scoreDetails: updated.scoreDetails,
1902:      winnerId: updated.winnerId,
1903:      status: updated.status,
1904:    };
