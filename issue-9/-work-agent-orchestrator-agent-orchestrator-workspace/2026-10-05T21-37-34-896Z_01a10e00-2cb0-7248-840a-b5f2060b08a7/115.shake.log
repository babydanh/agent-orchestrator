method" n="confirmRankingConsent" p="src/modules/tournaments/tournaments.repository.ts:576"/><s t="method" n="handleRankingConsentReminders" p="src/modules/tournaments/tournament-scheduler.service.ts:31"/><s t="method" n="addLiteClubMember" p="src/modules/tournaments/services/tournament-lite.service.ts:1387"/></far></sigs><bodies shown="2" total="6" capped="1"><b t="method" l="2318" p="src/modules/rankings/rankings.service.ts" n="hasEligibleRankingConsent"><![CDATA[private async hasEligibleRankingConsent(matchId: string): Promise<boolean> {
    const [match] = await this.db
      .select({
        completedAt: schema.matches.completedAt,
        participant1Id: schema.matches.participant1Id,
        participant2Id: schema.matches.participant2Id,
        isRanked: schema.tournaments.isRanked,
      })
      .from(schema.matches)
      .innerJoin(
        schema.tournaments,
        eq(schema.tournaments.id, schema.matches.tournamentId),
      )
      .where(eq(schema.matches.id, matchId))
      .limit(1);

    if (
      !match?.isRanked ||
      !match.completedAt ||
      !match.participant1Id ||
      !match.participant2Id
    ) {
      return false;
    }

    const participantIds = [match.participant1Id, match.participant2Id];
    const consentRows = await this.db
      .select({
        participantId: schema.tournamentRosters.participantId,
        rankingConsentAt: schema.tournamentRosters.rankingConsentAt,
      })
      .from(schema.tournamentRosters)
      .where(inArray(schema.tournamentRosters.participantId, participantIds));

    const guestRows = await this.db
      .select({ participantId: schema.tournamentGuestRosters.participantId })
      .from(schema.tournamentGuestRosters)
      .where(inArray(schema.tournamentGuestRosters.participantId, participantIds));
    if (consentRows.length === 0 || guestRows.length > 0) return false;

    const completedAt = match.completedAt.getTime();
    return participantIds.every((participantId) => {
      const rows = consentRows.filter(
        (row) => row.participantId === participantId,
      );
      return (
        rows.length > 0 &&
        rows.every(
          (row) =>
            row.rankingConsentAt !== null &&
            row.rankingConsentAt.getTime() <= completedAt,
        )
      );
    });
  }]]></b><b t="method" l="1525" p="src/modules/tournaments/services/tournament-participant-admin.service.ts" n="deliverGuestClaims"><![CDATA[private async deliverGuestClaims(
    guests: PendingGuestClaim[],
    tournamentId: string,
    tournamentName: string,
  ) {
    const claims: Array<{
      guestId: string;
      delivery: 'EMAILED' | 'HANDOFF';
      claimToken?: string;
    }> = [];
    for (const guest of guests) {
      const emailed = Boolean(
        guest.email &&
          (await this.rankingConsentService?.sendGuestClaimInvite({
            email: guest.email,
            displayName: guest.displayName,
            tournamentName,
            tournamentId,
            guestId: guest.guestId,
            claimToken: guest.claimToken,
          })),
      );
      claims.push({
        guestId: guest.guestId,
        delivery: emailed ? 'EMAILED' : 'HANDOFF',
        ...(emailed ? {} : { claimToken: guest.claimToken }),
      });
    }
    return claims;
  }]]><calls total="1"><c n="sendGuestClaimInvite" l="80">async sendGuestClaimInvite(args:</c></calls></b><!-- body omitted (over budget): confirmRankingConsent --><!-- body omitted (over budget): recalculateEloChain --><!-- body omitted (over budget): RankingConsentService --><!-- body omitted (over budget): TournamentParticipantAdminService --></bodies><callers of_top="6" shown="16" total="25" capped="1"><s t="method" n="insert" p="src/modules/friendships/friendships.repository.ts:102" rel="callee">async insert(row: typeof schema.friendships.$inferInsert)</s><s t="method" n="calculateElo" p="src/modules/rankings/elo-engine.service.ts:16" rel="callee">calculateElo( playerElo: number, opponentElo: number, isWin: boolean, matchesPlayed: number, win…</s><s t="fn" n="gate" p="src/modules/rankings/ranking-consent-gate.spec.ts:79" rel="caller">const gate = (service: RankingsService) =&gt; ( service as unknown as</s><s t="method" n="invalidateLeaderboardCache" p="src/modules/rankings/rankings.service.ts:82" rel="callee">private async invalidateLeaderboardCache(categoryId: string)</s><s t="method" n="extractScoreRatio" p="src/modules/rankings/rankings.service.ts:100" rel="callee">private extractScoreRatio( scoreDetails: Record&lt;string, unknown&gt; | null | undefined, winnerParti…</s><s t="method" n="updateMatchElo" p="src/modules/rankings/rankings.service.ts:265" rel="caller">async updateMatchElo(dto: UpdateEloDto)</s><s t="method" n="recalculateUserRankTier" p="src/modules/rankings/rankings.service.ts:1405" rel="callee">async recalculateUserRankTier( tx: Transaction, userId: string, categoryId: string, matchType: s…</s><s t="fn" n="getPlayerState" p="src/modules/rankings/rankings.service.ts:1895" rel="callee">const getPlayerState = async (userId: string, completedAt: Date) =&gt;</s><s t="fn" n="sideConsented" p="src/modules/rankings/rankings.service.ts:2107" rel="callee">const sideConsented = (rows: typeof winnerRosters) =&gt; completedAtMs !== undefined &amp;&amp; rows