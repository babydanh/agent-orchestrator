1621:function isMatchingClaimHash(storedHash: string, suppliedHash: string): boolean {
1622:  if (!/^[0-9a-f]{64}$/i.test(storedHash)) return false;
1623:  const stored = Buffer.from(storedHash, 'hex');
1624:  const supplied = Buffer.from(suppliedHash, 'hex');
1625:  return stored.length === supplied.length && timingSafeEqual(stored, supplied);
1626:}

