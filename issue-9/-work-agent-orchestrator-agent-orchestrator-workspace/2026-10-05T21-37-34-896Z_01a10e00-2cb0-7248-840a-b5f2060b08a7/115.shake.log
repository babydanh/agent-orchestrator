167:async function selectDivisionOwners(
168:  executor: AppDbOrTx,
169:  scope: {
170:    divisionIds?: readonly string[];
171:    divisionId?: string;
172:    tournamentId?: string;
173:  },
174:): Promise<CapacityOwnerRow[]> {
175:  return await executor
176:    .select({
177:      id: schema.tournamentDivisions.id,
178:      tournamentId: schema.tournamentDivisions.tournamentId,
179:      matchType: schema.tournamentDivisions.matchType,
180:      maxParticipants: schema.tournamentDivisions.maxParticipants,
181:      tournamentConfig: schema.tournaments.tournamentConfig,
182:    })
183:    .from(schema.tournamentDivisions)
184:    .innerJoin(
185:      schema.tournaments,
186:      eq(schema.tournaments.id, schema.tournamentDivisions.tournamentId),
187:    )
188:    .where(
189:      scope.divisionIds !== undefined
190:        ? inArray(schema.tournamentDivisions.id, [...scope.divisionIds])
191:        : scope.divisionId
192:          ? eq(schema.tournamentDivisions.id, scope.divisionId)
