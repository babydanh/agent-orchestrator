46:function sumSetPoints(
47:  scoreDetails: Record<string, unknown> | null | undefined,
48:): { p1: number; p2: number } {
49:  const football = scoreDetails?.football;
50:  if (football && typeof football === 'object' && !Array.isArray(football)) {
51:    const value = football as Record<string, unknown>;
52:    const p1 = Number(value.team1Goals);
53:    const p2 = Number(value.team2Goals);
54:    if (Number.isFinite(p1) && Number.isFinite(p2)) return { p1, p2 };
55:  }
56:  let p1 = 0;
57:  let p2 = 0;
58:  if (scoreDetails?.sets && Array.isArray(scoreDetails.sets)) {
59:    for (const set of scoreDetails.sets as Array<Record<string, unknown>>) {
60:      p1 += Number(set.team1Score) || 0;
61:      p2 += Number(set.team2Score) || 0;
62:    }
63:  }
64:  return { p1, p2 };
65:}
