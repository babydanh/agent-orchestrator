107:                <p className="text-base font-bold text-slate-900">{user?.fullName || translate('notUpdated')}</p>
108:                <p className="text-xs text-slate-500 mt-0.5">{translate('accountNameAuto')}</p>
109:              </div>
110:            </div>
111:
112:            {isDoubles && (
113:              <div className="space-y-1.5">
114:                <label className="text-xs font-bold text-slate-700">{translate('partnerLabel')}</label>
115:                <input
116:                  type="text"
117:                  placeholder="{translate('partnerPlaceholder')}"
118:                  value={partnerEmailOrPhone}
119:                  onChange={(e) => setPartnerEmailOrPhone(e.target.value)}
120:                  className="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
121:                />
122:                <p className="text-xs text-amber-700 bg-amber-50 p-2.5 rounded-md border border-amber-200 leading-snug">
123:                  ⏱️ <strong>{translate('pairingDeadline')}:</strong> {translate('pairingDeadlineNotice', { hours: 1 })}
124:                </p>
125:              </div>
126:            )}
127:            
128:            <div className="bg-slate-50 border border-slate-200/80 p-4 rounded-lg">
129:              <p className="text-xs text-slate-600 font-medium leading-relaxed">
130:                {translate('registrationTermsNotice')}
131:              </p>
132:            </div>
133:
134:            {isRanked && (
135:              <label className="flex items-start gap-3 rounded-xl border border-sky-200 bg-sky-50 p-3 text-sm text-slate-700">
136:                <input
137:                  type="checkbox"
138:                  checked={rankingConsent}
139:                  onChange={(event) => setRankingConsent(event.target.checked)}
140:                  className="mt-1 h-4 w-4 accent-sky-600"
141:                />
142:                <span>{translate('rankingConsentLabel')}</span>
143:              </label>
144:            )}
145:
146:            <div className="flex justify-end gap-3 mt-4">
147:              <Button type="button" variant="outline" onClick={onClose} className="border-slate-200 text-slate-600">
148:                {translate('cancel')}
149:              </Button>
150:              <Button type="submit" disabled={isSubmitting} className="bg-blue-600 hover:bg-blue-700 text-white font-semibold">
151:                {isSubmitting ? translate('processing') : translate('confirmRegistration')}
152:              </Button>
153:            </div>
154:          </form>
155:        </div>
156:      </div>
157:    </div>
158:  );
159:}

