28:  const [isSubmitting, setIsSubmitting] = useState(false);
29:  const [partnerEmailOrPhone, setPartnerEmailOrPhone] = useState('');
30:  const [rankingConsent, setRankingConsent] = useState(false);
31:
32:  const isDoubles = matchType === 'DOUBLES' || matchType === 'MIXED_DOUBLES';
33:
34:  if (!isOpen) return null;
35:
36:  const handleRegisterSubmit = async (e: React.FormEvent) => {
37:    e.preventDefault();
38:    if (!isAuthenticated || !user) {
39:      toast.error(translate('loginToRegister'));
40:      window.location.assign(`/login?redirect=/tournaments/${tournamentId}`);
41:      return;
42:    }
43:
44:    if (isRanked && !rankingConsent) {
45:      toast.error(translate('rankingConsentRequired'));
46:      return;
47:    }
48:
49:    try {
50:      setIsSubmitting(true);
51:      const teamName = user?.fullName || translate('player');
52:      const payload: { teamName: string; partnerEmailOrPhone?: string; tournamentDivisionId?: string; rankingConsent: boolean } = {
53:        teamName,
54:        rankingConsent,
55:        ...(divisionId ? { tournamentDivisionId: divisionId } : {}),
56:      };
57:      if (isDoubles && partnerEmailOrPhone.trim()) {
58:        payload.partnerEmailOrPhone = partnerEmailOrPhone.trim();
59:      }
60:
61:      const res = await tournamentsApi.register(tournamentId, payload);
62:      const participantId = res?.data?.participant?.id;
63:      const payableEntryFee = Number(res?.data?.entryFee ?? entryFee);
64:      const paymentEligible = res?.data?.paymentEligible === true;
65:
66:      if (isDoubles && partnerEmailOrPhone.trim()) {
67:        toast.success(translate('partnerInviteSent'), { duration: 5000 });
68:      } else {
69:        toast.success(translate('registrationSuccess'));
70:      }
71:      onClose();
72:      
73:            if (paymentEligible && payableEntryFee > 0 && participantId) {
74:
75:        router.push(`/payments/checkout?participantId=${participantId}&tournamentId=${tournamentId}`);
76:      } else {
77:        router.refresh();
78:      }
79:    } catch (error) {
80:      toast.error(getErrorMessage(error));
81:    } finally {
82:      setIsSubmitting(false);
83:    }
84:  };
85:
86:  return (
87:    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
88:      <div className="bg-white rounded-lg shadow-xl w-full max-w-md overflow-hidden">
89:        <div className="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
90:          <h2 className="text-lg font-bold text-slate-900 flex items-center gap-2">
91:            <Users className="w-5 h-5 text-blue-600" /> {translate('registerForTournament')}
92:          </h2>
93:          <button onClick={onClose} className="text-slate-400 hover:text-slate-600 transition-colors">
94:            <X className="w-5 h-5" />
95:          </button>
96:        </div>
97:        
98:        <div className="p-6">
99:          <p className="text-sm text-slate-600 mb-5">
100:            {translate('registerDescription')} <strong className="text-slate-900">{tournamentName}</strong>.
101:          </p>
102:          
103:          <form onSubmit={handleRegisterSubmit} className="flex flex-col gap-4">
104:            <div className="bg-blue-50/70 border border-blue-200/80 rounded-lg p-4 flex items-center justify-between">
105:              <div>
