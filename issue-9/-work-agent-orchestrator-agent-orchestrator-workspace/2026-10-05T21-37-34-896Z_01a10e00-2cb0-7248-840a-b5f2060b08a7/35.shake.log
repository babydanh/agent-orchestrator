1:import { Injectable, Logger, Inject } from '@nestjs/common';
2:import { Cron, CronExpression } from '@nestjs/schedule';
3:import { PG_CONNECTION } from '../../database/database.module';
4:import type { AppDb } from '../../database/db.types';
5:import * as schema from '../../database/schema';
6:import { eq, and, lte, ne, isNull, isNotNull, sql } from 'drizzle-orm';
7:import {
8:  evaluateTournamentCleanup,
9:  TOURNAMENT_CLEANUP_GRACE_DAYS,
10:} from './utils/tournament-cleanup-policy';
11:import { TournamentRegistrationService } from './services/tournament-registration.service';
12:import { RankingConsentService } from './services/ranking-consent.service';
