14:@Injectable()
15:export class TournamentSchedulerService {
16:  private readonly logger = new Logger(TournamentSchedulerService.name);
17:
18:  constructor(
19:    @Inject(PG_CONNECTION) private readonly db: AppDb,
20:    private readonly tournamentRegistrationService: TournamentRegistrationService,
21:    private readonly rankingConsentService: RankingConsentService,
22:  ) {}
23:
24:  /**
25:   * Nhắc xác nhận ELO tự động, tối đa 3 lần rồi dừng.
26:   *
27:   * Hourly, not 5-minutely: the delays are measured in hours, so a finer tick would
28: * only re-check the same rows and burn queries.
29:   */
30:  @Cron(CronExpression.EVERY_HOUR)
31:  async handleRankingConsentReminders() {
32:    try {
33:      const sent = await this.rankingConsentService.sendDueReminders();
34:      if (sent > 0) {
35:        this.logger.log(`Đã gửi ${sent} nhắc xác nhận Elo.`);
36:      }
37:    } catch (err) {
38:      this.logger.error(
39:        `Nhắc xác nhận Elo thất bại: ${
40:          err instanceof Error ? err.message : String(err)
41:        }`,
42:      );
43:    }
44:  }
45:  @Cron('*/5 * * * *')
46:  async handleRegistrationsTimeout() {
47:    await this.tournamentRegistrationService.processPendingRegistrationTimeout();
48:  }
49:
50:  @Cron(CronExpression.EVERY_5_MINUTES)
51:  async handleAutoCloseRegistration() {
52:    this.logger.log('Running auto-close registration cron job...');
53:    try {
54:      const now = new Date();
55:      // Find tournaments that are open but past registration end date
56:      const expiredTournaments = await this.db
57:        .select()
58:        .from(schema.tournaments)
59:        .where(
60:          and(
61:            eq(schema.tournaments.status, 'REGISTRATION_OPEN'),
62:            lte(schema.tournaments.registrationEndDate, now)
63:          )
64:        );
65:
66:      if (expiredTournaments.length === 0) {
67:        return;
68:      }
69:
70:      this.logger.log(`Found ${expiredTournaments.length} tournament(s) to close registration.`);
71:
