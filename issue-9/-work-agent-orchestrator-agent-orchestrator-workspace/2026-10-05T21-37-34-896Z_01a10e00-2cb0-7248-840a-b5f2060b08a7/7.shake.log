429:  bool _isOpsTerminalMatch(MatchModel match) {
430:    final status = match.status.trim().toUpperCase();
431:    return match.isCompleted ||
432:        status == 'FINISHED' ||
433:        match.completedAt != null ||
434:        match.winnerId.trim().isNotEmpty;
435:  }
436:
437:  String _opsMatchBucket(MatchModel match) {
438:    final status = match.status.trim().toUpperCase();
439:    final missingOpponent =
440:        match.team1Id.trim().isEmpty || match.team2Id.trim().isEmpty;
441:    final isDirectAdvance =
442:        match.isBye || (match.winnerId.trim().isNotEmpty && missingOpponent);
443:
444:    if (isDirectAdvance) return 'attention';
445:    if (match.isLive) return 'ongoing';
446:    if (_isOpsTerminalMatch(match)) return 'completed';
447:
448:    final needsAttention =
449:        status == 'DISPUTED' ||
450:        missingOpponent ||
451:        match.scheduledTime == null ||
452:        status != 'SCHEDULED';
453:    return needsAttention ? 'attention' : 'scheduled';
454:  }
455:
456:  List<MatchModel> _sortOpsMatches(
457:    List<MatchModel> matches,
458:    String selectedFilter,
459:  ) {
460:    const priority = <String, int>{
461:      'ongoing': 0,
462:      'scheduled': 1,
463:      'completed': 2,
464:      'attention': 3,
465:    };
466:    final visible = selectedFilter == 'all'
467:        ? List<MatchModel>.of(matches)
468:        : matches
469:              .where((match) => _opsMatchBucket(match) == selectedFilter)
470:              .toList();
471:    visible.sort((a, b) {
472:      final bucketCompare = (priority[_opsMatchBucket(a)] ?? 9).compareTo(
473:        priority[_opsMatchBucket(b)] ?? 9,
474:      );
475:      if (bucketCompare != 0) return bucketCompare;
476:      final groupCompare = (a.groupName ?? '').compareTo(b.groupName ?? '');
477:      if (groupCompare != 0) return groupCompare;
478:      final legCompare = (a.leg ?? 1).compareTo(b.leg ?? 1);
479:      if (legCompare != 0) return legCompare;
480:      return a.id.compareTo(b.id);
481:    });
482:    return visible;
483:  }
484:
485:  List<_OpsMatchSectionData> _buildOpsMatchSections(
486:    List<MatchModel> matches,
487:    String selectedFilter,
488:  ) {
489:    const order = ['ongoing', 'scheduled', 'completed', 'attention'];
490:    final keys = selectedFilter == 'all' ? order : [selectedFilter];
491:    return [
492:      for (final key in keys)
493:        _OpsMatchSectionData(key: key, matches: _sortOpsMatches(matches, key)),
494:    ];
495:  }
