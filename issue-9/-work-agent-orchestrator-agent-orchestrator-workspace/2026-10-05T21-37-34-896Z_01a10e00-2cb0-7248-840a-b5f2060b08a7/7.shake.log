250:  // Team sport: status mời — INVITED (chưa accept) / ACTIVE / REMOVED
251:  status: varchar('status', { length: 20 }).default('ACTIVE').notNull(),
252:  // When THIS user agreed to have their results ranked in THIS tournament.
253:  //
254:  // Lives here, not on tournament_participants, because ELO is applied per
255:  // tournament_rosters.userId: a team participant can carry several users
256:  // (MAIN + RESERVE), so a single per-participant timestamp cannot tell whose
257:  // consent it is — one user confirming would hand every team-mate their score.
258:  //
259:  // NULL means not confirmed. Distinct from tournament_participants.ranking_consent,
260:  // which is only a copy of the tournament's isRanked flag.
261:  //
262:  // Business rule: a match counts only when matches.completedAt >= this instant.
263:  // Matches played before confirming stay permanently unscored, so nobody can be
264:  // force-enrolled and then have old results land against them.
