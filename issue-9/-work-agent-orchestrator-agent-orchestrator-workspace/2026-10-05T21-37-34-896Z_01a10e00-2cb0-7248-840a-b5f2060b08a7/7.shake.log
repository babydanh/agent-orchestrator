8:/**
9: * Thông báo XÁC NHẬN (không phải lời mời) cho người tham gia.
10: *
11: * Mail KHÔNG mang token: bấm xác nhận phải đi qua endpoint đã đăng nhập, nên không
12: * có bí mật nào nằm trong link để lộ. Link chỉ đưa người chơi tới trang giải để bấm.
13: *
14: * Tự động nhắc tối đa 3 lần rồi dừng — bấm tay từ phía ban tổ chức là thao tác
15: * không còn thiết.
16: */
17:export const CONSENT_MAX_NOTIFICATIONS = 3;
18:
19:/** Số giờ chờ trước mỗi lần nhắc, tính từ lần gửi gần nhất. */
20:export const CONSENT_REMINDER_DELAYS_HOURS = [24, 72] as const;
21:
22:@Injectable()
23:export class RankingConsentService {
24:  private readonly logger = new Logger(RankingConsentService.name);
25:
26:  constructor(
27:    @Inject(PG_CONNECTION) private readonly db: AppDb,
28:    @Optional() private readonly mailService?: MailService,
29:  ) {}
30:
31:  private get frontendUrl(): string {
32:    return (
33:      process.env.FRONTEND_URL?.replace(/\/$/, '') ?? 'http://localhost:3001'
34:    );
35:  }
36:
37:  /** Gửi ngay cho một roster row cụ thể (dùng khi vừa thêm người). */
38:  async sendConfirmationRequest(rosterId: string): Promise<boolean> {
39:    return this.dispatch(rosterId, 'Xác nhận tham gia giải đấu');
40:  }
41:
42:  /** Nhắc lại cho những ai đã quá hạn mà chưa xác nhận. */
43:  async sendDueReminders(): Promise<number> {
44:    const now = Date.now();
45:
46:    // Rows whose notifiedAt is still NULL are included on purpose. dispatch stamps
47:    // that column only after a successful send, so filtering NULLs out would mean a
48:    // single temporary mail outage silently ends all reminders — the player never
49:    // hears again and never learns their matches go unscored. That is exactly the
50:    // silent-exclusion failure this feature exists to prevent.
51:    const due = await this.db
52:      .select({
53:        id: schema.tournamentRosters.id,
54:        attempts: schema.tournamentRosters.consentNotifiedCount,
55:        notifiedAt: schema.tournamentRosters.consentNotifiedAt,
56:        joinedAt: schema.tournamentRosters.joinedAt,
57:      })
58:      .from(schema.tournamentRosters)
59:      .innerJoin(
60:        schema.tournamentParticipants,
61:        eq(
62:          schema.tournamentParticipants.id,
63:          schema.tournamentRosters.participantId,
64:        ),
65:      )
66:      .innerJoin(
67:        schema.tournaments,
68:        eq(schema.tournaments.id, schema.tournamentParticipants.tournamentId),
69:      )
70:      .where(
71:        and(
72:          isNull(schema.tournamentRosters.rankingConsentAt),
73:          // A tournament that does not rank scores nothing, so asking its players to
74:          // consent would be noise.
75:          eq(schema.tournaments.isRanked, true),
76:        ),
77:      );
78:
79:    let sent = 0;
80:    for (const row of due) {
81:      // Three sends in total: the one at add time plus two reminders. Past the cap
82:      // the row is left alone — nobody gets nagged forever.
83:      if (row.attempts >= CONSENT_MAX_NOTIFICATIONS) continue;
84:
85:      // attempts === 0 means the first send never landed, so the clock runs from
86:      // when the player joined instead of from a send that does not exist.
87:      const anchor = row.notifiedAt ?? row.joinedAt;
88:      if (!anchor) continue;
89:
90:      // attempts counts DELIVERED sends, and the send at add time already made it 1.
91:      // So the first reminder is attempts === 1 → delays[0] = 24h. Indexing by
92:      // `attempts` would jump straight to 72h and leave delays[0] as dead code.
93:      // attempts === 0 means nothing was delivered yet, so the 24h delay runs from
94:      // joinedAt instead.
95:      const delayHours =
96:        CONSENT_REMINDER_DELAYS_HOURS[
97:          Math.min(
98:            Math.max(row.attempts - 1, 0),
99:            CONSENT_REMINDER_DELAYS_HOURS.length - 1,
100:          )
101:        ];
102:      const elapsedHours = (now - new Date(anchor).getTime()) / 3_600_000;
103:      if (elapsedHours < delayHours) continue;
104:
105:      if (await this.dispatch(row.id, 'Nhắc xác nhận tham gia giải đấu')) {
106:        sent += 1;
107:      }
108:    }
109:    return sent;
110:  }
111:
112:  /**
113:   * Gửi 1 mail và ghi nhận số lần đã gửi.
114:   *
115:   * Chỉ tăng bộ đếm khi gửi THÀNH CÔNG — nếu không, một hệ thống mail hỏng sẽ đốt
116:   * hết 3 lượt nhắc rồi im lặng, biến "chưa gửi được" thành "đã bỏ qua".
117:   */
118:  private async dispatch(rosterId: string, subject: string): Promise<boolean> {
119:    if (!this.mailService) return false;
120:
121:    const rows = await this.db
122:      .select({
123:        userEmail: schema.users.email,
124:        participantName: schema.tournamentParticipants.teamName,
125:        tournamentName: schema.tournaments.name,
126:        tournamentId: schema.tournaments.id,
127:        attempts: schema.tournamentRosters.consentNotifiedCount,
128:        consentedAt: schema.tournamentRosters.rankingConsentAt,
129:      })
130:      .from(schema.tournamentRosters)
131:      .innerJoin(
132:        schema.users,
133:        eq(schema.users.id, schema.tournamentRosters.userId),
134:      )
135:      .innerJoin(
136:        schema.tournamentParticipants,
137:        eq(schema.tournamentParticipants.id, schema.tournamentRosters.participantId),
138:      )
139:      .innerJoin(
140:        schema.tournaments,
141:        eq(schema.tournaments.id, schema.tournamentParticipants.tournamentId),
142:      )
143:      .where(eq(schema.tournamentRosters.id, rosterId))
144:      .limit(1);
145:
146:    const row = rows[0];
147:    if (!row?.userEmail || row.consentedAt) return false;
148:
149:    const link = `${this.frontendUrl}/tournaments/${row.tournamentId}`;
150:    const isReminder = row.attempts > 0;
151:
152:    try {
153:      const ok = await this.mailService.sendMail(
154:        row.userEmail,
155:        `[Sporto] ${subject}: ${row.tournamentName}`,
156:        this.buildHtml({
157:          participantName: row.participantName,
158:          tournamentName: row.tournamentName,
159:          link,
160:          isReminder,
161:        }),
162:      );
163:      if (!ok) return false;
164:    } catch (err) {
165:      this.logger.warn(
166:        `Gửi mail xác nhận thất bại cho roster ${rosterId}: ${
167:          err instanceof Error ? err.message : String(err)
168:        }`,
169:      );
170:      return false;
171:    }
172:
173:    await this.db
174:      .update(schema.tournamentRosters)
175:      .set({
176:        consentNotifiedAt: new Date(),
177:        consentNotifiedCount: row.attempts + 1,
178:      })
179:      .where(eq(schema.tournamentRosters.id, rosterId));
180:
181:    return true;
182:  }
