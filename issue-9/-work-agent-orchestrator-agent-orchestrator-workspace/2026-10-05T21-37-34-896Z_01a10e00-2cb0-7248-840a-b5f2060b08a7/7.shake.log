271:  // the scheduler cannot tell "never notified" from "notified and ignored", and
272:  // the organizer's "awaiting confirmation" view becomes unverifiable.
273:  consentNotifiedAt: timestamp('consent_notified_at', { withTimezone: true }),
274:  consentNotifiedCount: integer('consent_notified_count').default(0).notNull(),
