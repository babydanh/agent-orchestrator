nnerJoin(\n        schema.tournamentParticipants,\n        eq(\n          schema.tournamentParticipants.id,\n          schema.tournamentRosters.participantId,\n        ),\n      )\n      .where(\n        and(\n          eq(schema.tournamentRosters.userId, schema.users.id),\n          eq(schema.tournamentRosters.status, 'ACTIVE'),\n          eq(schema.tournamentParticipants.tournamentId, tournamentId),\n          inArray(\n            schema.tournamentParticipants.teamStatus,\n            [...CAPACITY_RESERVING_TEAM_STATUSES],\n          ),\n          dto.divisionId\n            ? eq(\n                schema.tournamentParticipants.tournamentDivisionId,\n                dto.divisionId,\n              )\n            : undefined,\n        ),\n      );\n    const rows = await this.db\n      .select({\n        userId: schema.users.id,\n        displayName: schema.profiles.fullName,\n        avatarUrl: schema.profiles.avatarUrl,\n      })\n      .from(schema.profiles)\n      .innerJoin(schema.users, eq(schema.users.id, schema.profiles.userId))\n      .where(\n        and(\n          inArray(schema.users.id, sourceUserIds),\n          eq(schema.users.isMock, false),\n          isNull(schema.users.deletedAt),\n          notExists(activeRosterQuery),\n          search ? ilike(schema.profiles.fullName, `%${search}%`) : undefined,\n          cursor\n            ? or(\n                gt(schema.profiles.fullName, cursor.displayName),\n                and(\n                  eq(schema.profiles.fullName, cursor.displayName),\n                  gt(schema.users.id, cursor.userId),\n                ),\n              )\n            : undefined,\n        ),\n      )\n      .orderBy(asc(schema.profiles.fullName), asc(schema.users.id))\n      .limit(limit + 1);\n\n    const hasMore = rows.length > limit;\n    const items = rows.slice(0, limit).map((row) => ({\n      ...row,\n      source: dto.source,\n    }));\n    const last = items[items.length - 1];\n    return {\n      items,\n      