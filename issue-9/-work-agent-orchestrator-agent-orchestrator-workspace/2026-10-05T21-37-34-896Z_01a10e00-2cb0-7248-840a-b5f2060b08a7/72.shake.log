1335:  private async resolveDirectAthletes(
1336:    tx: AppDbOrTx,
1337:    players: AddAthletePlayerDto[],
1338:  ): Promise<ResolvedAddAthlete[]> {
1339:    const normalizedEmails = [
1340:      ...new Set(
1341:        players
1342:          .map((player) => player.email)
1343:          .filter((email): email is string => Boolean(email))
1344:          .map(normalizeEmail),
1345:      ),
1346:    ];
1347:    const accountRows =
1348:      normalizedEmails.length > 0
1349:        ? await tx
1350:            .select({
1351:              userId: schema.users.id,
1352:              email: schema.users.email,
1353:              displayName: schema.profiles.fullName,
1354:            })
1355:            .from(schema.users)
1356:            .leftJoin(
1357:              schema.profiles,
1358:              eq(schema.profiles.userId, schema.users.id),
1359:            )
1360:            .where(
1361:              and(
1362:                inArray(
1363:                  sql<string>`lower(trim(${schema.users.email}))`,
1364:                  normalizedEmails,
1365:                ),
1366:                eq(schema.users.isEmailVerified, true),
1367:                eq(schema.users.isMock, false),
1368:                isNull(schema.users.deletedAt),
1369:              ),
1370:            )
1371:        : [];
1372:    const accountsByEmail = new Map<string, typeof accountRows>();
1373:    for (const account of accountRows) {
1374:      const email = normalizeEmail(account.email);
1375:      accountsByEmail.set(email, [...(accountsByEmail.get(email) ?? []), account]);
1376:    }
1377:    return players.map((player) => {
1378:      const email = player.email ? normalizeEmail(player.email) : null;
1379:      const matches = email ? accountsByEmail.get(email) ?? [] : [];
1380:      const account = matches.length === 1 ? matches[0] : null;
1381:      return {
1382:        userId: account?.userId ?? null,
1383:        displayName:
1384:          account?.displayName?.trim() || player.displayName!.trim(),
1385:        email: account ? null : email,
1386:        phone: account ? null : player.phone?.trim() || null,
1387:        role: player.role === 'RESERVE' ? 'RESERVE' : 'MAIN',
1388:      };
1389:    });
1390:  }
