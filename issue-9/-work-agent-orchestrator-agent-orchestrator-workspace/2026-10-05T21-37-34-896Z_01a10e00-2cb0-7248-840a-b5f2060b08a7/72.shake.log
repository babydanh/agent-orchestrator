1166:  private async getAcceptedFriendIds(
1167:    executor: AppDbOrTx,
1168:    managerId: string,
1169:    selectedIds?: string[],
1170:  ): Promise<string[]> {
1171:    if (selectedIds?.length === 0) return [];
1172:    const selection =
1173:      selectedIds && selectedIds.length > 0
1174:        ? or(
1175:            and(
1176:              eq(schema.friendships.senderId, managerId),
1177:              inArray(schema.friendships.receiverId, selectedIds),
1178:            ),
1179:            and(
1180:              eq(schema.friendships.receiverId, managerId),
1181:              inArray(schema.friendships.senderId, selectedIds),
1182:            ),
1183:          )
1184:        : undefined;
1185:    const relations = await executor
1186:      .select({
1187:        senderId: schema.friendships.senderId,
1188:        receiverId: schema.friendships.receiverId,
1189:      })
1190:      .from(schema.friendships)
1191:      .where(
1192:        and(
1193:          eq(schema.friendships.status, 'ACCEPTED'),
1194:          isNull(schema.friendships.deletedAt),
1195:          or(
1196:            eq(schema.friendships.senderId, managerId),
1197:            eq(schema.friendships.receiverId, managerId),
1198:          ),
1199:          selection,
1200:        ),
1201:      )
1202:      .for('share');
1203:    return [
1204:      ...new Set(
1205:        relations.map((relation) =>
1206:          relation.senderId === managerId
1207:            ? relation.receiverId
1208:            : relation.senderId,
1209:        ),
1210:      ),
1211:    ];
1212:  }
