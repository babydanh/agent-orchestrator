{"resolved_from_name":"@src/modules/tournaments/services/tournament-participant-admin.service.ts:388","handle":"sym#2f1c1469e5b2732a@9b90e84f78c6a404","name":"claimGuestRoster","kind":"method","file":"src/modules/tournaments/services/tournament-participant-admin.service.ts","line":388,"start_line":1,"end_line":132,"total_lines":132,"partial":false,"bytes":4236,"body":"async claimGuestRoster(\n    tournamentId: string,\n    guestId: string,\n    userId: string,\n    claimToken: string,\n    broadcast: RegistrationChanged,\n  ) {\n    const claimHash = createHash('sha256').update(claimToken).digest('hex');\n    const claimed = await this.db.transaction(async (tx) => {\n      const [user] = await tx\n        .select({\n          email: schema.users.email,\n          isEmailVerified: schema.users.isEmailVerified,\n          deletedAt: schema.users.deletedAt,\n        })\n        .from(schema.users)\n        .where(eq(schema.users.id, userId))\n        .for('share')\n        .limit(1);\n      if (!user || !user.isEmailVerified || user.deletedAt) {\n        throw new ForbiddenException('Cần email đã xác minh để nhận suất.');\n      }\n\n      const [guest] = await tx\n        .select()\n        .from(schema.tournamentGuestRosters)\n        .where(eq(schema.tournamentGuestRosters.id, guestId))\n        .for('update')\n        .limit(1);\n      if (\n        !guest ||\n        guest.claimExpiresAt <= new Date() ||\n        !isMatchingClaimHash(guest.claimTokenHash, claimHash)\n      ) {\n        throw new ConflictException('Mã nhận suất không hợp lệ hoặc đã hết hạn.');\n      }\n      if (\n        guest.contactEmail &&\n        normalizeEmail(guest.contactEmail) !== normalizeEmail(user.email)\n      ) {\n        throw new ForbiddenException(\n          'Tài khoản phải dùng email đã nhận lời mời.',\n        );\n      }\n\n      const [context] = await tx\n        .select({\n          participantId: schema.tournamentParticipants.id,\n          tournamentId: schema.tournamentParticipants.tournamentId,\n          divisionId: schema.tournamentParticipants.tournamentDivisionId,\n          participantStatus: schema.tournamentParticipants.teamStatus,\n          tournamentName: schema.tournaments.name,\n          tournamentStatus: schema.tournaments.status,\n          tournamentEndDate: schema.tournaments.endDate,\n          tournamentDeletedAt: schema.tournaments.deletedAt,\n          isRanked: schema.tournaments.isRanked,\n        })\n        .from(schema.tournamentParticipants)\n        .innerJoin(\n          schema.tournaments,\n          eq(\n            schema.tournaments.id,\n            schema.tournamentParticipants.tournamentId,\n          ),\n        )\n        .where(eq(schema.tournamentParticipants.id, guest.participantId))\n        .for('share')\n        .limit(1);\n      this.assertClaimContext(context, tournamentId);\n      await this.assertNoExistingRoster(\n        tx,\n        tournamentId,\n        null,\n        [{ userId, displayName: '', email: null, phone: null, role: guest.role }],\n      );\n\n      const [roster] = await tx\n        .insert(schema.tournamentRosters)\n        .values({\n          participantId: guest.participantId,\n          userId,\n          role: guest.role,\n          status: 'ACTIVE',\n        })\n        .returning({\n          id: schema.tournamentRosters.id,\n          participantId: schema.tournamentRosters.participantId,\n          userId: schema.tournamentRosters.userId,\n        });\n      if (!roster) {\n        throw new ConflictException('Không thể nhận suất tham gia.');\n      }\n      await tx\n        .delete(schema.tournamentGuestRosters)\n        .where(eq(schema.tournamentGuestRosters.id, guestId));\n      await this.auditService.logDelete(\n        tx,\n        userId,\n        'tournament_guest_rosters',\n        guestId,\n        { participantId: guest.participantId, role: guest.role },\n      );\n      await this.auditService.logCreate(\n        tx,\n        userId,\n        'tournament_rosters',\n        roster.id,\n        {\n          participantId: roster.participantId,\n          userId: roster.userId,\n          role: guest.role,\n        },\n      );\n      return { roster, context };\n    });\n\n    await this.notifyAddedAccounts(\n      [{ id: claimed.roster.id, userId }],\n      tournamentId,\n      claimed.context.tournamentName,\n      claimed.context.divisionId,\n    );\n    broadcast(tournamentId, {\n      participantId: claimed.roster.participantId,\n      divisionId: claimed.context.divisionId,\n      action: 'GUEST_CLAIMED',\n    });\n    return {\n      participantId: claimed.roster.participantId,\n      claimed: true,\n    };\n  }"}

