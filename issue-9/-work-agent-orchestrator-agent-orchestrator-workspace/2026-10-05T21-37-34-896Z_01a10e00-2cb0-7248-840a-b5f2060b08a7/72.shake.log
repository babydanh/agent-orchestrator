{"resolved_from_name":"@src/modules/rankings/rankings.service.ts:2318","handle":"sym#180d580a4458ffca@feddbfcbb85a76ec","name":"hasEligibleRankingConsent","kind":"method","file":"src/modules/rankings/rankings.service.ts","line":2318,"start_line":1,"end_line":55,"total_lines":55,"partial":false,"bytes":1831,"body":"private async hasEligibleRankingConsent(matchId: string): Promise<boolean> {\n    const [match] = await this.db\n      .select({\n        completedAt: schema.matches.completedAt,\n        participant1Id: schema.matches.participant1Id,\n        participant2Id: schema.matches.participant2Id,\n        isRanked: schema.tournaments.isRanked,\n      })\n      .from(schema.matches)\n      .innerJoin(\n        schema.tournaments,\n        eq(schema.tournaments.id, schema.matches.tournamentId),\n      )\n      .where(eq(schema.matches.id, matchId))\n      .limit(1);\n\n    if (\n      !match?.isRanked ||\n      !match.completedAt ||\n      !match.participant1Id ||\n      !match.participant2Id\n    ) {\n      return false;\n    }\n\n    const participantIds = [match.participant1Id, match.participant2Id];\n    const consentRows = await this.db\n      .select({\n        participantId: schema.tournamentRosters.participantId,\n        rankingConsentAt: schema.tournamentRosters.rankingConsentAt,\n      })\n      .from(schema.tournamentRosters)\n      .where(inArray(schema.tournamentRosters.participantId, participantIds));\n\n    const guestRows = await this.db\n      .select({ participantId: schema.tournamentGuestRosters.participantId })\n      .from(schema.tournamentGuestRosters)\n      .where(inArray(schema.tournamentGuestRosters.participantId, participantIds));\n    if (consentRows.length === 0 || guestRows.length > 0) return false;\n\n    const completedAt = match.completedAt.getTime();\n    return participantIds.every((participantId) => {\n      const rows = consentRows.filter(\n        (row) => row.participantId === participantId,\n      );\n      return (\n        rows.length > 0 &&\n        rows.every(\n          (row) =>\n            row.rankingConsentAt !== null &&\n            row.rankingConsentAt.getTime() <= completedAt,\n        )\n      );\n    });\n  }"}

