219:            consentNotifiedAt: schema.tournamentRosters.consentNotifiedAt,
220:            consentedAt: schema.tournamentRosters.rankingConsentAt,
221:            joinedAt: schema.tournamentRosters.joinedAt,
222:            rosterStatus: schema.tournamentRosters.status,
223:          })
