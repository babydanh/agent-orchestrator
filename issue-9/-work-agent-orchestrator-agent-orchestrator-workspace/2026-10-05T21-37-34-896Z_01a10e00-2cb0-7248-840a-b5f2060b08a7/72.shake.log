1308:      .from(schema.users)
1309:      .leftJoin(schema.profiles, eq(schema.profiles.userId, schema.users.id))
1310:      .where(
1311:        and(
1312:          inArray(schema.users.id, selectedIds),
1313:          eq(schema.users.isMock, false),
1314:          isNull(schema.users.deletedAt),
1315:        ),
1316:      );
1317:    if (rows.length !== selectedIds.length) {
1318:      throw new ConflictException('Một hoặc nhiều ứng viên không còn khả dụng.');
1319:    }
1320:    const namesById = new Map(
1321:      rows.map((row) => [
1322:        row.userId,
1323:        row.displayName?.trim() || 'Vận động viên',
1324:      ]),
1325:    );
