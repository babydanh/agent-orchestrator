{"resolved_from_name":"@src/modules/tournaments/services/ranking-consent.service.ts:113","handle":"sym#e94457a0d667b9ce@9e2511b62ad130a3","name":"sendDueReminders","kind":"method","file":"src/modules/tournaments/services/ranking-consent.service.ts","line":113,"start_line":1,"end_line":63,"total_lines":63,"partial":false,"bytes":2024,"body":"async sendDueReminders(): Promise<number> {\n    if (!this.mailService) return 0;\n    const now = new Date();\n\n    // Keep rows whose notifiedAt is NULL: failed delivery must not consume an\n    // attempt or silently end all reminders.\n    const due = await this.db\n      .select({\n        id: schema.tournamentRosters.id,\n        attempts: schema.tournamentRosters.consentNotifiedCount,\n        consentNotifiedAt: schema.tournamentRosters.consentNotifiedAt,\n        joinedAt: schema.tournamentRosters.joinedAt,\n      })\n      .from(schema.tournamentRosters)\n      .innerJoin(\n        schema.users,\n        eq(schema.users.id, schema.tournamentRosters.userId),\n      )\n      .innerJoin(\n        schema.tournamentParticipants,\n        eq(\n          schema.tournamentParticipants.id,\n          schema.tournamentRosters.participantId,\n        ),\n      )\n      .innerJoin(\n        schema.tournaments,\n        eq(schema.tournaments.id, schema.tournamentParticipants.tournamentId),\n      )\n      .where(\n        and(\n          isNull(schema.tournamentRosters.rankingConsentAt),\n          eq(schema.tournamentRosters.status, 'ACTIVE'),\n          inArray(\n            schema.tournamentParticipants.teamStatus,\n            [...CAPACITY_RESERVING_TEAM_STATUSES],\n          ),\n          eq(schema.users.isEmailVerified, true),\n          isNull(schema.users.deletedAt),\n          eq(schema.tournaments.isRanked, true),\n          isNull(schema.tournaments.deletedAt),\n          notInArray(schema.tournaments.status, [\n            'COMPLETED',\n            'CANCELLED',\n          ]),\n          or(\n            isNull(schema.tournaments.endDate),\n            gt(schema.tournaments.endDate, now),\n          ),\n          lt(\n            schema.tournamentRosters.consentNotifiedCount,\n            CONSENT_MAX_NOTIFICATIONS,\n          ),\n        ),\n      );\n\n    let sent = 0;\n    for (const row of due) {\n      if (!this.isReminderDue(row, now)) continue;\n      if (await this.dispatch(row.id, 'REMINDER')) sent += 1;\n    }\n    return sent;\n  }"}

