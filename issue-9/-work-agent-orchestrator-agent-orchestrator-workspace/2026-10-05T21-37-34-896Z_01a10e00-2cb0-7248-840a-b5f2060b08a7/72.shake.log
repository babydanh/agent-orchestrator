1218:  ): Promise<string[]> {
1219:    if (!communityId || selectedIds?.length === 0) return [];
1220:    const members = await executor
1221:      .select({ userId: schema.communityMembers.userId })
1222:      .from(schema.communityMembers)
1223:      .where(
1224:        and(
1225:          eq(schema.communityMembers.communityId, communityId),
1226:          eq(schema.communityMembers.status, 'JOINED'),
1227:          selectedIds?.length
1228:            ? inArray(schema.communityMembers.userId, selectedIds)
1229:            : undefined,
