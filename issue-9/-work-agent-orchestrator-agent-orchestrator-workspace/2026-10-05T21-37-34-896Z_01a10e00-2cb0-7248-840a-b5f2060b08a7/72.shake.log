1392:  private assertRosterComposition(
1393:    tournament: AdminTournament,
1394:    matchType: string | null,
1395:    players: ResolvedAddAthlete[],
1396:  ): void {
1397:    const football = resolveFootballTeamConfig(tournament.tournamentConfig);
1398:    if (matchType === 'DOUBLES' || matchType === 'MIXED_DOUBLES') {
1399:      if (
1400:        players.length !== 2 ||
1401:        players.some((player) => player.role !== 'MAIN')
1402:      ) {
1403:        throw new BadRequestException('Giải đôi cần đúng hai VĐV chính.');
1404:      }
1405:      return;
1406:    }
1407:    if (football.isTeamSport) {
1408:      const mainCount = players.filter((player) => player.role === 'MAIN').length;
1409:      const reserveCount = players.length - mainCount;
1410:      if (
1411:        mainCount !== football.mainSize ||
1412:        reserveCount > football.maxReserve ||
1413:        players.length > football.maxTotalSize
1414:      ) {
1415:        throw new BadRequestException('Danh sách đội không khớp cấu hình đội bóng.');
1416:      }
1417:      return;
1418:    }
1419:    if (players.length !== 1 || players[0]?.role !== 'MAIN') {
1420:      throw new BadRequestException('Giải đơn cần đúng một VĐV chính.');
1421:    }
1422:  }
