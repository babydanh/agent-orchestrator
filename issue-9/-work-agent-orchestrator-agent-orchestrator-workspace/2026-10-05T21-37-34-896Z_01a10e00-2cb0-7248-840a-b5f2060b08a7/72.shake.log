22: * Tự động nhắc tối đa 3 lần rồi dừng; không có nút gửi lại phía ban tổ chức.
23: */
24:export const CONSENT_MAX_NOTIFICATIONS = 3;
25:
26:/** Số giờ chờ trước mỗi lần nhắc, tính từ lần gửi gần nhất. */
27:export const CONSENT_REMINDER_DELAYS_HOURS = [24, 72] as const;
