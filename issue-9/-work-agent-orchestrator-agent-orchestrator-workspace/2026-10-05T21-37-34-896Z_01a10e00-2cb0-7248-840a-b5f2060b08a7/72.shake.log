nnerJoin(\n        schema.tournamentParticipants,\n        eq(\n          schema.tournamentParticipants.id,\n          schema.tournamentRosters.participantId,\n        ),\n      )\n      .where(\n        and(\n          eq(schema.tournamentRosters.userId, schema.users.id),\n          eq(schema.tournamentRosters.status, 'ACTIVE'),\n          eq(schema.tournamentParticipants.tournamentId, tournamentId),\n          inArray(\n            schema.tournamentParticipants.teamStatus,\n            [...CAPACITY_RESERVING_TEAM_STATUSES],\n          ),\n          dto.divisionId\n            ? eq(\n                schema.tournamentParticipants.tournamentDivisionId,\n                dto.divisionId,\n              )\n            : undefined,\n        ),\n      );\n    const rows = await this.db\n      .select({\n        userId: schema.users.id,\n        displayName: schema.profiles.fullName,\n        avatarUrl: schema.profiles.avatarUrl,\n      })\n      .from(schema.profiles)\n      .innerJoin(schema.users, eq(schema.users.id, schema.profiles.userId))\n      .where(\n        and(\n          inArray(schema.users.id, sourceUserIds),\n          eq(schema.users.isMock, false),\n          isNull(schema.users.deletedAt),\n          notExists(activeRosterQuery),\n          search ? ilike(schema.profiles.fullName, `%${search}%`) : undefined,\n          cursor\n            ? or(\n                gt(schema.profiles.fullName, cursor.displayName),\n                and(\n                  eq(schema.profiles.fullName, cursor.displayName),\n                  gt(schema.users.id, cursor.userId),\n                ),\n              )\n            : undefined,\n        ),\n      )\n      .orderBy(asc(schema.profiles.fullName), asc(schema.users.id))\n      .limit(limit + 1);\n\n    const hasMore = rows.length > limit;\n    const items = rows.slice(0, limit).map((row) => ({\n      ...row,\n      source: dto.source,\n    }));\n    const last = items[items.length - 1];\n    return {\n      items,\n      nextCursor:\n        hasMore && last\n          ? CursorPaginationHelper.encodeCursor({\n              displayName: last.displayName,\n              divisionId: dto.divisionId ?? null,\n              search,\n              source: dto.source,\n              userId: last.userId,\n            })\n          : null,\n    };\n  }\n\n  async addAthletes(\n    tournamentId: string,\n    userId: string,\n    systemRoles: string[],\n    dto: AddAthletesDto,\n    broadcast: RegistrationChanged,\n  ) {\n    const tournament = await this.getManagedAddableTournament(\n      tournamentId,\n      userId,\n      systemRoles,\n    );\n    this.assertAddAthletePayload(dto);\n\n    const created = await this.db.transaction(async (tx) => {\n      await lockCapacityOwner(tx, {\n        tournamentId,\n        divisionId: dto.divisionId,\n      });\n      const tournament = await this.getTransactionalTournament(tx, tournamentId);\n      this.assertAddableTournament(tournament);\n      const division = dto.divisionId\n        ? await this.getTournamentDivision(tx, tournamentId, dto.divisionId)\n        : null;\n      const players = await this.resolveAddAthletes(\n        tx,\n        tournament,\n        userId,\n        dto,\n      );\n      const matchType = division?.matchType ?? tournament.matchType;\n      this.assertRosterComposition(\n        tournament,\n        matchType,\n        players,\n      );\n      await this.assertNoExistingRoster(\n        tx,\n        tournamentId,\n        dto.divisionId ?? null,\n        players,\n      );\n      const capacity = await readEffectiveCapacity(tx, {\n        tournamentId,\n        divisionId: dto.divisionId,\n      });\n      assertDivisionHasRoom(\n        capacity,\n        matchType,\n        players.length,\n        { tournamentConfig: tournament.tournamentConfig },\n      );\n\n      const entryFee = await this.tournamentPaymentRepository\n        .resolveDivisionEntryFee(tx, tournament, dto.divisionId)\n        .then(Number);\n      if (!Number.isFinite(entryFee) || entryFee < 0) {\n        throw new BadRequestException('Lệ phí giải đấu không hợp lệ.');\n      }\n      const [participant] = await tx\n        .insert(schema.tournamentParticipants)\n        .values({\n          tournamentId,\n          tournamentDivisionId: dto.divisionId ?? null,\n          registeredBy: userId,\n          teamName:\n            dto.teamName?.trim() ||\n            players.map((player) => player.displayName).join(' / '),\n          teamStatus: 'COMPLETE',\n          rankingConsent: Boolean(tournament.isRanked),\n          organizerNote: dto.organizerNote?.trim() || null,\n          isPaid: entryFee === 0,\n          isPresent: false,\n          entryFeeAtRegistration: entryFee.toFixed(2),\n          isMock: false,\n          isWildcard: false,\n        })\n        .returning();\n      if (!participant) {\n        throw new BadRequestException('Không thể thêm VĐV vào giải đấu.');\n      }\n\n      const accountPlayers = players.filter(\n        (player): player is ResolvedAddAthlete & { userId: string } =>\n          player.userId !== null,\n      );\n      const rosters =\n        accountPlayers.length > 0\n          ? await tx\n              .insert(schema.tournamentRosters)\n              .values(\n                accountPlayers.map((player) => ({\n                  participantId: participant.id,\n                  userId: player.userId,\n                  role: player.role,\n                  status: 'ACTIVE',\n                })),\n              )\n              .returning({\n                id: schema.tournamentRosters.id,\n                userId: schema.tournamentRosters.userId,\n              })\n          : [];\n\n      const pendingGuests = await this.insertGuestRosters(\n        tx,\n        participant.id,\n        players.filter((player) => player.userId === null),\n      );\n      await this.auditService.logCreate(\n        tx,\n        userId,\n        'tournament_participants',\n        participant.id,\n        participant,\n      );\n      for (const roster of rosters) {\n        await this.auditService.logCreate(\n          tx,\n          userId,\n          'tournament_rosters',\n          roster.id,\n          {\n            participantId: participant.id,\n            userId: roster.userId,\n          },\n        );\n      }\n      for (const guest of pendingGuests) {\n        await this.auditService.logCreate(\n          tx,\n          userId,\n          'tournament_guest_rosters',\n          guest.guestId,\n          {\n            participantId: participant.id,\n            role: guest.role,\n            claimExpiresAt: guest.claimExpiresAt,\n          },\n        );\n      }\n      return { participant, rosters, pendingGuests };\n    });\n\n    const claims = await this.deliverGuestClaims(\n      created.pendingGuests,\n      tournamentId,\n      tournament.name,\n    );\n    await this.notifyAddedAccounts(\n      created.rosters,\n      tournamentId,\n      created.participant.teamName,\n      created.participant.tournamentDivisionId,\n    );\n    broadcast(tournamentId, {\n      participantId: created.participant.id,\n      divisionId: created.participant.tournamentDivisionId,\n      action: 'PARTICIPANT_ADDED',\n    });\n    return { participant: created.participant, claims };\n  }\n\n  async claimGuestRoster(\n    tournamentId: string,\n    guestId: string,\n    userId: string,\n    claimToken: string,\n    broadcast: RegistrationChanged,\n  ) {\n    const claimHash = createHash('sha256').update(claimToken).digest('hex');\n    const claimed = await this.db.transaction(async (tx) => {\n      const [user] = await tx\n        .select({\n          email: schema.users.email,\n          isEmailVerified: schema.users.isEmailVerified,\n          deletedAt: schema.users.deletedAt,\n        })\n        .from(schema.users)\n        .where(eq(schema.users.id, userId))\n        .for('share')\n        .limit(1);\n      if (!user || !user.isEmailVerified || user.deletedAt) {\n        throw new ForbiddenException('Cần email đã xác minh để nhận suất.');\n      }\n\n      const [guest] = await tx\n        .select()\n        .from(schema.tournamentGuestRosters)\n        .where(eq(schema.tournamentGuestRosters.id, guestId))\n        .for('update')\n        .limit(1);\n      if (\n        !guest ||\n        guest.claimExpiresAt <= new Date() ||\n        !isMatchingClaimHash(guest.claimTokenHash, claimHash)\n      ) {\n        throw new ConflictException('Mã nhận suất không hợp lệ hoặc đã hết hạn.');\n      }\n      if (\n        guest.contactEmail &&\n        normalizeEmail(guest.contactEmail) !== normalizeEmail(user.email)\n      ) {\n        throw new ForbiddenException(\n          'Tài khoản phải dùng email đã nhận lời mời.',\n        );\n      }\n\n      const [context] = await tx\n        .select({\n          participantId: schema.tournamentParticipants.id,\n          tournamentId: schema.tournamentParticipants.tournamentId,\n          divisionId: schema.tournamentParticipants.tournamentDivisionId,\n          participantStatus: schema.tournamentParticipants.teamStatus,\n          tournamentName: schema.tournaments.name,\n          tournamentStatus: schema.tournaments.status,\n          tournamentEndDate: schema.tournaments.endDate,\n          tournamentDeletedAt: schema.tournaments.deletedAt,\n          isRanked: schema.tournaments.isRanked,\n        })\n        .from(schema.tournamentParticipants)\n        .innerJoin(\n          schema.tournaments,\n          eq(\n            schema.tournaments.id,\n            schema.tournamentParticipants.tournamentId,\n          ),\n        )\n        .where(eq(schema.tournamentParticipants.id, guest.participantId))\n        .for('share')\n        .limit(1);\n      this.assertClaimContext(context, tournamentId);\n      await this.assertNoExistingRoster(\n        tx,\n        tournamentId,\n        null,\n        [{ userId, displayName: '', email: null, phone: null, role: guest.role }