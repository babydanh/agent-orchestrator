{"resolved_from_name":"@src/modules/tournaments/services/tournament-participant-admin.service.ts:225","handle":"sym#e569c1581ff926e4@9b90e84f78c6a404","name":"addAthletes","kind":"method","file":"src/modules/tournaments/services/tournament-participant-admin.service.ts","line":225,"start_line":1,"end_line":162,"total_lines":162,"partial":false,"bytes":4854,"body":"async addAthletes(\n    tournamentId: string,\n    userId: string,\n    systemRoles: string[],\n    dto: AddAthletesDto,\n    broadcast: RegistrationChanged,\n  ) {\n    const tournament = await this.getManagedAddableTournament(\n      tournamentId,\n      userId,\n      systemRoles,\n    );\n    this.assertAddAthletePayload(dto);\n\n    const created = await this.db.transaction(async (tx) => {\n      await lockCapacityOwner(tx, {\n        tournamentId,\n        divisionId: dto.divisionId,\n      });\n      const tournament = await this.getTransactionalTournament(tx, tournamentId);\n      this.assertAddableTournament(tournament);\n      const division = dto.divisionId\n        ? await this.getTournamentDivision(tx, tournamentId, dto.divisionId)\n        : null;\n      const players = await this.resolveAddAthletes(\n        tx,\n        tournament,\n        userId,\n        dto,\n      );\n      const matchType = division?.matchType ?? tournament.matchType;\n      this.assertRosterComposition(\n        tournament,\n        matchType,\n        players,\n      );\n      await this.assertNoExistingRoster(\n        tx,\n        tournamentId,\n        dto.divisionId ?? null,\n        players,\n      );\n      const capacity = await readEffectiveCapacity(tx, {\n        tournamentId,\n        divisionId: dto.divisionId,\n      });\n      assertDivisionHasRoom(\n        capacity,\n        matchType,\n        players.length,\n        { tournamentConfig: tournament.tournamentConfig },\n      );\n\n      const entryFee = await this.tournamentPaymentRepository\n        .resolveDivisionEntryFee(tx, tournament, dto.divisionId)\n        .then(Number);\n      if (!Number.isFinite(entryFee) || entryFee < 0) {\n        throw new BadRequestException('Lệ phí giải đấu không hợp lệ.');\n      }\n      const [participant] = await tx\n        .insert(schema.tournamentParticipants)\n        .values({\n          tournamentId,\n          tournamentDivisionId: dto.divisionId ?? null,\n          registeredBy: userId,\n          teamName:\n            dto.teamName?.trim() ||\n            players.map((player) => player.displayName).join(' / '),\n          teamStatus: 'COMPLETE',\n          rankingConsent: Boolean(tournament.isRanked),\n          organizerNote: dto.organizerNote?.trim() || null,\n          isPaid: entryFee === 0,\n          isPresent: false,\n          entryFeeAtRegistration: entryFee.toFixed(2),\n          isMock: false,\n          isWildcard: false,\n        })\n        .returning();\n      if (!participant) {\n        throw new BadRequestException('Không thể thêm VĐV vào giải đấu.');\n      }\n\n      const accountPlayers = players.filter(\n        (player): player is ResolvedAddAthlete & { userId: string } =>\n          player.userId !== null,\n      );\n      const rosters =\n        accountPlayers.length > 0\n          ? await tx\n              .insert(schema.tournamentRosters)\n              .values(\n                accountPlayers.map((player) => ({\n                  participantId: participant.id,\n                  userId: player.userId,\n                  role: player.role,\n                  status: 'ACTIVE',\n                })),\n              )\n              .returning({\n                id: schema.tournamentRosters.id,\n                userId: schema.tournamentRosters.userId,\n              })\n          : [];\n\n      const pendingGuests = await this.insertGuestRosters(\n        tx,\n        participant.id,\n        players.filter((player) => player.userId === null),\n      );\n      await this.auditService.logCreate(\n        tx,\n        userId,\n        'tournament_participants',\n        participant.id,\n        participant,\n      );\n      for (const roster of rosters) {\n        await this.auditService.logCreate(\n          tx,\n          userId,\n          'tournament_rosters',\n          roster.id,\n          {\n            participantId: participant.id,\n            userId: roster.userId,\n          },\n        );\n      }\n      for (const guest of pendingGuests) {\n        await this.auditService.logCreate(\n          tx,\n          userId,\n          'tournament_guest_rosters',\n          guest.guestId,\n          {\n            participantId: participant.id,\n            role: guest.role,\n            claimExpiresAt: guest.claimExpiresAt,\n          },\n        );\n      }\n      return { participant, rosters, pendingGuests };\n    });\n\n    const claims = await this.deliverGuestClaims(\n      created.pendingGuests,\n      tournamentId,\n      tournament.name,\n    );\n    await this.notifyAddedAccounts(\n      created.rosters,\n      tournamentId,\n      created.participant.teamName,\n      created.participant.tournamentDivisionId,\n    );\n    broadcast(tournamentId, {\n      participantId: created.participant.id,\n      divisionId: created.participant.tournamentDivisionId,\n      action: 'PARTICIPANT_ADDED',\n    });\n    return { participant: created.participant, claims };\n  }"}

