28:    const chain: Record<string, unknown> = {};
29:    const self = () => chain;
30:    chain.select = jest.fn(self);
31:    chain.from = jest.fn(self);
32:    chain.innerJoin = jest.fn(self);
33:    chain.where = jest.fn(self);
34:    chain.limit = jest.fn(self);
35:    chain.update = jest.fn(self);
36:    chain.set = jest.fn(self);
37:    chain.then = (resolve: (value: unknown) => unknown) =>
38:      Promise.resolve().then(() => {
39:        const value = call === 0 ? candidates : [detailRow()];
40:        call += 1;
41:        resolve(value);
42:      });
