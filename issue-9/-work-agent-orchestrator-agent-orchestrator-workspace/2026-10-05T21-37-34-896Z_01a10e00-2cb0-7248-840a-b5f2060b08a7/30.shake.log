29:    // 2. Actual Score
30:    const actual = isWin ? 1.0 : 0.0;
31:
32:    // 3. K-Factor (continuous formula thay vì step)
33:    // matchesPlayed = 0 → K=40, 10→20, 30→10, 100→~3.6
34:    const K = Math.max(4, Math.round(40 / (1 + matchesPlayed / 10)));
35:
36:    // 4. Win Streak Bonus (chỉ cho bên thắng)
37:    let streakMultiplier = 1.0;
38:    if (isWin) {
39:      if (winStreak >= 7) {
40:        streakMultiplier = 1.3;
41:      } else if (winStreak >= 5) {
42:        streakMultiplier = 1.2;
43:      } else if (winStreak >= 3) {
44:        streakMultiplier = 1.1;
45:      }
46:    }
47:
48:    // 5. Score Factor Modifier — hiệu số điểm từng set
49:    //    Công thức: scoreRatio = winnerPoints / (winnerPoints + loserPoints)
50:    //    scoreRatio ~0.5 (sát nút) → scoreFactor ~1.0
51:    //    scoreRatio ~0.65 (áp đảo) → scoreFactor ~1.18
52:    //    scoreRatio ~0.78 (hủy diệt) → scoreFactor ~1.34
53:    //    Decay: người mới (<10 trận) chịu ảnh hưởng 100%, người cũ giảm dần
54:    let scoreFactor = 1.0;
55:    if (scoreRatio !== undefined && scoreRatio > 0) {
56:      const clampedRatio = Math.min(0.85, Math.max(0.5, scoreRatio));
57:      const rawMultiplier = 1.0 + (clampedRatio - 0.5) * 1.2;
58:      // Decay dần theo số trận: mới đánh → full effect, 25+ trận → chỉ 20%
59:      const decayFactor = Math.max(0.2, 1 - matchesPlayed / 25);
60:      scoreFactor = 1.0 + (rawMultiplier - 1.0) * decayFactor;
61:    }
62:
63:    // 6. Upset Bonus / Penalty (thắng/thua bất ngờ khi chênh lệch ELO)
64:    const eloDiff = opponentElo - playerElo;
65:    let upsetModifier = 0;
66:
67:    if (isWin) {
68:      if (eloDiff >= 400) {
69:        upsetModifier = 10; // Thắng đối thủ vượt trội 400+ ELO
70:      } else if (eloDiff >= 200) {
71:        upsetModifier = 5;  // Thắng đối thủ mạnh hơn 200+ ELO
72:      }
73:    } else {
74:      if (eloDiff <= -200) {
75:        upsetModifier = -3; // Thua đối thủ kém 200+ ELO
76:      }
77:    }
78:
79:    // 7. Tính toán ELO cuối cùng
80:    const rawChange = K * streakMultiplier * scoreFactor * (actual - expected) + upsetModifier;
81:    const newElo = Math.max(100, Math.round(playerElo + rawChange));
82:    const changedPoints = newElo - playerElo;
83:    const newWinStreak = isWin ? winStreak + 1 : 0;
84:    const newPeakElo = peakElo ? Math.max(peakElo, newElo) : newElo;
85:
86:    return {
87:      newElo,
88:      changedPoints,
89:      newWinStreak,
90:      newPeakElo,
91:    };
92:  }
