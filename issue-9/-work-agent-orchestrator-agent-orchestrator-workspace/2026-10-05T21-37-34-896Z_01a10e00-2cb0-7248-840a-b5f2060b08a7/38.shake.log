1:import { BadRequestException, Inject, Injectable } from '@nestjs/common';
2:import { PG_CONNECTION } from '../../../database/database.module';
3:import type { AppDb, AppDbOrTx } from '../../../database/db.types';
4:import * as schema from '../../../database/schema';
5:import { and, count, eq, inArray } from 'drizzle-orm';
6:import {
7:  CAPACITY_RESERVING_TEAM_STATUSES,
8:  calculateOccupiedCapacity,
9:  calculateRequestedTeamSlots,
10:  type CapacityEntry,
11:} from '../utils/tournament-participant-status';
12:import {
13:  IMPORT_SOURCES,
14:  type ImportSource,
15:} from '../dto/roster-import.dto';
16:
17:/** Capacity is always expressed in team slots; `maxParticipants` stays a team limit. */
18:export interface TournamentCapacitySnapshot {
19:  occupiedTeamSlots: number;
20:  occupiedMemberSlots: number;
21:  maxTeamSlots: number | null;
22:  isFull: boolean;
23:}
24:
25:/** The subset a caller needs to decide whether a claim fits. */
26:export type DivisionCapacityLimit = Pick<
27:  TournamentCapacitySnapshot,
28:  'occupiedTeamSlots' | 'maxTeamSlots' | 'isFull'
29:>;
30:
31:/** Batched occupancy keyed by division id or tournament id. */
32:export type CapacityByScopeId = Record<string, TournamentCapacitySnapshot>;
33:
34:export interface CapacityOwnerContext {
35:  tournamentConfig?: unknown;
36:}
37:
38:/**
39: * Single source of truth for tournament/division occupancy.
40: *
41: * Doubles pairing divisions consume one team slot per two active roster
42: * members, so a single unpaired member occupies half a team. Singles and team
43: * sports keep one participant/team record per slot. Only capacity-reserving
44: * statuses count; waitlisted and terminal rows release their seats.
45: */
46:
47:/**
48: * Reject a capacity claim that would not fit `requestedTeamSlots`.
49: *
50: * Uncapped scopes never block, and a non-positive request consumes nothing
51: * (an athlete appended to an already-counted team row must not re-claim that
52: * row's slot).
53: */
54:export function assertCapacityHasRoom(
55:  capacity: DivisionCapacityLimit,
56:  requestedTeamSlots: number,
57:): void {
58:  if (capacity.maxTeamSlots == null) return;
59:  if (!(requestedTeamSlots > 0)) return;
60:
61:  if (capacity.occupiedTeamSlots + requestedTeamSlots > capacity.maxTeamSlots) {
62:    throw new BadRequestException('Nội dung thi đấu đã đầy.');
63:  }
64:}
65:
66:/**
67: * Reject a capacity claim that would not fit.
68: *
69: * Doubles/mixed doubles add `requestedMemberCount / 2` team slots; every other
70: * unit adds one whole team for the new registration row.
71: */
72:export function assertDivisionHasRoom(
73:  capacity: DivisionCapacityLimit,
74:  matchType: string | null | undefined,
75:  requestedMemberCount: number,
76:  context?: CapacityOwnerContext,
77:): void {
78:  assertCapacityHasRoom(
79:    capacity,
80:    calculateRequestedTeamSlots(matchType, requestedMemberCount, context),
81:  );
82:}
