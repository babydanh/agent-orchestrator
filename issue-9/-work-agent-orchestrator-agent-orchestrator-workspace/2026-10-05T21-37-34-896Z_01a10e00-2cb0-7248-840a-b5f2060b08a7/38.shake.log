17:/**
18: * Validate the persisted tournamentConfig boundary before registration starts.
19: * The DTO intentionally keeps tournamentConfig extensible for other sports,
20: * so football-specific invariants belong here instead of being trusted only
21: * by the web/app selectors.
22: */
23:export function assertValidFootballTeamConfig(
24:  input: unknown,
25:  options: FootballTeamConfigValidationOptions = {},
26:): void {
27:  if (!input || typeof input !== 'object' || Array.isArray(input)) {
28:    throw new BadRequestException('Cấu hình bóng đá không hợp lệ.');
29:  }
30:
31:  const record = input as Record<string, unknown>;
32:  const rawTeamSize = record.teamSize;
33:  const rawMinTeamSize = record.minTeamSize;
34:  const teamSize = rawTeamSize === undefined ? undefined : Number(rawTeamSize);
35:  const minTeamSize = rawMinTeamSize === undefined ? undefined : Number(rawMinTeamSize);
36:  const isAllowedSize = (value: number | undefined): value is FootballTeamSize =>
37:    value !== undefined && Number.isInteger(value) && FOOTBALL_TEAM_SIZES.includes(value as FootballTeamSize);
38:
39:  if (options.requireTeamSize && !isAllowedSize(teamSize)) {
40:    throw new BadRequestException('Bóng đá phải chọn sân 5, 7 hoặc 11 người.');
41:  }
42:  if (teamSize !== undefined && !isAllowedSize(teamSize)) {
43:    throw new BadRequestException('teamSize bóng đá chỉ nhận 5, 7 hoặc 11.');
44:  }
45:  if (minTeamSize !== undefined && !isAllowedSize(minTeamSize)) {
46:    throw new BadRequestException('minTeamSize bóng đá chỉ nhận 5, 7 hoặc 11.');
47:  }
48:  if (teamSize !== undefined && minTeamSize !== undefined && teamSize !== minTeamSize) {
49:    throw new BadRequestException('teamSize và minTeamSize phải cùng một cỡ sân.');
50:  }
51:
52:  if (record.teamSizeOptions !== undefined) {
53:    if (!Array.isArray(record.teamSizeOptions) || record.teamSizeOptions.length === 0) {
54:      throw new BadRequestException('teamSizeOptions bóng đá không được rỗng.');
55:    }
56:    const optionsAreValid = record.teamSizeOptions.every((value) => isAllowedSize(Number(value)));
57:    if (!optionsAreValid || (teamSize !== undefined && !record.teamSizeOptions.some((value) => Number(value) === teamSize))) {
58:      throw new BadRequestException('teamSizeOptions bóng đá không khớp cỡ sân đã chọn.');
59:    }
60:  }
61:
62:  const maxReserve = record.maxReserve === undefined ? 0 : Number(record.maxReserve);
63:  if (!Number.isInteger(maxReserve) || maxReserve < 0 || maxReserve > 20) {
64:    throw new BadRequestException('Số cầu thủ dự bị phải từ 0 đến 20.');
65:  }
66:  if (record.allowReserve === false && maxReserve > 0) {
67:    throw new BadRequestException('Không cho phép dự bị thì maxReserve phải bằng 0.');
68:  }
69:
70:  const mainSize = teamSize ?? minTeamSize;
71:  const maxTeamSize = record.maxTeamSize === undefined ? undefined : Number(record.maxTeamSize);
72:  if (maxTeamSize !== undefined) {
73:    if (!Number.isInteger(maxTeamSize) || maxTeamSize < 0 || (mainSize !== undefined && maxTeamSize < mainSize)) {
74:      throw new BadRequestException('maxTeamSize phải đủ số cầu thủ chính của sân.');
75:    }
76:    if (mainSize !== undefined && maxTeamSize - mainSize < maxReserve) {
77:      throw new BadRequestException('maxTeamSize không đủ chỗ cho số cầu thủ dự bị.');
78:    }
79:  }
80:
81:  for (const key of ['twoLegged', 'awayGoalsRule', 'penaltyShootout', 'allowDraw']) {
82:    if (record[key] !== undefined && typeof record[key] !== 'boolean') {
83:      throw new BadRequestException(`${key} bóng đá phải là boolean.`);
84:    }
85:  }
86:}
