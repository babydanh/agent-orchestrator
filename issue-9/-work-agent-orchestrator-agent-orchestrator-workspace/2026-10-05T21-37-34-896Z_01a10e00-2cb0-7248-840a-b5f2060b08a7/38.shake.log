7:  async assertEntryFeeAllowed(entryFee: number | null | undefined) {
8:    if (entryFee === null || entryFee === undefined || entryFee === 0) {
9:      return;
10:    }
11:
12:    // PUBLIC tournaments may use any valid non-negative VND integer. The
13:    // 100,000 VND value belongs to platform-fee calculation, not this guard.
14:    if (!Number.isSafeInteger(entryFee) || entryFee < 0) {
15:      throw new BadRequestException(
16:        'Lệ phí tham gia phải là số nguyên VND không âm.',
17:      );
18:    }
19:
20:    const feesConfig = await this.tournamentsRepository.getFeesConfig();
21:    if (feesConfig.allowEntryFees === false) {
22:      throw new BadRequestException(
23:        'Hệ thống hiện không cho phép ban tổ chức đặt lệ phí đăng ký. Vui lòng để lệ phí là 0đ.',
24:      );
25:    }
26:  }
27:
28:  resolveDivisionEntryFeeMutation(dto: {
29:    entryFee?: number | null;
30:    entryFeeOverrideEnabled?: boolean;
31:  }) {
32:    const hasMutation =
33:      dto.entryFeeOverrideEnabled !== undefined || dto.entryFee !== undefined;
34:    if (!hasMutation) {
35:      return { hasMutation: false, enabled: false, fee: null } as const;
36:    }
37:
38:    const enabled =
39:      dto.entryFeeOverrideEnabled ??
40:      (dto.entryFee !== undefined && dto.entryFee !== null && dto.entryFee > 0);
41:    const fee = enabled ? dto.entryFee : null;
42:    if (enabled && fee == null) {
43:      throw new BadRequestException(
44:        'Vui lòng nhập lệ phí riêng hoặc tắt tùy chọn lệ phí riêng.',
45:      );
46:    }
47:
48:    return { hasMutation: true, enabled, fee } as const;
49:  }
50:  async getFeesConfig() {
51:    return this.tournamentsRepository.getFeesConfig();
52:  }
53:
54:  async getPublishFee(
55:    tournamentType?: string | null,
56:    isRanked?: boolean | null,
57:  ) {
58:    const fees = await this.getFeesConfig();
59:    if (tournamentType === 'CLUB') return fees.feeClub;
60:    return isRanked ? fees.feePublicRanked : fees.feePublicUnranked;
