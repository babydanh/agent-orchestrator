84:@Injectable()
85:export class TournamentCapacityService {
86:  constructor(@Inject(PG_CONNECTION) private readonly db: AppDb) {}
87:
88:  async getDivisionCapacity(
89:    divisionId: string,
90:    options?: { executor?: AppDbOrTx },
91:  ): Promise<TournamentCapacitySnapshot> {
92:    return readDivisionCapacity(options?.executor ?? this.db, divisionId);
93:  }
94:
95:  /** Batched occupancy for every division; avoids one read per division. */
96:  async getDivisionCapacities(
97:    tournamentId: string,
98:    options?: { executor?: AppDbOrTx },
99:  ): Promise<CapacityByScopeId> {
100:    return readDivisionCapacities(options?.executor ?? this.db, tournamentId);
101:  }
102:
103:  async getTournamentCapacity(
104:    tournamentId: string,
105:    options?: { executor?: AppDbOrTx },
106:  ): Promise<TournamentCapacitySnapshot> {
107:    return readTournamentCapacity(options?.executor ?? this.db, tournamentId);
108:  }
109:
110:  /** Batched occupancy for a page of tournaments; avoids one read per item. */
111:  async getTournamentCapacities(
112:    tournamentIds: readonly string[],
113:    options?: { executor?: AppDbOrTx },
114:  ): Promise<CapacityByScopeId> {
115:    return readTournamentCapacities(
116:      options?.executor ?? this.db,
117:      tournamentIds,
118:    );
119:  }
120:}
121:
122:const EMPTY_CAPACITY: TournamentCapacitySnapshot = {
123:  occupiedTeamSlots: 0,
124:  occupiedMemberSlots: 0,
125:  maxTeamSlots: null,
126:  isFull: false,
127:};
128:
129:/** A row that owns a capacity limit, plus the config that picks the unit. */
130:interface CapacityOwnerRow {
131:  id: string;
132:  tournamentId: string | null;
133:  matchType: string | null;
134:  maxParticipants: number | null;
135:  tournamentConfig: unknown;
136:}
137:
138:/**
139: * Serialize a capacity claim on the rows that own the limit.
140: *
141: * Two concurrent claims would otherwise both read the same free slot and both
142: * write, overfilling the division. Lock order is always tournament -> division
143: * and callers take these locks before any participant row, so two capacity
144: * paths can never deadlock against each other.
145: */
146:export async function lockCapacityOwner(
147:  executor: AppDbOrTx,
148:  scope: { tournamentId: string; divisionId?: string | null },
149:): Promise<void> {
150:  await executor
151:    .select({ id: schema.tournaments.id })
152:    .from(schema.tournaments)
153:    .where(eq(schema.tournaments.id, scope.tournamentId))
154:    .for('update')
155:    .limit(1);
156:
157:  if (!scope.divisionId) return;
158:
159:  await executor
160:    .select({ id: schema.tournamentDivisions.id })
161:    .from(schema.tournamentDivisions)
162:    .where(eq(schema.tournamentDivisions.id, scope.divisionId))
163:    .for('update')
164:    .limit(1);
165:}
166:
167:async function selectDivisionOwners(
168:  executor: AppDbOrTx,
169:  scope: {
170:    divisionIds?: readonly string[];
171:    divisionId?: string;
172:    tournamentId?: string;
173:  },
174:): Promise<CapacityOwnerRow[]> {
175:  return await executor
176:    .select({
177:      id: schema.tournamentDivisions.id,
178:      tournamentId: schema.tournamentDivisions.tournamentId,
179:      matchType: schema.tournamentDivisions.matchType,
180:      maxParticipants: schema.tournamentDivisions.maxParticipants,
181:      tournamentConfig: schema.tournaments.tournamentConfig,
182:    })
183:    .from(schema.tournamentDivisions)
184:    .innerJoin(
185:      schema.tournaments,
186:      eq(schema.tournaments.id, schema.tournamentDivisions.tournamentId),
187:    )
188:    .where(
189:      scope.divisionIds !== undefined
190:        ? inArray(schema.tournamentDivisions.id, [...scope.divisionIds])
191:        : scope.divisionId
192:          ? eq(schema.tournamentDivisions.id, scope.divisionId)
193:          : eq(
194:              schema.tournamentDivisions.tournamentId,
195:              scope.tournamentId ?? '',
196:            ),
197:    );
198:}
199:
200:/**
201: * Division occupancy read inside an existing transaction or on the pool.
202: *
203: * Single and batch reads share {@link readCapacitiesForDivisionOwners} so a
204: * division can never project one capacity here and another there.
205: */
206:export async function readDivisionCapacity(
207:  executor: AppDbOrTx,
208:  divisionId: string,
209:): Promise<TournamentCapacitySnapshot> {
210:  const [division] = await selectDivisionOwners(executor, { divisionId });
211:  if (!division) return EMPTY_CAPACITY;
212:
213:  const snapshots = await readCapacitiesForDivisionOwners(executor, [division]);
214:  return snapshots[divisionId] ?? EMPTY_CAPACITY;
215:}
216:
217:/**
218: * Occupancy for every division of a tournament in a fixed number of queries, so
219: * a public projection never fans out into one capacity read per division.
220: */
221:export async function readDivisionCapacities(
222:  executor: AppDbOrTx,
223:  tournamentId: string,
224:): Promise<CapacityByScopeId> {
225:  return readCapacitiesForDivisionOwners(
226:    executor,
227:    await selectDivisionOwners(executor, { tournamentId }),
228:  );
229:}
230:
231:/**
232: * Occupancy for an explicit set of divisions. Read models that already hold
233: * division rows (catalog cards, community posts) use this so they never fan
234: * out into one capacity read per division.
235: */
236:export async function readCapacitiesForDivisions(
237:  executor: AppDbOrTx,
238:  divisionIds: readonly string[],
239:): Promise<CapacityByScopeId> {
240:  const ids = [...new Set(divisionIds.filter(Boolean))];
241:  if (ids.length === 0) return {};
242:
243:  return readCapacitiesForDivisionOwners(
244:    executor,
245:    await selectDivisionOwners(executor, { divisionIds: ids }),
246:  );
247:}
248:
249:async function readCapacitiesForDivisionOwners(
250:  executor: AppDbOrTx,
251:  divisions: readonly CapacityOwnerRow[],
252:): Promise<CapacityByScopeId> {
253:  const snapshots: CapacityByScopeId = {};
254:  for (const division of divisions) snapshots[division.id] = EMPTY_CAPACITY;
255:  if (divisions.length === 0) return snapshots;
256:
257:  // A division that sets no limit of its own is governed by its parent
258:  // tournament, and that cap is spent across the whole tournament. Read the
259:  // governing parents in one batched pass, then pay for parent-wide occupancy
260:  // only for the parents that actually cap — never one read per division.
261:  const parentIds = [
262:    ...new Set(
263:      divisions
264:        .filter((division) => division.maxParticipants == null)
265:        .map((division) => division.tournamentId)
266:        .filter((tournamentId): tournamentId is string => Boolean(tournamentId)),
267:    ),
268:  ];
269:  const cappedParents = parentIds.length
270:    ? (await selectTournamentOwners(executor, parentIds)).filter(
271:        (tournament) => tournament.maxParticipants != null,
272:      )
273:    : [];
274:  const parentCapacities = cappedParents.length
275:    ? buildTournamentSnapshots(
276:        cappedParents,
277:        cappedParents.map((tournament) => tournament.id),
278:        await selectParticipantEntries(executor, {
279:          tournamentIds: cappedParents.map((tournament) => tournament.id),
280:        }),
281:      )
282:    : {};
283:
284:  const inheritedSnapshot = (division: CapacityOwnerRow) =>
285:    division.maxParticipants != null || !division.tournamentId
286:      ? undefined
287:      : parentCapacities[division.tournamentId];
288:  const divisionOwned = divisions.filter(
289:    (division) => !inheritedSnapshot(division),
290:  );
291:
292:  const entriesByDivision =
293:    divisionOwned.length > 0
294:      ? groupEntriesByScope(
295:          await selectParticipantEntries(executor, {
296:            divisionIds: divisionOwned.map((division) => division.id),
297:          }),
298:        )
299:      : {};
300:
301:  for (const division of divisionOwned) {
302:    snapshots[division.id] = buildSnapshot(
303:      division,
304:      entriesByDivision[division.id] ?? [],
305:    );
306:  }
307:
308:  // An inherited division adopts its parent's snapshot whole: the same limit
309:  // and the same parent-wide occupancy, so no projection can show a division
310:  // as open while the cap that actually governs it is already spent.
311:  for (const division of divisions) {
312:    const parent = inheritedSnapshot(division);
313:    if (parent) snapshots[division.id] = { ...parent };
314:  }
315:
316:  return snapshots;
317:}
318:
319:/** Tournament-wide occupancy, the limit owner for a division-less claim. */
320:export async function readTournamentCapacity(
321:  executor: AppDbOrTx,
322:  tournamentId: string,
323:): Promise<TournamentCapacitySnapshot> {
324:  const snapshots = await readTournamentCapacities(executor, [tournamentId]);
325:  return snapshots[tournamentId] ?? EMPTY_CAPACITY;
326:}
327:
328:/**
329: * The capacity that actually applies to a claim.
330: *
331: * A division-scoped claim reads its division's effective capacity, which
332: * already inherits a parent cap that governs an uncapped division; a pair that
333: * belongs to the tournament only is limited by the tournament itself.
334: */
335:export async function readEffectiveCapacity(
336:  executor: AppDbOrTx,
337:  scope: { tournamentId: string; divisionId?: string | null },
338:): Promise<TournamentCapacitySnapshot> {
339:  if (!scope.divisionId) {
340:    return readTournamentCapacity(executor, scope.tournamentId);
341:  }
342:
343:  return readDivisionCapacity(executor, scope.divisionId);
344:}
