416:async function selectParticipantEntries(
417:  executor: AppDbOrTx,
418:  scope: {
419:    divisionIds?: readonly string[];
420:    tournamentIds?: readonly string[];
421:  },
422:): Promise<CapacityEntryRow[]> {
423:  const ids = [...(scope.divisionIds ?? scope.tournamentIds ?? [])];
424:  const reservingRows = inArray(schema.tournamentParticipants.teamStatus, [
425:    ...CAPACITY_RESERVING_TEAM_STATUSES,
426:  ]);
427:  const entryColumns = {
428:    teamStatus: schema.tournamentParticipants.teamStatus,
429:    rosterMemberCount: count(schema.tournamentRosters.userId),
430:    customResponses: schema.tournamentParticipants.customResponses,
431:  };
432:  const participants = schema.tournamentParticipants;
433:
434:  if (scope.divisionIds !== undefined) {
435:    const rows = await executor
436:      .select({
437:        scopeId: participants.tournamentDivisionId,
438:        ...entryColumns,
439:      })
440:      .from(participants)
441:      .leftJoin(
442:        schema.tournamentRosters,
443:        eq(schema.tournamentRosters.participantId, participants.id),
444:      )
445:      .where(
446:        and(inArray(participants.tournamentDivisionId, ids), reservingRows),
447:      )
448:      .groupBy(
449:        participants.id,
450:        participants.tournamentDivisionId,
451:        entryColumns.teamStatus,
452:        entryColumns.customResponses,
453:      );
454:
455:    return rows.map((row) => toCapacityEntry(row.scopeId, row, null));
456:  }
457:
458:  // A tournament-wide read spans divisions of different formats, so each row
459:  // has to carry its own; a division read already knows its format and never
460:  // joins. A row without a division keeps the tournament's format.
