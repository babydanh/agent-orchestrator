362:async function selectTournamentOwners(
363:  executor: AppDbOrTx,
364:  tournamentIds: readonly string[],
365:): Promise<CapacityOwnerRow[]> {
366:  return await executor
367:    .select({
368:      id: schema.tournaments.id,
369:      tournamentId: schema.tournaments.id,
370:      matchType: schema.tournaments.matchType,
371:      maxParticipants: schema.tournaments.maxParticipants,
372:      tournamentConfig: schema.tournaments.tournamentConfig,
373:    })
374:    .from(schema.tournaments)
375:    .where(inArray(schema.tournaments.id, [...tournamentIds]));
376:}
