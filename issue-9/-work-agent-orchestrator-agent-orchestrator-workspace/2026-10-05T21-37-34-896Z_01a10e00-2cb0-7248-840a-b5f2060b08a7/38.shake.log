467:    .from(participants)
468:    .leftJoin(
469:      schema.tournamentRosters,
470:      eq(schema.tournamentRosters.participantId, participants.id),
471:    )
472:    .leftJoin(
473:      schema.tournamentDivisions,
474:      eq(schema.tournamentDivisions.id, participants.tournamentDivisionId),
475:    )
476:    .where(and(inArray(participants.tournamentId, ids), reservingRows))
477:    .groupBy(
478:      participants.id,
479:      participants.tournamentId,
480:      entryColumns.teamStatus,
481:      entryColumns.customResponses,
482:      schema.tournamentDivisions.matchType,
483:    );
484:
485:  return rows.map((row) =>
486:    toCapacityEntry(row.scopeId, row, row.divisionMatchType),
487:  );
488:}
489:
490:function toCapacityEntry(
491:  scopeId: string | null,
492:  row: {
493:    teamStatus: string | null;
494:    rosterMemberCount: number;
495:    customResponses: unknown;
496:  },
497:  matchType: string | null | undefined,
498:): CapacityEntryRow {
499:  const rosterMemberCount = Number(row.rosterMemberCount ?? 0);
500:  return {
501:    scopeId: scopeId ?? '',
502:    teamStatus: row.teamStatus,
503:    rosterMemberCount,
504:    importedMemberCount: importedPairMemberCount(
505:      row.customResponses,
506:      rosterMemberCount,
507:    ),
508:    matchType: matchType ?? null,
509:  };
510:}
511:
512:function buildSnapshot(
513:  owner: CapacityOwnerRow,
514:  entries: readonly CapacityEntry[],
515:): TournamentCapacitySnapshot {
516:  const occupied = calculateOccupiedCapacity(
517:    owner.matchType,
518:    entries,
519:    { tournamentConfig: owner.tournamentConfig },
520:  );
521:  const maxTeamSlots = owner.maxParticipants ?? null;
522:
523:  return {
524:    occupiedTeamSlots: occupied.teamSlots,
525:    occupiedMemberSlots: occupied.memberSlots,
526:    maxTeamSlots,
527:    isFull: maxTeamSlots != null && occupied.teamSlots >= maxTeamSlots,
528:  };
529:}
530:
531:/**
532: * Imported doubles pairs can reference contacts with no linked account, so they
533: * own no roster rows. Their validated import metadata still declares the
534: * players that occupy the team.
535: *
536: * The marker matters: self-registered rows also carry a `customResponses`
537: * payload (registration-form answers), and an unpaired leader must keep
538: * consuming half a team there, not a whole one.
539: */
540:function importedPairMemberCount(
541:  customResponses: unknown,
542:  rosterMemberCount: number,
543:): number {
544:  if (!customResponses || typeof customResponses !== 'object') return 0;
545:
546:  const payload = customResponses as {
547:    importedFrom?: unknown;
548:    player2Name?: unknown;
549:  };
550:  if (
551:    !IMPORT_SOURCES.includes(payload.importedFrom as ImportSource)
552:  ) {
553:    return 0;
554:  }
555:
556:  const player2Name = payload.player2Name;
557:  const declaredMemberCount =
558:    typeof player2Name === 'string' && player2Name.trim().length > 0 ? 2 : 1;
559:
560:  return declaredMemberCount > rosterMemberCount ? declaredMemberCount : 0;
561:}

