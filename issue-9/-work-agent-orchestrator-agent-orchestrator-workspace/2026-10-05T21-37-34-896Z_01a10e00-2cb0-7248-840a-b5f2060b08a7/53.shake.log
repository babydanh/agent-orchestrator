90:      throw new BadRequestException(
91:        'Không thể thay đổi lệ phí sau khi giải đã có người tham gia.',
92:      );
93:    }
94:  }
95:  async resolveDivisionEntryFee(
96:    tx: Transaction | AppDbOrTx,
