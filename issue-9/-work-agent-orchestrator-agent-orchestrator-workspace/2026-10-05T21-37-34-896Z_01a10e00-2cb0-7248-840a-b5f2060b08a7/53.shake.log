200:  async updateParticipantStatus(
201:    tournamentId: string,
202:    participantId: string,
203:    status: string,
204:    userId: string,
205:    systemRoles: string[] = [],
206:    broadcastRegistrationChanged: RegistrationChanged,
207:  ) {
208:    const tournament = await this.tournamentsRepository.findById(tournamentId);
209:    if (!tournament) throw new NotFoundException('Giải đấu không tồn tại');
210:
211:    if (tournament.status !== 'REGISTRATION_OPEN') {
212:      throw new BadRequestException(
213:        'Giải đấu đã chốt danh sách, không thể duyệt hoặc từ chối vận động viên.',
214:      );
215:    }
216:
217:    const isAuthorized = await this.tournamentAccessService.isManager(tournament, userId, systemRoles);
218:    if (!isAuthorized) {
219:      throw new ForbiddenException('Bạn không có quyền cập nhật trạng thái');
220:    }
221:
222:    if (status !== 'COMPLETE' && status !== 'REJECTED') {
223:      throw new BadRequestException(
224:        'Chỉ hỗ trợ duyệt hoặc từ chối hồ sơ đăng ký.',
225:      );
226:    }
227:
228:    const participant =
229:      await this.tournamentsRepository.findParticipantById(participantId);
230:    if (!participant || participant.tournamentId !== tournamentId) {
231:      throw new NotFoundException('Người tham gia không tồn tại');
232:    }
233:
234:    if (participant.teamStatus !== 'PENDING_APPROVAL') {
235:      throw new BadRequestException(
236:        'Chỉ hồ sơ đang chờ duyệt mới được phép duyệt hoặc từ chối.',
237:      );
238:    }
239:
240:    let nextStatus = status;
241:    let participantRosters: Array<{ userId: string }> | null = null;
242:    const tournamentConfig = (tournament.tournamentConfig || {}) as Record<
243:      string,
244:      unknown
245:    >;
246:    if (status === 'COMPLETE') {
247:      const division = participant.tournamentDivisionId
248:        ? await this.tournamentsRepository.findDivisionById(
249:            participant.tournamentDivisionId,
250:          )
251:        : null;
252:      participantRosters =
253:        await this.tournamentsRepository.getParticipantRosters(participantId);
254:      const matchType = division?.matchType ?? tournament.matchType;
255:      nextStatus = resolveDoublesParticipantStatus({
256:        event: 'APPROVE',
257:        registrationMode: tournamentConfig.registrationMode,
258:        isDoubles:
259:          matchType === 'DOUBLES' || matchType === 'MIXED_DOUBLES',
260:        rosterCount: participantRosters.length,
261:        isLite: isLiteRegistrationTournament(tournamentConfig),
262:        pairingMode:
263:          tournamentConfig.doublesPairingMode === 'SELF' ? 'SELF' : 'ORGANIZER',
264:        hasPartnerInvite: Boolean(participant.teamInviteToken),
265:      });
266:
267:      if (nextStatus === 'COMPLETE') {
268:        if (!participant.isPaid) {
269:          const completedPayment =
270:            await this.tournamentsRepository.findCompletedParticipantPayment(
271:              participant.id,
272:            );
273:          if (completedPayment) {
274:            await this.tournamentsRepository.markParticipantPaid(participant.id);
275:            participant.isPaid = true;
276:          }
277:        }
278:
279:        const entryFeeAmount =
280:          participant.entryFeeAtRegistration != null
281:            ? Number(participant.entryFeeAtRegistration)
282:            : division?.entryFeeOverrideEnabled === true &&
283:                division.entryFee != null
284:              ? Number(division.entryFee)
285:              : Number(tournament.entryFee ?? 0);
286:
287:        if (entryFeeAmount > 0 && !participant.isPaid) {
288:          throw new BadRequestException(
289:            'Hồ sơ có lệ phí chưa thanh toán, không thể duyệt hoàn tất.',
290:          );
291:        }
292:      }
293:    }
294:
295:    let updated = await this.tournamentsRepository.updateParticipantStatus(
296:      participantId,
297:      nextStatus,
298:      'PENDING_APPROVAL',
299:    );
300:    if (!updated) {
301:      throw new BadRequestException(
302:        'Hồ sơ không còn ở trạng thái chờ Ban tổ chức duyệt.',
303:      );
304:    }
305:
306:    if (nextStatus === 'COMPLETE') {
307:      try {
308:        updated =
309:          (await this.tournamentsRepository.assignNextAvailableSeed(
310:            tournamentId,
311:            updated.id,
312:          )) ?? updated;
313:      } catch (err) {
314:        // Approval is already persisted; seed assignment is deliberately
315:        // best-effort so a transient seed-write failure cannot undo approval.
316:        console.error(
317:          'Failed to assign next available seed after participant approval:',
318:          err,
319:        );
320:      }
321:    }
322:
323:    try {
324:      const rosters =
325:        participantRosters ??
326:        (await this.tournamentsRepository.getParticipantRosters(participantId));
327:      for (const roster of rosters) {
328:        if (nextStatus === 'COMPLETE') {
329:          await this.notificationsService.sendNotification(
330:            buildParticipantRegistrationSuccessNotification({
331:              receiverId: roster.userId,
332:              tournamentId: tournament.id,
333:              tournamentName: tournament.name,
334:              divisionId: updated.tournamentDivisionId,
335:            }),
336:          );
337:        } else if (
338:          nextStatus === 'PENDING_PARTNER' &&
339:          !participant.teamInviteToken &&
340:          tournamentConfig.doublesPairingMode !== 'SELF'
341:        ) {
342:          await this.notificationsService.sendNotification(
343:            buildParticipantOrganizerPairingPendingNotification({
344:              receiverId: roster.userId,
345:              tournamentId: tournament.id,
346:              tournamentName: tournament.name,
347:              divisionId: updated.tournamentDivisionId,
348:            }),
349:          );
350:        } else if (status === 'REJECTED') {
351:          await this.notificationsService.sendNotification(
352:            buildParticipantRegistrationRejectedNotification({
353:              receiverId: roster.userId,
354:              tournamentId: tournament.id,
355:              tournamentName: tournament.name,
356:              divisionId: updated.tournamentDivisionId,
357:            }),
358:          );
359:        }
360:      }
361:    } catch (err) {
362:      console.error(
363:        'Failed to send notification for updateParticipantStatus:',
364:        err,
365:      );
366:    }
367:
368:    broadcastRegistrationChanged(tournamentId, {
369:      participantId: updated.id,
370:      divisionId: updated.tournamentDivisionId,
371:      action: status === 'COMPLETE' ? 'APPROVED' : 'REJECTED',
372:    });
373:
374:    return updated;
375:  }
