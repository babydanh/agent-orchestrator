43:    const nextEnabled = nextOverrideEnabled ?? nextEntryFee != null;
44:    const currentFee = currentEnabled ? Number(currentEntryFee ?? 0) : 0;
45:    const nextFee = nextEnabled ? Number(nextEntryFee ?? 0) : 0;
46:    if (currentEnabled === nextEnabled && currentFee === nextFee) return;
47:
48:    const editableStatuses = new Set([
