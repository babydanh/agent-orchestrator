ws( tournamentId: string, managerUserId: string, items: (RosterImportItem &amp;</d><d l="519" n="selectGuestRosterCounts" p="src/modules/tournaments/services/tournament-capacity.service.ts" cx="3" ccx="2" in="1" r="8">async function selectGuestRosterCounts( executor: AppDbOrTx, participantIds: readonly string[], ): Promise&lt;Map&lt;string, number&gt;&gt;</d><far of_top="12" shown="4" total="4" capped="0"><s t="fn" n="findExistingRosterImportEmails" p="src/modules/tournaments/validation/roster-import.ts:83"/><s t="method" n="promoteNextWaitlisted" p="src/modules/tournaments/repositories/tournament-registration.repository.ts:2657"/><s t="method" n="listActivityFeed" p="src/modules/communities/community-social.repository.ts:344"/><s t="method" n="isTournamentManager" p="src/modules/matches/matches.repository.ts:2687"/></far></sigs><bodies shown="1" total="6" capped="1"><b t="fn" l="416" p="src/modules/tournaments/services/tournament-capacity.service.ts" n="selectParticipantEntries"><![CDATA[async function selectParticipantEntries(
  executor: AppDbOrTx,
  scope: {
    divisionIds?: readonly string[];
    tournamentIds?: readonly string[];
  },
): Promise<CapacityEntryRow[]> {
  const ids = [...(scope.divisionIds ?? scope.tournamentIds ?? [])];
  const reservingRows = inArray(schema.tournamentParticipants.teamStatus, [
    ...CAPACITY_RESERVING_TEAM_STATUSES,
  ]);
  const participants = schema.tournamentParticipants;
  const entryColumns = {
    participantId: participants.id,
    teamStatus: participants.teamStatus,
    rosterMemberCount: count(schema.tournamentRosters.userId),
    customResponses: participants.customResponses,
  };

  if (scope.divisionIds !== undefined) {
    const rows = await executor
      .select({
        scopeId: participants.tournamentDivisionId,
        ...entryColumns,
      })
      .from(participants)
      .leftJoin(
        schema.tournamentRosters,
        eq(schema.tournamentRosters.participantId, participants.id),
      )
      .where(
        and(inArray(participants.tournamentDivisionId, ids), reservingRows),
      )
      .groupBy(
        participants.id,
        participants.tournamentDivisionId,
        entryColumns.teamStatus,
        entryColumns.customResponses,
      );

    const guestMemberCounts = await selectGuestRosterCounts(
      executor,
      rows.map(({ participantId }) => participantId),
    );
    return rows.map((row) =>
      toCapacityEntry(
        row.scopeId,
        {
          ...row,
          rosterMemberCount:
            Number(row.rosterMemberCount) +
            (guestMemberCounts.get(row.participantId) ?? 0),
        },
        null,
      ),
    );
  }

  // A tournament-wide read spans divisions of different formats, so each row
  // has to carry its own; a division read already knows its format and never
  // joins. A row without a division keeps the tournament's format.
  const rows = await executor
    .select({
      scopeId: participants.tournamentId,
      ...entryColumns,
      divisionMatchType: schema.tournamentDivisions.matchType,
    })
    .from(participants)
    .leftJoin(
      schema.tournamentRosters,
      eq(schema.tournamentRosters.participantId, participants.id),
    )
    .leftJoin(
      schema.tournamentDivisions,
      eq(schema.tournamentDivisions.id, participants.tournamentDivisionId),
    )
    .where(and(inArray(participants.tournamentId, ids), reservingRows))
    .groupBy(
      participants.id,
      participants.tournamentId,
      entryColumns.teamStatus,
      entryColumns.customResponses,
      schema.tournamentDivisions.matchType,
    );

  const guestMemberCounts = await selectGuestRosterCounts(
    executor,
    rows.map(({ participantId }) => participantId),
  );
  return rows.map((row) =>
    toCapacityEntry(
      row.scopeId,
      {
        ...row,
        rosterMemberCount:
          Number(row.rosterMemberCount) +
          (guestMemberCounts.get(row.participantId) ?? 0),
      },
      row.divisionMatchType,
    ),
  );
}]]><calls total="3" shown="2" capped="1"><c n="selectGuestRosterCounts" l="519">async function selectGuestRosterCounts( executor: AppDbOrTx, participantIds: readonly string[], ): Promise&lt;Map&lt;string, number&gt;&gt;</c><c n="toCapacityEntry" l="545">function toCapacityEntry( scopeId: string | null, row:</c></calls></b><!-- body omitted (over budget): isRosterWeightedCapacity --><!-- body omitted (over budget): findAll --><!-- body omitted (over budget): CapacityUnit --><!-- body omitted (over budget): persistImportRows --><!-- body omitted (over budget): TournamentImportRepository --></bodies><callers of_top="6" shown="14" total="21" capped="1"><s t="fn" n="readTournamentCapacities" p="src/modules/tournaments/services/tournament-capacity.service.ts:347" rel="caller" shared="2">async function readTournamentCapacities( executor: AppDbOrTx, tournamentIds: readonly string[], …</s><s t="method" n="encodeCursor" p="src/common/helpers/cursor-pagination.helper.ts:7" rel="callee">static encodeCursor(payload: Record&lt;string, unknown&gt;): string</s><s t="method" n="decodeCursor" p="src/common/helpers/cursor-pagination.helper.ts:17" rel="callee">static decodeCursor&lt;T = Record&lt;string, unknown&gt;&gt;(cursor: string): T | null</s><s t="method" n="insert" p="src/modules/friendships/friendships.repository.ts:102" rel="callee">async insert(row: typeof schema.friendships.$inferInsert)</s><s t="modscope" n="&lt;file-scope&gt;" p="src/modules/tournaments/repositories/tournament-catalog-capacity.spec.ts:1" rel="caller"/><s t="fn" n="createRepository" p="src/modules/tournaments/repositories/tournament-import-capacity.spec.ts:114" rel="caller">function createRepository(tx: unknown)</s><s t="fn" n="createRepository" p="src/modules/tournaments/repositories/tournament-import-email-link.spec.ts:137" rel="caller">function createRepository(tx: unknown)</s><s t="fn" n="createRepository" p="src/modules/tournaments/repositories/tournament-import-legacy-contract.spec.ts:123" rel="call