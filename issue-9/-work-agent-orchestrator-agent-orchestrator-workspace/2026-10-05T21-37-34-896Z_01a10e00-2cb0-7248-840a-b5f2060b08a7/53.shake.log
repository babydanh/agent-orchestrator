1:import { BadRequestException } from '@nestjs/common';
2:import * as schema from '../../../database/schema';
3:import { TournamentRegistrationRepository } from './tournament-registration.repository';
4:
5:// Drizzle tables are object keys, so the lookup must be by identity.
6:const TABLE_KEYS = new Map<unknown, string>([
7:  [schema.tournaments, 'tournaments'],
8:  [schema.tournamentDivisions, 'divisions'],
9:  [schema.tournamentParticipants, 'participants'],
10:  [schema.tournamentRosters, 'rosters'],
11:  [schema.profiles, 'profiles'],
12:  [schema.users, 'users'],
13:  [schema.communityMembers, 'communityMembers'],
14:]);
15:
16:type Row = Record<string, unknown>;
17:
18:interface Harness {
19:  tx: Record<string, unknown>;
20:  inserts: Array<{ table: string; values: Row }>;
21:  updates: Array<{ table: string; values: Row }>;
22:  lockedTables: string[];
23:  events: string[];
24:}
25:
26:/**
27: * A lock on the owner row itself is the capacity claim's serialization; any
28: * other row lock is incidental to reading or writing the claim.
29: */
30:function locksOwnerRow(fields: Record<string, unknown> | undefined): boolean {
31:  if (!fields) return false;
32:  const columns = Object.values(fields);
33:  return (
34:    columns.length > 0 &&
35:    columns.every(
36:      (column) =>
37:        column === schema.tournaments.id ||
38:        column === schema.tournamentDivisions.id,
39:    )
40:  );
41:}
42:
43:/**
44: * The fake tx never evaluates WHERE, so an occupancy row is projected onto the
45: * columns the capacity query asked for: the same row reads under its division
46: * for a division read and under its tournament for a tournament read, exactly
47: * as the real join would return it.
48: */
49:
50:function projectOccupancyRow(fields: Record<string, unknown>, row: Row): Row {
51:  const projected: Row = { rosterMemberCount: row.rosterMemberCount };
52:  for (const [key, column] of Object.entries(fields)) {
53:    if (key === 'rosterMemberCount') continue;
54:    if (column === schema.tournamentParticipants.tournamentDivisionId)
55:      projected[key] =
56:        row.divisionId !== undefined ? row.divisionId : row.scopeId;
57:    else if (column === schema.tournamentParticipants.tournamentId)
58:      projected[key] = row.tournamentId ?? row.scopeId ?? null;
59:    else projected[key] = row[key];
60:  }
61:  return projected;
62:}
63:
64:function createHarness(queues: Record<string, Row[][]>): Harness {
65:  const inserts: Array<{ table: string; values: Row }> = [];
66:  const updates: Array<{ table: string; values: Row }> = [];
67:  const lockedTables: string[] = [];
68:  const events: string[] = [];
69:
70:  const takeRows = (key: string): Row[] => {
71:    const queue = queues[key];
72:    if (!queue || queue.length === 0) return [];
73:    return queue.length === 1 ? queue[0] : queue.shift()!;
74:  };
75:
76:  const tableKey = (tables: string[]): string =>
77:    [...new Set(tables)].sort().join('+');
78:
79:  const select = (fields?: Record<string, unknown>) => {
80:    const tables: string[] = [];
81:    const query: Record<string, unknown> = {};
82:
83:    const record = (fn: (...args: unknown[]) => unknown) => (
84:      ...args: unknown[]
85:    ) => {
86:      for (const arg of args) {
87:        const name = TABLE_KEYS.get(arg);
88:        if (name) tables.push(name);
89:      }
90:      return fn(...args);
91:    };
92:
93:    query.from = record(() => query);
94:    query.innerJoin = record(() => query);
95:    query.leftJoin = record(() => query);
96:    query.where = () => query;
97:    query.groupBy = () => query;
98:    query.orderBy = () => query;
99:    query.limit = () => query;
100:    query.for = (locking: unknown) => {
101:      if (locking) {
102:        const key = tableKey(tables);
103:        lockedTables.push(key);
104:        const mode = String(locking).toLowerCase();
105:        const lockKind = locksOwnerRow(fields)
106:          ? 'lockOwner'
107:          : mode.includes('share')
108:            ? 'lockShared'
109:            : 'lock';
110:        events.push(`${lockKind}:${key}`);
111:      }
112:      return query;
113:    };
114:    query.then = (
115:      resolve: (value: unknown) => unknown,
116:      reject?: (reason: unknown) => unknown,
117:    ) =>
118:      Promise.resolve()
119:        .then(() => {
120:          const rows = takeRows(tableKey(tables));
121:          if (fields && 'rosterMemberCount' in fields) {
122:            events.push('read:occupancy');
123:            return rows.map((row) => projectOccupancyRow(fields, row));
124:          }
125:          events.push(`read:${tableKey(tables)}`);
126:          return rows;
127:        })
128:        .then(resolve, reject);
129:
130:    return query;
131:  };
132:
133:  const tx = {
134:    select,
135:    insert: (table: unknown) => {
136:      const name = TABLE_KEYS.get(table) ?? 'unknown';
137:      return {
