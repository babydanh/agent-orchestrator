95:    const effectiveMatchType =
96:      division?.matchType || tournament.matchType || 'SINGLES';
97:
98:    if (
99:      minElo === null &&
100:      maxElo === null &&
101:      maxCombinedElo === null &&
102:      maxTeammateGap === null
103:    ) {
104:      return;
105:    }
106:
107:    const elos: number[] = [];
108:    for (const uId of userIds) {
