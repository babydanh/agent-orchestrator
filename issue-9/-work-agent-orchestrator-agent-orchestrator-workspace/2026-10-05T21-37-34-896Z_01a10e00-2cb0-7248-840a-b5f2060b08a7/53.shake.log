49:  /** Nhắc lại cho những ai đã quá hạn mà chưa xác nhận. */
50:  async sendDueReminders(): Promise<number> {
51:    const now = Date.now();
52:
53:    // Rows whose notifiedAt is still NULL are included on purpose. dispatch stamps
54:    // that column only after a successful send, so filtering NULLs out would mean a
55:    // single temporary mail outage silently ends all reminders — the player never
56:    // hears again and never learns their matches go unscored. That is exactly the
57:    // silent-exclusion failure this feature exists to prevent.
58:    const due = await this.db
59:      .select({
60:        id: schema.tournamentRosters.id,
61:        attempts: schema.tournamentRosters.consentNotifiedCount,
62:        notifiedAt: schema.tournamentRosters.consentNotifiedAt,
63:        joinedAt: schema.tournamentRosters.joinedAt,
64:      })
65:      .from(schema.tournamentRosters)
66:      .innerJoin(
67:        schema.tournamentParticipants,
68:        eq(
69:          schema.tournamentParticipants.id,
70:          schema.tournamentRosters.participantId,
71:        ),
72:      )
73:      .innerJoin(
74:        schema.tournaments,
75:        eq(schema.tournaments.id, schema.tournamentParticipants.tournamentId),
76:      )
77:      .where(
78:        and(
79:          isNull(schema.tournamentRosters.rankingConsentAt),
80:          // A tournament that does not rank scores nothing, so asking its players to
81:          // consent would be noise.
82:          eq(schema.tournaments.isRanked, true),
83:        ),
84:      );
85:
86:    let sent = 0;
87:    for (const row of due) {
88:      // Three sends in total: the one at add time plus two reminders. Past the cap
89:      // the row is left alone — nobody gets nagged forever.
90:      if (row.attempts >= CONSENT_MAX_NOTIFICATIONS) continue;
91:
92:      // attempts === 0 means the first send never landed, so the clock runs from
93:      // when the player joined instead of from a send that does not exist.
94:      const anchor = row.notifiedAt ?? row.joinedAt;
95:      if (!anchor) continue;
96:
97:      // attempts counts DELIVERED sends, and the send at add time already made it 1.
98:      // So the first reminder is attempts === 1 → delays[0] = 24h. Indexing by
99:      // `attempts` would jump straight to 72h and leave delays[0] as dead code.
100:      // attempts === 0 means nothing was delivered yet, so the 24h delay runs from
101:      // joinedAt instead.
102:      const delayHours =
103:        CONSENT_REMINDER_DELAYS_HOURS[
104:          Math.min(
105:            Math.max(row.attempts - 1, 0),
106:            CONSENT_REMINDER_DELAYS_HOURS.length - 1,
107:          )
108:        ];
109:      const elapsedHours = (now - new Date(anchor).getTime()) / 3_600_000;
110:      if (elapsedHours < delayHours) continue;
111:
112:      if (await this.dispatch(row.id, 'Nhắc xác nhận tham gia giải đấu')) {
113:        sent += 1;
114:      }
115:    }
116:    return sent;
117:  }
