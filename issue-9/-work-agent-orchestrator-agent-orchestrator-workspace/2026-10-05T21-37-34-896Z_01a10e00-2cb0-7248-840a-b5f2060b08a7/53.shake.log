378:function buildTournamentSnapshots(
379:  tournaments: readonly CapacityOwnerRow[],
380:  tournamentIds: readonly string[],
381:  entries: readonly CapacityEntryRow[],
382:): CapacityByScopeId {
383:  const snapshots: CapacityByScopeId = {};
384:  const entriesByTournament = groupEntriesByScope(entries);
385:
386:  for (const tournament of tournaments) {
387:    snapshots[tournament.id] = buildSnapshot(
388:      tournament,
389:      entriesByTournament[tournament.id] ?? [],
390:    );
391:  }
392:
393:  for (const id of tournamentIds) {
394:    if (!snapshots[id]) snapshots[id] = EMPTY_CAPACITY;
395:  }
396:
397:  return snapshots;
398:}
