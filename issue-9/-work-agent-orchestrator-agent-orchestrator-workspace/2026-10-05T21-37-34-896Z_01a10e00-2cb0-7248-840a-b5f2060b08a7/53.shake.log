ament-capacity.service.ts:416"/></far></sigs><bodies shown="1" total="6" capped="1"><b t="cls" l="43" p="src/modules/tournaments/services/ranking-consent.service.ts" n="RankingConsentService" lines="1-128/320" truncated="1" next="--expand=src/modules/tournaments/services/ranking-consent.service.ts:43:RankingConsentService:129-320"><![CDATA[class RankingConsentService {
  private readonly logger = new Logger(RankingConsentService.name);

  constructor(
    @Inject(PG_CONNECTION) private readonly db: AppDb,
    @Optional() private readonly mailService?: MailService,
  ) {}

  private buildFrontendLink(path: string, claimToken?: string): string | null {
    const configuredUrl =
      process.env.FRONTEND_URL ?? 'http://localhost:3001';
    try {
      const base = new URL(configuredUrl);
      if (
        (base.protocol !== 'http:' && base.protocol !== 'https:') ||
        base.username ||
        base.password
      ) {
        return null;
      }

      const link = new URL(path, base.origin);
      if (link.origin !== base.origin) return null;
      if (claimToken) {
        link.hash = new URLSearchParams({ token: claimToken }).toString();
      }
      return link.toString();
    } catch {
      return null;
    }
  }

  /** Gửi ngay cho một roster row cụ thể (dùng khi vừa thêm người). */
  async sendConfirmationRequest(rosterId: string): Promise<boolean> {
    return this.dispatch(rosterId, 'INITIAL');
  }

  async sendGuestClaimInvite(args: {
    email: string;
    displayName: string;
    tournamentName: string;
    tournamentId: string;
    guestId: string;
    claimToken: string;
  }): Promise<boolean> {
    if (!this.mailService) return false;
    const link = this.buildFrontendLink(
      `/tournaments/${encodeURIComponent(args.tournamentId)}/guest-claim/${encodeURIComponent(args.guestId)}`,
      args.claimToken,
    );
    if (!link) return false;

    const tournamentName = args.tournamentName.replace(/[\r\n]+/g, ' ').trim();
    try {
      return await this.mailService.sendMail(
        args.email,
        `[Sporto] Xác nhận suất tham gia: ${tournamentName}`,
        this.buildGuestClaimHtml({
          displayName: args.displayName,
          tournamentName,
          link,
        }),
      );
    } catch {
      this.logger.warn('Gửi mail claim guest thất bại.');
      return false;
    }
  }

