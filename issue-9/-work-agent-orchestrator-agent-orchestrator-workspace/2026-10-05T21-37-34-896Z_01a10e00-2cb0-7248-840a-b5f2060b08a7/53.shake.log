4:@Injectable()
5:export class TournamentAccessService {
6:  constructor(private readonly tournamentsRepository: TournamentsRepository) {}
7:
8:  async isManager(
9:    tournament: {
10:      id: string;
11:      createdBy: string | null;
12:      communityId?: string | null;
13:    },
14:    userId: string,
15:    systemRoles: string[] = [],
16:  ): Promise<boolean> {
17:    if (systemRoles.includes('ADMIN')) return true;
18:    if (tournament.createdBy === userId) return true;
19:    if (
20:      typeof this.tournamentsRepository.isCoOrganizer === 'function' &&
21:      (await this.tournamentsRepository.isCoOrganizer(tournament.id, userId))
22:    ) {
23:      return true;
24:    }
25:    if (!tournament.communityId) return false;
26:    if (typeof this.tournamentsRepository.findCommunityById === 'function') {
27:      const community = await this.tournamentsRepository.findCommunityById(
28:        tournament.communityId,
29:      );
30:      if (community && community.creatorId === userId) {
31:        return true;
32:      }
33:    }
34:    const member = await this.tournamentsRepository.findCommunityMember(
35:      tournament.communityId,
36:      userId,
37:    );
38:    return (
39:      (member?.status === 'JOINED' || member?.status === 'ACTIVE') &&
40:      ['OWNER', 'MODERATOR'].includes(
41:        member.role?.toUpperCase?.() ?? member.role,
42:      )
43:    );
44:  }
45:
46:  isSystemTournamentCreator(systemRoles: string[] = []): boolean {
47:    return systemRoles.includes('ADMIN') || systemRoles.includes('ORGANIZER');
48:  }
49:
50:  async assertCommunityTournamentCreator(
51:    communityId: string,
52:    userId: string,
53:    systemRoles: string[] = [],
54:  ): Promise<void> {
55:    if (systemRoles.includes('ADMIN')) return;
56:    const member = await this.tournamentsRepository.findCommunityMember(
57:      communityId,
58:      userId,
59:    );
60:    if (
61:      !member ||
62:      member.status !== 'JOINED' ||
63:      !['OWNER', 'MODERATOR'].includes(member.role)
64:    ) {
65:      throw new ForbiddenException(
66:        'Chỉ Chủ CLB hoặc Quản trị viên CLB mới có thể tạo giải thuộc CLB.',
67:      );
68:    }
69:  }
70:}
