362:async function selectTournamentOwners(
363:  executor: AppDbOrTx,
364:  tournamentIds: readonly string[],
365:): Promise<CapacityOwnerRow[]> {
366:  return await executor
367:    .select({
368:      id: schema.tournaments.id,
369:      tournamentId: schema.tournaments.id,
370:      matchType: schema.tournaments.matchType,
371:      maxParticipants: schema.tournaments.maxParticipants,
372:      tournamentConfig: schema.tournaments.tournamentConfig,
373:    })
374:    .from(schema.tournaments)
375:    .where(inArray(schema.tournaments.id, [...tournamentIds]));
376:}
377:
378:function buildTournamentSnapshots(
379:  tournaments: readonly CapacityOwnerRow[],
380:  tournamentIds: readonly string[],
381:  entries: readonly CapacityEntryRow[],
382:): CapacityByScopeId {
383:  const snapshots: CapacityByScopeId = {};
384:  const entriesByTournament = groupEntriesByScope(entries);
385:
386:  for (const tournament of tournaments) {
387:    snapshots[tournament.id] = buildSnapshot(
388:      tournament,
389:      entriesByTournament[tournament.id] ?? [],
390:    );
391:  }
392:
393:  for (const id of tournamentIds) {
394:    if (!snapshots[id]) snapshots[id] = EMPTY_CAPACITY;
395:  }
396:
397:  return snapshots;
398:}
399:
400:function groupEntriesByScope(
401:  entries: readonly CapacityEntryRow[],
402:): Record<string, CapacityEntry[]> {
403:  const byScope: Record<string, CapacityEntry[]> = {};
404:  for (const entry of entries) {
405:    const bucket = byScope[entry.scopeId];
406:    if (bucket) bucket.push(entry);
407:    else byScope[entry.scopeId] = [entry];
408:  }
409:  return byScope;
410:}
411:
412:interface CapacityEntryRow extends CapacityEntry {
413:  scopeId: string;
414:}
