1:import { expect, test } from '@playwright/test';
2:import { fulfillApi, openManage, tournamentId } from './support/organizer-manage';
3:
4:const divisionId = 'synthetic-wide-division';
5:
6:test('organizer can add a directly entered guest and hand off a claim link', async ({ page }) => {
7:  let addRequest: Record<string, unknown> | undefined;
8:  let handoffUrl = '';
9:  page.on('dialog', async (dialog) => {
10:    expect(dialog.type()).toBe('prompt');
11:    handoffUrl = dialog.defaultValue();
12:    await dialog.accept();
13:  });
14:  await page.route(`**/api/v1/tournaments/${tournamentId}/add-athletes/candidates**`, async (route) => {
15:    await fulfillApi(route, { data: { rows: [], nextCursor: null } });
16:  });
17:  await page.route(`**/api/v1/tournaments/${tournamentId}/add-athletes`, async (route) => {
18:    addRequest = route.request().postDataJSON();
19:    await fulfillApi(route, {
20:      data: {
21:        participant: { id: 'new-participant' },
22:        claims: [{ guestId: 'guest-1', delivery: 'HANDOFF', claimToken: 'one-time-secret' }],
23:      },
24:    }, 201);
25:  });
26:  await openManage(page, { tab: 'registration' });
27:
28:  await expect(page.getByRole('button', { name: 'Import Excel' })).toBeVisible();
29:  await page.getByRole('button', { name: 'Thêm VĐV' }).click();
30:  const dialog = page.getByRole('dialog', { name: 'Thêm VĐV' });
31:  await expect(dialog).toBeVisible();
32:  await dialog.getByRole('button', { name: 'Nhập trực tiếp' }).click();
33:  await dialog.getByLabel('Tên VĐV').fill('Guest Athlete');
34:  await dialog.getByLabel('Ghi chú ban tổ chức').fill('Arrives late');
35:  await dialog.getByRole('button', { name: 'Thêm vào giải' }).click();
36:
37:  await expect.poll(() => addRequest).toEqual({
38:    source: 'DIRECT',
39:    divisionId,
40:    players: [{ displayName: 'Guest Athlete', role: 'MAIN' }],
41:    organizerNote: 'Arrives late',
42:  });
43:  expect(handoffUrl).toBe(
44:    `${new URL(page.url()).origin}/tournaments/${tournamentId}/guest-claim/guest-1#token=one-time-secret`,
45:  );
46:  expect(new URL(handoffUrl).search).toBe('');
47:  await expect(dialog).toBeHidden();
48:});
