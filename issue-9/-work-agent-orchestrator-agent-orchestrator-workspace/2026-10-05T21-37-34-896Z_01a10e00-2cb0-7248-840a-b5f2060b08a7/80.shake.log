50:test('candidate search paginates and selecting a player does not expose contact information', async ({ page }) => {
51:  const queries: URL[] = [];
52:  await page.route(`**/api/v1/tournaments/${tournamentId}/add-athletes/candidates**`, async (route) => {
53:    const url = new URL(route.request().url());
