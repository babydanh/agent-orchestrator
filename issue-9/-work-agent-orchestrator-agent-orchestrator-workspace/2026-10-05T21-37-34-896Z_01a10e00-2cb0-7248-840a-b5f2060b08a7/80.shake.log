130:export async function fulfillApi(route: Route, payload: unknown, status = 200) {
131:  const requestHeaders = route.request().headers();
132:  const headers = createApiFixtureCorsHeaders(requestHeaders, 'http://127.0.0.1:3001');
133:
134:  if (route.request().method() === 'OPTIONS') {
135:    await route.fulfill({ status: 204, headers });
136:    return;
137:  }
138:
139:  await route.fulfill({ status, headers, json: payload });
140:}
141:
142:export async function openManage(
143:  page: Page,
144:  options: {
145:    divisions?: Array<typeof divisionFixture>;
146:    tab?: string;
147:    matchType?: 'SINGLES' | 'DOUBLES';
148:    withBracket?: boolean;
149:  } = {},
150:) {
151:  const matchType = options.matchType ?? 'SINGLES';
152:  const divisions = options.divisions ?? [{ ...divisionFixture, matchType }];
153:  const withBracket = options.withBracket ?? false;
154:  const currentTournament = { ...tournament, matchType };
155:
156:  await page.addInitScript((user) => {
157:    localStorage.setItem('auth-storage', JSON.stringify({
158:      state: { user, isAuthenticated: true },
159:      version: 0,
160:    }));
161:  }, organizer);
162:
163:  await page.route('**/api/v1/**', async (route) => {
164:    const pathname = new URL(route.request().url()).pathname;
165:
166:    if (pathname.endsWith('/users/profile')) {
167:      await fulfillApi(route, { data: organizer });
168:      return;
169:    }
170:    if (pathname === `/api/v1/tournaments/${tournamentId}`) {
171:      await fulfillApi(route, { data: currentTournament });
172:      return;
173:    }
174:    if (pathname === `/api/v1/tournaments/${tournamentId}/divisions`) {
175:      await fulfillApi(route, { data: divisions });
176:      return;
177:    }
178:    if (pathname === `/api/v1/tournaments/${tournamentId}/bracket`) {
179:      await fulfillApi(route, { data: withBracket ? bracketFixture : { stages: [] } });
180:      return;
181:    }
182:    if (pathname === `/api/v1/tournaments/${tournamentId}/manage/participants`) {
183:      await fulfillApi(route, { data: divisions.length === 0 ? [] : [participant] });
184:      return;
185:    }
186:
187:    await fulfillApi(route, { data: [] });
188:  });
189:
190:  const tab = options.tab ? `?tab=${options.tab}` : '';
191:  await page.goto(`/organizer/tournaments/${tournamentId}/manage${tab}`, { waitUntil: 'domcontentloaded' });
192:}

