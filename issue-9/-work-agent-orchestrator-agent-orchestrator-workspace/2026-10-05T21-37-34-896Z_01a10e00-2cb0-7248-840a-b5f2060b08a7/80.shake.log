56:      ? { data: { rows: [], nextCursor: null } }
57:      : { data: { rows: [{ userId: 'friend-1', displayName: 'Friend Athlete', avatarUrl: null, source: 'FRIENDS' }], nextCursor: 'page-2' } });
58:  });
