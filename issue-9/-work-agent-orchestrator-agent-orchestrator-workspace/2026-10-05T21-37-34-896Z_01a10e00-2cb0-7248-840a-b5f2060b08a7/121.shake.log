130:export async function fulfillApi(route: Route, payload: unknown, status = 200) {
131:  const requestHeaders = route.request().headers();
132:  const headers = createApiFixtureCorsHeaders(requestHeaders, 'http://127.0.0.1:3001');
133:
134:  if (route.request().method() === 'OPTIONS') {
135:    await route.fulfill({ status: 204, headers });
136:    return;
137:  }
138:
139:  await route.fulfill({ status, headers, json: payload });
140:}
141:
142:export async function openManage(
143:  page: Page,
144:  options: {
145:    divisions?: Array<typeof divisionFixture>;
146:    tab?: string;
147:    matchType?: 'SINGLES' | 'DOUBLES';
148:    withBracket?: boolean;
149:    tournamentConfig?: {
150:      teamSize?: 5 | 7 | 11;
151:      maxReserve?: number;
152:      maxTeamSize?: number;
153:    };
154:  } = {},
155:) {
156:  const matchType = options.matchType ?? 'SINGLES';
157:  const divisions = options.divisions ?? [{ ...divisionFixture, matchType }];
158:  const withBracket = options.withBracket ?? false;
159:  const currentTournament = {
160:    ...tournament,
161:    matchType,
162:    tournamentConfig: { ...tournament.tournamentConfig, ...options.tournamentConfig },
163:  };
164:
165:  await page.addInitScript((user) => {
166:    localStorage.setItem('auth-storage', JSON.stringify({
167:      state: { user, isAuthenticated: true },
168:      version: 0,
169:    }));
170:  }, organizer);
171:
172:  await page.route('**/api/v1/**', async (route) => {
173:    const pathname = new URL(route.request().url()).pathname;
174:
175:    if (pathname.endsWith('/users/profile')) {
176:      await fulfillApi(route, { data: organizer });
177:      return;
178:    }
179:    if (pathname === `/api/v1/tournaments/${tournamentId}`) {
180:      await fulfillApi(route, { data: currentTournament });
181:      return;
182:    }
183:    if (pathname === `/api/v1/tournaments/${tournamentId}/divisions`) {
184:      await fulfillApi(route, { data: divisions });
185:      return;
186:    }
187:    if (pathname === `/api/v1/tournaments/${tournamentId}/bracket`) {
188:      await fulfillApi(route, { data: withBracket ? bracketFixture : { stages: [] } });
189:      return;
190:    }
191:    if (pathname === `/api/v1/tournaments/${tournamentId}/manage/participants`) {
192:      await fulfillApi(route, { data: divisions.length === 0 ? [] : [participant] });
193:      return;
194:    }
195:
196:    await fulfillApi(route, { data: [] });
197:  });
198:
199:  const tab = options.tab ? `?tab=${options.tab}` : '';
200:  await page.goto(`/organizer/tournaments/${tournamentId}/manage${tab}`, { waitUntil: 'domcontentloaded' });
201:}

