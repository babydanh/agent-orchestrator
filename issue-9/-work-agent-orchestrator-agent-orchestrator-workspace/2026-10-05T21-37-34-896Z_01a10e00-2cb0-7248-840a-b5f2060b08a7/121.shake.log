46:  constructor(
47:    @Inject(PG_CONNECTION) private readonly db: AppDb,
48:    @Optional() private readonly mailService?: MailService,
49:  ) {}
50:
51:  private buildFrontendLink(path: string, claimToken?: string): string | null {
52:    const configuredUrl =
53:      process.env.FRONTEND_URL ?? 'http://localhost:3001';
54:    try {
55:      const base = new URL(configuredUrl);
56:      if (
57:        (base.protocol !== 'http:' && base.protocol !== 'https:') ||
58:        base.username ||
59:        base.password
60:      ) {
61:        return null;
62:      }
63:
64:      const link = new URL(path, base.origin);
65:      if (link.origin !== base.origin) return null;
66:      if (claimToken) {
67:        link.hash = new URLSearchParams({ token: claimToken }).toString();
68:      }
69:      return link.toString();
70:    } catch {
71:      return null;
72:    }
73:  }
74:
75:  /** Gửi ngay cho một roster row cụ thể (dùng khi vừa thêm người). */
76:  async sendConfirmationRequest(rosterId: string): Promise<boolean> {
77:    return this.dispatch(rosterId, 'INITIAL');
78:  }
79:
80:  async sendGuestClaimInvite(args: {
81:    email: string;
82:    displayName: string;
83:    tournamentName: string;
84:    tournamentId: string;
85:    guestId: string;
86:    claimToken: string;
87:  }): Promise<boolean> {
88:    if (!this.mailService) return false;
89:    const link = this.buildFrontendLink(
90:      `/tournaments/${encodeURIComponent(args.tournamentId)}/guest-claim/${encodeURIComponent(args.guestId)}`,
91:      args.claimToken,
92:    );
93:    if (!link) return false;
94:
95:    const tournamentName = args.tournamentName.replace(/[\r\n]+/g, ' ').trim();
96:    try {
97:      return await this.mailService.sendMail(
98:        args.email,
99:        `[Sporto] Xác nhận suất tham gia: ${tournamentName}`,
100:        this.buildGuestClaimHtml({
101:          displayName: args.displayName,
102:          tournamentName,
103:          link,
104:        }),
105:      );
106:    } catch {
107:      this.logger.warn('Gửi mail claim guest thất bại.');
108:      return false;
109:    }
110:  }
111:
112:  /** Nhắc lại cho những ai đã quá hạn mà chưa xác nhận. */
113:  async sendDueReminders(): Promise<number> {
114:    if (!this.mailService) return 0;
115:    const now = new Date();
116:
117:    // Keep rows whose notifiedAt is NULL: failed delivery must not consume an
118:    // attempt or silently end all reminders.
119:    const due = await this.db
120:      .select({
121:        id: schema.tournamentRosters.id,
122:        attempts: schema.tournamentRosters.consentNotifiedCount,
123:        consentNotifiedAt: schema.tournamentRosters.consentNotifiedAt,
124:        joinedAt: schema.tournamentRosters.joinedAt,
125:      })
126:      .from(schema.tournamentRosters)
127:      .innerJoin(
128:        schema.users,
129:        eq(schema.users.id, schema.tournamentRosters.userId),
130:      )
131:      .innerJoin(
132:        schema.tournamentParticipants,
133:        eq(
134:          schema.tournamentParticipants.id,
135:          schema.tournamentRosters.participantId,
136:        ),
137:      )
138:      .innerJoin(
139:        schema.tournaments,
140:        eq(schema.tournaments.id, schema.tournamentParticipants.tournamentId),
141:      )
142:      .where(
143:        and(
144:          isNull(schema.tournamentRosters.rankingConsentAt),
145:          eq(schema.tournamentRosters.status, 'ACTIVE'),
146:          inArray(
147:            schema.tournamentParticipants.teamStatus,
148:            [...CAPACITY_RESERVING_TEAM_STATUSES],
149:          ),
150:          eq(schema.users.isEmailVerified, true),
151:          isNull(schema.users.deletedAt),
152:          eq(schema.tournaments.isRanked, true),
153:          isNull(schema.tournaments.deletedAt),
154:          notInArray(schema.tournaments.status, [
155:            'COMPLETED',
156:            'CANCELLED',
157:          ]),
158:          or(
159:            isNull(schema.tournaments.endDate),
160:            gt(schema.tournaments.endDate, now),
161:          ),
162:          lt(
163:            schema.tournamentRosters.consentNotifiedCount,
164:            CONSENT_MAX_NOTIFICATIONS,
165:          ),
166:        ),
167:      );
168:
169:    let sent = 0;
170:    for (const row of due) {
171:      if (!this.isReminderDue(row, now)) continue;
172:      if (await this.dispatch(row.id, 'REMINDER')) sent += 1;
173:    }
174:    return sent;
175:  }
