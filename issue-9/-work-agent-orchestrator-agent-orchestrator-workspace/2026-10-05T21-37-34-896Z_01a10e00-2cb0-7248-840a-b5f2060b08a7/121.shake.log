48:      [schema.matches, [results.matches]],
49:      [schema.tournamentGuestRosters, [results.guestRosterRows ?? []]],
50:      [schema.tournamentRosters, results.rosterRows ?? []],
51:    ]);
52:    let selectedTable: unknown;
53:    const chain: Record<string, unknown> = {};
54:    const self = () => chain;
