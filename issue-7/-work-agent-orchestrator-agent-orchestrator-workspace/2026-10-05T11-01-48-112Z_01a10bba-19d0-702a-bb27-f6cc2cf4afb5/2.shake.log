249:  /**
250:   * Strict roster commit: every row carries a validated source and a player-one
251:   * email, is checked against the active roster and only claims capacity for
252:   * rows that will actually be written.
253:   */
254:  async importRosterRows(
255:    tournamentId: string,
256:    managerUserId: string,
257:    items: (RosterImportItem & {
258:      teamName: string;
259:      player1Name: string;
260:      player1Email: string;
261:      source: ImportSource;
262:      entryType?: RosterEntryType;
263:    })[],
264:    divisionId?: string,
265:  ) {
266:    return await this.db.transaction(async (tx) => {
267:      const tournament = await tx
268:        .select()
269:        .from(schema.tournaments)
270:        .where(eq(schema.tournaments.id, tournamentId))
271:        .limit(1)
272:        .then((res) => res[0]);
273:
274:      if (!tournament) throw new BadRequestException('Giải đấu không tồn tại');
275:
276:      let divisionMatchType = tournament.matchType;
277:      let divisionNames: string[] = [];
278:      if (divisionId) {
279:        const division = await tx
280:          .select()
281:          .from(schema.tournamentDivisions)
282:          .where(
283:            and(
284:              eq(schema.tournamentDivisions.id, divisionId),
285:              eq(schema.tournamentDivisions.tournamentId, tournamentId),
286:            ),
287:          )
288:          .limit(1)
289:          .then((res) => res[0]);
290:
291:        if (!division) {
292:          throw new BadRequestException(
293:            'Nội dung thi đấu không thuộc giải này',
294:          );
295:        }
296:        divisionMatchType = division.matchType;
297:        divisionNames = [division.name];
298:      }
299:
300:      const isDoubles =
301:        divisionMatchType === 'DOUBLES' ||
302:        divisionMatchType === 'MIXED_DOUBLES';
