130:async function findLegacyUser(
131:  tx: AppTx,
132:  email: string,
133:  phone: string | undefined,
134:): Promise<string | null> {
135:  let foundUser: typeof schema.users.$inferSelect | undefined;
136:  if (email) {
137:    foundUser = await tx
138:      .select()
139:      .from(schema.users)
140:      .where(eq(schema.users.email, email))
141:      .limit(1)
142:      .then((rows) => rows[0]);
143:  }
144:  if (!foundUser && phone) {
145:    const foundProfile = await tx
146:      .select()
147:      .from(schema.profiles)
148:      .where(eq(schema.profiles.phoneNumber, phone))
149:      .limit(1)
150:      .then((rows) => rows[0]);
151:    if (foundProfile) {
152:      foundUser = await tx
153:        .select()
154:        .from(schema.users)
155:        .where(eq(schema.users.id, foundProfile.userId))
156:        .limit(1)
157:        .then((rows) => rows[0]);
158:    }
159:  }
160:  return foundUser?.id ?? null;
161:}
