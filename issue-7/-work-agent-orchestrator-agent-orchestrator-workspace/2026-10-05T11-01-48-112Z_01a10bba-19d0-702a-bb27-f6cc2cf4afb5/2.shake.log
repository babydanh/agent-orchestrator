58:function getRosterEmails(items: readonly RosterImportItem[]): string[] {
59:  return items.flatMap((item) =>
60:    [item.player1Email, item.player2Email]
61:      .filter((email): email is string => Boolean(email))
62:      .map(normalizeRosterEmail),
63:  );
64:}
65:
66:function applyAccountStatuses(
67:  rows: RosterPreviewRow[],
68:  eligibleEmails: ReadonlySet<string>,
69:): void {
70:  for (const row of rows) {
71:    const emails = [row.player1Email, row.player2Email].filter(
72:      (email): email is string =>
73:        typeof email === 'string' && ROSTER_EMAIL_PATTERN.test(email),
74:    );
75:    for (const email of emails) {
76:      row.status.push(eligibleEmails.has(email) ? 'FOUND' : 'NOT_FOUND');
77:    }
78:  }
79:}
