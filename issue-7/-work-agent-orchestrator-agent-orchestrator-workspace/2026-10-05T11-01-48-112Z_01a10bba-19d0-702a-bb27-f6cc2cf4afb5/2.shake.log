137:/**
138: * The format failures the API would return anyway: missing name, missing or
139: * malformed email, a pair that contradicts the division format, and an address
140: * used twice in the same file. Account and tournament checks need the server.
141: */
142:export function revalidateLocally(
143:  rows: RosterDraftRow[],
144:  isDoubles: boolean,
145:): Record<number, RosterRowStatus[]> {
146:  const claimedBy = new Map<string, number[]>();
147:  for (const row of rows) {
148:    for (const email of [row.player1Email, row.player2Email]) {
149:      const normalized = email.trim().toLowerCase();
150:      if (!ROSTER_EMAIL_PATTERN.test(normalized)) continue;
151:      const owners = claimedBy.get(normalized);
152:      if (owners) owners.push(row.rowIndex);
153:      else claimedBy.set(normalized, [row.rowIndex]);
154:    }
155:  }
156:
157:  return Object.fromEntries(
158:    rows.map((row) => {
159:      const status = new Set<RosterRowStatus>();
160:      const player1Email = row.player1Email.trim().toLowerCase();
161:      const player2Email = row.player2Email.trim().toLowerCase();
162:
163:      if (!row.player1Name.trim()) status.add('MISSING_NAME');
164:      if (!player1Email) status.add('MISSING_EMAIL');
165:      else if (!ROSTER_EMAIL_PATTERN.test(player1Email)) status.add('INVALID_EMAIL');
166:      if (player2Email && !ROSTER_EMAIL_PATTERN.test(player2Email)) status.add('INVALID_EMAIL');
167:      if (isDoubles && row.player2Name.trim() && !player2Email) status.add('MISSING_EMAIL');
168:      if (
169:        isDoubles &&
170:        !row.player2Name.trim() &&
171:        (player2Email || row.player2Phone.trim())
172:      ) {
173:        status.add('PLAYER2_REQUIRED');
174:      }
175:      if (!isDoubles && (row.player2Name.trim() || player2Email || row.player2Phone.trim())) {
176:        status.add('PLAYER2_NOT_ALLOWED');
177:      }
178:      if (
179:        (claimedBy.get(player1Email)?.length ?? 0) > 1 ||
180:        (claimedBy.get(player2Email)?.length ?? 0) > 1
181:      ) {
182:        status.add('DUPLICATE_IN_FILE');
183:      }
184:
185:      return [row.rowIndex, [...status]];
186:    }),
187:  );
188:}
