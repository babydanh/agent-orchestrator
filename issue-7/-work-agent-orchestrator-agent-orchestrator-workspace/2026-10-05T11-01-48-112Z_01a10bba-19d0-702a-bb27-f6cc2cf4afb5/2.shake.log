1:import { BadRequestException } from '@nestjs/common';
2:import * as schema from '../../../database/schema';
3:import { TournamentImportRepository } from './tournament-import.repository';
4:
5:/**
6: * The current participant-import row contract.
7: *
8: * Two rules are pinned here:
9: *
10: * - An email only ever resolves to an account that already exists. A matched
11: *   address links that one account; an unmatched address stays contact metadata
12: *   on the participant row and must not become a synthetic user, a roster
13: *   member, or a notification recipient.
14: * - The one/doubles row rules the add-athlete form depends on are enforced
15: *   before any row is written, so a malformed or half-filled row leaves the
16: *   tournament untouched.
17: *
18: * Capacity limits are deliberately left generous — the user-owned capacity lock
19: * and the weighted singles/doubles slot policy are already defended by
20: * `tournament-import-capacity.spec.ts` and are not re-tested here.
21: */
22:
23:// Drizzle tables are object keys, so the lookup must be by identity.
24:const TABLE_KEYS = new Map<unknown, string>([
25:  [schema.tournaments, 'tournaments'],
26:  [schema.tournamentDivisions, 'divisions'],
27:  [schema.tournamentParticipants, 'participants'],
28:  [schema.tournamentRosters, 'rosters'],
29:  [schema.profiles, 'profiles'],
30:  [schema.users, 'users'],
31:]);
32:
33:type Row = Record<string, unknown>;
34:
35:type Insert = { table: string; values: Row };
36:
37:/**
38: * Scripted transaction double.
39: *
40: * `reads` maps a joined-table key to the rows each successive lookup on that
41: * scope returns; the final entry repeats, so a query issued more than once for
42: * the same scope keeps answering with the same answer. `users` is the account
43: * directory: each queued entry is the account an email/phone lookup finds, and
44: * an empty entry models "no such account". No scope can insert a user — a
45: * synthetic account would be recorded as an insert and fail the assertions.
46: */
47:function createHarness(reads: Record<string, Row[][]>, users: Row[][]) {
48:  const inserts: Insert[] = [];
49:  const scopes: Record<string, Row[][]> = { ...reads, users };
50:
51:  const takeRows = (key: string): Row[] => {
52:    const queue = scopes[key];
53:    if (!queue || queue.length === 0) return [];
54:    return queue.length === 1 ? queue[0] : queue.shift()!;
55:  };
56:
57:  const tableKey = (tables: string[]): string =>
58:    [...new Set(tables)].sort().join('+');
59:
60:  // Occupancy rows are projected onto the columns the capacity query asked for,
61:  // exactly as the real grouped join would return them.
62:  const projectOccupancyRow = (
63:    fields: Record<string, unknown>,
64:    row: Row,
65:  ): Row => {
66:    const projected: Row = { rosterMemberCount: row.rosterMemberCount };
67:    for (const [key, column] of Object.entries(fields)) {
68:      if (key === 'rosterMemberCount') continue;
69:      if (column === schema.tournamentParticipants.tournamentDivisionId) {
70:        projected[key] =
71:          row.divisionId !== undefined ? row.divisionId : row.scopeId;
72:      } else if (column === schema.tournamentParticipants.tournamentId) {
73:        projected[key] = row.tournamentId ?? row.scopeId ?? null;
74:      } else {
75:        projected[key] = row[key];
76:      }
77:    }
78:    return projected;
79:  };
80:
81:  const tx = {
82:    select: (fields?: Record<string, unknown>) => {
83:      const tables: string[] = [];
84:      const query: Record<string, unknown> = {};
85:
86:      const record =
87:        (fn: (...args: unknown[]) => unknown) =>
88:        (...args: unknown[]) => {
89:          for (const arg of args) {
90:            const name = TABLE_KEYS.get(arg);
91:            if (name) tables.push(name);
92:          }
93:          return fn(...args);
94:        };
95:
96:      query.from = record(() => query);
97:      query.innerJoin = record(() => query);
98:      query.leftJoin = record(() => query);
99:      query.where = () => query;
100:      query.groupBy = () => query;
101:      query.orderBy = () => query;
102:      query.limit = () => query;
103:      query.for = () => query;
104:      query.then = (
105:        resolve: (value: unknown) => unknown,
106:        reject?: (reason: unknown) => unknown,
107:      ) =>
108:        Promise.resolve()
109:          .then(() => {
110:            const rows = takeRows(tableKey(tables));
111:            return fields && 'rosterMemberCount' in fields
112:              ? rows.map((row) => projectOccupancyRow(fields, row))
113:              : rows;
114:          })
115:          .then(resolve, reject);
116:
117:      return query;
118:    },
119:    insert: (table: unknown) => {
120:      const name = TABLE_KEYS.get(table) ?? 'unknown';
121:      return {
122:        values: (values: Row) => {
123:          inserts.push({ table: name, values });
124:          return {
125:            returning: async () => [
126:              { id: `participant-${inserts.length}`, ...values },
127:            ],
128:          };
129:        },
130:      };
131:    },
132:  };
133:
134:  return { tx: tx as unknown as Record<string, unknown>, inserts };
135:}
