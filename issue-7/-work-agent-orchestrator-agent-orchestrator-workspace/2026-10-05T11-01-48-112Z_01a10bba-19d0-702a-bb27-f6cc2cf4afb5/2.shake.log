239: * Weaker than an address on purpose: it cannot tell two different athletes with
240: * the same team name apart, and it cannot be compared against entries already
241: * in the tournament. But it is the only thing left when the address is blank,
242: * and without it importing the same file twice silently doubles the roster.
243: */
244:const rosterIdentityKey = (item: {
245:  teamName?: string;
246:  divisionName?: string;
247:  player1Name?: string;
248:}): string =>
249:  [item.teamName ?? '', item.divisionName ?? '', item.player1Name ?? '']
250:    .map((part) => part.trim().toLowerCase())
251:    .join(' ');
252:
253:export function validateRosterRows(
254:  input: ValidateRosterRowsInput,
255:): ValidatedRosterRows {
256:  const {
257:    items,
258:    isDoubles,
259:    matchType,
260:    tournamentConfig,
261:    divisionNames,
262:    existingEmails,
263:  } = input;
264:
265:  // An address claimed by more than one row is a file-level duplicate, so it
266:  // can only be decided once the whole batch has been seen.
267:  const claimedBy = new Map<string, number[]>();
268:  const rows: RosterPreviewRow[] = [];
269:
270:  const claimEmail = (email: string, rowIndex: number): void => {
271:    const owners = claimedBy.get(email);
272:    if (owners) owners.push(rowIndex);
273:    else claimedBy.set(email, [rowIndex]);
274:  };
275:
276:  // Rows with no address never enter claimedBy, because claiming is gated on
277:  // the address pattern. Once MISSING_EMAIL stopped blocking, that left them
278:  // with no duplicate detection at all, so they are keyed separately.
279:  const claimedByIdentity = new Map<string, number[]>();
280:  const claimIdentity = (key: string, rowIndex: number): void => {
281:    const owners = claimedByIdentity.get(key);
282:    if (owners) owners.push(rowIndex);
283:    else claimedByIdentity.set(key, [rowIndex]);
284:  };
285:
286:  for (const [rowIndex, item] of items.entries()) {
287:    const status = new Set<RosterRowStatus>();
288:    const player1Email = item.player1Email
289:      ? normalizeRosterEmail(item.player1Email)
290:      : '';
291:    const player2Email = item.player2Email?.trim()
292:      ? normalizeRosterEmail(item.player2Email)
293:      : null;
294:
295:    if (!item.player1Name?.trim()) status.add('MISSING_NAME');
296:    if (!player1Email) status.add('MISSING_EMAIL');
297:    else if (!ROSTER_EMAIL_PATTERN.test(player1Email)) {
298:      status.add('INVALID_EMAIL');
299:    }
300:
301:    if (
302:      isDoubles &&
303:      !item.player2Name?.trim() &&
304:      (item.player2Email?.trim() || item.player2Phone?.trim())
305:    ) {
306:      status.add('PLAYER2_REQUIRED');
307:    }
308:    if (
309:      isDoubles &&
310:      item.player2Name?.trim() &&
311:      !player2Email
312:    ) {
313:      status.add('MISSING_EMAIL');
314:    }
315:    if (
316:      !isDoubles &&
317:      (item.player2Name?.trim() ||
318:        item.player2Email?.trim() ||
319:        item.player2Phone?.trim())
320:    ) {
321:      status.add('PLAYER2_NOT_ALLOWED');
322:    }
323:    if (player2Email && !ROSTER_EMAIL_PATTERN.test(player2Email)) {
324:      status.add('INVALID_EMAIL');
325:    }
326:
327:    const divisionName = item.divisionName?.trim();
328:    if (
329:      divisionName &&
330:      divisionNames &&
331:      !divisionNames.some(
332:        (name) => name.trim().toLowerCase() === divisionName.toLowerCase(),
333:      )
334:    ) {
335:      status.add('DIVISION_UNKNOWN');
336:    }
337:
338:    // Keep both occurrences so an address used twice on the same pair row is
339:    // rejected as a duplicate just like an address reused across two rows.
340:    if (ROSTER_EMAIL_PATTERN.test(player1Email)) {
341:      claimEmail(player1Email, rowIndex);
342:    }
343:    if (!player1Email) {
344:      claimIdentity(rosterIdentityKey(item), rowIndex);
345:    }
346:    if (player2Email && ROSTER_EMAIL_PATTERN.test(player2Email)) {
347:      claimEmail(player2Email, rowIndex);
348:    }
349:    if (player1Email && existingEmails?.has(player1Email)) {
350:      status.add('DUPLICATE_IN_TOURNAMENT');
351:    }
352:    if (player2Email && existingEmails?.has(player2Email)) {
353:      status.add('DUPLICATE_IN_TOURNAMENT');
354:    }
355:
356:    const capacityDelta = calculateRequestedTeamSlots(
357:      matchType,
358:      item.player2Name?.trim() ? 2 : 1,
359:      { tournamentConfig },
360:    );
361:
362:    rows.push({
363:      rowIndex,
364:      player1Email,
365:      player2Email,
366:      status: [...status],
367:      isEligible: [...status].every((code) => !isBlockingRosterStatus(code)),
368:      capacityDelta,
369:    });
370:  }
371:
372:  for (const owners of claimedBy.values()) {
373:    if (owners.length < 2) continue;
374:    for (const rowIndex of owners) {
375:      const row = rows[rowIndex];
376:      if (row.status.includes('DUPLICATE_IN_FILE')) continue;
377:      row.status.push('DUPLICATE_IN_FILE');
378:      row.isEligible = false;
379:    }
380:  }
381:  for (const owners of claimedByIdentity.values()) {
382:    if (owners.length < 2) continue;
383:    for (const rowIndex of owners) {
384:      const row = rows[rowIndex];
385:      if (row.status.includes('DUPLICATE_IN_FILE')) continue;
386:      row.status.push('DUPLICATE_IN_FILE');
387:      row.isEligible = false;
388:    }
389:  }
390:  const requestedTeamSlots = rows.reduce(
391:    (total, row) => total + (row.isEligible ? row.capacityDelta : 0),
392:    0,
393:  );
394:
395:  return { rows, requestedTeamSlots };
396:}

