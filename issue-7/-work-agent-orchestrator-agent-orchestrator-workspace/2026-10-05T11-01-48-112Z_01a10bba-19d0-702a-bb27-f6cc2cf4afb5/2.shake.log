33:
34:  constructor(
35:    @Inject(PG_CONNECTION) private readonly db: AppDb,
36:    private readonly rankingsService: RankingsService,
37:  ) {
38:    this.instanceId =
39:      process.env.HOSTNAME || process.env.POD_NAME || `${require('os').hostname()}-${process.pid}`;
40:  }
41:
42:  @Cron(CronExpression.EVERY_30_SECONDS)
43:  async processOutbox(): Promise<void> {
44:    if (this.running) return;
45:    this.running = true;
46:    let claimed = 0;
47:    try {
48:      while (claimed < 20) {
49:        const row = await this.claimOne();
50:        if (!row) break;
51:        claimed += 1;
52:        await this.processClaimed(row);
53:      }
54:    } catch (err) {
55:      this.logger.error(`ELO outbox cycle failed: ${(err as Error).message}`, (err as Error).stack);
56:    } finally {
57:      this.running = false;
58:    }
59:  }
60:
61:  /** Fire-and-forget safe entry point used only after the score transaction commits. */
62:  async dispatchNow(): Promise<void> {
63:    await this.processOutbox();
64:  }
65:
66:  setClubMatchUpdatePublisher(
67:    publisher: (matchId: string) => Promise<void>,
68:  ): void {
69:    this.clubMatchUpdatePublisher = publisher;
70:  }
71:
72:  setStandaloneMatchUpdatePublisher(
73:    publisher: (matchId: string) => Promise<void>,
74:  ): void {
75:    this.standaloneMatchUpdatePublisher = publisher;
76:  }
77:
78:  private async publishClubMatchUpdate(matchId: string | null): Promise<void> {
79:    if (!matchId || !this.clubMatchUpdatePublisher) return;
80:    try {
81:      await this.clubMatchUpdatePublisher(matchId);
82:    } catch (error) {
83:      this.logger.warn(
84:        `Unable to publish club match ELO update for ${matchId}: ${(error as Error).message}`,
85:      );
86:    }
87:  }
88:
89:  private async publishStandaloneMatchUpdate(matchId: string | null): Promise<void> {
90:    if (!matchId || !this.standaloneMatchUpdatePublisher) return;
91:    try {
92:      await this.standaloneMatchUpdatePublisher(matchId);
93:    } catch (error) {
94:      this.logger.warn(
95:        `Unable to publish standalone match ELO update for ${matchId}: ${(error as Error).message}`,
96:      );
97:    }
98:  }
99:
100:  private async claimOne(): Promise<
101:    | {
102:        id: string;
103:        match_id: string | null;
104:        club_match_session_match_id: string | null;
105:        standalone_match_id: string | null;
106:      }
107:    | null
108:  > {
109:    const result = (await this.db.execute(sql`
110:      WITH candidate AS (
111:        SELECT id FROM match_elo_outbox
112:        WHERE (
113:          (status = 'PENDING' AND (next_attempt_at IS NULL OR next_attempt_at <= now()))
114:          OR
115:          (status = 'PROCESSING' AND locked_at IS NOT NULL
116:             AND locked_at < now() - interval '${sql.raw(String(LEASE_TIMEOUT_MINUTES))} minutes')
117:        )
118:          AND attempts < ${RETRY_CAP}
119:        ORDER BY created_at
120:        LIMIT 1
121:        FOR UPDATE SKIP LOCKED
122:      )
123:      UPDATE match_elo_outbox
124:      SET status = 'PROCESSING',
125:          locked_at = now(),
126:          locked_by = ${this.instanceId},
127:          attempts = attempts + 1,
128:          last_error = NULL
129:      WHERE id IN (SELECT id FROM candidate)
130:      RETURNING id, match_id, club_match_session_match_id, standalone_match_id
131:    `)) as unknown as Array<{
132:      id: string;
133:      match_id: string | null;
134:      club_match_session_match_id: string | null;
135:      standalone_match_id: string | null;
136:    }>;
137:
138:    return result[0] ?? null;
139:  }
140:
141:  private async processClaimed(row: {
142:    id: string;
143:    match_id: string | null;
144:    club_match_session_match_id: string | null;
145:    standalone_match_id: string | null;
146:  }): Promise<void> {
147:    try {
148:      if (row.club_match_session_match_id) {
149:        await this.rankingsService.processClubMatchResultFromOutbox(
150:          row.club_match_session_match_id,
151:        );
152:      } else if (row.standalone_match_id) {
153:        await this.rankingsService.processStandaloneMatchResultFromOutbox(
154:          row.standalone_match_id,
155:        );
156:      } else if (row.match_id) {
157:        await this.rankingsService.processMatchResultFromOutbox(row.match_id);
158:      } else {
159:        throw new Error('ELO outbox row has no match context');
160:      }
161:      await this.db.execute(sql`
162:        UPDATE match_elo_outbox
163:        SET status = 'PROCESSED', processed_at = now(), locked_at = NULL, locked_by = NULL
164:        WHERE id = ${row.id}
165:      `);
166:      await this.publishClubMatchUpdate(row.club_match_session_match_id);
167:      await this.publishStandaloneMatchUpdate(row.standalone_match_id);
168:    } catch (err) {
169:      const message = (err as Error).message ?? String(err);
170:      // Retryable (transient) + under cap → back to PENDING with backoff.
171:      const attemptsResult = (await this.db.execute(sql`
172:        SELECT attempts FROM match_elo_outbox WHERE id = ${row.id}
173:      `)) as unknown as Array<{ attempts: string }>;
174:      const attempts = attemptsResult[0] ? Number(attemptsResult[0].attempts) : 1;
175:
176:      if (attempts < RETRY_CAP) {
177:        const backoffSeconds = Math.min(2 ** attempts, 300);
178:        await this.db.execute(sql`
179:          UPDATE match_elo_outbox
180:          SET status = 'PENDING',
181:              next_attempt_at = now() + interval '${sql.raw(String(backoffSeconds))} seconds',
182:              locked_at = NULL, locked_by = NULL,
183:              last_error = ${message}
184:          WHERE id = ${row.id}
185:        `);
186:        if (row.club_match_session_match_id) {
187:          await this.db.execute(sql`
188:            UPDATE club_match_session_matches SET elo_status = 'FAILED_RETRYABLE', updated_at = now()
189:            WHERE id = ${row.club_match_session_match_id}
190:          `);
191:        }
192:        if (row.standalone_match_id) {
193:          await this.db.execute(sql`
194:            UPDATE club_standalone_matches SET elo_status = 'FAILED_RETRYABLE', updated_at = now()
195:            WHERE id = ${row.standalone_match_id}
196:          `);
197:        }
198:        await this.publishClubMatchUpdate(row.club_match_session_match_id);
199:        await this.publishStandaloneMatchUpdate(row.standalone_match_id);
200:        this.logger.warn(`ELO outbox retry (attempt ${attempts}/${RETRY_CAP}) for match ${row.match_id ?? row.club_match_session_match_id}: ${message}`);
201:      } else {
202:        // Terminal failure after retry cap.
203:        await this.db.execute(sql`
204:          UPDATE match_elo_outbox
205:          SET status = 'FAILED', locked_at = NULL, locked_by = NULL, last_error = ${message}
206:          WHERE id = ${row.id}
207:        `);
208:        if (row.club_match_session_match_id) {
209:          await this.db.execute(sql`
210:            UPDATE club_match_session_matches SET elo_status = 'FAILED_TERMINAL', updated_at = now()
211:            WHERE id = ${row.club_match_session_match_id}
212:          `);
213:        }
214:        if (row.standalone_match_id) {
215:          await this.db.execute(sql`
216:            UPDATE club_standalone_matches SET elo_status = 'FAILED_TERMINAL', updated_at = now()
217:            WHERE id = ${row.standalone_match_id}
218:          `);
219:        }
220:        await this.publishClubMatchUpdate(row.club_match_session_match_id);
221:        await this.publishStandaloneMatchUpdate(row.standalone_match_id);
222:        this.logger.error(`ELO outbox FAILED (terminal) for match ${row.match_id ?? row.club_match_session_match_id}: ${message}`);
223:      }
224:    }
225:  }
