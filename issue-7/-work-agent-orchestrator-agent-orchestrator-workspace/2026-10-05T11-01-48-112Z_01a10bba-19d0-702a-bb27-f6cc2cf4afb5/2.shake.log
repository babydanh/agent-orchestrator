1:import { Injectable, NotFoundException, Logger } from '@nestjs/common';
2:import { CreateNotificationDto } from './dto/create-notification.dto';
3:import { NOTIFICATION_TYPES } from './notification-types';
4:import { QueryNotificationsDto } from './dto/query-notifications.dto';
5:import { RegisterDeviceTokenDto, RemoveDeviceTokenDto } from './dto/register-device-token.dto';
6:import { NotificationsGateway } from './notifications.gateway';
7:import { NotificationsRepository } from './notifications.repository';
8:import { FirebaseService } from '../firebase/firebase.service';
9:
10:@Injectable()
11:export class NotificationsService {
12:  private readonly logger = new Logger(NotificationsService.name);
13:
14:  constructor(
15:    private readonly notificationsRepository: NotificationsRepository,
16:    private readonly notificationsGateway: NotificationsGateway,
17:    private readonly firebaseService: FirebaseService,
18:  ) {}
19:
20:  async registerDeviceToken(userId: string, dto: RegisterDeviceTokenDto) {
21:    return this.firebaseService.registerDeviceToken(
22:      userId,
23:      dto.token,
24:      dto.platform || 'ANDROID',
25:      dto.deviceInfo,
26:    );
27:  }
28:
29:  async removeDeviceToken(userId: string, dto: RemoveDeviceTokenDto) {
30:    return this.firebaseService.removeDeviceToken(userId, dto.token);
31:  }
32:
33:  async sendNotification(data: CreateNotificationDto) {
34:    const notification = await this.notificationsRepository.createNotification(data);
35:    // A referee invitation shows who invited the referee. Every other type keeps
36:    // its existing payload, so nothing new is published beyond that invitation.
37:    const isRefereeInvitation = data.type === NOTIFICATION_TYPES.REFEREE_INVITED;
38:    const senderProfile =
39:      isRefereeInvitation && data.senderId
40:        ? await this.notificationsRepository.findSenderProfile(data.senderId)
41:        : null;
42:
43:    // 1. Socket.IO (In-app real-time notification)
44:    // The payload carries the same sender identity the recipient read endpoint
45:    // returns, so a live item is attributed exactly like a fetched one.
46:    this.notificationsGateway.pushNotification(data.receiverId, {
47:      ...notification,
48:      senderName: senderProfile?.fullName ?? null,
49:      senderAvatarUrl: senderProfile?.avatarUrl ?? null,
50:    });
51:
52:    // 2. Firebase Cloud Messaging (OS Push Notification to lockscreen / system tray)
53:    try {
54:      await this.firebaseService.sendPushToUser(data.receiverId, {
55:        title: data.title,
56:        body: data.content,
57:        data: {
58:          notificationId: notification.id,
59:          type: data.type,
60:          redirectUrl: data.redirectUrl || '',
61:        },
62:      });
63:    } catch (err: any) {
64:      this.logger.warn(`Failed to dispatch FCM push for notification ${notification.id}: ${err?.message || err}`);
65:    }
66:
67:    return notification;
68:  }
69:
70:  async getMyNotifications(userId: string, query: QueryNotificationsDto) {
71:    return this.notificationsRepository.getNotificationsByUser(userId, query);
72:  }
73:
74:  async getUnreadCount(userId: string, scope: 'player' | 'management' = 'player') {
75:    const count = await this.notificationsRepository.getUnreadCountByUser(userId, scope);
76:    return { count };
77:  }
78:
79:  async markAsRead(id: string, userId: string) {
80:    const notification = await this.notificationsRepository.markAsRead(id, userId);
81:
82:    if (!notification) {
83:      throw new NotFoundException('Notification not found');
84:    }
85:
86:    return notification;
87:  }
88:
89:  async markAllAsRead(userId: string, scope: 'player' | 'management' = 'player') {
90:    return this.notificationsRepository.markAllAsRead(userId, scope);
91:  }
92:
93:  async deleteByReceiverTypeAndRedirect(
94:    receiverId: string,
95:    type: string,
96:    redirectUrl: string,
97:  ) {
98:    return this.notificationsRepository.deleteByReceiverTypeAndRedirect(
99:      receiverId,
100:      type,
101:      redirectUrl,
102:    );
103:  }
104:}

