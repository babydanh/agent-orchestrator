66:
67:  async sendConfirmation(
68:    participantId: string,
69:    recipientEmail: string,
70:    participantName: string,
71:    tournamentName: string,
72:  ): Promise<boolean> {
73:    const email = normalizedEmail(recipientEmail);
74:    if (!email) return false;
75:
76:    try {
77:      const token = jwt.sign(
78:        { purpose: TOKEN_PURPOSE, participantId, email },
79:        this.jwtSecret(),
80:        { expiresIn: '7d' },
81:      );
82:      const frontendUrl = (
83:        this.configService.get<string>('FRONTEND_URL') || 'http://localhost:3101'
84:      ).replace(/\/+$/, '');
85:      const confirmUrl = `${frontendUrl}/tournaments/ranking-consent?token=${encodeURIComponent(token)}`;
86:      const safeName = escapeHtml(participantName);
87:      const safeTournamentName = escapeHtml(tournamentName);
88:      const html = `
89:        <p>Xin chào ${safeName},</p>
90:        <p>Ban tổ chức đã ghi nhận bạn tham gia giải <strong>${safeTournamentName}</strong>.</p>
91:        <p><strong>Bạn đã tham gia giải này chưa? Có phải bạn không?</strong></p>
92:        <p>Chỉ khi bạn chủ động xác nhận, kết quả các trận đấu sau đó mới được tính vào bảng xếp hạng ELO. Trận đã diễn ra trước lúc xác nhận sẽ không được tính.</p>
93:        <p><a href="${confirmUrl}">Xác nhận tôi đã tham gia</a></p>
94:        <p>Nếu chưa có tài khoản, hãy đăng ký hoặc đăng nhập bằng email này trước khi xác nhận.</p>
95:      `;
96:
97:      return await this.mailService.sendMail(
98:        email,
99:        `Xác nhận tham gia giải ${tournamentName}`,
100:        html,
101:      );
102:    } catch (error) {
103:      this.logger.warn('Không gửi được email xác nhận consent ELO.');
104:      return false;
105:    }
106:  }
107:
108:  async handleAccountAccess(userId: string, emailValue: string): Promise<number> {
109:    const email = normalizedEmail(emailValue);
110:    if (!email) return 0;
111:
112:    try {
113:      const rows = await this.db
114:        .select({
115:          participantId: schema.tournamentParticipants.id,
116:          participantName: schema.tournamentParticipants.teamName,
117:          tournamentName: schema.tournaments.name,
118:          customResponses: schema.tournamentParticipants.customResponses,
119:        })
120:        .from(schema.tournamentParticipants)
121:        .innerJoin(
122:          schema.tournaments,
123:          eq(schema.tournamentParticipants.tournamentId, schema.tournaments.id),
124:        )
125:        .where(
126:          and(
127:            eq(schema.tournamentParticipants.rankingConsent, false),
128:            eq(schema.tournamentParticipants.isMock, false),
129:            or(
130:              sql`lower(${schema.tournamentParticipants.customResponses}->>'player1Email') = ${email}`,
131:              sql`lower(${schema.tournamentParticipants.customResponses}->>'player2Email') = ${email}`,
132:            ),
133:          ),
134:        );
135:
136:      let notifiedCount = 0;
137:      for (const row of rows) {
138:        if (!participantEmails(row.customResponses).includes(email)) continue;
139:        await this.linkRosterAccount(row, userId, email);
140:        if (
141:          await this.sendConfirmation(
142:            row.participantId,
143:            email,
144:            row.participantName,
145:            row.tournamentName,
146:          )
147:        ) {
148:          notifiedCount += 1;
149:        }
150:      }
151:      return notifiedCount;
152:    } catch (error) {
153:      this.logger.warn('Không xử lý được email participant consent sau khi đăng nhập.');
154:      return 0;
155:    }
156:  }
157:
158:  async confirm(token: string): Promise<{ confirmed: true }> {
159:    let claims: ConsentToken;
160:    try {
161:      const decoded = jwt.verify(token, this.jwtSecret());
162:      if (
163:        typeof decoded === 'string' ||
164:        decoded.purpose !== TOKEN_PURPOSE ||
165:        typeof decoded.participantId !== 'string' ||
166:        !normalizedEmail(decoded.email)
167:      ) {
168:        throw new Error('Invalid consent token');
169:      }
170:      claims = decoded as ConsentToken;
171:    } catch {
172:      throw new BadRequestException('Liên kết xác nhận không hợp lệ hoặc đã hết hạn.');
173:    }
174:
175:    const email = normalizedEmail(claims.email);
176:    if (!email) {
177:      throw new BadRequestException('Email xác nhận không hợp lệ.');
178:    }
179:
180:    const [participant] = await this.db
181:      .select({
182:        participantId: schema.tournamentParticipants.id,
183:        rankingConsent: schema.tournamentParticipants.rankingConsent,
184:        isMock: schema.tournamentParticipants.isMock,
185:        customResponses: schema.tournamentParticipants.customResponses,
186:      })
187:      .from(schema.tournamentParticipants)
188:      .where(eq(schema.tournamentParticipants.id, claims.participantId))
189:      .limit(1);
190:
191:    if (
192:      !participant ||
193:      participant.isMock ||
194:      !participantEmails(participant.customResponses).includes(email)
195:    ) {
196:      throw new BadRequestException('Không tìm thấy participant đăng ký bằng email này.');
197:    }
198:
199:    const [user] = await this.db
200:      .select({ id: schema.users.id })
201:      .from(schema.users)
202:      .where(sql`lower(${schema.users.email}) = ${email}`)
203:      .limit(1);
204:
205:    if (!user) {
206:      throw new BadRequestException(
207:        'Vui lòng đăng ký hoặc đăng nhập bằng email này trước khi xác nhận.',
208:      );
209:    }
210:
211:    await this.linkRosterAccount(participant, user.id, email);
212:    if (!participant.rankingConsent) {
213:      await this.db
214:        .update(schema.tournamentParticipants)
215:        .set({ rankingConsent: true })
216:        .where(eq(schema.tournamentParticipants.id, claims.participantId));
217:    }
218:
219:    return { confirmed: true };
220:  }
221:
222:  private async linkRosterAccount(
223:    participant: ParticipantConsentRow,
224:    userId: string,
225:    email: string,
226:  ): Promise<void> {
227:    const responses = responsesOf(participant.customResponses);
228:    const role = normalizedEmail(responses.player2Email) === email ? 'MAIN' : 'MAIN';
229:    await this.db
230:      .insert(schema.tournamentRosters)
231:      .values({ participantId: participant.participantId, userId, role });
232:  }
233:
234:  private jwtSecret(): string {
235:    const secret = this.configService.get<string>('auth.jwtAccessSecret');
236:    if (!secret) throw new Error('JWT access secret is not configured');
237:    return secret;
238:  }
