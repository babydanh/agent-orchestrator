10:const TOKEN_PURPOSE = 'tournament-participant-ranking-consent';
11:const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
12:
13:type ConsentToken = jwt.JwtPayload & {
14:  purpose: typeof TOKEN_PURPOSE;
15:  participantId: string;
16:  email: string;
17:};
18:
19:type ParticipantConsentRow = {
20:  participantId: string;
21:  participantName: string;
22:  tournamentName: string;
23:  customResponses: unknown;
24:};
25:
26:function normalizedEmail(value: unknown): string | null {
27:  if (typeof value !== 'string') return null;
28:  const email = value.trim().toLowerCase();
29:  return EMAIL_PATTERN.test(email) ? email : null;
30:}
31:
32:function responsesOf(value: unknown): Record<string, unknown> {
33:  return value && typeof value === 'object' && !Array.isArray(value)
34:    ? (value as Record<string, unknown>)
35:    : {};
36:}
37:
38:function participantEmails(value: unknown): string[] {
39:  const responses = responsesOf(value);
40:  return [responses.player1Email, responses.player2Email]
41:    .map(normalizedEmail)
42:    .filter((email): email is string => email !== null);
43:}
44:
45:function escapeHtml(value: string): string {
46:  return value.replace(/[&<>"']/g, (character) => {
47:    switch (character) {
48:      case '&': return '&amp;';
49:      case '<': return '&lt;';
50:      case '>': return '&gt;';
51:      case '"': return '&quot;';
52:      default: return '&#39;';
53:    }
54:  });
55:}
