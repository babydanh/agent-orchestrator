30:function getRosterValidationMessage(
31:  rowIndex: number,
32:  status: RosterRowStatus,
33:): string {
34:  const rowNumber = rowIndex + 1;
35:  switch (status) {
36:    case 'MISSING_NAME':
37:      return `Dòng ${rowNumber} thiếu tên VĐV 1`;
38:    case 'MISSING_EMAIL':
39:      return `Dòng ${rowNumber} thiếu email VĐV`;
40:    case 'INVALID_EMAIL':
41:      return `Dòng ${rowNumber} có email không hợp lệ`;
42:    case 'DUPLICATE_IN_FILE':
43:      return `Dòng ${rowNumber} dùng email đã xuất hiện trong danh sách`;
44:    case 'DUPLICATE_IN_TOURNAMENT':
45:      return `Dòng ${rowNumber} có VĐV đã tham gia giải`;
46:    case 'PLAYER2_REQUIRED':
47:      return `Dòng ${rowNumber} có thông tin VĐV 2 nhưng thiếu tên`;
48:    case 'PLAYER2_NOT_ALLOWED':
49:      return `Dòng ${rowNumber} của nội dung đơn có dữ liệu VĐV 2`;
50:    case 'DIVISION_UNKNOWN':
51:      return `Dòng ${rowNumber} có nội dung thi đấu không khớp`;
52:    case 'FOUND':
53:    case 'NOT_FOUND':
54:      return `Dòng ${rowNumber} không hợp lệ`;
55:  }
56:}
