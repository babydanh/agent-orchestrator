5:@Injectable()
6:export class MailService implements OnModuleInit {
7:  private readonly logger = new Logger(MailService.name);
8:  private transporter: nodemailer.Transporter | null = null;
9:  private readonly from: string;
10:  private readonly isProduction: boolean;
11:
12:  constructor(private readonly configService: ConfigService) {
13:    const host = this.configService.get<string>('SMTP_HOST') || 'smtp.larksuite.com';
14:    const configuredPort = this.configService.get<string | number>('SMTP_PORT');
15:    const parsedPort = Number(configuredPort);
16:    const port = Number.isFinite(parsedPort) && parsedPort > 0 ? parsedPort : 465;
17:    const configuredSecure = this.configService.get<string | boolean>('SMTP_SECURE');
18:    const secure =
19:      typeof configuredSecure === 'boolean'
20:        ? configuredSecure
21:        : configuredSecure === undefined || configuredSecure === ''
22:          ? port === 465
23:          : configuredSecure === 'true';
24:    const user = this.configService.get<string>('SMTP_USER');
25:    const pass = this.configService.get<string>('SMTP_PASS');
26:    this.from =
27:      this.configService.get<string>('SMTP_FROM') ||
28:      '"Noreply" <noreply@sporto.asia>';
29:    this.isProduction = this.configService.get<string>('NODE_ENV') === 'production';
30:
31:    if (!user || !pass) {
32:      this.logger.warn(
33:        this.isProduction
34:          ? 'SMTP credentials are missing; production email delivery is disabled.'
35:          : 'SMTP credentials are missing; development email delivery will be mocked to console.',
36:      );
37:      return;
38:    }
39:
40:    this.transporter = nodemailer.createTransport({
41:      host,
42:      port,
43:      secure,
44:      connectionTimeout: 10000,
45:      greetingTimeout: 10000,
46:      socketTimeout: 20000,
47:      auth: {
48:        user,
49:        pass,
50:      },
51:    });
52:  }
53:
54:  async onModuleInit(): Promise<void> {
55:    if (!this.transporter) {
56:      return;
57:    }
58:
59:    try {
60:      await this.transporter.verify();
61:      this.logger.log('SMTP connection verified.');
62:    } catch {
63:      // Keep boot resilient, but make the provider problem visible without leaking credentials.
64:      this.logger.error(
65:        'SMTP connection verification failed; email jobs will remain visible as failed until the provider configuration is fixed.',
66:      );
67:    }
68:  }
69:
