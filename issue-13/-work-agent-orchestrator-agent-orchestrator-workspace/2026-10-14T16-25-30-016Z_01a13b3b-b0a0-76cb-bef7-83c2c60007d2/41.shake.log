544:          fi
545:          gh issue comment "$ISSUE_NUMBER" --repo "${{ github.repository }}" \
546:            --body "**OMP Orchestrator:** $HEADLINE
547:
548:          Nhánh đã push (nếu có):
549:          ${{ env.PUSHED_REPOS }}
550:
551:          Log và artifact (Allure/Playwright): $RUN_URL
552:
553:          Để kéo code và session về máy: \`powershell C:\Users\GIGABYTE\.omp\scripts\cancel-cloud-and-pull.ps1\`"
554:
555:      - name: 8.5 Lưu và đồng bộ phiên làm việc (Session Sync) lên branch omp-sync/sessions
556:        if: always()
557:        env:
558:          GH_PAT: ${{ secrets.GH_PAT || secrets.GITHUB_TOKEN }}
559:          ISSUE_NUMBER: ${{ github.event.issue.number || github.run_number }}
560:        run: |
561:          echo "Đang lưu phiên làm việc OMP lên branch omp-sync/sessions..."
562:          if [ -d "$HOME/.omp/agent/sessions" ] && [ "$(ls -A $HOME/.omp/agent/sessions 2>/dev/null)" ]; then
563:            git config --global user.name "github-actions[bot]"
564:            git config --global user.email "github-actions[bot]@users.noreply.github.com"
565:
566:            rm -rf /tmp/session_repo
567:            git clone --branch omp-sync/sessions "https://${GH_PAT}@github.com/${{ github.repository }}.git" /tmp/session_repo || {
568:              mkdir -p /tmp/session_repo && cd /tmp/session_repo
569:              git init && git checkout -b omp-sync/sessions
570:              git remote add origin "https://${GH_PAT}@github.com/${{ github.repository }}.git"
571:            }
572:
573:            cd /tmp/session_repo
574:            mkdir -p "issue-$ISSUE_NUMBER"
575:            cp -r $HOME/.omp/agent/sessions/* "issue-$ISSUE_NUMBER/" 2>/dev/null || true
576:
577:            # Khử toàn bộ token / secret nhạy cảm trước khi commit để không bị GitHub Secret Scanning chặn push
578:            if [ -n "$GH_PAT" ]; then
579:              grep -rl "$GH_PAT" "issue-$ISSUE_NUMBER" 2>/dev/null | xargs sed -i "s/$GH_PAT/***/g" 2>/dev/null || true
580:            fi
581:            find "issue-$ISSUE_NUMBER" -type f \( -name "*.json" -o -name "*.jsonl" -o -name "*.txt" -o -name "*.log" \) -exec sed -i -E 's/ghp_[a-zA-Z0-9]{36}/***/g; s/github_pat_[a-zA-Z0-9_]{82}/***/g; s/sk-or-v1-[a-f0-9]{64}/***/g' {} + 2>/dev/null || true
582:
583:            git add .
584:            if ! git diff --cached --quiet; then
585:              git commit -m "chore(session): update session state for issue #$ISSUE_NUMBER"
586:              git push origin omp-sync/sessions || echo "Warning: Push to omp-sync/sessions skipped or blocked by repository rules."
587:              echo "Đã xử lý lưu session lên branch omp-sync/sessions!"
588:            else
589:              echo "Không có thay đổi trong session, bỏ qua push."
590:            fi
591:          fi
592:
593:      - name: 9. Tự động đồng bộ & lưu mới Token Codex OAuth vào GitHub Secrets (Auto-Persist)
594:        if: always()
595:        env:
596:          GH_PAT: ${{ secrets.GH_PAT }}
597:          REPO: ${{ github.repository }}
598:        run: |
599:          echo "Kiểm tra và cập nhật Token Codex OAuth mới nhất từ agent.db..."
600:          pip install --quiet pynacl requests
601:          python3 -c "
602:          import sqlite3, base64, os, sys, requests
603:          from nacl import encoding, public
604:
605:          token = os.environ.get('GH_PAT')
606:          repo = os.environ.get('REPO')
607:          if not token or not repo:
608:              print('Thiếu GH_PAT hoặc REPO, bỏ qua auto-update secret.')
609:              sys.exit(0)
610:
611:          db_path = os.path.expanduser('~/.omp/agent/agent.db')
612:          if not os.path.exists(db_path):
613:              print('Không tìm thấy agent.db.')
614:              sys.exit(0)
615:
616:          con = sqlite3.connect(db_path)
617:          cur = con.cursor()
618:          cur.execute(\"SELECT data FROM auth_credentials WHERE provider = 'openai-codex'\")
619:          row = cur.fetchone()
620:          if not row or not row[0]:
621:              print('Không tìm thấy bản ghi oauth openai-codex trong db.')
622:              sys.exit(0)
623:
624:          new_data = row[0]
625:          b64_new_auth = base64.b64encode(new_data.encode('utf-8')).decode('utf-8')
626:
627:          # Lấy repo public key từ GitHub API
628:          headers = {
629:              'Authorization': f'Bearer {token}',
630:              'Accept': 'application/vnd.github+json',
631:              'X-GitHub-Api-Version': '2022-11-28'
632:          }
633:          pk_res = requests.get(f'https://api.github.com/repos/{repo}/actions/secrets/public-key', headers=headers)
634:          if pk_res.status_code != 200:
635:              print(f'Lỗi lấy public key: {pk_res.status_code} {pk_res.text}')
636:              sys.exit(0)
637:
638:          pk_data = pk_res.json()
639:          public_key = pk_data['key']
640:          key_id = pk_data['key_id']
641:
642:          # Mã hóa secret theo chuẩn Libsodium SealedBox của GitHub
643:          public_key_obj = public.PublicKey(public_key.encode('utf-8'), encoding.Base64Encoder)
644:          sealed_box = public.SealedBox(public_key_obj)
645:          encrypted = sealed_box.encrypt(b64_new_auth.encode('utf-8'))
646:          encrypted_value = base64.b64encode(encrypted).decode('utf-8')
647:
648:          # Cập nhật Secret OMP_CODEX_AUTH
649:          put_res = requests.put(
650:              f'https://api.github.com/repos/{repo}/actions/secrets/OMP_CODEX_AUTH',
651:              headers=headers,
652:              json={'encrypted_value': encrypted_value, 'key_id': key_id}
653:          )
654:
655:          if put_res.status_code in [201, 204]:
656:              print('ĐÃ TỰ ĐỘNG CẬP NHẬT SECRET OMP_CODEX_AUTH THÀNH CÔNG! Token Codex sống vĩnh viễn!')
657:          else:
658:              print(f'Lỗi cập nhật secret: {put_res.status_code} {put_res.text}')
659:          "

