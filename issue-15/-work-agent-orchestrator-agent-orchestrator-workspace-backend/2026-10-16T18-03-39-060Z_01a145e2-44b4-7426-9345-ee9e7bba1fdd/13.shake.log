1215:    let qrPayloadString: string | null = null;
1216:    let rtmp: AqpCameraStreamKeyResponse['rtmp'] = null;
1217:
1218:    if (push) {
1219:      const server = push.rtmpServer.replace(/\/+$/, '');
1220:      const streamKey = push.streamKey.replace(/^\/+/, '');
1221:      let url: URL;
1222:      try {
1223:        url = new URL(`${server}/${streamKey}`);
1224:      } catch {
1225:        throw new ServiceUnavailableException('AQP trả về URL RTMP không hợp lệ.');
1226:      }
1227:      if (url.protocol !== 'rtmp:' || url.username || url.password || url.hash) {
1228:        throw new ServiceUnavailableException('AQP trả về URL RTMP không hợp lệ.');
1229:      }
1230:      // QR dạng RTSP theo docx §2.2 (host/cổng RTSP lấy từ env, khác cổng RTMP).
1231:      // OBS nhập tay vẫn dùng cặp RTMP server/stream key bên dưới.
1232:      qrPayload = this.buildAqpRtspQrPayload({
1233:        stream: url.pathname.split('/').filter(Boolean).pop() ?? '',
1234:        publishKey: url.searchParams.get('key') ?? '',
1235:        matchTitle: camera.name,
1236:      });
1237:      qrPayloadString = JSON.stringify(qrPayload);
1238:      rtmp = { server: push.rtmpServer, streamKey: push.streamKey };
1239:    }
1240:
1241:    return {
1242:      camera: { id: camera.id, name: camera.name, streamName: camera.streamName },
1243:      streamKeyId: key?.id ?? null,
1244:      status: key?.status ?? null,
1245:      qrPayload,
1246:      qrPayloadString,
1247:      rtmp,
1248:    };
1249:  }
