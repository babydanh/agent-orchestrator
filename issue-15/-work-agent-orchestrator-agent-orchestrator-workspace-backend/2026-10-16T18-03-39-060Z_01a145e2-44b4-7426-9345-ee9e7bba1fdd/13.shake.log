302:  private parseStreamKey(value: unknown, includePush: boolean): AqvisionAgencyStreamKey {
303:    const data = this.readObject(value);
304:    // Agency API trả id dạng số (ví dụ 30); giữ id là chuỗi ở phía mình.
305:    const rawId = data?.id;
306:    const id = typeof rawId === 'number' && Number.isSafeInteger(rawId) ? String(rawId) : rawId;
307:    const app = data?.app;
308:    const stream = data?.stream;
309:    const status = data?.status;
310:    const rawPush = data?.push;
311:    let push: AqvisionAgencyPushConfig | null = null;
312:
313:    if (rawPush !== null && rawPush !== undefined) {
314:      const pushData = this.readObject(rawPush);
315:      const rtmpServer = pushData?.rtmpServer;
316:      const streamKey = pushData?.streamKey;
317:      // Tài liệu Agency: sau thu hồi/đổi tên, key và URL chứa key là null. Chỉ `streamKey: null`
318:      // tường minh mới là key đã thu hồi; trường thiếu hoặc rỗng vẫn là phản hồi hỏng.
319:      const isRevokedPush = streamKey === null;
320:      if (!isRevokedPush) {
321:        if (
322:          typeof rtmpServer !== 'string' ||
323:          !rtmpServer.trim() ||
324:          typeof streamKey !== 'string' ||
325:          !streamKey.trim()
326:        ) {
327:          throw new AqvisionAgencyApiException('Agency API trả về cấu hình RTMP không hợp lệ.');
328:        }
329:        push = { rtmpServer: rtmpServer.trim(), streamKey: streamKey.trim() };
330:      }
331:    }
332:
333:    if (
334:      typeof id !== 'string' ||
335:      !id ||
336:      typeof app !== 'string' ||
337:      !app ||
338:      typeof stream !== 'string' ||
339:      !stream ||
340:      typeof status !== 'string' ||
341:      !status ||
342:      (includePush && rawPush === undefined)
343:    ) {
344:      throw new AqvisionAgencyApiException('Agency API trả về stream key không hợp lệ.');
345:    }
346:
347:    return { id, app, stream, status, push };
348:  }
