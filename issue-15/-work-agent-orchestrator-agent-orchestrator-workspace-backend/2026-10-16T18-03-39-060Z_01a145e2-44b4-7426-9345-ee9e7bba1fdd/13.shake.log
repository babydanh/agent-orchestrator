732:   * Keep the legacy response shape for older clients. AQP-linked cameras rotate
733:   * through Agency; unlinked cameras retain local identity rotation.
734:   */
735:  async rotateCameraStreamKey(cameraId: string, user: JwtPayload) {
736:    const camera = await this.getPushCamera(cameraId, user);
737:    const maxAttempts = 5;
738:
739:    for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
740:      const streamName = camera.aqpStreamKeyId
741:        ? camera.streamName
742:        : `camera_${randomUUID().replace(/-/g, '')}`;
743:      const streamKey = randomUUID().replace(/-/g, '');
744:      try {
745:        const result = await this.runWithAqpCameraAndStreamNameLocks(
746:          camera.id,
747:          streamName,
748:          async (lease) => {
749:            const current = await this.getPushCamera(cameraId, user);
750:            this.assertAqpLeaseOwned(lease);
751:            if (current.aqpStreamKeyId) {
752:              const rotated = await this.rotateLinkedAqpStreamKey(current, lease);
753:              return {
754:                collision: false as const,
755:                response: {
756:                  ...this.toPublicCamera({ ...current, aqpStreamKeyId: rotated.id }),
757:                  publish: {
758:                    ...this.buildPublishInfo(
759:                      current.protocol === 'SRT' ? 'SRT' : 'RTMP',
760:                      current.streamName,
761:                    ),
762:                    rtmpServer: rotated.push.rtmpServer,
763:                    streamKey: rotated.push.streamKey,
764:                  },
765:                },
766:              };
767:            }
768:            if (camera.aqpStreamKeyId) {
769:              throw new ServiceUnavailableException(
770:                'Camera vừa thay đổi trạng thái AQP; vui lòng thử lại.',
771:              );
772:            }
773:            const nameTaken = await this.livestreamRepository.isCameraStreamNameTaken(
774:              streamName,
775:              current.id,
776:            );
777:            this.assertAqpLeaseOwned(lease);
778:            if (nameTaken) return { collision: true as const };
779:
780:            const rotated = await this.livestreamRepository.updateCameraStreamIdentity(
781:              current.id,
782:              { streamName, streamKey, playbackUrl: this.buildAqvisionHlsUrl(streamName) },
783:            );
784:            if (!rotated) throw new NotFoundException('Camera không tồn tại');
785:            this.assertAqpLeaseOwned(lease);
786:            return {
787:              collision: false as const,
788:              response: {
789:                ...this.toPublicCamera(rotated),
790:                publish: this.buildPublishInfo(
791:                  rotated.protocol === 'SRT' ? 'SRT' : 'RTMP',
792:                  rotated.streamName,
793:                ),
794:              },
795:            };
796:          },
797:        );
798:        if (result.collision) continue;
799:        return result.response;
800:      } catch (error) {
801:        const isLastAttempt = attempt === maxAttempts;
802:        if (!this.isUniqueViolation(error) || isLastAttempt) throw error;
803:      }
804:    }
805:
806:    throw new ConflictException('Không cấp được stream key mới, vui lòng thử lại.');
807:  }
