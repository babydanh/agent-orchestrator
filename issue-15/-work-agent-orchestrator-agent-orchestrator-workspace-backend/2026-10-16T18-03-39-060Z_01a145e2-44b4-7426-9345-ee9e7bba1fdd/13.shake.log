1070:      key = await this.aqvisionAgencyApiClient.createStreamKey({
1071:        app: 'live',
1072:        stream: camera.streamName,
1073:      });
1074:    } catch (error) {
1075:      if (
1076:        !(error instanceof AqvisionAgencyApiException) ||
1077:        (error.httpStatus !== 409 && !error.mayHaveApplied)
1078:      ) {
1079:        throw this.toAqpServiceUnavailable(error);
1080:      }
1081:      key = await this.reconcileAqpStreamKey(camera.streamName);
1082:    }
