108:  private async runWithLease<T>(
109:    key: string,
110:    cameraId: string,
111:    operation: (lease: CameraLeaseHandle) => Promise<T>,
112:  ): Promise<T | null> {
113:    const token = randomUUID();
114:    const client = this.redisService.getClient();
115:
116:    const acquired = await client.set(key, token, 'PX', CAMERA_LOCK_TTL_MS, 'NX');
117:    if (acquired !== 'OK') return null;
118:
119:    const lease: CameraLease = { token, lost: false };
120:    this.resourceLeases.set(key, lease);
121:    const leaseHandle: CameraLeaseHandle = {
122:      cameraId,
123:      isOwned: () => !lease.lost && this.resourceLeases.get(key) === lease,
124:    };
125:
126:    let signalLeaseLost: (() => void) | undefined;
127:    const leaseLost = new Promise<void>((resolve) => {
128:      signalLeaseLost = resolve;
129:    });
130:
131:    const abandonLease = (): void => {
132:      if (lease.lost) return;
133:      lease.lost = true;
134:      clearInterval(renewTimer);
135:      if (this.resourceLeases.get(key) === lease) {
136:        this.resourceLeases.delete(key);
137:      }
138:      this.logger.warn(`Resource lock lost during operation: camera=${cameraId}`);
139:      signalLeaseLost?.();
140:    };
141:
142:    const renewTimer = setInterval(() => {
143:      void (async () => {
144:        try {
145:          const renewed = await client.eval(
146:            RENEW_CAMERA_LOCK_SCRIPT,
147:            1,
148:            key,
149:            token,
150:            CAMERA_LOCK_TTL_MS,
151:          );
152:          if (renewed !== 1) abandonLease();
153:        } catch {
154:          // Lỗi Redis: không thể xác minh quyền sở hữu ⇒ coi như mất lease.
155:          abandonLease();
156:        }
157:      })();
158:    }, CAMERA_LOCK_RENEW_MS);
159:
160:    try {
161:      return await Promise.race([
162:        operation(leaseHandle),
163:        leaseLost.then(() => null as T | null),
164:      ]);
165:    } finally {
166:      clearInterval(renewTimer);
167:      if (!lease.lost) {
168:        try {
169:          await client.eval(RELEASE_CAMERA_LOCK_SCRIPT, 1, key, token);
170:        } catch {
171:          // Lease hết hạn là lưới an toàn; không fail operation vì cleanup.
172:          this.logger.debug(`Resource lock release skipped: camera=${cameraId}`);
173:        }
174:      }
175:      if (this.resourceLeases.get(key) === lease) {
176:        this.resourceLeases.delete(key);
177:      }
178:    }
179:  }
180:
181:
182:  /**
183:   * Lên job xác nhận offline cho camera sau grace period 60s.
184:   * Job ID ổn định theo camera: sweep 30s lặp lại khi offline
185:   * kéo dài sẽ không tạo job trùng (BullMQ bỏ qua add trùng jobId).
186:   * Xóa job lỗi cuối cùng để lần sweep sau có thể lập lại job.
187:   */
188:  async scheduleCameraOfflineConfirmation(cameraId: string): Promise<void> {
189:    await this.queue.add(
190:      'confirm-camera-offline',
191:      { kind: 'confirm-camera-offline', cameraId },
192:      {
193:        jobId: this.offlineConfirmationJobId(cameraId),
194:        delay: OFFLINE_CONFIRMATION_DELAY_MS,
195:        attempts: 3,
196:        backoff: { type: 'exponential', delay: 5000 },
197:        removeOnComplete: true,
198:        removeOnFail: true,
199:      },
200:    );
201:  }
202:
203:  /**
204:   * Huỷ job xác nhận offline đang chờ của camera (camera online
205:   * lại hoặc hết assignment LIVE). `Queue.remove` trả 0 (không
206:   * ném) khi job đang chạy hoặc đã xong — không có gì để huỷ.
207:   */
208:  async cancelCameraOfflineConfirmation(cameraId: string): Promise<void> {
209:    await this.queue.remove(this.offlineConfirmationJobId(cameraId));
210:  }
211:
212:  private offlineConfirmationJobId(cameraId: string): string {
213:    return `${OFFLINE_CONFIRMATION_JOB_ID}${cameraId}`;
214:  }
215:}

