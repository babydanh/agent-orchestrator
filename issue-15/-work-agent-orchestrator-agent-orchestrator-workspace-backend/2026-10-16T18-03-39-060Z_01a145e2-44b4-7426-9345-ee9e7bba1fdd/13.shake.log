1494:  async getCameraLiveStatus(cameraId: string, user: JwtPayload) {
1495:    const camera = await this.livestreamRepository.findCameraById(cameraId);
1496:    if (!camera) {
1497:      throw new NotFoundException('Camera không tồn tại');
1498:    }
1499:
1500:    await this.assertTournamentOperator(camera.tournamentId, user);
1501:
1502:    let online: boolean;
1503:    try {
1504:      ({ online } = await this.aqvisionApiClient.isMediaOnline(camera.streamName));
1505:    } catch (error) {
1506:      if (error instanceof AqvisionApiException) {
1507:        throw new ServiceUnavailableException(
1508:          'Không đọc được trạng thái phát từ máy chủ media AQP. ' +
1509:            'Kiểm tra AQVISION_API_SECRET.',
1510:        );
1511:      }
1512:      throw error;
1513:    }
1514:
1515:    const status = online ? 'LIVE' : 'IDLE';
1516:    if (camera.status !== status && camera.status !== 'ARCHIVED') {
1517:      await this.livestreamRepository.updateCameraStatus(camera.id, status);
1518:    }
1519:
1520:    return {
1521:      cameraId: camera.id,
1522:      streamName: camera.streamName,
1523:      online,
1524:      status: camera.status === 'ARCHIVED' ? camera.status : status,
1525:    };
1526:  }
1527:
1528:  async deleteCamera(cameraId: string, user: JwtPayload) {
1529:    const camera = await this.livestreamRepository.findCameraById(cameraId);
1530:    if (!camera) {
1531:      throw new NotFoundException('Camera không tồn tại');
1532:    }
1533:
1534:    await this.assertTournamentOperator(camera.tournamentId, user);
1535:    const result = await this.livestreamHealthQueue.runWithCameraLock(
1536:      camera.id,
1537:      async (lease) => {
1538:        if (!lease.isOwned()) {
1539:          throw new ServiceUnavailableException('Đã mất quyền xử lý camera.');
1540:        }
1541:        await this.stopAqvisionPull(camera.pullProxyKey);
1542:        if (!lease.isOwned()) {
1543:          throw new ServiceUnavailableException('Đã mất quyền xử lý camera.');
1544:        }
1545:        if (camera.aqpStreamKeyId) {
1546:          await this.revokeAqpProviderStreamKey(camera.aqpStreamKeyId, lease);
1547:        }
1548:
1549:        const archived = await this.livestreamRepository.deleteCamera(cameraId);
1550:        if (!lease.isOwned()) {
1551:          throw new ServiceUnavailableException('Đã mất quyền xử lý camera.');
1552:        }
1553:        return { archived };
1554:      },
1555:    );
1556:    if (!result) {
1557:      throw new ServiceUnavailableException('Camera đang được xử lý; thử lại sau.');
1558:    }
1559:
1560:    return result.archived ? this.toPublicCamera(result.archived) : null;
1561:  }
1562:
1563:  async assignCamera(matchId: string, user: JwtPayload, data: AssignCameraDto) {
1564:    const match = await this.livestreamRepository.findMatchWithTournament(matchId);
1565:    if (!match) {
1566:      throw new NotFoundException('Trận đấu không tồn tại');
1567:    }
1568:
1569:    await this.assertTournamentOperator(match.tournamentId, user);
1570:
1571:    // Gửi null nghĩa là "bỏ gán tay": trận quay về camera của sân. Nếu sân
1572:    // không có camera thì trận trở lại chưa gán, đúng như lúc chưa chọn gì.
1573:    if (data.cameraId === null) {
1574:      const courtCamera = match.courtId
1575:        ? await this.livestreamRepository.findActiveCameraByCourt(match.courtId, match.tournamentId)
1576:        : null;
1577:      if (courtCamera) {
1578:        return this.livestreamRepository.assignCameraToMatch(
1579:          matchId,
1580:          courtCamera.id,
1581:          this.normalizePublicPlaybackUrl(courtCamera.playbackUrl) ?? '',
1582:        );
1583:      }
1584:      return this.livestreamRepository.clearMatchCamera(matchId);
1585:    }
1586:
1587:    const camera = await this.livestreamRepository.findCameraById(data.cameraId);
1588:    if (!camera || camera.tournamentId !== match.tournamentId) {
1589:      throw new BadRequestException('Camera không thuộc giải đấu của trận này.');
1590:    }
1591:
1592:    return this.livestreamRepository.assignCameraToMatch(
1593:      matchId,
1594:      data.cameraId,
1595:      this.normalizePublicPlaybackUrl(camera.playbackUrl) ?? '',
1596:    );
1597:  }
