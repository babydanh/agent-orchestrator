1048:      } catch (error) {
1049:        if (!(error instanceof AqvisionAgencyApiException) || error.httpStatus !== 404) {
1050:          throw this.toAqpServiceUnavailable(error);
1051:        }
1052:        await this.saveAqpStreamKeyId(camera.id, null, lease);
1053:        existingId = null;
1054:      }
1055:    }
1056:
1057:    if (!existingId) {
1058:      const discovered = await this.findAqpStreamKey(camera.streamName);
1059:      this.assertAqpLeaseOwned(lease);
1060:      if (discovered?.push) {
1061:        await this.saveAqpStreamKeyId(camera.id, discovered.id, lease);
1062:        return discovered;
1063:      }
1064:      if (discovered) existingId = discovered.id;
1065:    }
1066:
1067:    this.assertAqpLeaseOwned(lease);
