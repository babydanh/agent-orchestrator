            '          icon: tournament.isRanked\n'
            '              ? Icons.stars_rounded\n'
            '              : Icons.sports_score_rounded,\n'
            '          iconColor: tournament.isRanked\n'
            '              ? const Color(0xFFF59E0B)\n'
            '              : const Color(0xFF10B981),\n'
            '        ),\n'
            '        _HeaderTag(\n'
            '          bracketLabel.toUpperCase(),\n'
            '          icon: Icons.loop_rounded,\n'
            '          iconColor: const Color(0xFFD97706),\n'
            '        ),\n'
            '      ],\n'
            '    );\n'
            '  }\n'
            '}\n'
            '\n'
            'class _HeaderInfo extends StatelessWidget {\n'
            '  final Tournament tournament;\n'
            '  final bool compact;\n'
            '\n'
            '  const _HeaderInfo({required this.tournament, required this.compact});\n'
            '\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
            '    final colors = context.colors;\n'
            '    final viewportSize = MediaQuery.sizeOf(context);\n'
            '    return AnimatedDefaultTextStyle(\n'
            '      duration: const Duration(milliseconds: 140),\n'
            '      curve: Curves.easeOut,\n'
            '      style: TextStyle(\n'
            '        // Nhánh compact không có banner (cao = 0) nên giữ literal.\n'
            '        fontSize: compact\n'
            '            ? 15\n'
            '            : AppResponsive.bannerFontSize(\n'
            '                viewportSize.height,\n'
            '                viewportWidth: viewportSize.width,\n'
            '                ratio: AppResponsive.bannerHeadlineRatio,\n'
            '              ),\n'
            '        fontWeight: FontWeight.w900,\n'
            '        color: colors.textPrimary,\n'
            '        height: 1.18,\n'
            '        letterSpacing: -0.35,\n'
            '      ),\n'
            '      child: Text(\n'
            '        tournament.name.toUpperCase(),\n'
            '        maxLines: compact ? 2 : 3,\n'
            '        overflow: TextOverflow.ellipsis,\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '}\n'
            '\n'
            'class _HeaderMeta extends StatelessWidget {\n'
            '  final Tournament tournament;\n'
            '  final String? selectedDivision;\n'
            '  final String? selectedDivisionId;\n'
            '  final ValueChanged<TournamentDivision>? onChangedDivision;\n'
            '\n'
            '  const _HeaderMeta({\n'
            '    required this.tournament,\n'
            '    this.selectedDivision,\n'
            '    this.selectedDivisionId,\n'
            '    this.onChangedDivision,\n'
            '  });\n'
            '\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
            '    final colors = context.colors;\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '    final locationLabel = TournamentLocationFormatter.tournamentFullLocation(\n'
            '      tournament,\n'
            '    );\n'
            '    final divisions = tournament.divisions;\n'
            '\n'
            '    final selected =\n'
            '        divisions\n'
            '            .where(\n'
            '              (d) => d.id == selectedDivisionId || d.name == selectedDivision,\n'
            '            )\n'
            '            .firstOrNull ??\n'
            '        divisions.firstOrNull;\n'
            '\n'
            '    final registeredCount = selected?.participantCount ?? 0;\n'
            '    final maxCount = selected?.maxParticipants ?? tournament.maxTeams;\n'
            '\n'
            '    final divisionSelector = divisions.length > 1 && onChangedDivision != null\n'
            '        ? Container(\n'
            '            width: double.infinity,\n'
            '            padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),\n'
            '            decoration: BoxDecoration(\n'
            '              color: AppTheme.primary.withValues(alpha: 0.08),\n'
            '              borderRadius: BorderRadius.circular(10),\n'
            '              border: Border.all(\n'
            '                color: AppTheme.primary.withValues(alpha: 0.25),\n'
            '              ),\n'
            '            ),\n'
            '            child: DropdownButtonHideUnderline(\n'
            '              child: DropdownButton<String>(\n'
            '                value: selected?.name ?? selectedDivision,\n'
            '                isDense: true,\n'
            '                isExpanded: true,\n'
            '                icon: const Icon(\n'
            '                  Icons.keyboard_arrow_down_rounded,\n'
            '                  color: AppTheme.primary,\n'
            '                  size: 20,\n'
            '                ),\n'
            '                style: const TextStyle(\n'
            '                  color: AppTheme.primary,\n'
            '                  fontSize: 14,\n'
            '                  fontWeight: FontWeight.w800,\n'
            '                ),\n'
            '                items: divisions.map((division) {\n'
            '                  final divReg = division.participantCount;\n'
            '                  final divMax =\n'
            '                      division.maxParticipants ?? tournament.maxTeams;\n'
            '                  return DropdownMenuItem<String>(\n'
            '                    value: division.name,\n'
            '                    child: Text(\n'
            '                      \'${division.name}  •  $divReg/$divMax\',\n'
            '                      overflow: TextOverflow.ellipsis,\n'
            '                      style: TextStyle(\n'
            '                        color: colors.textPrimary,\n'
            '                        fontSize: 13.5,\n'
            '                        fontWeight: FontWeight.w700,\n'
            '                      ),\n'
            '                    ),\n'
            '                  );\n'
            '                }).toList(),\n'
            '                onChanged: (value) {\n'
            '                  if (value == null) return;\n'
            '                  final div = divisions.firstWhere(\n'
            '                    (item) => item.name == value,\n'
            '                  );\n'
            '                  onChangedDivision!(div);\n'
            '                },\n'
            '              ),\n'
            '            ),\n'
            '          )\n'
            '        : Container(\n'
            '            width: double.infinity,\n'
            '            padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 7),\n'
            '            decoration: BoxDecoration(\n'
            '              color: AppTheme.primary.withValues(alpha: 0.08),\n'
            '              borderRadius: BorderRadius.circular(10),\n'
            '            ),\n'
            '            child: Row(\n'
            '              children: [\n'
            '                const Icon(\n'
            '                  Icons.groups_rounded,\n'
            '                  size: 16,\n'
            '                  color: AppTheme.primary,\n'
            '                ),\n'
            '                const SizedBox(width: 7),\n'
            '                Expanded(\n'
            '                  child: Text(\n'
            '                    selected != null\n'
            '                        ? \'${selected.name}  •  $registeredCount/$maxCount\'\n'
            '                        : \'$registeredCount / $maxCount ${l10n.teamsUnit}\',\n'
            '                    overflow: TextOverflow.ellipsis,\n'
            '                    style: const TextStyle(\n'
            '                      color: AppTheme.primary,\n'
            '                      fontSize: 13.5,\n'
            '                      fontWeight: FontWeight.w800,\n'
            '                    ),\n'
            '                  ),\n'
            '                ),\n'
            '              ],\n'
            '            ),\n'
            '          );\n'
            '\n'
            '    return Column(\n'
            '      crossAxisAlignment: CrossAxisAlignment.start,\n'
            '      children: [\n'
            '        Wrap(\n'
            '          spacing: 12,\n'
            '          runSpacing: 6,\n'
            '          children: [\n'
            '            _HeaderIconText(\n'
            '              icon: Icons.calendar_today_rounded,\n'
            '              text: _formatDateRange(\n'
            '                tournament.registrationStartDate,\n'
            '                tournament.registrationEndDate,\n'
            '                l10n.notUpdated,\n'
            '              ),\n'
            '            ),\n'
            '            _HeaderIconText(\n'
            '              icon: Icons.location_on_outlined,\n'
            '              text: locationLabel.isNotEmpty\n'
            '                  ? locationLabel\n'
            '                  : l10n.locationNotUpdated,\n'
            '            ),\n'
            '          ],\n'
            '        ),\n'
            '        if (selected != null) ...[\n'
            '          const SizedBox(height: 10),\n'
            '          Row(\n'
            '            crossAxisAlignment: CrossAxisAlignment.center,\n'
            '            children: [\n'
            '              Icon(Icons.view_list_rounded, size: 16, color: colors.textMuted),\n'
            '              const SizedBox(width: 7),\n'
            '              Expanded(child: divisionSelector),\n'
            '            ],\n'
            '          ),\n'
            '        ],\n'
            '      ],\n'
            '    );\n'
            '  }\n'
            '}\n'
            '\n'
            'class _HeaderTag extends StatelessWidget {\n'
            '  final String text;\n'
            '  final IconData? icon;\n'
            '  final Color? iconColor;\n'
            '\n'
            '  const _HeaderTag(this.text, {this.icon, this.iconColor});\n'
            '\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
            '    final colors = context.colors;\n'
            '    return Container(\n'
            '      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 5),\n'
            '      decoration: BoxDecoration(\n'
            '        color: colors.bgSurface,\n'
            '        borderRadius: BorderRadius.circular(20),\n'
            '        border: Border.all(color: colors.border),\n'
            '      ),\n'
            '      child: Row(\n'
            '        mainAxisSize: MainAxisSize.min,\n'
            '        children: [\n'
            '          if (icon != null) ...[\n'
            '            Icon(icon, size: 14, color: iconColor ?? colors.textSecondary),\n'
            '            const SizedBox(width: 5),\n'
            '          ],\n'
            '          Text(\n'
            '            text,\n'
            '            style: TextStyle(\n'
            '              fontSize: 11,\n'
            '              fontWeight: FontWeight.bold,\n'
            '              color: colors.textPrimary,\n'
            '              letterSpacing: 0.2,\n'
            '            ),\n'
            '          ),\n'
            '        ],\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '}\n'
            '\n'
            'class _HeaderIconText extends StatelessWidget {\n'
            '  final IconData icon;\n'
            '  final String text;\n'
            '\n'
            '  const _HeaderIconText({required this.icon, required this.text});\n'
            '\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
            '    final colors = context.colors;\n'
            '    return Row(\n'
            '      mainAxisSize: MainAxisSize.min,\n'
            '      children: [\n'
            '        Icon(icon, size: 15, color: colors.textMuted),\n'
            '        const SizedBox(width: 5),\n'
            '        Flexible(\n'
            '          child: Text(\n'
            '            text,\n'
            '            maxLines: 1,\n'
            '            overflow: TextOverflow.ellipsis,\n'
            '            style: TextStyle(\n'
            '              fontSize: 12,\n'
            '              fontWeight: FontWeight.w600,\n'
            '              color: colors.textSecondary,\n'
            '            ),\n'
            '          ),\n'
            '        ),\n'
            '      ],\n'
            '    );\n'
            '  }\n'
            '}\n'
            '\n'
            'class _TournamentLogo extends StatelessWidget {\n'
            '  final Tournament tournament;\n'
            '  final double size;\n'
            '\n'
            '  const _TournamentLogo({required this.tournament, required this.size});\n'
            '\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
            '    final colors = context.colors;\n'
            '    final logoUrl = tournament.logoUrl?.trim();\n'
            '    if (logoUrl == null || logoUrl.isEmpty) return const SizedBox.shrink();\n'
            '\n'
            '    return AnimatedContainer(\n'
            '      duration: const Duration(milliseconds: 140),\n'
            '      curve: Curves.easeOut,\n'
            '      width: size,\n'
            '      height: size,\n'
            '      padding: const EdgeInsets.all(3),\n'
            '      decoration: BoxDecoration(\n'
            '        color: Colors.white,\n'
            '        borderRadius: BorderRadius.circular(14),\n'
            '        border: Border.all(color: colors.border),\n'
            '        boxShadow: [\n'
            '          BoxShadow(\n'
            '            color: Colors.black.withValues(alpha: 0.08),\n'
            '            blurRadius: 12,\n'
            '            offset: const Offset(0, 6),\n'
            '          ),\n'
            '        ],\n'
            '      ),\n'
            '      child: ClipRRect(\n'
            '        borderRadius: BorderRadius.circular(11),\n'
            '        child: Image.network(\n'
            '          _resolveImageUrl(logoUrl),\n'
            '          fit: BoxFit.contain,\n'
            '          errorBuilder: (context, error, stackTrace) =>\n'
            '              const SportoBrandFallback(\n'
            '                semanticsLabel: \'SportO fallback tournament logo\',\n'
            '                padding: EdgeInsets.all(8),\n'
            '              ),\n'
            '        ),\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '}\n'
            '\n'
            'String _resolveImageUrl(String url) {\n'
            '  if (url.startsWith("http")) return url;\n'
            '  return "https://sporto.asia$url";\n'
            '}\n'
            '\n'
            'String _formatDateRange(DateTime? start, DateTime? end, String fallback) {\n'
            '  if (start == null && end == null) {\n'
            '    return fallback;\n'
            '  }\n'
            '  final startStr = start != null\n'
            '      ? "${start.day.toString().padLeft(2, \'0\')}/${start.month.toString().padLeft(2, \'0\')}/${start.year}"\n'
            '      : "...";\n'
            '  final endStr = end != null\n'
            '      ? "${end.day.toString().padLeft(2, \'0\')}/${end.month.toString().padLeft(2, \'0\')}/${end.year}"\n'
            '      : "...";\n'
            '  return "$startStr - $endStr";\n'
            '}\n'
            '\n'
            'class TournamentBanner extends StatefulWidget {\n'
            '  final Tournament tournament;\n'
            '\n'
            '  const TournamentBanner({super.key, required this.tournament});\n'
            '\n'
            '  @override\n'
            '  State<TournamentBanner> createState() => _TournamentBannerState();\n'
            '}\n'
            '\n'
            'class _TournamentBannerState extends State<TournamentBanner> {\n'
            '  final PageController _pageController = PageController();\n'
            '  int _currentPage = 0;\n'
            '\n'
            '  @override\n'
            '  void dispose() {\n'
            '    _pageController.dispose();\n'
            '    super.dispose();\n'
            '  }\n'
            '\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
            '    final colors = context.colors;\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '    final List<String> images = [];\n'
            '    if (widget.tournament.bannerUrl != null &&\n'
            '        widget.tournament.bannerUrl!.isNotEmpty) {\n'
            '      images.add(widget.tournament.bannerUrl!);\n'
            '    }\n'
            '    if (widget.tournament.galleryImages.isNotEmpty) {\n'
            '      images.addAll(widget.tournament.galleryImages);\n'
            '    }\n'
            '    // Một nguồn cho cả container (banner phía trên) lẫn chữ tiêu đề phía dưới\n'
            '    // — truyền lệch nhau sẽ ra banner cao mà chữ nhỏ, không lỗi biên dịch nào\n'
            '    // bắt được.\n'
            '    final viewportSize = MediaQuery.sizeOf(context);\n'
            '\n'
            '    return Column(\n'
            '      crossAxisAlignment: CrossAxisAlignment.start,\n'
            '      children: [\n'
            '        Stack(\n'
            '          children: [\n'
            '            Container(\n'
            '              height: AppResponsive.bannerHeight(\n'
            '                viewportSize.height,\n'
            '                viewportWidth: viewportSize.width,\n'
            '              ),\n'
            '              width: double.infinity,\n'
            '              color: colors.bgCard,\n'
            '              child: images.isEmpty\n'
            '                  ? const SportoBrandFallback(\n'
            '                      withTagline: true,\n'
            '                      semanticsLabel: \'SportO tournament fallback banner\',\n'
            '                    )\n'
            '                  : PageView.builder(\n'
            '                      controller: _pageController,\n'
            '                      onPageChanged: (index) {\n'
            '                        setState(() {\n'
            '                          _currentPage = index;\n'
            '                        });\n'
            '                      },\n'
            '                      itemCount: images.length,\n'
            '                      itemBuilder: (context, index) {\n'
            '                        final imgUrl = images[index].startsWith("http")\n'
            '                            ? images[index]\n'
            '                            : "https://sporto.asia${images[index]}";\n'
            '                        return Image.network(\n'
            '                          imgUrl,\n'
            '                          fit: BoxFit.cover,\n'
            '                          errorBuilder: (context, error, stackTrace) {\n'
            '                            return const SportoBrandFallback(\n'
            '                              withTagline: true,\n'
            '                              semanticsLabel:\n'
            '                                  \'SportO tournament fallback banner\',\n'
            '                            );\n'
            '                          },\n'
            '                        );\n'
