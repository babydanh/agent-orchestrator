            '}\n'
            '\n'
            '  Widget _buildTournamentHighlightsCard(Tournament t) {\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '    final colors = context.colors;\n'
            '    final startDateStr = t.startDate != null\n'
            '        ? DateFormat(\'dd/MM/yyyy\').format(t.startDate!)\n'
            '        : l10n.registerNotScheduled;\n'
            '    final endDateStr = t.endDate != null\n'
            '        ? DateFormat(\'dd/MM/yyyy\').format(t.endDate!)\n'
            '        : null;\n'
            '\n'
            '    return Container(\n'
            '      width: double.infinity,\n'
            '      padding: const EdgeInsets.all(18),\n'
            '      decoration: BoxDecoration(\n'
            '        color: colors.bgCard,\n'
            '        borderRadius: BorderRadius.circular(16),\n'
            '        border: Border.all(color: colors.border),\n'
            '      ),\n'
            '      child: Column(\n'
            '        crossAxisAlignment: CrossAxisAlignment.start,\n'
            '        children: [\n'
            '          Text(\n'
            '            l10n.registerTermsTitle,\n'
            '            style: TextStyle(\n'
            '              fontSize: 11,\n'
            '              fontWeight: FontWeight.w800,\n'
            '              color: colors.textMuted,\n'
            '              letterSpacing: 0.8,\n'
            '            ),\n'
            '          ),\n'
            '          const SizedBox(height: 14),\n'
            '          _buildInfoRow(\n'
            '            Icons.event_available_rounded,\n'
            '            l10n.registerScheduleTitle,\n'
            '            endDateStr != null ? \'$startDateStr - $endDateStr\' : startDateStr,\n'
            '            colors,\n'
