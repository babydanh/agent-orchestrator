            '  final _joinQuestionCtrl = TextEditingController();\n'
            '\n'
            '  final List<String> _joinQuestions = [];\n'
            '  Map<String, String> _socialLinks = const {};\n'
            '  ClubRegionSelection _region = const ClubRegionSelection();\n'
            '\n'
            '  String _selectedSport = \'\';\n'
            '  String _joinMode = \'OPEN\';\n'
            '  String _visibility = \'PUBLIC\';\n'
            '  bool _isLoading = false;\n'
            '  bool _initialized = false;\n'
            '\n'
            '  @override\n'
            '  void dispose() {\n'
            '    _nameCtrl.dispose();\n'
            '    _descCtrl.dispose();\n'
            '    _locationCtrl.dispose();\n'
            '    _maxMembersCtrl.dispose();\n'
            '    _rulesCtrl.dispose();\n'
            '    _joinQuestionCtrl.dispose();\n'
            '    super.dispose();\n'
            '  }\n'
            '\n'
            '  void _initFromClub(Community? club) {\n'
            '    if (_initialized || club == null) return;\n'
            '    _nameCtrl.text = club.name;\n'
            '    _descCtrl.text = club.description ?? \'\';\n'
            '    _locationCtrl.text = club.locationAddress ?? \'\';\n'
            '    _rulesCtrl.text = club.rules ?? \'\';\n'
            '    _maxMembersCtrl.text = club.maxMembers?.toString() ?? \'\';\n'
            '    _selectedSport = club.sports.isNotEmpty ? club.sports.first : \'\';\n'
            '    _joinMode = club.joinMode;\n'
            '    _visibility = club.visibility;\n'
            '    _joinQuestions.addAll(club.joinQuestions);\n'
            '    _socialLinks = club.socialLinks;\n'
            '    _initialized = true;\n'
            '  }\n'
            '\n'
            '  Future<String> _resolveCategoryId() async {\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '    final categories = await ref.read(categoriesProvider.future);\n'
            '    final selected = categories.where((category) {\n'
            '      final slug = category.slug.trim().toLowerCase();\n'
            '      final name = category.name.trim().toLowerCase();\n'
            '      return slug == _selectedSport.toLowerCase() ||\n'
            '          name == _selectedSport.toLowerCase();\n'
            '    }).firstOrNull;\n'
            '    if (selected == null || selected.id.isEmpty) {\n'
            '      throw StateError(l10n.editClub_primarySportError);\n'
            '    }\n'
            '    return selected.id;\n'
            '  }\n'
            '\n'
            '\n'
            '\n'
            '\n'
            '\n'
            '  Future<void> _save() async {\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '    if (!_formKey.currentState!.validate()) return;\n'
            '    if (_selectedSport.isEmpty) {\n'
            '      ScaffoldMessenger.of(\n'
            '        context,\n'
            '      ).showSnackBar(SnackBar(content: Text(l10n.editClub_primarySportError)));\n'
            '      return;\n'
            '    }\n'
            '    if (_region.provinceCode.isEmpty) {\n'
            '      ScaffoldMessenger.of(\n'
            '        context,\n'
            '      ).showSnackBar(SnackBar(content: Text(l10n.editClub_provinceRequired)));\n'
            '      return;\n'
            '    }\n'
            '\n'
            '    setState(() => _isLoading = true);\n'
            '    _log.info(\'Bắt đầu cập nhật CLB: ${widget.clubId}\');\n'
            '\n'
            '    try {\n'
            '      final composedAddress = _region.composeAddress(_locationCtrl.text);\n'
            '      final repo = ref.read(communityRepositoryProvider);\n'
            '      final currentClub = ref\n'
            '          .read(communityDetailProvider(widget.clubId))\n'
            '          .asData\n'
            '          ?.value;\n'
            '      final isResubmission =\n'
            '          currentClub?.status.trim().toUpperCase() == \'REJECTED\';\n'
            '      final payload = <String, dynamic>{\n'
            '        \'name\': _nameCtrl.text.trim(),\n'
            '        \'description\': _descCtrl.text.trim(),\n'
            '        \'rules\': _rulesCtrl.text.trim(),\n'
            '        \'visibility\': _visibility,\n'
            '        \'joinMode\': _joinMode,\n'
            '        \'joinQuestions\': _joinQuestions,\n'
            '        \'socialLinks\': _socialLinks,\n'
            '        \'categoryIds\': [await _resolveCategoryId()],\n'
            '        \'maxMembers\': int.tryParse(_maxMembersCtrl.text.trim()),\n'
            '        \'locationAddress\': composedAddress.isEmpty ? null : composedAddress,\n'
            '        \'provinceCode\': _region.provinceCode,\n'
            '        \'districtCode\': null,\n'
            '        \'wardCode\': _region.wardCode.isEmpty ? null : _region.wardCode,\n'
            '      };\n'
            '      if (isResubmission) {\n'
            '        await repo.resubmitCommunity(widget.clubId, payload);\n'
            '      } else {\n'
            '        await repo.updateCommunity(widget.clubId, payload);\n'
            '      }\n'
            '\n'
            '      _log.success(\n'
            '        isResubmission\n'
            '            ? \'Gửi lại CLB để xét duyệt thành công\'\n'
            '            : \'Cập nhật CLB thành công\',\n'
            '      );\n'
            '      ref.invalidate(communityDetailProvider(widget.clubId));\n'
            '      invalidateCommunityCollections(ref);\n'
            '\n'
            '      if (mounted) {\n'
            '        ScaffoldMessenger.of(context).showSnackBar(\n'
            '          SnackBar(\n'
            '            content: Text(\n'
            '              isResubmission\n'
            '                  ? l10n.editClub_resubmitSuccess\n'
            '                  : l10n.editClub_saved,\n'
            '            ),\n'
            '            backgroundColor: context.colors.success,\n'
            '            behavior: SnackBarBehavior.floating,\n'
            '          ),\n'
            '        );\n'
            '        // Deep-link (vào thẳng /club/:id/edit) không có stack để pop thì về chi tiết CLB.\n'
            '        if (context.canPop()) {\n'
            '          context.pop();\n'
            '        } else {\n'
            '          context.go(\'/club/${widget.clubId}\');\n'
            '        }\n'
            '      }\n'
            '    } catch (e, stack) {\n'
            '      _log.error(\'Lỗi cập nhật CLB\', e, stack);\n'
            '      if (mounted) {\n'
            '        ScaffoldMessenger.of(context).showSnackBar(\n'
            '          SnackBar(\n'
            '            content: Text(\n'
            '              l10n.editClub_saveError(\n'
            '                e.toString().replaceAll(\'Exception: \', \'\'),\n'
            '              ),\n'
            '            ),\n'
            '            backgroundColor: context.colors.error,\n'
            '            behavior: SnackBarBehavior.floating,\n'
            '          ),\n'
            '        );\n'
            '      }\n'
            '    } finally {\n'
            '      if (mounted) setState(() => _isLoading = false);\n'
            '    }\n'
            '  }\n'
            '\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '    final colors = context.colors;\n'
            '    final clubAsync = ref.watch(communityDetailProvider(widget.clubId));\n'
            '\n'
            '    return Scaffold(\n'
            '      backgroundColor: colors.bgDark,\n'
            '      appBar: AppBar(\n'
            '        backgroundColor: colors.bgDark,\n'
            '        elevation: 0,\n'
            '        leading: IconButton(\n'
            '          icon: Icon(Icons.close_rounded, color: colors.textPrimary),\n'
            '          onPressed: () {\n'
            '            if (context.canPop()) {\n'
            '              context.pop();\n'
            '            } else {\n'
            '              context.go(\'/club/${widget.clubId}\');\n'
            '            }\n'
            '          },\n'
            '        ),\n'
            '        title: Text(\n'
            '          l10n.editClub_title,\n'
            '          style: TextStyle(\n'
            '            color: colors.textPrimary,\n'
            '            fontWeight: FontWeight.w800,\n'
            '            fontSize: 17,\n'
            '          ),\n'
            '        ),\n'
            '        centerTitle: true,\n'
            '        actions: [\n'
            '          TextButton(\n'
            '            onPressed: _isLoading ? null : _save,\n'
            '            child: _isLoading\n'
            '                ? const SizedBox(\n'
            '                    width: 20,\n'
            '                    height: 20,\n'
            '                    child: CircularProgressIndicator(strokeWidth: 2),\n'
            '                  )\n'
            '                : Text(\n'
            '                    l10n.editClub_save,\n'
            '                    style: TextStyle(fontWeight: FontWeight.w800, fontSize: 15),\n'
            '                  ),\n'
            '          ),\n'
            '        ],\n'
            '      ),\n'
            '      body: clubAsync.when(\n'
            '        data: (club) {\n'
            '          _initFromClub(club);\n'
            '          return _buildForm(colors, club);\n'
            '        },\n'
            '        loading: () => const Center(child: CircularProgressIndicator()),\n'
            '        error: (e, _) => _buildError(\n'
            '          colors,\n'
            '          () => ref.invalidate(communityDetailProvider(widget.clubId)),\n'
            '        ),\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '\n'
            '  Widget _buildForm(AppColorsExtension colors, Community? club) {\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '    return SingleChildScrollView(\n'
            '      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 20),\n'
            '      physics: const BouncingScrollPhysics(),\n'
            '      child: Form(\n'
            '        key: _formKey,\n'
            '        child: Column(\n'
            '          crossAxisAlignment: CrossAxisAlignment.start,\n'
            '          children: [\n'
            '            if (club?.status.trim().toUpperCase() == \'PENDING\' ||\n'
            '                club?.status.trim().toUpperCase() == \'REJECTED\') ...[\n'
            '              _approvalStatusBanner(colors, club!),\n'
            '              const SizedBox(height: 16),\n'
            '            ],\n'
            '\n'
            '            // ── Card 2: Thông tin cơ bản ──\n'
            '            _sectionCard(\n'
            '              colors: colors,\n'
            '              title: l10n.editClub_basicSection,\n'
            '              subtitle: l10n.editClub_basicSubtitle,\n'
            '              child: Column(\n'
            '                crossAxisAlignment: CrossAxisAlignment.start,\n'
            '                children: [\n'
            '                  _fieldLabel(\n'
            '                    l10n.editClub_clubName,\n'
            '                    isRequired: true,\n'
            '                    colors: colors,\n'
            '                  ),\n'
            '                  const SizedBox(height: 6),\n'
            '                  AppTextFormField(\n'
            '                    controller: _nameCtrl,\n'
            '                    hint: l10n.editClub_clubNameHint,\n'
            '                    prefixIcon: Icons.badge_outlined,\n'
            '                    validator: (v) {\n'
            '                      final value = v?.trim() ?? \'\';\n'
            '                      if (value.isEmpty) return l10n.editClub_clubNameRequired;\n'
            '                      if (value.length > 255) return l10n.editClub_clubNameMax;\n'
            '                      return null;\n'
            '                    },\n'
            '                  ),\n'
            '                  const SizedBox(height: 16),\n'
            '\n'
            '                  _fieldLabel(\n'
            '                    l10n.editClub_primarySport,\n'
            '                    isRequired: true,\n'
            '                    colors: colors,\n'
            '                  ),\n'
            '                  const SizedBox(height: 2),\n'
            '                  Text(\n'
            '                    l10n.editClub_primarySportDescription,\n'
            '                    style: TextStyle(fontSize: 11, color: colors.textSecondary),\n'
            '                  ),\n'
            '                  const SizedBox(height: 8),\n'
            '                  _buildSportSelector(),\n'
            '                  const SizedBox(height: 16),\n'
            '\n'
            '                  _fieldLabel(l10n.editClub_descriptionLabel, colors: colors),\n'
            '                  const SizedBox(height: 6),\n'
            '                  AppTextFormField(\n'
            '                    controller: _descCtrl,\n'
            '                    hint: l10n.editClub_descriptionHint,\n'
            '                    maxLines: 3,\n'
            '                    prefixIcon: Icons.description_outlined,\n'
            '                  ),\n'
            '                ],\n'
            '              ),\n'
            '            ),\n'
            '            const SizedBox(height: 16),\n'
            '\n'
            '            // ── Card 3: Địa điểm hoạt động ──\n'
            '            _sectionCard(\n'
            '              colors: colors,\n'
            '              title: l10n.editClub_locationSection,\n'
            '              subtitle: l10n.editClub_locationSubtitle,\n'
            '              child: Column(\n'
            '                crossAxisAlignment: CrossAxisAlignment.start,\n'
            '                children: [\n'
            '                  _fieldLabel(\n'
            '                    l10n.editClub_administrativeArea,\n'
            '                    isRequired: true,\n'
            '                    colors: colors,\n'
            '                  ),\n'
            '                  const SizedBox(height: 6),\n'
            '                  ClubRegionSelector(\n'
            '                    initialProvinceCode: club?.provinceCode ?? \'\',\n'
            '                    initialWardCode: club?.wardCode ?? \'\',\n'
            '                    onChanged: (selection) => _region = selection,\n'
            '                  ),\n'
            '                  const SizedBox(height: 12),\n'
            '\n'
            '                  _fieldLabel(l10n.editClub_detailedAddress, colors: colors),\n'
            '                  const SizedBox(height: 6),\n'
            '                  AppTextFormField(\n'
            '                    controller: _locationCtrl,\n'
            '                    hint: l10n.editClub_detailedAddressHint,\n'
            '                    prefixIcon: Icons.location_on_outlined,\n'
            '                  ),\n'
            '                ],\n'
            '              ),\n'
            '            ),\n'
            '            const SizedBox(height: 16),\n'
            '\n'
            '            // ── Card 4: Quyền riêng tư & Cách thức tham gia ──\n'
            '            _sectionCard(\n'
            '              colors: colors,\n'
            '              title: l10n.editClub_privacySection,\n'
            '              subtitle: l10n.editClub_privacySubtitle,\n'
            '              child: Column(\n'
            '                crossAxisAlignment: CrossAxisAlignment.start,\n'
            '                children: [\n'
            '                  _fieldLabel(\n'
            '                    l10n.editClub_visibility,\n'
            '                    isRequired: true,\n'
            '                    colors: colors,\n'
            '                  ),\n'
            '                  const SizedBox(height: 6),\n'
            '                  ClubVisibilitySelector(\n'
            '                    value: _visibility,\n'
            '                    onChanged: (value) => setState(() => _visibility = value),\n'
            '                  ),\n'
            '                  const SizedBox(height: 16),\n'
            '\n'
            '                  _fieldLabel(\n'
            '                    l10n.editClub_memberJoinMethod,\n'
            '                    isRequired: true,\n'
            '                    colors: colors,\n'
            '                  ),\n'
            '                  const SizedBox(height: 6),\n'
            '                  _buildJoinModeSelector(),\n'
            '                  const SizedBox(height: 16),\n'
            '\n'
            '                  _fieldLabel(l10n.editClub_memberLimit, colors: colors),\n'
            '                  const SizedBox(height: 6),\n'
            '                  AppTextFormField(\n'
            '                    controller: _maxMembersCtrl,\n'
            '                    hint: l10n.editClub_memberLimitHint,\n'
            '                    keyboardType: TextInputType.number,\n'
            '                    prefixIcon: Icons.group_outlined,\n'
            '                  ),\n'
            '                  const SizedBox(height: 16),\n'
            '\n'
            '                  _fieldLabel(l10n.editClub_rules, colors: colors),\n'
            '                  const SizedBox(height: 6),\n'
            '                  AppTextFormField(\n'
            '                    controller: _rulesCtrl,\n'
            '                    hint: l10n.editClub_rulesHint,\n'
            '                    maxLines: 4,\n'
            '                    prefixIcon: Icons.gavel_rounded,\n'
            '                  ),\n'
            '                ],\n'
            '              ),\n'
            '            ),\n'
            '            const SizedBox(height: 16),\n'
            '\n'
            '            // ── Card 5: Câu hỏi xét duyệt (khi APPROVAL) ──\n'
            '            if (_joinMode == \'APPROVAL\') ...[\n'
            '              _sectionCard(\n'
            '                colors: colors,\n'
            '                title: l10n.editClub_approvalSection,\n'
            '                subtitle: l10n.editClub_approvalSubtitle,\n'
            '                child: Column(\n'
            '                  crossAxisAlignment: CrossAxisAlignment.start,\n'
            '                  children: [\n'
            '                    Row(\n'
            '                      children: [\n'
            '                        Expanded(\n'
            '                          child: AppTextFormField(\n'
            '                            controller: _joinQuestionCtrl,\n'
            '                            hint: l10n.editClub_questionHint,\n'
            '                            prefixIcon: Icons.help_outline_rounded,\n'
            '                          ),\n'
            '                        ),\n'
            '                        const SizedBox(width: 8),\n'
            '                        IconButton.filled(\n'
            '                          onPressed: () {\n'
            '                            final question = _joinQuestionCtrl.text.trim();\n'
            '                            if (question.isEmpty ||\n'
            '                                _joinQuestions.contains(question)) {\n'
            '                              return;\n'
            '                            }\n'
            '                            setState(() {\n'
            '                              _joinQuestions.add(question);\n'
            '                              _joinQuestionCtrl.clear();\n'
            '                            });\n'
            '                          },\n'
            '                          icon: const Icon(\n'
            '                            Icons.add_rounded,\n'
            '                            color: Colors.white,\n'
            '                          ),\n'
            '                          style: IconButton.styleFrom(\n'
            '                            backgroundColor: AppTheme.primary,\n'
            '                            padding: const EdgeInsets.all(12),\n'
            '                          ),\n'
            '                          tooltip: l10n.editClub_addQuestion,\n'
            '                        ),\n'
            '                      ],\n'
            '                    ),\n'
            '                    if (_joinQuestions.isNotEmpty) ...[\n'
            '                      const SizedBox(height: 10),\n'
            '                      ..._joinQuestions.asMap().entries.map(\n'
            '                        (entry) => Container(\n'
            '                          margin: const EdgeInsets.only(bottom: 6),\n'
            '                          padding: const EdgeInsets.symmetric(\n'
            '                            horizontal: 12,\n'
            '                            vertical: 8,\n'
            '                          ),\n'
            '                          decoration: BoxDecoration(\n'
            '                            color: colors.bgDark,\n'
            '                            borderRadius: BorderRadius.circular(8),\n'
            '                            border: Border.all(color: colors.border),\n'
            '                          ),\n'
            '                          child: Row(\n'
            '                            children: [\n'
            '                              Text(\n'
            '                                \'${entry.key + 1}.\',\n'
            '                                style: const TextStyle(\n'
            '                                  fontWeight: FontWeight.w700,\n'
            '                                  color: AppTheme.primary,\n'
            '                                  fontSize: 13,\n'
            '                                ),\n'
            '                              ),\n'
            '                              const SizedBox(width: 8),\n'
            '                              Expanded(\n'
            '                                child: Text(\n'
            '                                  entry.value,\n'
            '                                  style: TextStyle(\n'
            '                                    fontSize: 13,\n'
            '                                    fontWeight: FontWeight.w500,\n'
            '                                    color: colors.textPrimary,\n'
            '                                  ),\n'
            '                                ),\n'
            '                              ),\n'
            '                              IconButton(\n'
            '                                icon: Icon(\n'
            '                                  Icons.close_rounded,\n'
            '                                  size: 16,\n'
            '                                  color: colors.textSecondary,\n'
            '                                ),\n'
            '                                padding: EdgeInsets.zero,\n'
            '                                constraints: const BoxConstraints(),\n'
            '                                onPressed: () => setState(\n'
            '                                  () => _joinQuestions.removeAt(entry.key),\n'
            '                                ),\n'
            '                              ),\n'
            '                            ],\n'
            '                          ),\n'
            '                        ),\n'
            '                      ),\n'
            '                    ],\n'
            '                  ],\n'
            '                ),\n'
            '              ),\n'
            '              const SizedBox(height: 16),\n'
            '            ],\n'
            '\n'
            '            // ── Card 6: Mạng xã hội ──\n'
            '            _sectionCard(\n'
            '              colors: colors,\n'
            '              title: l10n.editClub_socialSection,\n'
            '              subtitle: l10n.editClub_socialSubtitle,\n'
            '              child: ClubSocialLinksEditor(\n'
            '                initialLinks: _socialLinks,\n'
            '                onChanged: (links) => _socialLinks = links,\n'
            '              ),\n'
            '            ),\n'
            '            const SizedBox(height: 24),\n'
            '\n'
            '            // Nút Lưu chính\n'
            '            SizedBox(\n'
            '              width: double.infinity,\n'
            '              height: 50,\n'
            '              child: FilledButton.icon(\n'
            '                onPressed: _isLoading ? null : _save,\n'
            '                icon: _isLoading\n'
            '                    ? const SizedBox(\n'
            '                        width: 18,\n'
            '                        height: 18,\n'
            '                        child: CircularProgressIndicator(\n'
            '                          strokeWidth: 2,\n'
            '                          color: Colors.white,\n'
            '                        ),\n'
            '                      )\n'
            '                    : const Icon(Icons.check_circle_outline_rounded, size: 20),\n'
            '                label: Text(\n'
            '                  _isLoading\n'
            '                      ? (club?.status.trim().toUpperCase() == \'REJECTED\'\n'
            '                            ? l10n.editClub_resubmitting\n'
            '                            : l10n.editClub_saving)\n'
            '                      : (club?.status.trim().toUpperCase() == \'REJECTED\'\n'
            '                            ? l10n.editClub_resubmit\n'
            '                            : l10n.editClub_saveAll),\n'
            '                  style: const TextStyle(\n'
            '                    fontWeight: FontWeight.w800,\n'
            '                    fontSize: 15,\n'
            '                  ),\n'
            '                ),\n'
            '                style: FilledButton.styleFrom(\n'
            '                  backgroundColor: AppTheme.primary,\n'
            '                  foregroundColor: Colors.white,\n'
            '                  shape: RoundedRectangleBorder(\n'
            '                    borderRadius: BorderRadius.circular(12),\n'
            '                  ),\n'
            '                ),\n'
            '              ),\n'
            '            ),\n'
            '            const SizedBox(height: 24),\n'
            '\n'
            '            _buildDangerZone(colors),\n'
            '            const SizedBox(height: 32),\n'
            '          ],\n'
            '        ),\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '\n'
            '  Widget _approvalStatusBanner(AppColorsExtension colors, Community club) {\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '    final isRejected = club.status.trim().toUpperCase() == \'REJECTED\';\n'
            '    final color = isRejected ? colors.error : const Color(0xFFD97706);\n'
            '    final message = isRejected\n'
            '        ? (club.rejectedReason?.trim().isNotEmpty == true\n'
            '              ? club.rejectedReason!.trim()\n'
            '              : l10n.profileClubRejected)\n'
            '        : l10n.editClub_pendingNotice;\n'
            '\n'
            '    return Container(\n'
            '      width: double.infinity,\n'
            '      padding: const EdgeInsets.all(14),\n'
            '      decoration: BoxDecoration(\n'
            '        color: color.withValues(alpha: 0.08),\n'
            '        borderRadius: BorderRadius.circular(14),\n'
            '        border: Border.all(color: color.withValues(alpha: 0.25)),\n'
            '      ),\n'
            '      child: Row(\n'
            '        crossAxisAlignment: CrossAxisAlignment.start,\n'
            '        children: [\n'
            '          Icon(\n'
            '            isRejected\n'
            '                ? Icons.error_outline_rounded\n'
            '                : Icons.hourglass_empty_rounded,\n'
            '            color: color,\n'
            '          ),\n'
            '          const SizedBox(width: 10),\n'
            '          Expanded(\n'
            '            child: Text(\n'
            '              message,\n'
            '              style: TextStyle(\n'
            '                color: color,\n'
            '                fontSize: 13,\n'
            '                fontWeight: FontWeight.w600,\n'
            '              ),\n'
            '            ),\n'
            '          ),\n'
            '        ],\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '\n'
            '  Widget _sectionCard({\n'
            '    required AppColorsExtension colors,\n'
            '    required String title,\n'
            '    required String subtitle,\n'
            '    required Widget child,\n'
            '  }) {\n'
            '    return Container(\n'
            '      width: double.infinity,\n'
            '      padding: const EdgeInsets.all(16),\n'
