            '        child: Column(\n'
            '          mainAxisAlignment: MainAxisAlignment.center,\n'
            '          children: [\n'
            '            Container(\n'
            '              width: 100,\n'
            '              height: 100,\n'
            '              decoration: BoxDecoration(\n'
            '                color: context.colors.success.withValues(alpha: 0.1),\n'
            '                shape: BoxShape.circle,\n'
            '              ),\n'
            '              child: Icon(\n'
            '                Icons.check_circle_rounded,\n'
            '                size: 52,\n'
