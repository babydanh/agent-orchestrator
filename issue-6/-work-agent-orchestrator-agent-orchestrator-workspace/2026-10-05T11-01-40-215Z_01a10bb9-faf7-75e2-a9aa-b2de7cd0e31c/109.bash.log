            '\n'
            '  String _formatFee(num amount) =>\n'
            '      \'${_formatAmount(amount)}${l10n.registerFeeUnit}\';\n'
            '\n'
            '  String? _genderError;\n'
            '  String? _eloError;\n'
            '  bool _eloChecking = false;\n'
            '  bool _inviteValidating = false;\n'
            '  String? _inviteError;\n'
            '  String? _localInviteCode;\n'
            '  double? _registeredEntryFee;\n'
            '  TournamentDivisionOption? _registeredDivision;\n'
            '  String? _registrationTeamStatus;\n'
            '  bool _checkingRegistration = true;\n'
            '  bool _alreadyRegistered = false;\n'
            '  String? _existingParticipantId;\n'
            '  String? _existingDivisionId;\n'
            '  String? _existingTeamStatus;\n'
            '  bool _existingIsPaid = false;\n'
            '  bool _existingPaymentEligible = false;\n'
            '\n'
            '  bool _rankingConsent = false;\n'
            '  final Map<String, dynamic> _customResponses = {};\n'
            '\n'
            '  String _getSubmitLabel(Tournament? t) {\n'
            '    if (t?.registrationMode == \'APPROVAL\') return l10n.registerSubmitApproval;\n'
            '    return l10n.registerSubmitConfirm;\n'
            '  }\n'
            '\n'
            '  List<Map<String, dynamic>> _activeRegistrationFields(Tournament tournament) {\n'
            '    final divisionId = _selectedDiv;\n'
            '    if (divisionId == null || divisionId.isEmpty) return const [];\n'
            '    if (tournament.registrationFormDivisionIds.isNotEmpty &&\n'
            '        !tournament.registrationFormDivisionIds.contains(divisionId)) {\n'
            '      return const [];\n'
            '    }\n'
            '\n'
            '    return tournament.registrationFields;\n'
            '  }\n'
            '\n'
            '  String? _validateCustomResponses(Tournament tournament) {\n'
            '    for (final field in _activeRegistrationFields(tournament)) {\n'
            '      final id = field[\'id\']?.toString() ?? \'\';\n'
            '      final value = _customResponses[id];\n'
            '      final empty =\n'
            '          value == null ||\n'
            '          value.toString().trim().isEmpty ||\n'
            '          (value is List && value.isEmpty);\n'
            '      final label = field[\'label\']?.toString() ?? id;\n'
            '      if (field[\'required\'] == true && empty) {\n'
            '        return l10n.registerCustomFieldRequired(label);\n'
            '      }\n'
            '      if (empty) continue;\n'
            '      if (field[\'type\'] == \'EMAIL\' &&\n'
            '          !RegExp(r\'^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$\').hasMatch(value.toString())) {\n'
            '        return l10n.registerCustomFieldEmailInvalid(label);\n'
            '      }\n'
            '\n'
            '      if (field[\'type\'] == \'NUMBER\') {\n'
            '        final number = num.tryParse(value.toString());\n'
            '        if (number == null) return l10n.registerCustomFieldNumberInvalid(label);\n'
            '        final min = num.tryParse(field[\'min\']?.toString() ?? \'\');\n'
            '        final max = num.tryParse(field[\'max\']?.toString() ?? \'\');\n'
            '        if (min != null && number < min) {\n'
            '          return l10n.registerCustomFieldMin(label, min);\n'
            '        }\n'
            '        if (max != null && number > max) {\n'
            '          return l10n.registerCustomFieldMax(label, max);\n'
            '        }\n'
            '      }\n'
            '      if (field[\'type\'] == \'SELECT\' &&\n'
            '          field[\'options\'] is List &&\n'
            '          !(field[\'options\'] as List).contains(value)) {\n'
            '        return l10n.registerCustomFieldSelectInvalid(label);\n'
            '      }\n'
            '      if (field[\'type\'] == \'CHECKBOX\' && value != true) {\n'
            '        return l10n.registerCustomFieldCheckboxRequired(label);\n'
            '      }\n'
            '    }\n'
            '    return null;\n'
            '  }\n'
            '\n'
            '  Widget _buildCustomFields(Tournament tournament) {\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '    final fields = _activeRegistrationFields(tournament);\n'
            '    if (fields.isEmpty) return const SizedBox.shrink();\n'
            '\n'
            '    // Tự động điền sẵn Email và Số điện thoại từ profile nếu trường chưa có giá trị\n'
            '    final userProfileAsync = ref.watch(userProfileProvider);\n'
            '    final userProfile = userProfileAsync.asData?.value;\n'
            '    if (userProfile != null) {\n'
            '      for (final field in fields) {\n'
            '        final id = field[\'id\']?.toString() ?? \'\';\n'
            '        if (id.isEmpty) continue;\n'
            '        if (!_customResponses.containsKey(id) ||\n'
            '            _customResponses[id] == null ||\n'
            '            _customResponses[id].toString().trim().isEmpty) {\n'
            '          final label = (field[\'label\']?.toString() ?? \'\').toLowerCase();\n'
            '          final type = field[\'type\']?.toString();\n'
            '          final isEmailField =\n'
            '              type == \'EMAIL\' ||\n'
            '              label.contains(\'email\') ||\n'
            '              label.contains(\'gmail\');\n'
            '          final isPhoneField =\n'
            '              type == \'PHONE\' ||\n'
            '              label.contains(\'điện thoại\') ||\n'
            '              label.contains(\'sđt\') ||\n'
            '              label.contains(\'phone\');\n'
            '\n'
            '          if (isEmailField &&\n'
            '              userProfile.email != null &&\n'
            '              userProfile.email!.isNotEmpty) {\n'
            '            _customResponses[id] = userProfile.email;\n'
            '          } else if (isPhoneField &&\n'
            '              userProfile.phoneNumber != null &&\n'
            '              userProfile.phoneNumber!.isNotEmpty) {\n'
            '            _customResponses[id] = userProfile.phoneNumber;\n'
            '          }\n'
            '        }\n'
            '      }\n'
            '    }\n'
            '\n'
            '    return Container(\n'
            '      padding: const EdgeInsets.all(14),\n'
            '      decoration: BoxDecoration(\n'
            '        color: context.colors.bgSurface,\n'
            '        borderRadius: BorderRadius.circular(12),\n'
            '        border: Border.all(color: AppTheme.primary.withValues(alpha: 0.25)),\n'
            '      ),\n'
            '      child: Column(\n'
            '        crossAxisAlignment: CrossAxisAlignment.start,\n'
            '        children: [\n'
            '          Text(\n'
            '            l10n.registerAdditionalInfoTitle,\n'
            '            style: TextStyle(fontSize: 14, fontWeight: FontWeight.w800),\n'
            '          ),\n'
            '          const SizedBox(height: 4),\n'
            '          Text(\n'
            '            l10n.registerAdditionalInfoDescription,\n'
            '            style: TextStyle(fontSize: 12, color: context.colors.textSecondary),\n'
            '          ),\n'
            '          const SizedBox(height: 12),\n'
            '          ...fields.map((field) {\n'
            '            final id = field[\'id\']?.toString() ?? \'\';\n'
            '            final label = field[\'label\']?.toString() ?? id;\n'
            '            final required = field[\'required\'] == true;\n'
            '            final type = field[\'type\']?.toString();\n'
            '            final help = field[\'helpText\']?.toString();\n'
            '            if (type == \'CHECKBOX\') {\n'
            '              return CheckboxListTile(\n'
            '                contentPadding: EdgeInsets.zero,\n'
            '                value: _customResponses[id] == true,\n'
            '                onChanged: (value) =>\n'
            '                    setState(() => _customResponses[id] = value == true),\n'
            '                title: Text(\n'
            '                  \'$label${required ? \' *\' : \'\'}\',\n'
            '                  style: const TextStyle(\n'
            '                    fontSize: 13,\n'
            '                    fontWeight: FontWeight.w700,\n'
            '                  ),\n'
            '                ),\n'
            '              );\n'
            '            }\n'
            '            if (type == \'SELECT\') {\n'
            '              return DropdownButtonFormField<String>(\n'
            '                initialValue: _customResponses[id]?.toString(),\n'
            '                decoration: InputDecoration(\n'
            '                  labelText: \'$label${required ? \' *\' : \'\'}\',\n'
            '                  helperText: help,\n'
            '                ),\n'
            '                items: [\n'
            '                  DropdownMenuItem(\n'
            '                    value: \'\',\n'
            '                    child: Text(l10n.registerSelectOption),\n'
            '                  ),\n'
            '                  ...((field[\'options\'] as List? ?? const []).map(\n'
            '                    (option) => DropdownMenuItem(\n'
            '                      value: option.toString(),\n'
            '                      child: Text(option.toString()),\n'
            '                    ),\n'
            '                  )),\n'
            '                ],\n'
            '                onChanged: (value) =>\n'
            '                    setState(() => _customResponses[id] = value),\n'
            '              );\n'
            '            }\n'
            '            return Padding(\n'
            '              padding: const EdgeInsets.only(bottom: 10),\n'
            '              child: TextFormField(\n'
            '                initialValue: _customResponses[id]?.toString() ?? \'\',\n'
            '                keyboardType: type == \'NUMBER\'\n'
            '                    ? TextInputType.number\n'
            '                    : type == \'EMAIL\'\n'
            '                    ? TextInputType.emailAddress\n'
            '                    : type == \'PHONE\'\n'
            '                    ? TextInputType.phone\n'
            '                    : TextInputType.text,\n'
            '                maxLines: type == \'TEXTAREA\' ? 3 : 1,\n'
            '                decoration: InputDecoration(\n'
            '                  labelText: \'$label${required ? \' *\' : \'\'}\',\n'
            '                  helperText: help,\n'
            '                ),\n'
            '                onChanged: (value) => _customResponses[id] = value,\n'
            '              ),\n'
            '            );\n'
            '          }),\n'
            '        ],\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '\n'
            '  @override\n'
            '  void dispose() {\n'
            '    _registrationSubscription?.cancel();\n'
            '    _registrationRefreshDebounce?.cancel();\n'
            '    _socketService?.leaveTournament(widget.tournamentId);\n'
            '    _nameCtrl.dispose();\n'
            '    _inviteCtrl.dispose();\n'
            '    super.dispose();\n'
            '  }\n'
            '\n'
            '  TournamentDivisionOption? get _selectedDivision {\n'
            '    final divisions = ref\n'
            '        .read(_divisionsProvider(widget.tournamentId))\n'
            '        .asData\n'
            '        ?.value;\n'
            '    if (divisions == null || _selectedDiv == null) return null;\n'
            '    final division = divisions\n'
            '        .where((candidate) => candidate.id == _selectedDiv)\n'
            '        .firstOrNull;\n'
            '    if (division == null) return null;\n'
            '    return _alreadyRegistered || isRegistrationDivisionActive(division)\n'
            '        ? division\n'
            '        : null;\n'
            '  }\n'
            '\n'
            '  /// Hạn chót hiệu lực của nội dung đang chọn.\n'
            '  ///\n'
            '  /// Backend chặn theo mốc sớm nhất trong hạn của nội dung và hạn của giải\n'
            '  /// (tournament-registration.repository.ts:705-719), còn màn này trước đây chỉ\n'
            '  /// xét hạn cấp giải. Chọn nội dung đã đóng hạn thì form vẫn nhận và nút vẫn\n'
            '  /// bấm được, chỉ tới lúc gửi mới nhận lỗi.\n'
            '  ///\n'
            '  /// `effectiveRegistrationEndDate` là mốc backend đã tính sẵn; null nghĩa là\n'
            '  /// không đặt hạn và server cũng không chặn theo ngày, nên không được coi null\n'
            '  /// là đã hết hạn. Khi chưa chọn division, chỉ hạn cấp giải được áp dụng; nếu\n'
            '  /// các division đã lưu chưa có lựa chọn hợp lệ thì đăng ký sẽ bị chặn.\n'
            '  DateTime? get _effectiveRegistrationDeadline {\n'
            '    final tournament = ref.read(tournamentProvider(widget.tournamentId)).value;\n'
            '    return _selectedDivision?.effectiveRegistrationEndDate ??\n'
            '        tournament?.registrationEndDate;\n'
            '  }\n'
            '\n'
            '  bool get _isDivisionRegistrationExpired {\n'
            '    final deadline = _effectiveRegistrationDeadline;\n'
            '    return deadline != null && DateTime.now().isAfter(deadline);\n'
            '  }\n'
            '\n'
            '  /// Nội dung mà lần đăng ký mới sẽ nhắm tới.\n'
            '  ///\n'
            '  /// Chỉ dùng lựa chọn hiện tại nếu division còn hoạt động; tự chọn chỉ khi có\n'
            '  /// đúng một division hoạt động. Nếu có nhiều, caller phải chọn rõ ràng.\n'
            '  TournamentDivisionOption? get _claimDivision {\n'
            '    final divisions = ref\n'
            '        .read(_divisionsProvider(widget.tournamentId))\n'
            '        .asData\n'
            '        ?.value;\n'
            '    if (divisions == null) return null;\n'
            '    final id = resolveRegistrationDivisionId(\n'
            '      divisions,\n'
            '      preferredDivisionId: _selectedDiv,\n'
            '    );\n'
            '    if (id == null) return null;\n'
            '    return divisions.where((division) => division.id == id).firstOrNull;\n'
            '  }\n'
            '\n'
            '  /// Nội dung sắp đăng ký đã đầy suất đội.\n'
            '  ///\n'
            '  /// Chỉ chặn đăng ký MỚI: người đã có đơn được `build` đưa thẳng sang\n'
            '  /// `_buildExistingRegistration`, không bao giờ tới form nên vẫn xem trạng\n'
            '  /// thái / thanh toán / rút lui bình thường. Khóa đăng ký thủ công của BTC là\n'
            '  /// trạng thái riêng (`isRegistrationClosed`), không gộp vào đây.\n'
            '  bool get _isSelectedDivisionFull => _claimDivision?.isFull ?? false;\n'
            '\n'
            '  void _onDivisionSelected(\n'
            '    String id,\n'
            '    List<TournamentDivisionOption> divisions,\n'
            '  ) {\n'
            '    if (_alreadyRegistered &&\n'
            '        _existingDivisionId != null &&\n'
            '        _existingDivisionId != id) {\n'
            '      final existingDiv =\n'
            '          divisions.where((d) => d.id == _existingDivisionId).firstOrNull;\n'
            '      final name = existingDiv?.name ?? \'nội dung khác\';\n'
            '      ScaffoldMessenger.of(context).showSnackBar(\n'
            '        SnackBar(\n'
            '          content: Text(\n'
            '            \'Bạn đang có đơn/đội đã tạo ở nội dung "$name". Vui lòng hủy đăng ký hiện tại trước khi chuyển sang nội dung khác.\',\n'
            '          ),\n'
            '          backgroundColor: Colors.orange,\n'
            '        ),\n'
            '      );\n'
            '      return;\n'
            '    }\n'
            '\n'
            '    setState(() {\n'
            '      _selectedDiv = id;\n'
            '      _divisionError = null;\n'
            '      _genderError = null;\n'
            '      _eloError = null;\n'
            '    });\n'
            '    // Find selected division for validation\n'
            '    final div = _selectedDivision;\n'
            '    if (div == null) return;\n'
            '\n'
            '    // Check gender restriction\n'
            '    final userAsync = ref.read(userProfileProvider);\n'
            '    final user = userAsync.asData?.value;\n'
            '    final divGender = _normalizedGender(div.genderRestriction);\n'
            '    if (user != null && divGender != null && divGender != \'MIXED\') {\n'
            '      final userGender = _normalizedGender(user.gender);\n'
            '      if (userGender != null && userGender != divGender) {\n'
            '        setState(() {\n'
            '          _genderError = divGender == \'MALE\'\n'
            '              ? l10n.registerGenderErrorMale\n'
            '              : l10n.registerGenderErrorFemale;\n'
            '        });\n'
            '      }\n'
            '    }\n'
            '\n'
            '    // Check ELO\n'
            '    if (div.categoryId != null && user != null) {\n'
            '      _checkElo(user.id, div.categoryId!, div.minElo, div.maxElo);\n'
            '    }\n'
            '  }\n'
            '\n'
            '  Future<void> _checkElo(\n'
            '    String userId,\n'
            '    String categoryId,\n'
            '    double? minElo,\n'
            '    double? maxElo,\n'
            '  ) async {\n'
            '    setState(() => _eloChecking = true);\n'
            '    try {\n'
            '      final repo = ref.read(rankingRepositoryProvider);\n'
            '      final response = await repo.getUserRank(userId, categoryId);\n'
            '      final elo = response.eloPoints ?? 1000;\n'
            '      if (minElo != null && elo < minElo) {\n'
            '        setState(() => _eloError = l10n.registerEloTooLow(elo, minElo.toInt()));\n'
            '      } else if (maxElo != null && elo > maxElo) {\n'
            '        setState(\n'
            '          () => _eloError = l10n.registerEloTooHigh(elo, maxElo.toInt()),\n'
            '        );\n'
            '      }\n'
            '    } catch (_) {\n'
            '      if (mounted) {\n'
            '        setState(() => _eloError = l10n.registerEloCheckError);\n'
            '      }\n'
            '    } finally {\n'
            '      if (mounted) setState(() => _eloChecking = false);\n'
            '    }\n'
            '  }\n'
            '\n'
            '  Future<void> _validateInvite() async {\n'
            '    final code = _inviteCtrl.text.trim();\n'
            '    if (code.length < 6) {\n'
            '      setState(() => _inviteError = l10n.registerInviteTooShort);\n'
            '      return;\n'
            '    }\n'
            '    setState(() {\n'
            '      _inviteValidating = true;\n'
            '      _inviteError = null;\n'
            '    });\n'
            '    try {\n'
            '      final dio = ref.read(dioClientProvider);\n'
            '      await dio.dio.post(\n'
            '        \'/tournaments/${widget.tournamentId}/validate-invite\',\n'
            '        data: {\'inviteCode\': code},\n'
            '      );\n'
            '      if (mounted) setState(() => _localInviteCode = code);\n'
            '    } catch (e) {\n'
            '      if (mounted) {\n'
            '        setState(() => _inviteError = l10n.registerInviteInvalid);\n'
            '      }\n'
            '    } finally {\n'
            '      if (mounted) setState(() => _inviteValidating = false);\n'
            '    }\n'
            '  }\n'
            '\n'
            '  Future<void> _register() async {\n'
            '    if (_alreadyRegistered) {\n'
            '      ScaffoldMessenger.of(\n'
            '        context,\n'
            '      ).showSnackBar(SnackBar(content: Text(l10n.registerAlreadyRegistered)));\n'
            '      return;\n'
            '    }\n'
            '\n'
            '    // Chặn ở client trước khi gọi API; server vẫn là nguồn chân lý và trả 400\n'
            '    // nếu suất vừa bị người khác chiếm mất giữa hai lần đọc capacity.\n'
            '    if (_isSelectedDivisionFull) {\n'
            '      ScaffoldMessenger.of(\n'
            '        context,\n'
            '      ).showSnackBar(SnackBar(content: Text(l10n.registerDivisionFull)));\n'
            '      return;\n'
            '    }\n'
            '    if (!_formKey.currentState!.validate()) return;\n'
            '    final userAsync = ref.read(userProfileProvider);\n'
            '    final user = userAsync.asData?.value;\n'
            '    final tournament = ref\n'
            '        .read(tournamentProvider(widget.tournamentId))\n'
            '        .asData\n'
            '        ?.value;\n'
            '    final divisions = ref.read(_divisionsProvider(widget.tournamentId)).value;\n'
            '    final divisionId = divisions == null\n'
            '        ? _selectedDiv\n'
            '        : resolveRegistrationDivisionId(\n'
            '            divisions,\n'
            '            preferredDivisionId: _selectedDiv,\n'
            '          );\n'
            '    final hasPersistedDivisions =\n'
            '        divisions?.any(\n'
            '          (division) => persistedTournamentDivisionId(division.id) != null,\n'
            '        ) ??\n'
            '        false;\n'
            '    if (divisionId == null && (divisions == null || hasPersistedDivisions)) {\n'
            '      setState(() => _divisionError = l10n.registerSelectDivision);\n'
            '      return;\n'
            '    }\n'
            '    final selectedDivision = divisions\n'
            '        ?.where((division) => division.id == divisionId)\n'
            '        .firstOrNull;\n'
            '    // Đã có ID nội dung nhưng danh sách chưa tải xong thì không suy đoán: để\n'
            '    // server từ chối nếu nội dung đó giới hạn giới tính, thay vì chặn nhầm\n'
            '    // người chơi của nội dung linh hoạt.\n'
            '    final genderRestriction = selectedDivision == null\n'
            '        ? (divisionId == null ? tournament?.genderRestriction : null)\n'
            '        : selectedDivision.genderRestriction;\n'
            '    final missingFields = <String>[];\n'
            '    if (user?.fullName == null || user!.fullName!.trim().isEmpty) {\n'
            '      missingFields.add(l10n.registerMissingFullName);\n'
            '    }\n'
            '    if (user?.phoneNumber == null || user!.phoneNumber!.trim().isEmpty) {\n'
            '      missingFields.add(l10n.registerMissingPhone);\n'
            '    }\n'
            '    final profileGender = user?.gender?.trim();\n'
            '    if (requiresGenderProfileForDivision(genderRestriction) &&\n'
            '        (profileGender == null || profileGender.isEmpty)) {\n'
            '      missingFields.add(l10n.registerMissingGender);\n'
            '    }\n'
            '\n'
            '    if (missingFields.isNotEmpty) {\n'
            '      if (mounted) {\n'
            '        final missingStr = missingFields.join(\', \');\n'
            '        showDialog(\n'
            '          context: context,\n'
            '          builder: (ctx) => AlertDialog(\n'
            '            title: Text(l10n.registerProfileIncompleteTitle),\n'
            '            content: Text(l10n.registerProfileIncompleteFields(missingStr)),\n'
            '            actions: [\n'
            '              TextButton(\n'
            '                onPressed: () => Navigator.pop(ctx),\n'
            '                child: Text(l10n.registerClose),\n'
            '              ),\n'
            '              ElevatedButton(\n'
            '                onPressed: () {\n'
            '                  Navigator.pop(ctx);\n'
            '                  context.push(\'/profile\');\n'
            '                },\n'
            '                child: Text(l10n.registerUpdateProfile),\n'
            '              ),\n'
            '            ],\n'
            '          ),\n'
            '        );\n'
            '      }\n'
            '      return;\n'
            '    }\n'
            '    if (tournament?.isRanked == true && !_rankingConsent) {\n'
            '      if (mounted) {\n'
            '        ScaffoldMessenger.of(context).showSnackBar(\n'
            '          SnackBar(content: Text(l10n.registerRankingConsentRequired)),\n'
            '        );\n'
            '      }\n'
            '      return;\n'
            '    }\n'
            '    if (_genderError != null) {\n'
            '      if (mounted) {\n'
            '        ScaffoldMessenger.of(\n'
            '          context,\n'
            '        ).showSnackBar(SnackBar(content: Text(_genderError!)));\n'
            '      }\n'
            '      return;\n'
            '    }\n'
            '    if (_eloError != null) {\n'
            '      if (mounted) {\n'
            '        ScaffoldMessenger.of(\n'
            '          context,\n'
            '        ).showSnackBar(SnackBar(content: Text(_eloError!)));\n'
            '      }\n'
            '      return;\n'
            '    }\n'
            '\n'
            '    if (tournament != null) {\n'
            '      final customError = _validateCustomResponses(tournament);\n'
            '      if (customError != null) {\n'
            '        if (mounted) {\n'
            '          ScaffoldMessenger.of(\n'
            '            context,\n'
            '          ).showSnackBar(SnackBar(content: Text(customError)));\n'
            '        }\n'
            '\n'
            '        return;\n'
            '      }\n'
            '    }\n'
            '    // Team sport (bóng đá): config có teamSize → đăng ký đội nhiều người\n'
            '    final tournamentForTeam = ref\n'
            '        .read(tournamentProvider(widget.tournamentId))\n'
            '        .asData\n'
            '        ?.value;\n'
            '    if (tournamentForTeam != null &&\n'
            '        (tournamentForTeam.teamSize != null ||\n'
            '            tournamentForTeam.minTeamSize != null)) {\n'
            '      final inviteCode = _localInviteCode ?? widget.inviteCode ?? \'\';\n'
            '      final selectedTeamDivision = divisions\n'
            '          ?.where((d) => d.id == divisionId)\n'
            '          .firstOrNull;\n'
            '      final query = <String, String>{\n'
            '        \'invite\': inviteCode,\n'
            '        ...?(divisionId == null ? null : {\'divisionId\': divisionId}),\n'
            '        if (selectedTeamDivision?.categoryId != null)\n'
            '          \'categoryId\': selectedTeamDivision!.categoryId!,\n'
            '        if (tournamentForTeam.teamSize != null)\n'
            '          \'teamSize\': \'${tournamentForTeam.teamSize}\',\n'
            '        if (tournamentForTeam.maxReserve != null)\n'
            '          \'maxReserve\': \'${tournamentForTeam.maxReserve}\',\n'
            '      };\n'
            '      await context.push(\n'
            '        Uri(\n'
            '          path: \'/register/${widget.tournamentId}/team\',\n'
            '          queryParameters: query,\n'
            '        ).toString(),\n'
            '      );\n'
            '      if (mounted) {\n'
            '        // The team flow mutates the participant/division counters outside this\n'
            '        // screen. Refresh them when it returns instead of showing stale data.\n'
            '        ref.invalidate(tournamentProvider(widget.tournamentId));\n'
            '        ref.invalidate(tournamentIntroProvider(widget.tournamentId));\n'
            '        ref.invalidate(_divisionsProvider(widget.tournamentId));\n'
            '      }\n'
            '      return;\n'
            '    }\n'
            '    // If doubles division, navigate to doubles flow\n'
            '    final selectedDiv = divisions?.where((d) => d.id == divisionId).firstOrNull;\n'
            '    if (selectedDiv != null &&\n'
            '        (_normalizedMatchType(selectedDiv.matchType) == \'DOUBLES\' ||\n'
            '            _normalizedMatchType(selectedDiv.matchType) == \'MIXED_DOUBLES\')) {\n'
            '      final inviteCode = _localInviteCode ?? widget.inviteCode ?? \'\';\n'
            '      context.push(\n'
            '        \'/register/${widget.tournamentId}/doubles?divisionId=$divisionId&invite=$inviteCode\',\n'
            '        extra: selectedDiv,\n'
            '      );\n'
            '      return;\n'
            '    }\n'
            '    final String effectiveTeamName = _nameCtrl.text.trim().isNotEmpty\n'
            '        ? _nameCtrl.text.trim()\n'
            '        : (user?.fullName?.trim().isNotEmpty == true\n'
            '              ? user!.fullName!.trim()\n'
            '              : l10n.registerTypeDefault);\n'
            '\n'
            '    setState(() => _submitting = true);\n'
            '    try {\n'
            '      final result = await ref\n'
            '          .read(tournamentRepositoryProvider)\n'
            '          .registerParticipant(\n'
            '            tournamentId: widget.tournamentId,\n'
            '            teamName: effectiveTeamName,\n'
            '            divisionId: divisionId,\n'
            '            inviteCode: _localInviteCode ?? widget.inviteCode,\n'
            '            rankingConsent: _rankingConsent,\n'
            '            customResponses: _customResponses,\n'
            '          );\n'
            '      if (!mounted) return;\n'
            '      // Refresh the detail streams so the participant count reflects the\n'
            '      // successful registration when the user returns to the tournament.\n'
            '      ref.invalidate(tournamentProvider(widget.tournamentId));\n'
            '      ref.invalidate(tournamentIntroProvider(widget.tournamentId));\n'
            '      final t = ref.read(tournamentProvider(widget.tournamentId)).asData?.value;\n'
            '      final effectiveFee = result.entryFee;\n'
            '      _registrationTeamStatus = result.teamStatus;\n'
            '      _registeredDivision = selectedDiv;\n'
            '      final canProceedToPayment =\n'
            '          !result.isWaitlisted && result.paymentEligible;\n'
            '\n'
            '      if (effectiveFee > 0 &&\n'
            '          result.participantId.isNotEmpty &&\n'
            '          canProceedToPayment) {\n'
            '        context.push(\n'
            '          \'/payment/checkout\',\n'
            '          extra: {\n'
            '            \'tournamentId\': widget.tournamentId,\n'
            '            \'participantId\': result.participantId,\n'
            '            \'divisionId\': divisionId,\n'
            '            \'amount\': effectiveFee,\n'
            '            \'tournamentName\': t?.name ?? l10n.payments_defaultTournamentName,\n'
            '          },\n'
            '        );\n'
            '      } else {\n'
            '        setState(() {\n'
            '          _success = true;\n'
            '          _registeredEntryFee = effectiveFee;\n'
            '        });\n'
            '      }\n'
            '    } catch (e) {\n'
            '      if (mounted) {\n'
            '        String msg = ErrorParser.parse(e, l10n.registerError);\n'
            '        if (msg == l10n.registerError || msg.contains(\'Không thể đăng ký\')) {\n'
            '          final raw = e.toString();\n'
            '          if (raw.contains(\'BadRequestException:\') ||\n'
            '              raw.contains(\'Exception:\')) {\n'
            '            msg = raw.replaceAll(RegExp(r\'.*Exception:\\s*\'), \'\');\n'
            '          } else {\n'
            '            msg = raw;\n'
            '          }\n'
            '        }\n'
            '        // Nếu lỗi là "đã đăng ký rồi" → re-check và chuyển sang màn hình đăng ký hiện có\n'
            '        final lowerMsg = msg.toLowerCase();\n'
            '        if (lowerMsg.contains(\'đã đăng ký\') ||\n'
            '            lowerMsg.contains(\'already registered\') ||\n'
            '            lowerMsg.contains(\'đã tham gia\')) {\n'
            '          await _checkExistingRegistration();\n'
            '          return;\n'
            '        }\n'
            '        ScaffoldMessenger.of(context).showSnackBar(\n'
            '          SnackBar(\n'
            '            content: Text(msg),\n'
            '            backgroundColor: Colors.red,\n'
            '            duration: const Duration(seconds: 5),\n'
            '          ),\n'
            '        );\n'
            '      }\n'
            '    } finally {\n'
            '      if (mounted) setState(() => _submitting = false);\n'
            '    }\n'
            '  }\n'
            '\n'
            '  String _divisionTypeLabel(TournamentDivisionOption d) {\n'
            '    final matchType = _normalizedMatchType(d.matchType);\n'
            '    final isOpen = !requiresGenderProfileForDivision(d.genderRestriction);\n'
            '    if (isOpen && matchType == \'SINGLES\') {\n'
            '      return l10n.registerTypeOpenSingles;\n'
            '    }\n'
            '    if (isOpen && matchType == \'DOUBLES\') {\n'
            '      return l10n.registerTypeOpenDoubles;\n'
            '    }\n'
            '    final gender = switch (_normalizedGender(d.genderRestriction)) {\n'
            '      \'MALE\' => l10n.registerDivMale,\n'
            '      \'FEMALE\' => l10n.registerDivFemale,\n'
            '      \'MIXED\' => l10n.registerDivMixed,\n'
            '      _ => \'\',\n'
            '    };\n'
            '    final type = switch (matchType) {\n'
            '      \'SINGLES\' => l10n.registerTypeSingles,\n'
            '      \'DOUBLES\' => l10n.registerTypeDoubles,\n'
            '      \'MIXED_DOUBLES\' => l10n.registerTypeMixedDoubles,\n'
            '      _ => l10n.registerContentTitle,\n'
            '    };\n'
            '    if (type == l10n.registerTypeMixedDoubles || gender.isEmpty) return type;\n'
            '    return \'$type $gender\';\n'
            '  }\n'
            '\n'
            '  String? _normalizedGender(String? value) =>\n'
            '      normalizeDivisionGenderRestriction(value);\n'
            '\n'
            '  String? _normalizedMatchType(String? value) {\n'
            '    final normalized = value\n'
            '        ?.trim()\n'
            '        .toUpperCase()\n'
            '        .replaceAll(\'-\', \'_\')\n'
            '        .replaceAll(\' \', \'_\');\n'
            '    return switch (normalized) {\n'
            '      \'SINGLE\' || \'SINGLES\' || \'DON\' => \'SINGLES\',\n'
            '      \'DOUBLE\' || \'DOUBLES\' || \'DOI\' => \'DOUBLES\',\n'
            '      \'MIXED_DOUBLE\' || \'MIXED_DOUBLES\' || \'DOI_NAM_NU\' => \'MIXED_DOUBLES\',\n'
            '      _ => null,\n'
            '    };\n'
            '  }\n'
            '\n'
            '  List<String> _divisionMeta(TournamentDivisionOption d) {\n'
            '    final items = <String>[_divisionTypeLabel(d)];\n'
            '    if (d.minElo != null || d.maxElo != null) {\n'
            '      final min = d.minElo?.toInt().toString() ?? \'0\';\n'
            '      final max = d.maxElo?.toInt().toString() ?? \'∞\';\n'
            '      items.add(l10n.registerEloRange(min, max));\n'
            '    }\n'
            '    if (d.entryFee != null && d.entryFee! > 0) {\n'
            '      items.add(_formatFee(d.entryFee!));\n'
            '    } else {\n'
            '      items.add(l10n.registerFree);\n'
            '    }\n'
            '    final bracket = switch (d.bracketType?.toUpperCase()) {\n'
            '      \'SINGLE_ELIMINATION\' => l10n.registerBracketSingleElimination,\n'
            '      \'DOUBLE_ELIMINATION\' => l10n.registerBracketDoubleElimination,\n'
            '      \'ROUND_ROBIN\' => l10n.registerBracketRoundRobin,\n'
            '      \'GROUP_STAGE_KNOCKOUT\' => l10n.registerBracketGroupStageKnockout,\n'
            '      _ => null,\n'
            '    };\n'
            '    if (bracket != null) items.add(bracket);\n'
            '    // Sức chứa đếm theo suất đội: nội dung đôi có thể lẻ (1 VĐV = 0.5 đội).\n'
            '    // Nội dung đôi thiếu projection thì bỏ trống — số bản ghi không phải số suất.\n'
            '    final slots = d.teamSlotsLabel;\n'
            '    if (slots != null) items.add(l10n.registerTeamSlotCount(slots));\n'
            '    if (d.isFull) items.add(l10n.registerDivisionFull);\n'
            '    return items;\n'
            '  }\n'
            '\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '    final isAuth = ref.watch(authProvider).isAuthenticated;\n'
            '    // Tải kèm mã mời để đọc được giải PRIVATE (backend yêu cầu `?invite=`).\n'
            '    // Key đổi khi `_localInviteCode` đổi → tự refetch sau khi nhập mã.\n'
            '    final tAsync = ref.watch(\n'
            '      registerTournamentProvider((\n'
            '        id: widget.tournamentId,\n'
            '        invite: _localInviteCode ?? widget.inviteCode,\n'
            '      )),\n'
            '    );\n'
            '    final divAsync = ref.watch(_divisionsProvider(widget.tournamentId));\n'
            '\n'
            '    return Scaffold(\n'
            '      backgroundColor: context.colors.bgDark,\n'
            '      appBar: AppBar(title: Text(l10n.registerTitle), centerTitle: true),\n'
            '      body: SingleChildScrollView(\n'
            '        physics: const BouncingScrollPhysics(),\n'
            '        padding: const EdgeInsets.all(16),\n'
            '        child: tAsync.when(\n'
            '          data: (t) {\n'
            '            if (t == null) {\n'
            '              // Giải PRIVATE trả 403 (→ null) khi chưa có mã mời. Nếu chưa có\n'
            '              // mã thì hiện cổng nhập mã; chỉ báo "không tìm thấy" khi đã có\n'
            '              // mã mà vẫn tải không được (mã sai / giải không tồn tại).\n'
            '              final hasCode =\n'
            '                  widget.inviteCode != null || _localInviteCode != null;\n'
            '              if (!hasCode) return _buildInviteGate(null);\n'
            '              return Center(child: Text(l10n.registerTournamentNotFound));\n'
            '            }\n'
            '            if (!isAuth) return _buildLoginPrompt(t);\n'
            '            if (_checkingRegistration) {\n'
            '              return const Center(child: CircularProgressIndicator());\n'
            '            }\n'
            '            // Invite gate: nếu là PRIVATE và chưa có mã mời\n'
            '            final needsInvite =\n'
            '                (t.visibility == \'PRIVATE\' ||\n'
            '                    t.registrationMode == \'INVITE_ONLY\') &&\n'
            '                widget.inviteCode == null &&\n'
            '                _localInviteCode == null;\n'
            '            if (needsInvite) return _buildInviteGate(t);\n'
            '            return divAsync.when(\n'
            '              data: (divs) {\n'
            '                final effectiveDivs = divs.isNotEmpty\n'
            '                    ? divs\n'
            '                    : [\n'
            '                        TournamentDivisionOption(\n'
            '                          id: \'default_${t.id}\',\n'
            '                          name: t.name.isNotEmpty\n'
            '                              ? t.name\n'
            '                              : l10n.registerContentTitle,\n'
            '                          matchType:\n'
            '                              t.format.toLowerCase() == \'doubles\' ||\n'
            '                                  t.name.toLowerCase().contains(\n'
            '                                    l10n.registerTypeDoubles,\n'
            '                                  )\n'
            '                              ? \'DOUBLES\'\n'
            '                              : \'SINGLES\',\n'
            '                          entryFee: t.entryFee,\n'
            '                          maxParticipants: t.maxTeams,\n'
            '                          capacity: t.capacity,\n'
            '                        ),\n'
            '                      ];\n'
            '                if (_alreadyRegistered) {\n'
            '                  return _buildExistingRegistration(t, effectiveDivs);\n'
            '                }\n'
            '                if (_success) return _buildSuccess(t);\n'
            '                return _buildForm(t, AsyncValue.data(effectiveDivs));\n'
            '              },\n'
            '              loading: () => const Center(child: CircularProgressIndicator()),\n'
            '              error: (e, _) {\n'
            '                final fallbackDivs = [\n'
            '                  TournamentDivisionOption(\n'
            '                    id: \'default_${t.id}\',\n'
            '                    name: t.name.isNotEmpty\n'
            '                        ? t.name\n'
            '                        : l10n.registerContentTitle,\n'
            '                    matchType:\n'
            '                        t.format.toLowerCase() == \'doubles\' ||\n'
            '                            t.name.toLowerCase().contains(\n'
            '                              l10n.registerTypeDoubles,\n'
            '                            )\n'
            '                        ? \'DOUBLES\'\n'
            '                        : \'SINGLES\',\n'
            '                    entryFee: t.entryFee,\n'
            '                    maxParticipants: t.maxTeams,\n'
            '                    capacity: t.capacity,\n'
            '                  ),\n'
            '                ];\n'
            '                if (_alreadyRegistered) {\n'
            '                  return _buildExistingRegistration(t, fallbackDivs);\n'
            '                }\n'
            '                if (_success) return _buildSuccess(t);\n'
            '                return _buildForm(t, AsyncValue.data(fallbackDivs));\n'
            '              },\n'
            '            );\n'
            '          },\n'
            '          loading: () => const Center(child: CircularProgressIndicator()),\n'
            '          error: (e, _) => Center(child: Text(l10n.registerLoadError(e))),\n'
            '        ),\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '\n'
            '  String _getSuccessTitle(Tournament? t) {\n'
            '    if (_registrationTeamStatus == \'WAITLISTED\') {\n'
            '      return l10n.registerSuccessWaitlisted;\n'
            '    }\n'
            '    if (t?.registrationMode == \'APPROVAL\') {\n'
            '      return l10n.registerApprovalSuccessTitle;\n'
            '    }\n'
            '    return l10n.registerSuccess;\n'
            '  }\n'
            '\n'
            '  Widget _buildExistingRegistration(\n'
            '    Tournament tournament,\n'
            '    List<TournamentDivisionOption> divisions,\n'
            '  ) {\n'
            '    TournamentDivisionOption? existingDivision;\n'
            '    for (final division in divisions) {\n'
            '      if (division.id == _existingDivisionId) {\n'
            '        existingDivision = division;\n'
            '        break;\n'
            '      }\n'
            '    }\n'
            '\n'
            '    final fee = existingDivision?.entryFee ?? tournament.entryFee ?? 0;\n'
            '    final status = _existingTeamStatus ?? \'\';\n'
            '    final isPendingApproval = status == \'PENDING_APPROVAL\';\n'
            '    final isPendingPartner = status == \'PENDING_PARTNER\';\n'
            '    final isWaitlisted = status == \'WAITLISTED\';\n'
            '    final isComplete = status == \'COMPLETE\' || status == \'CONFIRMED\' || status == \'APPROVED\';\n'
            '    final canPay = !_existingIsPaid &&\n'
            '        fee > 0 &&\n'
            '        (_existingPaymentEligible || isComplete) &&\n'
            '        !isWaitlisted &&\n'
            '        !isPendingApproval &&\n'
            '        !isPendingPartner;\n'
            '\n'
            '    final statusLabel = switch (status) {\n'
            '      \'PENDING_PARTNER\' => l10n.registerStatusPendingPartner,\n'
            '      \'PENDING_APPROVAL\' => l10n.registerStatusPendingApproval,\n'
            '      \'WAITLISTED\' => l10n.registerStatusWaitlisted,\n'
            '      \'COMPLETE\' when _existingIsPaid => l10n.registerStatusCompletePaid,\n'
            '      \'COMPLETE\' => l10n.registerStatusCompleteUnpaid,\n'
            '      _ => l10n.registerAlreadyRegistered,\n'
            '    };\n'
            '\n'
            '    return Container(\n'
            '      width: double.infinity,\n'
            '      padding: const EdgeInsets.all(24),\n'
            '      decoration: BoxDecoration(\n'
            '        color: context.colors.bgCard,\n'
            '        borderRadius: BorderRadius.circular(16),\n'
            '        border: Border.all(color: context.colors.border),\n'
            '      ),\n'
            '      child: Column(\n'
            '        children: [\n'
            '          Icon(\n'
            '            _existingIsPaid ? Icons.verified_rounded : Icons.how_to_reg_rounded,\n'
            '            size: 52,\n'
            '            color: _existingIsPaid ? context.colors.success : AppTheme.primary,\n'
            '          ),\n'
            '          const SizedBox(height: 16),\n'
            '          Text(\n'
            '            statusLabel,\n'
            '            textAlign: TextAlign.center,\n'
            '            style: TextStyle(\n'
            '              color: context.colors.textPrimary,\n'
            '              fontSize: 18,\n'
            '              fontWeight: FontWeight.w800,\n'
            '            ),\n'
            '          ),\n'
            '          if (isPendingApproval) ...[\n'
            '            const SizedBox(height: 12),\n'
            '            Container(\n'
            '              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),\n'
            '              decoration: BoxDecoration(\n'
            '                color: Colors.amber.withValues(alpha: 0.12),\n'
            '                borderRadius: BorderRadius.circular(10),\n'
            '                border: Border.all(color: Colors.amber.withValues(alpha: 0.3)),\n'
            '              ),\n'
            '              child: Row(\n'
            '                children: [\n'
            '                  const Icon(Icons.info_outline_rounded, color: Colors.amber, size: 20),\n'
            '                  const SizedBox(width: 10),\n'
            '                  Expanded(\n'
            '                    child: Text(\n'
            '                      \'Đơn đăng ký đang chờ Ban Tổ Chức xét duyệt. Nút thanh toán sẽ hiển thị sau khi BTC phê duyệt.\',\n'
            '                      style: TextStyle(\n'
            '                        fontSize: 12.5,\n'
            '                        color: context.colors.textPrimary,\n'
            '                        height: 1.35,\n'
            '                      ),\n'
            '                    ),\n'
            '                  ),\n'
            '                ],\n'
            '              ),\n'
            '            ),\n'
            '          ],\n'
            '          if (isPendingPartner) ...[\n'
            '            const SizedBox(height: 12),\n'
            '            Container(\n'
            '              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),\n'
            '              decoration: BoxDecoration(\n'
            '                color: AppTheme.primary.withValues(alpha: 0.1),\n'
            '                borderRadius: BorderRadius.circular(10),\n'
            '                border: Border.all(color: AppTheme.primary.withValues(alpha: 0.3)),\n'
            '              ),\n'
            '              child: Row(\n'
            '                children: [\n'
            '                  const Icon(Icons.group_add_rounded, color: AppTheme.primary, size: 20),\n'
            '                  const SizedBox(width: 10),\n'
            '                  Expanded(\n'
            '                    child: Text(\n'
            '                      \'Đang chờ đồng đội tham gia. Sau khi đồng đội vào đội, bạn có thể thanh toán lệ phí.\',\n'
            '                      style: TextStyle(\n'
            '                        fontSize: 12.5,\n'
            '                        color: context.colors.textPrimary,\n'
            '                        height: 1.35,\n'
            '                      ),\n'
            '                    ),\n'
            '                  ),\n'
            '                ],\n'
            '              ),\n'
            '            ),\n'
            '          ],\n'
            '          if (isWaitlisted) ...[\n'
            '            const SizedBox(height: 12),\n'
            '            Container(\n'
            '              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),\n'
            '              decoration: BoxDecoration(\n'
            '                color: Colors.orange.withValues(alpha: 0.12),\n'
            '                borderRadius: BorderRadius.circular(10),\n'
            '                border: Border.all(color: Colors.orange.withValues(alpha: 0.3)),\n'
            '              ),\n'
            '              child: Row(\n'
            '                children: [\n'
            '                  const Icon(Icons.hourglass_top_rounded, color: Colors.orange, size: 20),\n'
            '                  const SizedBox(width: 10),\n'
            '                  Expanded(\n'
            '                    child: Text(\n'
            '                      l10n.registerNoPaymentWaitlisted,\n'
            '                      style: TextStyle(\n'
            '                        fontSize: 12.5,\n'
            '                        color: context.colors.textPrimary,\n'
            '                        height: 1.35,\n'
            '                      ),\n'
            '                    ),\n'
            '                  ),\n'
            '                ],\n'
            '              ),\n'
            '            ),\n'
            '          ],\n'
            '          if (existingDivision != null) ...[\n'
            '            const SizedBox(height: 12),\n'
            '            _buildRegistrationDetails(\n'
            '              existingDivision,\n'
            '              status,\n'
            '              _existingIsPaid,\n'
            '            ),\n'
            '          ],\n'
            '          if (status == \'PENDING_PARTNER\') ...[\n'
            '            const SizedBox(height: 16),\n'
            '            SizedBox(\n'
            '              width: double.infinity,\n'
            '              child: FilledButton.icon(\n'
            '                onPressed: () {\n'
            '                  final inviteCode =\n'
            '                      _localInviteCode ?? widget.inviteCode ?? \'\';\n'
            '                  context.push(\n'
            '                    \'/register/${widget.tournamentId}/doubles?divisionId=${_existingDivisionId ?? \'\'}&invite=$inviteCode\',\n'
            '                    extra: existingDivision,\n'
            '                  );\n'
            '                },\n'
            '                icon: const Icon(Icons.qr_code_rounded),\n'
            '                label: Text(l10n.registerViewInviteCode),\n'
            '              ),\n'
            '            ),\n'
            '          ],\n'
            '          if (canPay) ...[\n'
            '            const SizedBox(height: 20),\n'
            '            SizedBox(\n'
            '              width: double.infinity,\n'
            '              height: 48,\n'
            '              child: FilledButton.icon(\n'
            '                onPressed: () => context.push(\n'
            '                  \'/payment/checkout\',\n'
            '                  extra: {\n'
            '                    \'tournamentId\': tournament.id,\n'
            '                    \'participantId\': _existingParticipantId,\n'
            '                    \'divisionId\': _existingDivisionId,\n'
            '                    \'amount\': fee,\n'
            '                    \'tournamentName\': tournament.name,\n'
            '                  },\n'
            '                ),\n'
            '                icon: const Icon(Icons.payment_rounded),\n'
            '                label: Text(\n'
            '                  l10n.registerPayNow(_formatAmount(fee)),\n'
            '                  style: const TextStyle(fontWeight: FontWeight.w800, fontSize: 15),\n'
            '                ),\n'
            '              ),\n'
            '            ),\n'
            '          ],\n'
            '          const SizedBox(height: 12),\n'
            '          OutlinedButton.icon(\n'
            '            onPressed: () async {\n'
            '              final withdrew = await WithdrawSheet.show(\n'
            '                context,\n'
            '                tournamentId: tournament.id,\n'
            '                divisionId: _existingDivisionId,\n'
            '                hasPaid: _existingIsPaid && fee > 0,\n'
            '              );\n'
            '              if (!withdrew || !mounted) return;\n'
            '              context.go(\'/intro/${tournament.id}\');\n'
            '            },\n'
            '            icon: Icon(Icons.exit_to_app_rounded, color: context.colors.error),\n'
            '            label: Text(\n'
            '              l10n.registerWithdraw,\n'
            '              style: TextStyle(color: context.colors.error),\n'
            '            ),\n'
            '          ),\n'
            '          const SizedBox(height: 8),\n'
            '          SizedBox(\n'
            '            width: double.infinity,\n'
            '            child: OutlinedButton(\n'
            '              onPressed: () => context.go(\'/intro/${tournament.id}\'),\n'
            '              child: Text(l10n.registerViewDetail),\n'
            '            ),\n'
            '          ),\n'
            '        ],\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '\n'
            '  Widget _buildRegistrationDetails(\n'
            '    TournamentDivisionOption division,\n'
            '    String status,\n'
            '    bool isPaid,\n'
            '  ) {\n'
            '    final rows = <String, String>{\n'
            '      l10n.registerDetailsContent: division.name,\n'
            '      l10n.registerDetailsFormat: _divisionTypeLabel(division),\n'
            '      l10n.registerDetailsStatus: switch (status) {\n'
            '        \'PENDING_APPROVAL\' => l10n.registerDetailsPendingApproval,\n'
            '        \'WAITLISTED\' => l10n.registerDetailsWaitlisted,\n'
            '        \'COMPLETE\' => l10n.registerDetailsApproved,\n'
            '        _ => status.isEmpty ? l10n.registerDetailsRegistered : status,\n'
            '      },\n'
            '      l10n.registerDetailsPayment: isPaid\n'
            '          ? l10n.registerDetailsPaid\n'
            '          : l10n.registerDetailsUnpaid,\n'
            '    };\n'
            '    return Container(\n'
            '      width: double.infinity,\n'
            '      padding: const EdgeInsets.all(14),\n'
            '      decoration: BoxDecoration(\n'
            '        color: context.colors.bgDark,\n'
            '        borderRadius: BorderRadius.circular(12),\n'
            '        border: Border.all(color: context.colors.border),\n'
            '      ),\n'
            '      child: Column(\n'
            '        children: rows.entries\n'
            '            .map(\n'
            '              (entry) => Padding(\n'
            '                padding: const EdgeInsets.symmetric(vertical: 4),\n'
            '                child: Row(\n'
            '                  crossAxisAlignment: CrossAxisAlignment.start,\n'
            '                  children: [\n'
            '                    Expanded(\n'
            '                      child: Text(\n'
            '                        entry.key,\n'
            '                        style: TextStyle(\n'
            '                          color: context.colors.textMuted,\n'
            '                          fontSize: 12,\n'
            '                        ),\n'
            '                      ),\n'
            '                    ),\n'
            '                    const SizedBox(width: 12),\n'
            '                    Flexible(\n'
            '                      child: Text(\n'
            '                        entry.value,\n'
            '                        textAlign: TextAlign.right,\n'
            '                        style: TextStyle(\n'
            '                          color: context.colors.textPrimary,\n'
            '                          fontSize: 12,\n'
            '                          fontWeight: FontWeight.w700,\n'
            '                        ),\n'
            '                      ),\n'
            '                    ),\n'
            '                  ],\n'
            '                ),\n'
            '              ),\n'
            '            )\n'
            '            .toList(),\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '\n'
            '  Widget _buildSuccess(Tournament? t) => Scaffold(\n'
            '    backgroundColor: context.colors.bgDark,\n'
            '    body: Center(\n'
            '      child: Padding(\n'
