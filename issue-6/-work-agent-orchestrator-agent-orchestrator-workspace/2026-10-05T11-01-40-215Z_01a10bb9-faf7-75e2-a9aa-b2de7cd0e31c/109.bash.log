            '              : PageView.builder(\n'
            '                  controller: pageController,\n'
            '                  itemCount: images.length,\n'
            '                  onPageChanged: onPageChanged,\n'
            '                  itemBuilder: (context, index) {\n'
            '                    final resolvedList = images\n'
            '                        .map((i) => _resolveImageUrl(i))\n'
            '                        .toList();\n'
            '                    return GestureDetector(\n'
            '                      onTap: () {\n'
            '                        AppImageViewer.showGallery(\n'
            '                          context,\n'
            '                          imageUrls: resolvedList,\n'
            '                          initialIndex: index,\n'
            '                        );\n'
            '                      },\n'
            '                      child: Image.network(\n'
            '                        resolvedList[index],\n'
            '                        fit: BoxFit.cover,\n'
            '                        errorBuilder: (context, error, stackTrace) =>\n'
            '                            _FallbackBanner(),\n'
            '                      ),\n'
            '                    );\n'
            '                  },\n'
            '                ),\n'
            '        ),\n'
            '        if (showOverlay)\n'
            '          DecoratedBox(\n'
            '            decoration: BoxDecoration(\n'
            '              gradient: LinearGradient(\n'
            '                begin: Alignment.topCenter,\n'
            '                end: Alignment.bottomCenter,\n'
            '                colors: [\n'
            '                  Colors.black.withValues(alpha: 0.08),\n'
            '                  Colors.black.withValues(alpha: 0.45),\n'
            '                ],\n'
            '              ),\n'
            '            ),\n'
            '          ),\n'
            '        if (tournament.logoUrl?.trim().isNotEmpty == true)\n'
            '          Positioned(\n'
            '            top: 12,\n'
            '            right: 12,\n'
            '            child: _TournamentLogo(tournament: tournament, size: 58),\n'
            '          ),\n'
            '        if (images.length > 1)\n'
            '          Positioned(\n'
            '            bottom: 34,\n'
            '            left: 0,\n'
            '            right: 0,\n'
            '            child: Row(\n'
            '              mainAxisAlignment: MainAxisAlignment.center,\n'
            '              children: List.generate(images.length, (index) {\n'
            '                final isActive = index == currentPage;\n'
            '                return AnimatedContainer(\n'
            '                  duration: const Duration(milliseconds: 180),\n'
            '                  margin: const EdgeInsets.symmetric(horizontal: 3),\n'
            '                  height: 6,\n'
            '                  width: isActive ? 18 : 6,\n'
            '                  decoration: BoxDecoration(\n'
            '                    color: isActive\n'
            '                        ? Colors.white\n'
            '                        : Colors.white.withValues(alpha: 0.42),\n'
            '                    borderRadius: BorderRadius.circular(999),\n'
            '                  ),\n'
            '                );\n'
            '              }),\n'
            '            ),\n'
            '          ),\n'
            '      ],\n'
            '    );\n'
            '  }\n'
            '}\n'
            '\n'
            'class TournamentManagementBanner extends StatefulWidget {\n'
            '  final Tournament tournament;\n'
            '  final AppColorsExtension colors;\n'
            '\n'
            '  const TournamentManagementBanner({\n'
            '    super.key,\n'
            '    required this.tournament,\n'
            '    required this.colors,\n'
            '  });\n'
            '\n'
            '  @override\n'
            '  State<TournamentManagementBanner> createState() =>\n'
            '      _TournamentManagementBannerState();\n'
            '}\n'
            '\n'
            'class _TournamentManagementBannerState\n'
            '    extends State<TournamentManagementBanner> {\n'
            '  final PageController _pageController = PageController();\n'
            '  int _currentPage = 0;\n'
            '\n'
            '  @override\n'
            '  void dispose() {\n'
            '    _pageController.dispose();\n'
            '    super.dispose();\n'
            '  }\n'
            '\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
            '    final tournament = widget.tournament;\n'
            '    final colors = widget.colors;\n'
            '    final viewportSize = MediaQuery.sizeOf(context);\n'
            '\n'
            '    return Container(\n'
            '      decoration: BoxDecoration(\n'
            '        color: colors.bgDark,\n'
            '        borderRadius: BorderRadius.circular(AppTheme.radiusLarge),\n'
            '        border: Border.all(color: colors.border),\n'
            '      ),\n'
            '      clipBehavior: Clip.antiAlias,\n'
            '      child: Column(\n'
            '        crossAxisAlignment: CrossAxisAlignment.stretch,\n'
            '        children: [\n'
            '          SizedBox(\n'
            '            height: AppResponsive.bannerHeight(\n'
            '              viewportSize.height,\n'
            '              viewportWidth: viewportSize.width,\n'
            '            ),\n'
            '            child: Stack(\n'
            '              children: [\n'
            '                _BannerCarousel(\n'
            '                  images: _collectImages(tournament),\n'
            '                  pageController: _pageController,\n'
            '                  currentPage: _currentPage,\n'
            '                  onPageChanged: (index) => setState(() {\n'
            '                    _currentPage = index;\n'
            '                  }),\n'
            '                  showOverlay: true,\n'
            '                  tournament: tournament,\n'
            '                ),\n'
            '                Positioned(\n'
            '                  top: 10,\n'
            '                  left: 10,\n'
            '                  child: Row(\n'
            '                    mainAxisSize: MainAxisSize.min,\n'
            '                    children: [\n'
            '                      SportPill(sportKey: tournament.sport),\n'
            '                      const SizedBox(width: 6),\n'
            '                      StatusBadge(statusKey: tournament.status),\n'
            '                    ],\n'
            '                  ),\n'
            '                ),\n'
            '              ],\n'
            '            ),\n'
            '          ),\n'
            '          Padding(\n'
            '            padding: const EdgeInsets.fromLTRB(14, 10, 14, 12),\n'
            '            child: Text(\n'
            '              tournament.name.trim().isEmpty\n'
            '                  ? AppLocalizations.of(context)!.unnamed\n'
            '                  : tournament.name,\n'
            '              maxLines: 2,\n'
            '              overflow: TextOverflow.ellipsis,\n'
            '              style: TextStyle(\n'
            '                color: colors.textPrimary,\n'
            '                fontSize: AppResponsive.bannerFontSize(\n'
            '                  viewportSize.height,\n'
            '                  viewportWidth: viewportSize.width,\n'
            '                ),\n'
            '                fontWeight: FontWeight.w800,\n'
            '                height: 1.2,\n'
            '              ),\n'
            '            ),\n'
            '          ),\n'
            '        ],\n'
            '      ),\n'
            '    );\n'
            '  }\n'
            '}\n'
            '\n'
            'class _FallbackBanner extends StatelessWidget {\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
            '    return const SportoBrandFallback(\n'
            '      withTagline: true,\n'
            '      semanticsLabel: \'SportO tournament fallback banner\',\n'
            '    );\n'
            '  }\n'
            '}\n'
            '\n'
            'class _HeaderBadges extends StatelessWidget {\n'
            '  final Tournament tournament;\n'
            '\n'
            '  const _HeaderBadges({required this.tournament});\n'
            '\n'
            '  @override\n'
            '  Widget build(BuildContext context) {\n'
