            '              child: Text(l10n.registerViewDetail),\n'
            '            ),\n'
            '            const SizedBox(height: 12),\n'
            '            TextButton.icon(\n'
            '              onPressed: () async {\n'
            '                final targetDivisionId = _registeredDivision?.id ??\n'
            '                    _existingDivisionId ??\n'
            '                    _selectedDiv;\n'
            '                final withdrew = await WithdrawSheet.show(\n'
            '                  context,\n'
            '                  tournamentId: widget.tournamentId,\n'
            '                  divisionId: targetDivisionId,\n'
            '                  hasPaid: false,\n'
            '                );\n'
            '                if (!withdrew || !mounted) return;\n'
            '                context.go(\'/intro/${widget.tournamentId}\');\n'
            '              },\n'
            '              icon: Icon(\n'
            '                Icons.exit_to_app_rounded,\n'
            '                size: 16,\n'
            '                color: context.colors.error,\n'
            '              ),\n'
            '              label: Text(\n'
            '                l10n.registerWithdraw,\n'
            '                style: TextStyle(color: context.colors.error, fontSize: 13),\n'
            '              ),\n'
            '            ),\n'
            '          ],\n'
            '        ),\n'
            '      ),\n'
            '    ),\n'
            '  );\n'
            '\n'
            '  Widget _buildHeader(Tournament t) {\n'
            '    final colors = context.colors;\n'
            '    final hasFee = t.entryFee != null && t.entryFee! > 0;\n'
            '\n'
            '    return Container(\n'
            '      width: double.infinity,\n'
            '      padding: const EdgeInsets.all(20),\n'
            '      decoration: BoxDecoration(\n'
            '        color: colors.bgCard,\n'
            '        borderRadius: BorderRadius.circular(20),\n'
            '        border: Border.all(color: colors.border),\n'
            '      ),\n'
            '      child: Column(\n'
            '        crossAxisAlignment: CrossAxisAlignment.start,\n'
            '        children: [\n'
            '          Text(\n'
            '            t.name,\n'
            '            style: TextStyle(\n'
            '              color: colors.textPrimary,\n'
            '              fontSize: 18,\n'
            '              fontWeight: FontWeight.w900,\n'
            '              letterSpacing: -0.3,\n'
            '            ),\n'
            '            maxLines: 2,\n'
            '          ),\n'
            '          const SizedBox(height: 10),\n'
            '          Wrap(\n'
            '            spacing: 8,\n'
            '            runSpacing: 8,\n'
            '            children: [\n'
            '              Container(\n'
            '                padding: const EdgeInsets.symmetric(\n'
            '                  horizontal: 10,\n'
            '                  vertical: 4,\n'
            '                ),\n'
            '                decoration: BoxDecoration(\n'
            '                  color: colors.bgSurface,\n'
            '                  borderRadius: BorderRadius.circular(8),\n'
            '                  border: Border.all(color: colors.border),\n'
            '                ),\n'
            '                child: Text(\n'
            '                  l10n.registerMaxTeams(t.maxTeams),\n'
            '                  style: TextStyle(\n'
            '                    color: colors.textMuted,\n'
            '                    fontSize: 12,\n'
            '                    fontWeight: FontWeight.w600,\n'
            '                  ),\n'
            '                ),\n'
            '              ),\n'
            '              Container(\n'
            '                padding: const EdgeInsets.symmetric(\n'
            '                  horizontal: 10,\n'
            '                  vertical: 4,\n'
            '                ),\n'
            '                decoration: BoxDecoration(\n'
            '                  color: hasFee\n'
            '                      ? AppTheme.primary.withValues(alpha: 0.12)\n'
            '                      : colors.bgSurface,\n'
            '                  borderRadius: BorderRadius.circular(8),\n'
            '                  border: Border.all(\n'
            '                    color: hasFee\n'
            '                        ? AppTheme.primary.withValues(alpha: 0.3)\n'
            '                        : colors.border,\n'
            '                  ),\n'
            '                ),\n'
            '                child: Text(\n'
            '                  hasFee\n'
            '                      ? l10n.doublesRegEntryFee(_formatFee(t.entryFee!))\n'
            '                      : l10n.registerFree,\n'
            '                  style: TextStyle(\n'
            '                    color: hasFee ? AppTheme.primary : colors.textMuted,\n'
            '                    fontWeight: FontWeight.w800,\n'
            '                    fontSize: 12,\n'
            '                  ),\n'
            '                ),\n'
            '              ),\n'
            '            ],\n'
            '          ),\n'
            '        ],\n'
            '      ),\n'
            '    ).animate().fadeIn(duration: 250.ms);\n'
            '  }\n'
            '\n'
            '  Widget _buildInviteGate(Tournament? t) => Padding(\n'
            '    padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 32),\n'
            '    child: Column(\n'
            '      mainAxisAlignment: MainAxisAlignment.center,\n'
            '      children: [\n'
            '        Icon(Icons.lock_rounded, size: 64, color: context.colors.textMuted),\n'
            '        const SizedBox(height: 24),\n'
            '        Text(\n'
            '          l10n.registerPrivateTitle,\n'
            '          style: TextStyle(\n'
            '            fontSize: 22,\n'
            '            fontWeight: FontWeight.w800,\n'
            '            color: context.colors.textPrimary,\n'
            '          ),\n'
            '        ),\n'
            '        const SizedBox(height: 8),\n'
            '        Text(\n'
            '          l10n.registerPrivateDesc,\n'
            '          style: TextStyle(fontSize: 14, color: context.colors.textSecondary),\n'
            '          textAlign: TextAlign.center,\n'
            '        ),\n'
            '        const SizedBox(height: 32),\n'
            '        TextField(\n'
            '          controller: _inviteCtrl,\n'
            '          textAlign: TextAlign.center,\n'
            '          style: TextStyle(\n'
            '            fontSize: 20,\n'
            '            fontWeight: FontWeight.w700,\n'
            '            letterSpacing: 8,\n'
            '            color: context.colors.textPrimary,\n'
            '          ),\n'
            '          decoration: InputDecoration(\n'
            '            hintText: l10n.registerInviteHint,\n'
            '            filled: true,\n'
            '            fillColor: context.colors.bgCard,\n'
            '            border: OutlineInputBorder(borderRadius: BorderRadius.circular(16)),\n'
            '            contentPadding: const EdgeInsets.symmetric(\n'
            '              horizontal: 20,\n'
            '              vertical: 16,\n'
            '            ),\n'
            '          ),\n'
            '          maxLength: 20,\n'
            '        ),\n'
            '        if (_inviteError != null) ...[\n'
            '          const SizedBox(height: 8),\n'
            '          Text(\n'
            '            _inviteError!,\n'
            '            style: TextStyle(\n'
            '              color: context.colors.error,\n'
            '              fontSize: 13,\n'
            '              fontWeight: FontWeight.w600,\n'
            '            ),\n'
            '          ),\n'
            '        ],\n'
            '        const SizedBox(height: 24),\n'
            '        SizedBox(\n'
            '          width: double.infinity,\n'
            '          height: 52,\n'
            '          child: FilledButton.icon(\n'
            '            onPressed: _inviteValidating ? null : _validateInvite,\n'
            '            icon: _inviteValidating\n'
            '                ? const SizedBox(\n'
            '                    width: 20,\n'
            '                    height: 20,\n'
            '                    child: CircularProgressIndicator(\n'
            '                      strokeWidth: 2,\n'
            '                      color: Colors.white,\n'
            '                    ),\n'
            '                  )\n'
            '                : const Icon(Icons.login_rounded),\n'
            '            label: Text(\n'
            '              _inviteValidating\n'
            '                  ? l10n.registerInviteValidating\n'
            '                  : l10n.registerInviteConfirm,\n'
            '            ),\n'
            '            style: FilledButton.styleFrom(\n'
            '              shape: RoundedRectangleBorder(\n'
            '                borderRadius: BorderRadius.circular(16),\n'
            '              ),\n'
            '            ),\n'
            '          ),\n'
            '        ),\n'
            '      ],\n'
            '    ),\n'
            '  );\n'
            '\n'
            '  Widget _buildLoginPrompt(Tournament t) => Column(\n'
            '    children: [\n'
            '      _buildHeader(t),\n'
            '      const SizedBox(height: 24),\n'
            '      Container(\n'
            '        padding: const EdgeInsets.all(20),\n'
            '        decoration: BoxDecoration(\n'
            '          color: context.colors.bgCard,\n'
            '          borderRadius: BorderRadius.circular(14),\n'
            '          border: Border.all(color: context.colors.border),\n'
            '        ),\n'
            '        child: Column(\n'
            '          children: [\n'
            '            Icon(\n'
            '              Icons.login_rounded,\n'
            '              size: 48,\n'
            '              color: context.colors.textMuted,\n'
            '            ),\n'
            '            const SizedBox(height: 12),\n'
            '            Text(l10n.registerLoginPrompt, textAlign: TextAlign.center),\n'
            '            const SizedBox(height: 16),\n'
            '            ElevatedButton.icon(\n'
            '              onPressed: () {\n'
            '                final params = <String, String>{};\n'
            '                if (widget.inviteCode?.isNotEmpty == true) {\n'
            '                  params[\'invite\'] = widget.inviteCode!;\n'
            '                }\n'
            '                if (widget.divisionId?.isNotEmpty == true) {\n'
            '                  params[\'divisionId\'] = widget.divisionId!;\n'
            '                }\n'
            '                final query = Uri(queryParameters: params).query;\n'
            '                final redirect =\n'
            '                    \'/register/${widget.tournamentId}${query.isEmpty ? \'\' : \'?$query\'}\';\n'
            '                context.push(\n'
            '                  \'/login?redirect=${Uri.encodeComponent(redirect)}\',\n'
            '                );\n'
            '              },\n'
            '              icon: const Icon(Icons.login),\n'
            '              label: Text(l10n.registerLoginButton),\n'
            '            ),\n'
            '          ],\n'
            '        ),\n'
            '      ),\n'
            '    ],\n'
            '  );\n'
            '\n'
            '  Widget _buildForm(\n'
            '    Tournament t,\n'
            '    AsyncValue<List<TournamentDivisionOption>> divAsync,\n'
            '  ) {\n'
            '    // Check profile completeness\n'
            '    final userAsync = ref.watch(userProfileProvider);\n'
            '    final user = userAsync.asData?.value;\n'
            '    final isIncomplete =\n'
            '        user?.fullName == null ||\n'
            '        user?.fullName?.isEmpty == true ||\n'
            '        user?.phoneNumber == null ||\n'
            '        user?.phoneNumber?.isEmpty == true ||\n'
            '        user?.gender == null ||\n'
            '        user?.gender?.isEmpty == true;\n'
            '\n'
            '    final now = DateTime.now();\n'
            '    final isRegistrationClosed =\n'
            '        (t.status == \'REGISTRATION_CLOSED\' ||\n'
            '        t.status == \'IN_PROGRESS\' ||\n'
            '        t.status == \'COMPLETED\' ||\n'
            '        t.status == \'CANCELLED\' ||\n'
            '        (t.registrationEndDate != null && now.isAfter(t.registrationEndDate!)));\n'
            '    final l10n = AppLocalizations.of(context)!;\n'
            '\n'
            '    return Column(\n'
            '      crossAxisAlignment: CrossAxisAlignment.start,\n'
            '      children: [\n'
            '        _buildHeader(t),\n'
            '        const SizedBox(height: 14),\n'
            '        _RegistrationCountdownCard(\n'
            '          targetDate:\n'
            '              t.registrationEndDate ??\n'
            '              t.startDate ??\n'
            '              DateTime.now().add(const Duration(days: 7)),\n'
            '        ),\n'
            '        const SizedBox(height: 16),\n'
            '        if (isRegistrationClosed) ...[\n'
            '          Container(\n'
            '            padding: const EdgeInsets.all(16),\n'
            '            decoration: BoxDecoration(\n'
            '              color: context.colors.warning.withValues(alpha: 0.12),\n'
            '              borderRadius: BorderRadius.circular(14),\n'
            '              border: Border.all(\n'
            '                color: context.colors.warning.withValues(alpha: 0.3),\n'
            '              ),\n'
            '            ),\n'
            '            child: Column(\n'
            '              crossAxisAlignment: CrossAxisAlignment.start,\n'
            '              children: [\n'
            '                Text(\n'
            '                  l10n.registerRegClosed,\n'
            '                  style: TextStyle(\n'
            '                    fontWeight: FontWeight.w800,\n'
            '                    fontSize: 14,\n'
            '                    color: context.colors.warning,\n'
            '                  ),\n'
            '                ),\n'
            '                const SizedBox(height: 6),\n'
            '                Text(\n'
            '                  l10n.registerRegClosedDesc,\n'
            '                  style: TextStyle(\n'
            '                    color: context.colors.textSecondary,\n'
            '                    fontSize: 13,\n'
            '                    height: 1.4,\n'
            '                  ),\n'
            '                ),\n'
            '              ],\n'
            '            ),\n'
            '          ),\n'
            '          const SizedBox(height: 16),\n'
            '        ],\n'
            '        if (isIncomplete) ...[\n'
            '          Container(\n'
            '            padding: const EdgeInsets.all(16),\n'
            '            decoration: BoxDecoration(\n'
            '              color: context.colors.error.withValues(alpha: 0.08),\n'
            '              borderRadius: BorderRadius.circular(14),\n'
            '              border: Border.all(\n'
            '                color: context.colors.error.withValues(alpha: 0.2),\n'
            '              ),\n'
            '            ),\n'
            '            child: Column(\n'
            '              crossAxisAlignment: CrossAxisAlignment.start,\n'
            '              children: [\n'
            '                Row(\n'
            '                  children: [\n'
            '                    Icon(\n'
            '                      Icons.warning_rounded,\n'
            '                      color: context.colors.error,\n'
            '                      size: 20,\n'
            '                    ),\n'
            '                    const SizedBox(width: 8),\n'
            '                    Text(\n'
            '                      l10n.registerProfileIncompleteTitle,\n'
            '                      style: const TextStyle(\n'
            '                        fontWeight: FontWeight.w800,\n'
            '                        fontSize: 14,\n'
            '                      ),\n'
            '                    ),\n'
            '                  ],\n'
            '                ),\n'
            '                const SizedBox(height: 8),\n'
            '                Text(\n'
            '                  l10n.registerProfileIncompleteDesc,\n'
            '                  style: TextStyle(\n'
            '                    color: context.colors.textSecondary,\n'
            '                    fontSize: 13,\n'
            '                    height: 1.4,\n'
            '                  ),\n'
            '                ),\n'
            '                const SizedBox(height: 12),\n'
            '                SizedBox(\n'
            '                  width: double.infinity,\n'
            '                  child: OutlinedButton.icon(\n'
            '                    onPressed: () => context.push(\'/profile/edit\'),\n'
            '                    icon: const Icon(Icons.edit_rounded, size: 16),\n'
            '                    label: Text(\n'
            '                      l10n.registerUpdateProfile,\n'
            '                      style: const TextStyle(fontWeight: FontWeight.w700),\n'
            '                    ),\n'
            '                    style: OutlinedButton.styleFrom(\n'
            '                      shape: RoundedRectangleBorder(\n'
            '                        borderRadius: BorderRadius.circular(12),\n'
            '                      ),\n'
            '                    ),\n'
            '                  ),\n'
