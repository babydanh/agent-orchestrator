            '                                    _isDivisionRegistrationExpired)\n'
            '                                ? l10n.registerRegClosed\n'
            '                                : _isSelectedDivisionFull\n'
            '                                ? l10n.registerDivisionFull\n'
            '                                : (_selectedDivision?.entryFee != null &&\n'
            '                                      _selectedDivision!.entryFee! > 0)\n'
            '                                ? l10n.registerSubmitFee(\n'
            '                                    _getSubmitLabel(t),\n'
            '                                    _formatFee(_selectedDivision!.entryFee!),\n'
            '                                  )\n'
            '                                : (t.entryFee != null && t.entryFee! > 0)\n'
            '                                ? l10n.registerSubmitFee(\n'
