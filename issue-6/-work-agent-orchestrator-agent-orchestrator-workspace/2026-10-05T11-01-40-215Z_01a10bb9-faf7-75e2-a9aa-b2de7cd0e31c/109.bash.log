            '                ],\n'
            '                const SizedBox(height: 24),\n'
            '                // Cảnh báo tĩnh trước khi bấm: trước đây người dùng phải điền\n'
            '                // hết form rồi mới biết hạn đã kết thúc, vì lỗi chỉ hiện sau\n'
            '                // khi server từ chối.\n'
            '                if (_isDivisionRegistrationExpired) ...[\n'
            '                  Container(\n'
            '                    padding: const EdgeInsets.all(12),\n'
            '                    decoration: BoxDecoration(\n'
            '                      color: context.colors.warning.withValues(alpha: 0.12),\n'
            '                      borderRadius: BorderRadius.circular(14),\n'
            '                      border: Border.all(\n'
            '                        color: context.colors.warning.withValues(alpha: 0.3),\n'
            '                      ),\n'
            '                    ),\n'
            '                    child: Row(\n'
            '                      children: [\n'
            '                        Icon(\n'
            '                          Icons.timer_off_rounded,\n'
            '                          size: 20,\n'
            '                          color: context.colors.warning,\n'
            '                        ),\n'
            '                        const SizedBox(width: 10),\n'
            '                        Expanded(\n'
            '                          child: Text(\n'
            '                            AppLocalizations.of(context)!\n'
