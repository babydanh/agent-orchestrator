            '                child: Text(\n'
            '                  _registrationTeamStatus == \'WAITLISTED\'\n'
            '                      ? l10n.registerNoPaymentWaitlisted\n'
            '                      : l10n.registerFeePending2(\n'
            '                          _formatAmount(_registeredEntryFee!),\n'
            '                        ),\n'
            '                  style: TextStyle(\n'
            '                    fontSize: 13,\n'
