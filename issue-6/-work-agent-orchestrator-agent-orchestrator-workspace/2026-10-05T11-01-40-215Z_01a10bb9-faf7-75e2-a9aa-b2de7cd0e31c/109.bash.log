            '                  width: double.infinity,\n'
            '                  height: 52,\n'
            '                  child: FilledButton(\n'
            '                    // Hạn cấp nội dung cũng chặn: trước đây chỉ xét hạn cấp\n'
            '                    // giải nên chọn nội dung đã đóng vẫn bấm được rồi mới nhận\n'
            '                    // lỗi từ server. Suất đội đã đầy chặn tương tự, nhưng là\n'
            '                    // trạng thái riêng vì khóa thủ công của BTC vẫn độc lập.\n'
            '                    onPressed:\n'
            '                        (isRegistrationClosed ||\n'
            '                            _isDivisionRegistrationExpired ||\n'
            '                            _isSelectedDivisionFull ||\n'
            '                            _submitting)\n'
            '                        ? null\n'
            '                        : _register,\n'
            '                    style: FilledButton.styleFrom(\n'
            '                      backgroundColor: AppTheme.primary,\n'
