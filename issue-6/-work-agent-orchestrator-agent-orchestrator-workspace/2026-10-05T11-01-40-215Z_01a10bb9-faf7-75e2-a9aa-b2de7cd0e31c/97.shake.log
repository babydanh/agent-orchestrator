1024:  Stream<List<MatchModel>> watchBracketMatches(
1025:    String tournamentId, {
1026:    String? divisionId,
1027:  }) {
1028:    final updates = StreamController<List<MatchModel>>();
1029:    final socketService = _matchSocketService;
1030:    StreamSubscription<Map<String, dynamic>>? matchUpdateSubscription;
1031:    Timer? refreshTimer;
1032:    var refreshing = false;
1033:    var refreshQueued = false;
