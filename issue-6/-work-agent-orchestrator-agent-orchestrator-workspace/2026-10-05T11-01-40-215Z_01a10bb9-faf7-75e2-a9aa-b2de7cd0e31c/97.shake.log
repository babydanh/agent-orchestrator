14:export function getInitialRegistrationDivisionId<T extends RegistrationDivision>(
15:  divisions: readonly T[],
16:  preferredDivisionId?: string | null,
17:): string {
18:  const activeDivisions = getActiveRegistrationDivisions(divisions);
19:  if (
20:    preferredDivisionId &&
