129:export async function fulfillApi(route: Route, payload: unknown, status = 200) {
130:  const requestHeaders = route.request().headers();
131:  const headers = {
132:    'access-control-allow-origin': requestHeaders.origin ?? 'http://127.0.0.1:3001',
133:    'access-control-allow-credentials': 'true',
134:    'access-control-allow-methods': 'GET, POST, OPTIONS',
135:    'access-control-allow-headers': requestHeaders['access-control-request-headers'] ?? 'authorization,content-type',
136:  };
137:
138:  if (route.request().method() === 'OPTIONS') {
139:    await route.fulfill({ status: 204, headers });
140:    return;
141:  }
142:
143:  await route.fulfill({ status, headers, json: payload });
144:}
145:
146:export async function openManage(
147:  page: Page,
148:  options: {
149:    divisions?: Array<typeof divisionFixture>;
150:    tab?: string;
151:    matchType?: 'SINGLES' | 'DOUBLES';
152:    withBracket?: boolean;
153:  } = {},
154:) {
155:  const matchType = options.matchType ?? 'SINGLES';
156:  const divisions = options.divisions ?? [{ ...divisionFixture, matchType }];
157:  const withBracket = options.withBracket ?? false;
158:  const currentTournament = { ...tournament, matchType };
159:
160:  await page.addInitScript((user) => {
161:    localStorage.setItem('auth-storage', JSON.stringify({
162:      state: { user, isAuthenticated: true },
163:      version: 0,
164:    }));
165:  }, organizer);
166:
167:  await page.route('**/api/v1/**', async (route) => {
168:    const pathname = new URL(route.request().url()).pathname;
169:
170:    if (pathname.endsWith('/users/profile')) {
171:      await fulfillApi(route, organizer);
172:      return;
173:    }
174:    if (pathname === `/api/v1/tournaments/${tournamentId}`) {
175:      await fulfillApi(route, { data: currentTournament });
176:      return;
177:    }
178:    if (pathname === `/api/v1/tournaments/${tournamentId}/divisions`) {
179:      await fulfillApi(route, { data: divisions });
180:      return;
181:    }
182:    if (pathname === `/api/v1/tournaments/${tournamentId}/bracket`) {
183:      await fulfillApi(route, { data: withBracket ? bracketFixture : { stages: [] } });
184:      return;
185:    }
186:    if (pathname === `/api/v1/tournaments/${tournamentId}/manage/participants`) {
187:      await fulfillApi(route, { data: divisions.length === 0 ? [] : [participant] });
188:      return;
189:    }
190:
191:    await fulfillApi(route, { data: [] });
192:  });
193:
194:  const tab = options.tab ? `?tab=${options.tab}` : '';
195:  await page.goto(`/organizer/tournaments/${tournamentId}/manage${tab}`, { waitUntil: 'domcontentloaded' });
196:}

