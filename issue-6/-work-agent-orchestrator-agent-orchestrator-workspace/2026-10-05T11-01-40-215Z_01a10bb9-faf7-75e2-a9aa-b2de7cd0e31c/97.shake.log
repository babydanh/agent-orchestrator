1035:    Future<void> refresh() async {
1036:      if (refreshing) {
1037:        refreshQueued = true;
1038:        return;
1039:      }
1040:      refreshing = true;
1041:      try {
1042:        final snapshot = await getBracketMatches(
1043:          tournamentId,
1044:          divisionId: divisionId,
1045:        );
1046:        if (!updates.isClosed) updates.add(snapshot);
1047:      } catch (error, stack) {
1048:        // Keep the last bracket visible after a dropped socket/reconciliation
1049:        // request. The next socket event or timer tick retries it.
1050:        _log.error('Error refreshing bracket after match update', error, stack);
1051:      } finally {
1052:        refreshing = false;
1053:        if (refreshQueued && !updates.isClosed) {
1054:          refreshQueued = false;
1055:          unawaited(refresh());
1056:        }
1057:      }
1058:    }
1059:
1060:    updates.onListen = () {
1061:      if (socketService != null) {
1062:        // The backend emits match:update to the tournament room after every
1063:        // score/status write, so the bracket re-reads the authoritative
1064:        // projection instead of trying to merge a partial match payload.
1065:        matchUpdateSubscription = socketService.onTournamentMatchUpdate
1066:            .where(
1067:              (payload) =>
1068:                  payload['tournamentId']?.toString() == tournamentId &&
1069:                  (divisionId == null ||
1070:                      divisionId.isEmpty ||
1071:                      payload['divisionId']?.toString() == divisionId),
1072:            )
1073:            .listen((_) => unawaited(refresh()));
1074:        socketService.connect(null, joinMatch: false);
1075:        socketService.joinTournament(tournamentId);
1076:      }
1077:
1078:      unawaited(refresh());
1079:      // Polling remains as a recovery path for a missed socket event or an
1080:      // older backend node that does not broadcast tournament match:update.
1081:      refreshTimer = Timer.periodic(
1082:        const Duration(seconds: 30),
1083:        (_) => unawaited(refresh()),
1084:      );
